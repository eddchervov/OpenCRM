@model EmailConfirmationModel
@{
    Layout = "/Templates/OpenCRM/V1/_Layout.cshtml";
}
<h1 style="margin:0 0 24px;font-size:26px;">Подтвердите электронную почту</h1>
<p style="line-height:1.6;">Здравствуйте, @Model.Name!</p>
<p style="line-height:1.6;">Нажмите на кнопку, чтобы подтвердить этот адрес в вашем аккаунте.</p>
<p style="margin:28px 0;">
    <a href="@Model.ConfirmationUrl" style="display:inline-block;padding:14px 20px;background:#1f6feb;color:#fff;text-decoration:none;border-radius:6px;">Подтвердить почту</a>
</p>
<p style="font-size:14px;line-height:1.6;">Если кнопка не работает, откройте
    <a href="@Model.ConfirmationUrl" style="color:#1f6feb;">ссылку подтверждения</a>.
</p>
<p style="font-size:14px;line-height:1.6;">Если вы не запрашивали подтверждение, проигнорируйте это письмо.</p>
