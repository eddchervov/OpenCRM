@startuml domain_model
title OpenCRM — предметная модель CRM

hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class ApplicationUser {
  Id: string
  Email: string
  LastLoginDate: DateTime
}

class Organization {
  Id: Guid
  Name: string
  PrimaryScenarioCode: string
  IsActive: bool
  IsArchived: bool
  IsDeleted: bool
}

class OrganizationMember {
  OrganizationId: Guid
  UserId: string
  RoleCode: string
}

class OrganizationClient {
  Id: Guid
  OrganizationId: Guid
  Name: string
}

class Vehicle {
  Id: Guid
  UserId: string
  OrganizationId: Guid?
  OrganizationClientId: Guid?
  RegistrationPlate: string?
}

class Maintenance {
  Id: Guid
  Date: DateTime
  VehicleId: Guid
  Details: List<MaintenanceDetail>
}

class MaintenanceDetail {
  MaintenanceId: Guid <<FK>>
  DetailId: Guid
  Position: int
  Price: decimal?
}

class OrganizationSubscription <<опциональная коммерция>> {
  Id: int
  OrganizationId: Guid
  SubscriptionPlanId: int
  StartDate: DateTime
  EndDate: DateTime
}

class SubscriptionPlan <<опциональная коммерция>> {
  Id: int
  Name: string
}

ApplicationUser "1" -- "0..*" OrganizationMember
Organization "1" *-- "0..*" OrganizationMember
Organization "1" *-- "0..*" OrganizationClient
Organization "0..1" -- "0..*" Vehicle
ApplicationUser "1" -- "0..*" Vehicle : владелец личной техники
OrganizationClient "0..1" -- "0..*" Vehicle
Vehicle "1" *-- "0..*" Maintenance
Maintenance "1" *-- "0..*" MaintenanceDetail : строки в отдельной таблице
Organization "1" -- "0..*" OrganizationSubscription
SubscriptionPlan "1" -- "0..*" OrganizationSubscription

note bottom of MaintenanceDetail
  MaintenanceId — внешний ключ на Maintenance.
  Строки услуг и работ хранятся как связанные записи, а не JSON.
end note

note bottom of OrganizationSubscription
  Коммерческие записи используются только если установка включает
  PlatformPolicy:Commercial:Enabled.
end note

@enduml
