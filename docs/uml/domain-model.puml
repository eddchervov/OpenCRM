@startuml domain_model
title OpenCRM — core CRM domain

hide methods
skinparam classAttributeIconSize 0
skinparam shadowing false
skinparam linetype ortho

class ApplicationUser {
  Id: string
  Email: string
  LastLoginDate: DateTime
}

class Organization {
  Id: Guid
  Name: string
  PrimaryScenarioCode: string
  IsActive: bool
  IsArchived: bool
  IsDeleted: bool
}

class OrganizationMember {
  OrganizationId: Guid
  UserId: string
  RoleCode: string
}

class OrganizationClient {
  Id: Guid
  OrganizationId: Guid
  Name: string
}

class Vehicle {
  Id: Guid
  UserId: string
  OrganizationId: Guid?
  OrganizationClientId: Guid?
  RegistrationPlate: string?
}

class Maintenance {
  Id: Guid
  Date: DateTime
  VehicleId: Guid
  Details: List<MaintenanceDetail>
}

class MaintenanceDetail {
  MaintenanceId: Guid <<FK>>
  DetailId: Guid
  Position: int
  Price: decimal?
}

class OrganizationSubscription <<optional commercial>> {
  Id: int
  OrganizationId: Guid
  SubscriptionPlanId: int
  StartDate: DateTime
  EndDate: DateTime
}

class SubscriptionPlan <<optional commercial>> {
  Id: int
  Name: string
}

ApplicationUser "1" -- "0..*" OrganizationMember
Organization "1" *-- "0..*" OrganizationMember
Organization "1" *-- "0..*" OrganizationClient
Organization "0..1" -- "0..*" Vehicle
ApplicationUser "1" -- "0..*" Vehicle : personal owner
OrganizationClient "0..1" -- "0..*" Vehicle
Vehicle "1" *-- "0..*" Maintenance
Maintenance "1" *-- "0..*" MaintenanceDetail : rows in separate table
Organization "1" -- "0..*" OrganizationSubscription
SubscriptionPlan "1" -- "0..*" OrganizationSubscription

note bottom of MaintenanceDetail
  MaintenanceId is a foreign key to Maintenance.
  Service and work rows are relational records, not JSON.
end note

note bottom of OrganizationSubscription
  Commercial records are used only when the installation enables
  PlatformPolicy:Commercial:Enabled.
end note

@enduml
