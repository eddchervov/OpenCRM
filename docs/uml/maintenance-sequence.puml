@startuml maintenance_sequence
title opencrm.example.invalid — create a maintenance record

autonumber
actor "Employee" as Employee
boundary "Maintenance / Workspace API" as Api
control "Permission Service" as Permission
control "Subscription Service" as Subscription
control "Maintenance Service" as Maintenance
control "Audit Service" as Audit
database "PostgreSQL" as Db

Employee -> Api : maintenance data
Api -> Permission : maintenance.edit
Permission -> Db : membership, role, overrides
Db --> Permission : access
Permission --> Api : allowed

Api -> Subscription : check write access and features
Subscription -> Db : active organization subscription
Db --> Subscription : plan snapshot
Subscription --> Api : write enabled

Api -> Maintenance : CreateAsync
Maintenance -> Db : validate vehicle and organization
Maintenance -> Db : INSERT Maintenance
Maintenance -> Db : history, defects,\ncounters, and materials
Maintenance -> Audit : add event
Audit -> Db : INSERT OrganizationAuditEvent
Db --> Maintenance : commit
Maintenance --> Api : Maintenance DTO
Api --> Employee : 201 Created

@enduml
