@startuml system_architecture
title OpenCRM — modular CRM and service integrations

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho

actor "CRM user" as User
actor "Administrator" as Admin

rectangle "OpenCRM clients" {
  component "CRM web interface\n+ REST API" as CrmClient
  component "Web admin\nVue" as AdminWeb
  component "Desktop admin\nAvalonia" as AdminDesktop
}

rectangle "OpenCRM modular host\nASP.NET Core" {
  component "Authentication\nIdentity + JWT" as Auth
  component "CRM modules\norganizations, clients, vehicles,\nmaintenance, workspace" as Modules
  component "Admin APIs" as AdminApi
  component "Optional AI assistant" as AI
  component "Outbox dispatchers" as Outbox
}

database "Main PostgreSQL\nCRM + identity" as MainDb
cloud "Configured file storage\noptional media integration" as Storage
queue "RabbitMQ\nservice message transport" as Rabbit
cloud "Optional AI provider" as AIProvider

rectangle "Notifications service" {
  component "Notifications.Worker" as NotifyWorker
  database "Notifications database" as NotifyDb
  cloud "Configured delivery providers" as Delivery
}

rectangle "Payments service" {
  component "Payments.Service" as PaymentsWorker
  database "Payments database" as PaymentsDb
  cloud "Configured payment provider" as PaymentProvider
}

User --> CrmClient
Admin --> AdminWeb
Admin --> AdminDesktop
CrmClient --> Auth
CrmClient --> Modules
AdminWeb --> AdminApi
AdminDesktop --> AdminApi
AdminApi --> Auth
AdminApi --> Modules
Modules --> MainDb
Auth --> MainDb
Outbox --> MainDb
Modules --> Storage
Outbox --> Rabbit
Rabbit --> NotifyWorker
NotifyWorker --> NotifyDb
NotifyWorker --> Delivery
Rabbit --> PaymentsWorker
PaymentsWorker --> PaymentsDb
PaymentsWorker --> PaymentProvider
PaymentsWorker --> Rabbit : state events
AI ..> AIProvider : optional provider

note bottom of CrmClient
  OpenCRM is the CRM application, not a public marketing website.
end note

note bottom of Rabbit
  External providers are configured by each installation.
  Core sign-in and CRM work do not require payment or AI providers.
end note

@enduml
