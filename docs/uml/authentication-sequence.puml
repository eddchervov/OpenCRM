@startuml authentication_sequence
title opencrm.example.invalid — registration and authentication

autonumber
actor "User" as User
boundary "Web / API" as UI
control "AuthController" as Controller
control "ASP.NET Identity" as Identity
control "AuthTokenService" as Tokens
database "PostgreSQL" as Db

alt Registration
  User -> UI : email, password, consent
  UI -> Controller : Register
  Controller -> Identity : CreateAsync
  Identity -> Db : INSERT ApplicationUser
  Controller -> Db : profile and base plan
  Controller --> UI : cookie or JWT
  UI --> User : signed in
else Web sign-in
  User -> UI : email and password
  UI -> Controller : Login
  Controller -> Identity : PasswordSignInAsync
  Identity -> Db : validate user
  Identity --> Controller : Identity cookie
  Controller --> User : redirect to account
else API sign-in
  User -> UI : email and password
  UI -> Tokens : LoginAsync
  Tokens -> Identity : CheckPasswordAsync
  Identity -> Db : validate user
  Tokens -> Db : save sessionId,\nrefresh secret hash and expiry
  Tokens --> User : access JWT + refresh token
else JWT refresh
  User -> Tokens : refresh token
  Tokens -> Db : validate session, hash, and expiry
  Tokens -> Db : revoke old refresh token
  Tokens -> Db : save new refresh token
  Tokens --> User : new token pair
end

note over Controller,Tokens
  Google Login is commented out.
  Standard registration and sign-in are enabled.
end note

@enduml
