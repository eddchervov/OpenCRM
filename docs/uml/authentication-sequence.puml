@startuml authentication_sequence
title OpenCRM — registration and authentication

autonumber
actor "User" as User
boundary "Web or API" as Client
control "AuthController" as WebAuth
control "AccountRegistrationService" as Registration
control "ASP.NET Identity" as Identity
control "AuthTokenService" as Tokens
control "Email confirmation policy" as EmailPolicy
database "Main PostgreSQL" as Db
queue "Notification outbox" as Mail

alt Web registration
  User -> Client : email, password, required personal-data consent
  Client -> WebAuth : Register
  WebAuth -> Registration : CreateAsync
  Registration -> Identity : create ApplicationUser
  Identity -> Db : INSERT ApplicationUser
  Registration --> WebAuth : account created
  WebAuth -> EmailPolicy : IsRequired
  alt EmailConfirmation:Required = false (default)
    EmailPolicy --> WebAuth : confirmation not required
    WebAuth --> Client : registration succeeds; sign-in continues
  else Email confirmation enabled
    EmailPolicy --> WebAuth : confirmation required
    WebAuth -> Mail : queue confirmation message
    WebAuth --> Client : confirmation page
  end
else Web sign-in
  User -> Client : email and password
  Client -> WebAuth : Login
  WebAuth -> Identity : PasswordSignInAsync
  Identity -> Db : validate account and password
  WebAuth -> EmailPolicy : check optional confirmation policy
  WebAuth --> Client : sign-in result / confirmation redirect
else API sign-in
  User -> Client : email and password
  Client -> Tokens : LoginAsync
  Tokens -> Identity : CheckPasswordAsync
  Identity -> Db : validate account and password
  Tokens -> Db : persist refresh-token hash and expiry
  Tokens --> Client : access JWT + refresh token
else API token refresh
  User -> Tokens : refresh token
  Tokens -> Db : validate and revoke current token
  Tokens -> Db : persist rotated refresh-token hash
  Tokens --> User : new access JWT + refresh token
end

note over Registration,Db
  Registration creates an ApplicationUser. There is no required AccountProfile
  row or organization tariff in this flow.
end note

@enduml
