@startuml system_architecture
title opencrm.example.invalid — общая архитектура

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho

actor "Посетитель" as Visitor
actor "Пользователь /\nсотрудник" as User
actor "Администратор" as Admin
actor "Клиент организации" as Client

rectangle "Клиентские интерфейсы" {
  component "Публичный сайт\nRazor / MVC" as PublicWeb
  component "Личный кабинет\nRazor + Vue 2" as Cabinet
  component "REST API\n/api/v1" as Api
  component "Admin API\n/api/v1/admin" as AdminApi
}

rectangle "OpenCRM.WebApp\nASP.NET Core 10" {
  component "Authentication\nIdentity Cookie + JWT" as Auth
  component "MVC/API Controllers" as Controllers
  component "Business Services" as Services
  component "Organization Permissions" as Permissions
  component "Subscription Features" as Features
  component "Hangfire Jobs" as Jobs
  component "PDF / DOCX" as Documents
  component "Media Services" as Media
}

database "PostgreSQL\nbusiness + identity + hangfire" as Db
cloud "S3-compatible storage" as S3
cloud "YooKassa" as YooKassa
cloud "SMTP / UniSender Go" as Email
cloud "SMS.ru" as Sms
cloud "Seq" as Seq
cloud "Google reCAPTCHA" as Captcha

Visitor --> PublicWeb
User --> Cabinet
User --> Api
Admin --> AdminApi
Client --> PublicWeb

PublicWeb --> Controllers
Cabinet --> Controllers
Api --> Controllers
AdminApi --> Controllers

Controllers --> Auth
Controllers --> Services
Services --> Permissions
Services --> Features
Services --> Documents
Services --> Media
Services --> Db
Auth --> Db
Permissions --> Db
Features --> Db
Jobs --> Db
Media --> S3
Services --> YooKassa
YooKassa --> Controllers : webhook
Services --> Email
Email --> Controllers : delivery webhook
Services --> Sms
Controllers --> Captcha
Controllers --> Seq : logs

note right of Auth
  Обычная регистрация активна.
  Google Login отключен.
end note

@enduml
