@startuml system_architecture
title OpenCRM — модульная CRM и интеграционные сервисы

left to right direction
skinparam componentStyle rectangle
skinparam shadowing false
skinparam linetype ortho

actor "Пользователь CRM" as User
actor "Администратор" as Admin

rectangle "Клиенты OpenCRM" {
  component "Веб-интерфейс CRM\n+ REST API" as CrmClient
  component "Веб-админка\nVue" as AdminWeb
  component "Desktop-админка\nAvalonia" as AdminDesktop
}

rectangle "Модульный хост OpenCRM\nASP.NET Core" {
  component "Аутентификация\nIdentity + JWT" as Auth
  component "Модули CRM\nорганизации, клиенты, техника,\nобслуживание, рабочее пространство" as Modules
  component "Административные API" as AdminApi
  component "Опциональный ИИ-помощник" as AI
  component "Диспетчеры outbox" as Outbox
}

database "Основной PostgreSQL\nCRM + идентификация" as MainDb
cloud "Настроенное файловое хранилище\nопциональная интеграция медиа" as Storage
queue "RabbitMQ\nтранспорт сообщений сервисов" as Rabbit
cloud "Внешний ИИ-провайдер, опционально" as AIProvider

rectangle "Сервис уведомлений" {
  component "Notifications.Worker" as NotifyWorker
  database "База уведомлений" as NotifyDb
  cloud "Настроенные провайдеры доставки" as Delivery
}

rectangle "Платёжный сервис" {
  component "Payments.Service" as PaymentsWorker
  database "База платежей" as PaymentsDb
  cloud "Настроенный платёжный провайдер" as PaymentProvider
}

User --> CrmClient
Admin --> AdminWeb
Admin --> AdminDesktop
CrmClient --> Auth
CrmClient --> Modules
AdminWeb --> AdminApi
AdminDesktop --> AdminApi
AdminApi --> Auth
AdminApi --> Modules
Modules --> MainDb
Auth --> MainDb
Outbox --> MainDb
Modules --> Storage
Outbox --> Rabbit
Rabbit --> NotifyWorker
NotifyWorker --> NotifyDb
NotifyWorker --> Delivery
Rabbit --> PaymentsWorker
PaymentsWorker --> PaymentsDb
PaymentsWorker --> PaymentProvider
PaymentsWorker --> Rabbit : события состояний
AI ..> AIProvider : опциональный провайдер

note bottom of CrmClient
  OpenCRM — приложение CRM, а не публичный маркетинговый сайт.
end note

note bottom of Rabbit
  Внешние провайдеры настраивает владелец установки.
  Для входа и основной работы CRM платёжный или ИИ-провайдер не нужен.
end note

@enduml
