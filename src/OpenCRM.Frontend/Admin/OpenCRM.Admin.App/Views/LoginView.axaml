<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             x:Class="OpenCRM.Admin.App.Views.LoginView"
             x:DataType="vm:MainWindowViewModel">
  <StackPanel Width="340" Spacing="14" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24">
    <TextBox Text="{Binding Email}" PlaceholderText="Email" IsEnabled="{Binding !IsBusy}"
             AutomationProperties.AutomationId="EmailInput" AutomationProperties.Name="Email" />
    <TextBox Text="{Binding Password}" PasswordChar="●" PlaceholderText="Пароль" IsEnabled="{Binding !IsBusy}"
             AutomationProperties.AutomationId="PasswordInput" AutomationProperties.Name="Пароль" />
    <Border IsVisible="{Binding HasError}" Background="#261A1A" BorderBrush="#594040"
            BorderThickness="1" CornerRadius="7" Padding="14,12">
      <TextBlock Text="{Binding ErrorMessage}" Foreground="#F4CACA" TextWrapping="Wrap"
                 AutomationProperties.AutomationId="LoginError" />
    </Border>
    <Button Content="Войти" Classes="primary" Command="{Binding LoginCommand}" IsDefault="True"
            HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" MinHeight="44"
            AutomationProperties.AutomationId="LoginButton" />
  </StackPanel>
</UserControl>
