<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenCRM.Admin.App.Localization"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:api="using:OpenCRM.Admin.Api.Models"
             x:Class="OpenCRM.Admin.App.Views.VehicleCatalogView"
             x:DataType="vm:VehicleCatalogViewModel">
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.katalog.tekhniki}" Classes="heading" />
        <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.marki.i.modeli.dostupnye.v.prilozhenii}" Classes="caption" />
      </StackPanel>
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
        <Button Content="{loc:LocalizedText Key=native.vehicleCatalog.dopolnit.katalog}" Command="{Binding RequestSeedCommand}" />
        <Button Content="{loc:LocalizedText Key=native.billing.obnovit}" Command="{Binding RefreshCommand}" />
      </StackPanel>
    </Grid>

    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" Foreground="#9CDABB" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>

    <Border Grid.Row="2" Classes="configurationSection" Padding="14" IsVisible="{Binding HasNoSelectedBrand}">
      <WrapPanel>
        <TextBox Width="300" Text="{Binding Search}" PlaceholderText="{loc:LocalizedText Key=native.vehicleCatalog.poisk.po.nazvaniyu.marki}" Margin="0,0,8,8" />
        <ComboBox Width="220" ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedKind}" Margin="0,0,8,8" />
        <Button Content="{loc:LocalizedText Key=native.billing.nayti}" Command="{Binding ApplyFiltersCommand}" Margin="0,0,8,8" />
        <Button Content="{loc:LocalizedText Key=native.vehicleCatalog.novaya.marka}" Classes="configurationPrimary" Command="{Binding CreateBrandCommand}" Margin="0,0,0,8" />
      </WrapPanel>
    </Border>

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="configurationSection" Padding="0" IsVisible="{Binding HasNoSelectedBrand}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="18,16,18,12">
              <StackPanel Spacing="3">
                <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.marki}" Classes="configurationHeading" />
                <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.otkroyte.marku.chtoby.upravlyat.eyo.modelyami}" Classes="caption" />
              </StackPanel>
              <Border Grid.Column="1" Classes="configurationBadge" VerticalAlignment="Center">
                <TextBlock Text="{loc:LocalizedFormat Key=native.vehicleCatalog.vsego.0.n0, Path=Brands.Count}" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding Brands}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="api:AdminCatalogBrand">
                  <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding KindText}" Classes="caption" />
                          <TextBlock Text="·" Classes="caption" />
                          <TextBlock Text="{loc:LocalizedFormat Key=native.vehicleCatalog.0.modeley, Path=ModelsCount}" Classes="caption" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button Content="{loc:LocalizedText Key=native.vehicleCatalog.modeli}" Command="{Binding $parent[UserControl].((vm:VehicleCatalogViewModel)DataContext).SelectBrandCommand}"
                                CommandParameter="{Binding}" Classes="configurationPrimary" />
                        <Button Content="{loc:LocalizedText Key=native.siteNotifications.izmenit}" Command="{Binding $parent[UserControl].((vm:VehicleCatalogViewModel)DataContext).EditBrandCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="{loc:LocalizedText Key=native.plans.udalit}" Command="{Binding $parent[UserControl].((vm:VehicleCatalogViewModel)DataContext).RequestDeleteBrandCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding IsEmpty}" Padding="18,24">
              <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.marki.ne.naydeny.izmenite.filtr.ili.dobavte.novuyu.marku}" Classes="caption" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="configurationSection" Padding="0" IsVisible="{Binding HasSelectedBrand}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="18,16,18,12" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="{loc:LocalizedFormat Path=SelectedBrand.Name, FallbackKey=native.vehicleCatalog.modeli}" Classes="configurationHeading" TextWrapping="Wrap" />
                <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.modeli.vybrannoy.marki}" Classes="caption" />
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                <Button Content="{loc:LocalizedText Key=native.vehicleCatalog.k.markam}" Command="{Binding CloseModelsCommand}" />
                <Button Content="{loc:LocalizedText Key=native.vehicleCatalog.novaya.model}" Classes="configurationPrimary" Command="{Binding CreateModelCommand}" />
              </StackPanel>
            </Grid>
            <ItemsControl ItemsSource="{Binding Models}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="api:AdminCatalogModel">
                  <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4" VerticalAlignment="Center">
                        <TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{loc:LocalizedFormat Key=native.vehicleCatalog.0.edinits.tekhniki, Path=VehiclesCount}" Classes="caption" />
                      </StackPanel>
                      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="7" VerticalAlignment="Center">
                        <Button Content="{loc:LocalizedText Key=native.siteNotifications.izmenit}" Command="{Binding $parent[UserControl].((vm:VehicleCatalogViewModel)DataContext).EditModelCommand}"
                                CommandParameter="{Binding}" />
                        <Button Content="{loc:LocalizedText Key=native.plans.udalit}" Command="{Binding $parent[UserControl].((vm:VehicleCatalogViewModel)DataContext).RequestDeleteModelCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.u.etoy.marki.poka.net.modeley.dobavte.pervuyu.model.knopkoy.vysh}" IsVisible="{Binding HasNoModels}"
                       Classes="caption" Margin="18,16" TextWrapping="Wrap" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.RowSpan="4" IsVisible="{Binding IsEditorOpen}" Background="#B8000000" ZIndex="5" Padding="20">
      <Border Classes="configurationSection" MaxWidth="660" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="24">
        <StackPanel Spacing="18">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <StackPanel Spacing="4">
              <TextBlock Text="{Binding EditorTitle}" Classes="configurationHeading" />
              <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.izmeneniya.srazu.poyavyatsya.v.kataloge}" Classes="caption" />
            </StackPanel>
            <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelEditCommand}" VerticalAlignment="Center" />
          </Grid>
          <StackPanel Spacing="7">
            <TextBlock Text="{loc:LocalizedText Key=native.plans.nazvanie}" Classes="caption" />
            <TextBox Text="{Binding Name}" PlaceholderText="{loc:LocalizedText Key=native.vehicleCatalog.vvedite.nazvanie}" />
          </StackPanel>
          <StackPanel Spacing="7" IsVisible="{Binding IsBrandEditor}">
            <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.vid.tekhniki}" Classes="caption" />
            <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding SelectedEditKind}" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:LocalizedText Key=native.vehicleCatalog.sokhranit}" Classes="configurationPrimary" Command="{Binding SaveCommand}" />
            <Button Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelEditCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>

    <Border Grid.RowSpan="4" IsVisible="{Binding IsConfirmationOpen}" Background="#CC000000" ZIndex="10" Padding="20">
      <Border Classes="configurationSection" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.podtverzhdenie}" Classes="configurationHeading" />
          <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:LocalizedText Key=native.email.prodolzhit}" Classes="configurationPrimary" Command="{Binding ConfirmCommand}" />
            <Button Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelConfirmationCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
