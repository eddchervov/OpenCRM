<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenCRM.Admin.App.Localization"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:api="using:OpenCRM.Admin.Api.Models"
             xmlns:views="using:OpenCRM.Admin.App.Views"
             x:Class="OpenCRM.Admin.App.Views.PromoCodesView"
             x:DataType="vm:PromoCodesViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.promokody}" Classes="heading" AutomationProperties.AutomationId="PromoCodesHeading" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="{loc:LocalizedText Key=native.billing.obnovit}" Command="{Binding RefreshCommand}" />
        <Button Content="{loc:LocalizedText Key=native.promoCodes.createButton}" Classes="configurationPrimary" Command="{Binding CreateCommand}" IsVisible="{Binding !IsEditorOpen}" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SuccessMessage}" IsVisible="{Binding HasMessage}" Foreground="#A7DCA7" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="PromoCodePageScroll">
      <StackPanel Spacing="18">
        <StackPanel Spacing="16" IsVisible="{Binding !IsEditorOpen}" MaxWidth="1400" HorizontalAlignment="Stretch">
          <Border Classes="configurationSection" Padding="16">
            <WrapPanel>
              <TextBox Text="{Binding Search}" PlaceholderText="{loc:LocalizedText Key=native.promoCodes.nayti.kod.ili.nazvanie}" Width="280" Margin="0,0,10,0" IsEnabled="{Binding CanEdit}" />
              <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValue="{Binding StatusFilter}" SelectedValueBinding="{Binding Code}" Width="174" IsEnabled="{Binding CanEdit}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PromoCodeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </WrapPanel>
          </Border>
          <Border Classes="configurationSection" Padding="0">
            <StackPanel>
              <Grid ColumnDefinitions="1.2*,1.1*,1.1*,Auto,Auto" ColumnSpacing="16" Margin="18,14">
                <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.promokod}" Classes="caption" /><TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=native.promoCodes.vygoda}" Classes="caption" />
                <TextBlock Grid.Column="2" Text="{loc:LocalizedText Key=native.promoCodes.ispolzovanie}" Classes="caption" /><TextBlock Grid.Column="3" Text="{loc:LocalizedText Key=native.plans.status}" Classes="caption" />
                <TextBlock Grid.Column="4" Text="{loc:LocalizedText Key=native.promoCodes.deystvie}" Classes="caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding FilteredRows}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PromoCodeRow">
                  <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,16">
                    <Grid ColumnDefinitions="1.2*,1.1*,1.1*,Auto,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Name}" Classes="caption" TextWrapping="Wrap" /><TextBlock Text="{Binding ValidUntil}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Benefit}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding UsageCount}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Border Grid.Column="3" Classes="configurationBadge" Classes.active="{Binding PromoCode.IsActive}"><TextBlock Text="{Binding Status}" /></Border>
                      <Button Grid.Column="4" Content="{loc:LocalizedText Key=native.plans.otkryt}" Command="{Binding $parent[views:PromoCodesView].((vm:PromoCodesViewModel)DataContext).OpenRowCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.AutomationId="PromoCodeOpen" />
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.promokody.ne.naydeny}" IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" Margin="24" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Spacing="18" IsVisible="{Binding IsEditorOpen}" MaxWidth="1040" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button Content="{loc:LocalizedText Key=native.promoCodes.k.promokodam}" Command="{Binding CloseEditorCommand}" HorizontalAlignment="Left" Background="Transparent" Padding="0,8,12,8" />
            <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.promoCodes.sokhranit.promokod}" Classes="configurationPrimary" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="PromoCodeSave" />
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.createTitle}" IsVisible="{Binding IsCreating}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsCreating}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="{loc:LocalizedText Key=native.plans.osnovnoe}" Classes="configurationHeading" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14">
                <StackPanel Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.kod.promokoda}" Classes="caption" /><TextBox Text="{Binding Code}" MaxLength="64" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PromoCodeCode" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.plans.nazvanie}" Classes="caption" /><TextBox Text="{Binding Name}" MaxLength="160" IsEnabled="{Binding CanEdit}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.plans.opisanie}" Classes="caption" /><TextBox Text="{Binding Description}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" Height="76" IsEnabled="{Binding CanEdit}" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.srok.deystviya}" Classes="configurationHeading" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.nachalo}" Classes="caption" /><views:AdminDateTimeField Value="{Binding ValidFromLocal, Mode=TwoWay}" Placeholder="{loc:LocalizedText Key=core.dateTime.noStart}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PromoCodeValidFrom" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.okonchanie}" Classes="caption" /><views:AdminDateTimeField Value="{Binding ValidUntilLocal, Mode=TwoWay}" Placeholder="{loc:LocalizedText Key=core.dateTime.noEnd}" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PromoCodeValidUntil" /></StackPanel>
              </Grid>
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.mestnoe.vremya.pustaya.data.oznachaet.otsutstvie.ogranicheniya}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.vygoda}" Classes="configurationHeading" />
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.avtomaticheskogo.demo.net.podarochnye.dni.dobavlyayut.pro.k.vybr}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsLegacySelected}" />
              <StackPanel Spacing="6" IsVisible="{Binding IsLegacySelected}"><TextBlock Text="{Binding LegacyBenefit}" /><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.bonus.starogo.promokoda.dostupen.tolko.dlya.prosmotra}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
              <StackPanel Spacing="16" IsVisible="{Binding !IsLegacySelected}">
                <ComboBox ItemsSource="{Binding BenefitOptions}" SelectedItem="{Binding SelectedBenefit}" IsEnabled="{Binding CanEditScope}" Width="280" HorizontalAlignment="Left" AutomationProperties.AutomationId="PromoCodeBenefit">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PromoCodeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="160,*" ColumnSpacing="16" IsVisible="{Binding IsGift}">
                  <StackPanel Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.podarochnye.dni}" Classes="caption" /><TextBox Text="{Binding BonusDaysText}" PlaceholderText="1–3650" IsEnabled="{Binding CanEdit}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.tarif.podarka}" Classes="caption" /><ComboBox ItemsSource="{Binding AvailablePaidPlans}" SelectedItem="{Binding GiftPlan}" IsEnabled="{Binding CanEditScope}" AutomationProperties.AutomationId="PromoCodeGiftPlan">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="api:AdminSubscriptionPlan"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox></StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsDiscount}">
                  <StackPanel Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.razmer.skidki}" Classes="caption" /><TextBox Text="{Binding DiscountValueText}" PlaceholderText="{loc:LocalizedText Key=native.promoCodes.naprimer.15}" IsEnabled="{Binding CanEdit}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.srok.skidki.dney}" Classes="caption" /><TextBox Text="{Binding DiscountValidityDaysText}" PlaceholderText="{loc:LocalizedText Key=native.promoCodes.bez.ogranicheniya}" IsEnabled="{Binding CanEdit}" /></StackPanel>
                </Grid>
                <StackPanel Spacing="10" IsVisible="{Binding IsDiscount}">
                  <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.tarify.so.skidkoy}" Classes="caption" />
                  <WrapPanel><ComboBox ItemsSource="{Binding AvailablePaidPlans}" SelectedItem="{Binding SelectedPlanToAdd}" IsEnabled="{Binding CanEditScope}" Width="260" Margin="0,0,10,8" AutomationProperties.AutomationId="PromoCodePlanPicker">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="api:AdminSubscriptionPlan"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox><Button Content="{loc:LocalizedText Key=native.promoCodes.dobavit.tarif}" Command="{Binding AddSelectedPlanCommand}" Margin="0,0,0,8" /></WrapPanel>
                  <ItemsControl ItemsSource="{Binding SelectedPlans}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="api:AdminSubscriptionPlan">
                    <Button Command="{Binding $parent[views:PromoCodesView].((vm:PromoCodesViewModel)DataContext).RemovePlanCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:LocalizedText Key=native.promoCodes.ubrat.tarif}" Margin="0,0,8,4" IsEnabled="{Binding $parent[views:PromoCodesView].((vm:PromoCodesViewModel)DataContext).CanEditScope}"><TextBlock><Run Text="{Binding Name}" /><Run Text="  ×" /></TextBlock></Button>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.tip.bonusa.tarify.i.napravleniya.zakrepleny.posle.pervogo.primen}" Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasApplications}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.usloviya.primeneniya}" Classes="configurationHeading" />
              <StackPanel Spacing="6" IsVisible="{Binding !IsLegacySelected}"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.obshchiy.limit.primeneniy}" Classes="caption" /><TextBox Text="{Binding OrganizationLimitText}" PlaceholderText="{loc:LocalizedText Key=native.promoCodes.bez.ogranicheniya}" IsEnabled="{Binding CanEdit}" Width="220" HorizontalAlignment="Left" /></StackPanel>
              <TextBlock IsVisible="{Binding IsLegacySelected}" Classes="caption"><Run Text="{loc:LocalizedText Key=native.promoCodes.limit.registratsiy.prefix}" /><Run Text="{Binding SelectedPromoCode.MaximumRedemptions}" /></TextBlock>
              <ToggleSwitch Content="{loc:LocalizedText Key=native.promoCodes.vse.napravleniya}" IsChecked="{Binding AppliesToAllScenarios}" IsEnabled="{Binding CanEditScope}" IsVisible="{Binding !IsLegacySelected}" />
              <WrapPanel IsVisible="{Binding !AppliesToAllScenarios}"><CheckBox Content="{loc:LocalizedText Key=native.promoCodes.deteyling}" IsChecked="{Binding DetailingScenario}" IsEnabled="{Binding CanEditScope}" Margin="0,0,20,0" /><CheckBox Content="{loc:LocalizedText Key=native.promoCodes.sto}" IsChecked="{Binding ServiceStationScenario}" IsEnabled="{Binding CanEditScope}" Margin="0,0,20,0" /><CheckBox Content="{loc:LocalizedText Key=native.promoCodes.avtopark}" IsChecked="{Binding FleetScenario}" IsEnabled="{Binding CanEditScope}" /></WrapPanel>
              <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid ColumnDefinitions="*,Auto"><ToggleSwitch Content="{loc:LocalizedText Key=native.promoCodes.promokod.aktiven}" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanEdit}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{Binding StatusActionLabel}" Command="{Binding ToggleStatusCommand}" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}" /><Button Content="{loc:LocalizedText Key=native.plans.udalit}" Foreground="#E5A7A7" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}" /></StackPanel></Grid></Border>
            </StackPanel>
          </Border>
          <Border Classes="configurationSection" IsVisible="{Binding IsConfirmationOpen}" BorderBrush="#775247"><StackPanel Spacing="12"><TextBlock Text="{loc:LocalizedText Key=native.promoCodes.deleteConfirmTitle}" Classes="configurationHeading" /><TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap" /><WrapPanel><Button Content="{loc:LocalizedText Key=native.promoCodes.deleteAction}" Command="{Binding ConfirmDeleteCommand}" Margin="0,0,8,0" /><Button Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelDeleteCommand}" /></WrapPanel></StackPanel></Border>
          <Border Classes="configurationSection" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="12" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.istoriya.primeneniy}" Classes="configurationHeading" />
              <TextBlock Text="{Binding UsageCountLabel}" Classes="caption" />
              <Border Classes="card" Padding="0">
                <StackPanel>
                  <Grid ColumnDefinitions="1.2*,1.2*,1.1*,1.2*,1.2*" ColumnSpacing="8" Margin="10">
                    <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.polzovatel}" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=native.promoCodes.organizatsiya}" Classes="caption" />
                    <TextBlock Grid.Column="2" Text="{loc:LocalizedText Key=native.promoCodes.data}" Classes="caption" />
                    <TextBlock Grid.Column="3" Text="{loc:LocalizedText Key=native.plans.status}" Classes="caption" />
                    <TextBlock Grid.Column="4" Text="{loc:LocalizedText Key=native.promoCodes.skidka.dostupna}" Classes="caption" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding UsageRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PromoCodeUsageRow">
                        <Border BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="10">
                          <Grid ColumnDefinitions="1.2*,1.2*,1.1*,1.2*,1.2*" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Email}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Details}" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Organization}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding AppliedAt}" Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="4" Text="{Binding DiscountAvailability}" Classes="caption" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.primeneniy.poka.net}" IsVisible="{Binding !HasUsages}" Classes="muted" Margin="10" />
                </StackPanel>
              </Border>
            </StackPanel>

          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
