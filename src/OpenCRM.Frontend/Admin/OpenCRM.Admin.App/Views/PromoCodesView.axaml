<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:api="using:OpenCRM.Admin.Api.Models"
             xmlns:views="using:OpenCRM.Admin.App.Views"
             x:Class="OpenCRM.Admin.App.Views.PromoCodesView"
             x:DataType="vm:PromoCodesViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="16">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <TextBlock Text="Промокоды" Classes="heading" AutomationProperties.AutomationId="PromoCodesHeading" />
      <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
        <Button Content="Обновить" Command="{Binding RefreshCommand}" />
        <Button Content="+ Новый промокод" Classes="configurationPrimary" Command="{Binding CreateCommand}" IsVisible="{Binding !IsEditorOpen}" />
      </StackPanel>
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SuccessMessage}" IsVisible="{Binding HasMessage}" Foreground="#A7DCA7" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled" AutomationProperties.AutomationId="PromoCodePageScroll">
      <StackPanel Spacing="18">
        <StackPanel Spacing="16" IsVisible="{Binding !IsEditorOpen}" MaxWidth="1400" HorizontalAlignment="Stretch">
          <Border Classes="configurationSection" Padding="16">
            <WrapPanel>
              <TextBox Text="{Binding Search}" PlaceholderText="Найти код или название" Width="280" Margin="0,0,10,0" IsEnabled="{Binding CanEdit}" />
              <ComboBox ItemsSource="{Binding StatusOptions}" SelectedValue="{Binding StatusFilter}" SelectedValueBinding="{Binding Code}" Width="174" IsEnabled="{Binding CanEdit}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PromoCodeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
            </WrapPanel>
          </Border>
          <Border Classes="configurationSection" Padding="0">
            <StackPanel>
              <Grid ColumnDefinitions="1.2*,1.1*,1.1*,Auto,Auto" ColumnSpacing="16" Margin="18,14">
                <TextBlock Text="Промокод" Classes="caption" /><TextBlock Grid.Column="1" Text="Выгода" Classes="caption" />
                <TextBlock Grid.Column="2" Text="Использование" Classes="caption" /><TextBlock Grid.Column="3" Text="Статус" Classes="caption" />
                <TextBlock Grid.Column="4" Text="Действие" Classes="caption" />
              </Grid>
              <ItemsControl ItemsSource="{Binding FilteredRows}">
                <ItemsControl.ItemTemplate><DataTemplate x:DataType="vm:PromoCodeRow">
                  <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,16">
                    <Grid ColumnDefinitions="1.2*,1.1*,1.1*,Auto,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="4"><TextBlock Text="{Binding Code}" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Name}" Classes="caption" TextWrapping="Wrap" /><TextBlock Text="{Binding ValidUntil}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                      <TextBlock Grid.Column="1" Text="{Binding Benefit}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding UsageCount}" TextWrapping="Wrap" VerticalAlignment="Center" />
                      <Border Grid.Column="3" Classes="configurationBadge" Classes.active="{Binding PromoCode.IsActive}"><TextBlock Text="{Binding Status}" /></Border>
                      <Button Grid.Column="4" Content="Открыть →" Command="{Binding $parent[views:PromoCodesView].((vm:PromoCodesViewModel)DataContext).OpenRowCommand}" CommandParameter="{Binding}" VerticalAlignment="Center" AutomationProperties.AutomationId="PromoCodeOpen" />
                    </Grid>
                  </Border>
                </DataTemplate></ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="Промокоды не найдены" IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" Margin="24" />
            </StackPanel>
          </Border>
        </StackPanel>
        <StackPanel Spacing="18" IsVisible="{Binding IsEditorOpen}" MaxWidth="1040" HorizontalAlignment="Stretch">
          <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Button Content="← К промокодам" Command="{Binding CloseEditorCommand}" HorizontalAlignment="Left" Background="Transparent" Padding="0,8,12,8" />
            <Button Grid.Column="1" Content="Сохранить промокод" Classes="configurationPrimary" Command="{Binding SaveCommand}" AutomationProperties.AutomationId="PromoCodeSave" />
          </Grid>
          <StackPanel Spacing="4">
            <TextBlock Text="Новый промокод" IsVisible="{Binding IsCreating}" FontSize="24" FontWeight="SemiBold" />
            <TextBlock Text="{Binding Name}" IsVisible="{Binding !IsCreating}" FontSize="24" FontWeight="SemiBold" TextWrapping="Wrap" />
          </StackPanel>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="Основное" Classes="configurationHeading" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16" RowDefinitions="Auto,Auto" RowSpacing="14">
                <StackPanel Spacing="6"><TextBlock Text="Код промокода" Classes="caption" /><TextBox Text="{Binding Code}" MaxLength="64" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PromoCodeCode" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Название" Classes="caption" /><TextBox Text="{Binding Name}" MaxLength="160" IsEnabled="{Binding CanEdit}" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Spacing="6"><TextBlock Text="Описание" Classes="caption" /><TextBox Text="{Binding Description}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" Height="76" IsEnabled="{Binding CanEdit}" /></StackPanel>
              </Grid>
            </StackPanel>
          </Border>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="Срок действия" Classes="configurationHeading" />
              <Grid ColumnDefinitions="*,*" ColumnSpacing="16">
                <StackPanel Spacing="6"><TextBlock Text="Начало" Classes="caption" /><views:AdminDateTimeField Value="{Binding ValidFromLocal, Mode=TwoWay}" Placeholder="Без даты начала" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PromoCodeValidFrom" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Окончание" Classes="caption" /><views:AdminDateTimeField Value="{Binding ValidUntilLocal, Mode=TwoWay}" Placeholder="Без даты окончания" IsEnabled="{Binding CanEdit}" AutomationProperties.AutomationId="PromoCodeValidUntil" /></StackPanel>
              </Grid>
              <TextBlock Text="Местное время. Пустая дата означает отсутствие ограничения." Classes="caption" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="Выгода" Classes="configurationHeading" />
              <TextBlock Text="Автоматического демо нет. Подарочные дни добавляют PRO к выбранному тарифу; Free для детейлинга и СТО действует бессрочно." Classes="caption" TextWrapping="Wrap" IsVisible="{Binding !IsLegacySelected}" />
              <StackPanel Spacing="6" IsVisible="{Binding IsLegacySelected}"><TextBlock Text="{Binding LegacyBenefit}" /><TextBlock Text="Бонус старого промокода доступен только для просмотра." Classes="caption" TextWrapping="Wrap" /></StackPanel>
              <StackPanel Spacing="16" IsVisible="{Binding !IsLegacySelected}">
                <ComboBox ItemsSource="{Binding BenefitOptions}" SelectedItem="{Binding SelectedBenefit}" IsEnabled="{Binding CanEditScope}" Width="280" HorizontalAlignment="Left" AutomationProperties.AutomationId="PromoCodeBenefit">
                  <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:PromoCodeOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                </ComboBox>
                <Grid ColumnDefinitions="160,*" ColumnSpacing="16" IsVisible="{Binding IsGift}">
                  <StackPanel Spacing="6"><TextBlock Text="Подарочные дни" Classes="caption" /><TextBox Text="{Binding BonusDaysText}" PlaceholderText="1–3650" IsEnabled="{Binding CanEdit}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Тариф подарка" Classes="caption" /><ComboBox ItemsSource="{Binding AvailablePaidPlans}" SelectedItem="{Binding GiftPlan}" IsEnabled="{Binding CanEditScope}" AutomationProperties.AutomationId="PromoCodeGiftPlan">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="api:AdminSubscriptionPlan"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox></StackPanel>
                </Grid>
                <Grid ColumnDefinitions="*,*" ColumnSpacing="16" IsVisible="{Binding IsDiscount}">
                  <StackPanel Spacing="6"><TextBlock Text="Размер скидки" Classes="caption" /><TextBox Text="{Binding DiscountValueText}" PlaceholderText="Например, 15" IsEnabled="{Binding CanEdit}" /></StackPanel>
                  <StackPanel Grid.Column="1" Spacing="6"><TextBlock Text="Срок скидки, дней" Classes="caption" /><TextBox Text="{Binding DiscountValidityDaysText}" PlaceholderText="Без ограничения" IsEnabled="{Binding CanEdit}" /></StackPanel>
                </Grid>
                <StackPanel Spacing="10" IsVisible="{Binding IsDiscount}">
                  <TextBlock Text="Тарифы со скидкой" Classes="caption" />
                  <WrapPanel><ComboBox ItemsSource="{Binding AvailablePaidPlans}" SelectedItem="{Binding SelectedPlanToAdd}" IsEnabled="{Binding CanEditScope}" Width="260" Margin="0,0,10,8" AutomationProperties.AutomationId="PromoCodePlanPicker">
                    <ComboBox.ItemTemplate><DataTemplate x:DataType="api:AdminSubscriptionPlan"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
                  </ComboBox><Button Content="Добавить тариф" Command="{Binding AddSelectedPlanCommand}" Margin="0,0,0,8" /></WrapPanel>
                  <ItemsControl ItemsSource="{Binding SelectedPlans}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate x:DataType="api:AdminSubscriptionPlan">
                    <Button Command="{Binding $parent[views:PromoCodesView].((vm:PromoCodesViewModel)DataContext).RemovePlanCommand}" CommandParameter="{Binding}" ToolTip.Tip="Убрать тариф" Margin="0,0,8,4" IsEnabled="{Binding $parent[views:PromoCodesView].((vm:PromoCodesViewModel)DataContext).CanEditScope}"><TextBlock><Run Text="{Binding Name}" /><Run Text="  ×" /></TextBlock></Button>
                  </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                </StackPanel>
                <TextBlock Text="Тип бонуса, тарифы и направления закреплены после первого применения." Classes="caption" TextWrapping="Wrap" IsVisible="{Binding HasApplications}" />
              </StackPanel>
            </StackPanel>
          </Border>
          <Border Classes="configurationSection">
            <StackPanel Spacing="16">
              <TextBlock Text="Условия применения" Classes="configurationHeading" />
              <StackPanel Spacing="6" IsVisible="{Binding !IsLegacySelected}"><TextBlock Text="Общий лимит применений" Classes="caption" /><TextBox Text="{Binding OrganizationLimitText}" PlaceholderText="Без ограничения" IsEnabled="{Binding CanEdit}" Width="220" HorizontalAlignment="Left" /></StackPanel>
              <TextBlock IsVisible="{Binding IsLegacySelected}" Classes="caption"><Run Text="Лимит регистраций: " /><Run Text="{Binding SelectedPromoCode.MaximumRedemptions}" /></TextBlock>
              <ToggleSwitch Content="Все направления" IsChecked="{Binding AppliesToAllScenarios}" IsEnabled="{Binding CanEditScope}" IsVisible="{Binding !IsLegacySelected}" />
              <WrapPanel IsVisible="{Binding !AppliesToAllScenarios}"><CheckBox Content="Детейлинг" IsChecked="{Binding DetailingScenario}" IsEnabled="{Binding CanEditScope}" Margin="0,0,20,0" /><CheckBox Content="СТО" IsChecked="{Binding ServiceStationScenario}" IsEnabled="{Binding CanEditScope}" Margin="0,0,20,0" /><CheckBox Content="Автопарк" IsChecked="{Binding FleetScenario}" IsEnabled="{Binding CanEditScope}" /></WrapPanel>
              <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="0,16,0,0"><Grid ColumnDefinitions="*,Auto"><ToggleSwitch Content="Промокод активен" IsChecked="{Binding IsEnabled}" IsEnabled="{Binding CanEdit}" /><StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Content="{Binding StatusActionLabel}" Command="{Binding ToggleStatusCommand}" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}" /><Button Content="Удалить" Foreground="#E5A7A7" Command="{Binding RequestDeleteCommand}" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}" /></StackPanel></Grid></Border>
            </StackPanel>
          </Border>
          <Border Classes="configurationSection" IsVisible="{Binding IsConfirmationOpen}" BorderBrush="#775247"><StackPanel Spacing="12"><TextBlock Text="Удалить промокод?" Classes="configurationHeading" /><TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap" /><WrapPanel><Button Content="Удалить промокод" Command="{Binding ConfirmDeleteCommand}" Margin="0,0,8,0" /><Button Content="Отмена" Command="{Binding CancelDeleteCommand}" /></WrapPanel></StackPanel></Border>
          <Border Classes="configurationSection" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}">
            <StackPanel Spacing="12" IsVisible="{Binding SelectedPromoCode, Converter={x:Static ObjectConverters.IsNotNull}}">
              <TextBlock Text="История применений" Classes="configurationHeading" />
              <TextBlock Text="{Binding UsageCountLabel}" Classes="caption" />
              <Border Classes="card" Padding="0">
                <StackPanel>
                  <Grid ColumnDefinitions="1.2*,1.2*,1.1*,1.2*,1.2*" ColumnSpacing="8" Margin="10">
                    <TextBlock Text="Пользователь" Classes="caption" />
                    <TextBlock Grid.Column="1" Text="Организация" Classes="caption" />
                    <TextBlock Grid.Column="2" Text="Дата" Classes="caption" />
                    <TextBlock Grid.Column="3" Text="Статус" Classes="caption" />
                    <TextBlock Grid.Column="4" Text="Скидка доступна" Classes="caption" />
                  </Grid>
                  <ItemsControl ItemsSource="{Binding UsageRows}">
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:PromoCodeUsageRow">
                        <Border BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="10">
                          <Grid ColumnDefinitions="1.2*,1.2*,1.1*,1.2*,1.2*" ColumnSpacing="8">
                            <StackPanel Spacing="4">
                              <TextBlock Text="{Binding Email}" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding Details}" Classes="caption" TextWrapping="Wrap" />
                            </StackPanel>
                            <TextBlock Grid.Column="1" Text="{Binding Organization}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="2" Text="{Binding AppliedAt}" Classes="caption" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="3" Text="{Binding Status}" TextWrapping="Wrap" />
                            <TextBlock Grid.Column="4" Text="{Binding DiscountAvailability}" Classes="caption" TextWrapping="Wrap" />
                          </Grid>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                  <TextBlock Text="Применений пока нет." IsVisible="{Binding !HasUsages}" Classes="muted" Margin="10" />
                </StackPanel>
              </Border>
            </StackPanel>

          </Border>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
