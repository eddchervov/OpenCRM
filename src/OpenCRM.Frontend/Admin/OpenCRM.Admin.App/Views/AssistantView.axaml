<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenCRM.Admin.App.Localization"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:api="using:OpenCRM.Admin.Api.Models"
             xmlns:views="using:OpenCRM.Admin.App.Views"
             x:Class="OpenCRM.Admin.App.Views.AssistantView"
             x:DataType="vm:AssistantViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:LocalizedText Key=native.assistant.ii.pomoshchnik}" Classes="heading" />
        <TextBlock Text="{loc:LocalizedText Key=native.assistant.upravlyayte.dostupom.limitami.i.raskhodami.servisa}" Classes="caption" />
        <TextBlock Text="{Binding ProviderLabel}" Classes="caption" />
      </StackPanel>
      <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.billing.obnovit}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="5">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SuccessMessage}" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#9CDABB" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>
    <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="card" Padding="18" IsVisible="{Binding CanManage}">
          <StackPanel Spacing="12">
            <Grid ColumnDefinitions="*,Auto">
              <StackPanel Spacing="3">
                <TextBlock Text="{loc:LocalizedText Key=native.assistant.globalnye.nastroyki}" Classes="section-title" />
                <TextBlock Text="{loc:LocalizedText Key=native.assistant.globalnoe.vyklyuchenie.skryvaet.knopku.i.blokiruet.rabotu.pomosh}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.assistant.sokhranit.nastroyki}" Classes="primary" Command="{Binding SaveSettingsCommand}" VerticalAlignment="Center" />
            </Grid>
            <TextBlock Text="{Binding BudgetLimitsLabel}" Classes="caption" TextWrapping="Wrap" />
            <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto,Auto" ColumnSpacing="24" RowSpacing="10">
              <StackPanel Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding IsEnabled}" /><TextBlock Text="{loc:LocalizedText Key=native.assistant.pomoshchnik.vklyuchyon.globalno}" VerticalAlignment="Center" /></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding WebEnabled}" /><TextBlock Text="{loc:LocalizedText Key=native.assistant.kanal.sayta}" VerticalAlignment="Center" /></StackPanel>
              <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding TelegramEnabled}" /><TextBlock Text="{loc:LocalizedText Key=native.assistant.kanal.sluzhebnogo.telegram}" VerticalAlignment="Center" /></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding SpeechRepliesEnabled}" /><TextBlock Text="{loc:LocalizedText Key=native.assistant.ozvuchivanie.otvetov}" VerticalAlignment="Center" /></StackPanel>
              <StackPanel Grid.Row="2" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.tekstovaya.model}" Classes="caption" /><TextBox Text="{Binding TextModel}" /></StackPanel>
              <StackPanel Grid.Row="2" Grid.Column="1" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.model.raspoznavaniya.rechi}" Classes="caption" /><TextBox Text="{Binding SpeechModel}" /></StackPanel>
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*" RowDefinitions="Auto,Auto" ColumnSpacing="12" RowSpacing="8">
              <StackPanel Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.model.ozvuchivaniya}" Classes="caption" /><TextBox Text="{Binding VoiceModel}" /></StackPanel>
              <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.golos}" Classes="caption" /><TextBox Text="{Binding VoiceName}" /></StackPanel>
              <StackPanel Grid.Column="2" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.dnevnoy.byudzhet}" Classes="caption" /><TextBox Text="{Binding DailyBudgetRub}" /></StackPanel>
              <StackPanel Grid.Column="3" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.mesyachnyy.byudzhet}" Classes="caption" /><TextBox Text="{Binding MonthlyBudgetRub}" /></StackPanel>
              <StackPanel Grid.Row="1" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.rezerv.tekstovogo.zaprosa}" Classes="caption" /><TextBox Text="{Binding TextReservationRub}" /></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.rezerv.audiozaprosa}" Classes="caption" /><TextBox Text="{Binding AudioReservationRub}" /></StackPanel>
              <StackPanel Grid.Row="1" Grid.Column="2" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.maksimum.tokenov.otveta}" Classes="caption" /><TextBox Text="{Binding MaximumOutputTokens}" /></StackPanel>
            </Grid>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18" IsVisible="{Binding CanManage}">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:LocalizedText Key=native.assistant.dostup.organizatsiy}" Classes="section-title" />
            <Grid ColumnDefinitions="*,Auto,Auto,Auto" ColumnSpacing="8">
              <TextBox Text="{Binding Search}" PlaceholderText="{loc:LocalizedText Key=native.assistant.nazvanie.organizatsii}" />
              <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.billing.nayti}" Command="{Binding SearchOrganizationsCommand}" />
              <Button Grid.Column="2" Content="←" Command="{Binding PreviousOrganizationPageCommand}" />
              <Button Grid.Column="3" Content="→" Command="{Binding NextOrganizationPageCommand}" />
            </Grid>
            <TextBlock Text="{Binding OrganizationPageLabel}" Classes="caption" />
            <ListBox ItemsSource="{Binding Organizations}" SelectedItem="{Binding SelectedOrganization}" MaxHeight="210" Background="Transparent">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:AssistantOrganizationRow">
                  <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="12" Margin="4">
                    <StackPanel Spacing="2"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Channels}" Classes="caption" /></StackPanel>
                    <TextBlock Grid.Column="1" Text="{Binding Access}" VerticalAlignment="Center" />
                  </Grid>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel IsVisible="{Binding SelectedOrganization, Converter={x:Static ObjectConverters.IsNotNull}}" Spacing="10">
              <TextBlock Text="{loc:LocalizedFormat Key=native.assistant.nastroyki.dostupa.0, Path=SelectedOrganization.Name}" FontWeight="SemiBold" />
              <Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" ColumnSpacing="20" RowSpacing="8">
                <StackPanel Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding OrganizationIsEnabled}" /><TextBlock Text="{loc:LocalizedText Key=native.assistant.dostup.razreshyon}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding OrganizationWebEnabled}" /><TextBlock Text="{loc:LocalizedText Key=native.assistant.sayt}" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="8"><CheckBox IsChecked="{Binding OrganizationTelegramEnabled}" /><TextBlock Text="Telegram" VerticalAlignment="Center" /></StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.dostup.do.lokalnoe.vremya}" Classes="caption" /><views:AdminDateTimeField Value="{Binding OrganizationEnabledUntilLocal, Mode=TwoWay}" Placeholder="{loc:LocalizedText Key=native.promoCodes.bez.sroka}" /></StackPanel>
              </Grid>
              <Grid ColumnDefinitions="*,*,Auto" ColumnSpacing="12">
                <StackPanel Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.dnevnoy.byudzhet}" Classes="caption" /><TextBox Text="{Binding OrganizationDailyBudgetRub}" /></StackPanel>
                <StackPanel Grid.Column="1" Spacing="4"><TextBlock Text="{loc:LocalizedText Key=native.assistant.mesyachnyy.byudzhet}" Classes="caption" /><TextBox Text="{Binding OrganizationMonthlyBudgetRub}" /></StackPanel>
                <Button Grid.Column="2" Content="{loc:LocalizedText Key=native.assistant.sokhranit.dostup}" Classes="primary" Command="{Binding SaveOrganizationAccessCommand}" VerticalAlignment="Bottom" />
              </Grid>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18" IsVisible="{Binding CanViewBilling}">
          <StackPanel Spacing="10">
            <TextBlock Text="{loc:LocalizedText Key=native.assistant.raskhody.i.sverka.stoimosti}" Classes="section-title" />
            <Grid ColumnDefinitions="*,*,*,*,*,Auto" ColumnSpacing="8">
              <views:AdminDateTimeField Value="{Binding UsageFrom, Mode=TwoWay}" Placeholder="{loc:LocalizedText Key=core.dateTime.periodStart}" />
              <views:AdminDateTimeField Grid.Column="1" Value="{Binding UsageTo, Mode=TwoWay}" Placeholder="{loc:LocalizedText Key=core.dateTime.periodEnd}" />
              <ComboBox Grid.Column="2" ItemsSource="{Binding ChannelOptions}" SelectedItem="{Binding SelectedChannel}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CommunicationOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <ComboBox Grid.Column="3" ItemsSource="{Binding StatusOptions}" SelectedItem="{Binding SelectedStatus}">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="vm:CommunicationOption"><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <TextBox Grid.Column="4" Text="{Binding ModelFilter}" PlaceholderText="{loc:LocalizedText Key=native.assistant.model}" />
              <Button Grid.Column="5" Content="{loc:LocalizedText Key=native.assistant.zagruzit}" Command="{Binding FilterUsageCommand}" />
            </Grid>
            <Grid ColumnDefinitions="*,*,*,*,*" IsVisible="{Binding HasUsage}" ColumnSpacing="12">
              <TextBlock Text="{loc:LocalizedFormat Key=native.assistant.zaprosy.0.n0, Path=Usage.Totals.RequestCount}" />
              <TextBlock Grid.Column="1" Text="{loc:LocalizedFormat Key=native.assistant.raskhod.0.n2, Path=Usage.Totals.CostRub}" />
              <TextBlock Grid.Column="2" Text="{loc:LocalizedFormat Key=native.assistant.rezerv.0.n2, Path=Usage.Totals.ReservedRub}" />
              <TextBlock Grid.Column="3" Text="{loc:LocalizedFormat Key=native.assistant.neizvestnaya.stoimost.0, Path=Usage.Totals.UnknownCount}" />
              <TextBlock Grid.Column="4" Text="{Binding UsagePageLabel}" Classes="caption" />
            </Grid>
            <Grid ColumnDefinitions="*,*" ColumnSpacing="18" IsVisible="{Binding HasUsage}">
              <StackPanel Spacing="5">
                <TextBlock Text="{loc:LocalizedText Key=native.assistant.po.dnyam}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Usage.Daily}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="api:AdminAssistantUsageDay">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2"><TextBlock Text="{Binding Date}" /><TextBlock Grid.Column="1" Text="{loc:LocalizedFormat Key=native.assistant.raskhod.0.n2, Path=CostRub}" Classes="caption" Margin="8,0" /><TextBlock Grid.Column="2" Text="{loc:LocalizedFormat Key=native.assistant.rezerv.0.n2, Path=ReservedRub}" Classes="caption" /></Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{loc:LocalizedText Key=native.assistant.po.organizatsiyam}" FontWeight="SemiBold" />
                <ItemsControl ItemsSource="{Binding Usage.ByOrganization}">
                  <ItemsControl.ItemTemplate><DataTemplate x:DataType="api:AdminAssistantUsageOrganization">
                    <Grid ColumnDefinitions="*,Auto,Auto" Margin="0,2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /><TextBlock Grid.Column="1" Text="{loc:LocalizedFormat Key=native.assistant.zaprosy.0, Path=RequestCount}" Classes="caption" Margin="8,0" /><TextBlock Grid.Column="2" Text="{loc:LocalizedFormat Key=core.format.rubles, Path=CostRub}" Classes="caption" /></Grid>
                  </DataTemplate></ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Grid>
            <ListBox ItemsSource="{Binding UsageItems}" SelectedItem="{Binding SelectedUsage}" MaxHeight="260" Background="Transparent">
              <ListBox.ItemTemplate><DataTemplate x:DataType="api:AdminAssistantUsageItem">
                <Grid ColumnDefinitions="*,Auto,Auto,Auto,Auto" ColumnSpacing="12" Margin="4">
                  <StackPanel Spacing="2"><TextBlock Text="{Binding OrganizationName}" FontWeight="SemiBold" /><TextBlock Text="{loc:LocalizedFormat Key=core.format.dateTime, Path=CreatedAt, UseLocalTime=True}" Classes="caption" /></StackPanel>
                  <TextBlock Grid.Column="1" Text="{Binding UserEmail}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="2" Text="{Binding Channel}" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="3" Text="{Binding Model}" VerticalAlignment="Center" />
                  <StackPanel Grid.Column="4" Spacing="3"><TextBlock Text="{Binding Status}" /><TextBlock Text="{loc:LocalizedFormat Key=core.format.rubles, Path=CostRub}" Classes="caption" /></StackPanel>
                </Grid>
              </DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button Content="{loc:LocalizedText Key=native.assistant.predydushchaya}" Command="{Binding PreviousUsagePageCommand}" />
              <Button Content="{loc:LocalizedText Key=native.assistant.sleduyushchaya}" Command="{Binding NextUsagePageCommand}" />
            </StackPanel>
            <StackPanel IsVisible="{Binding HasUnknownSelectedUsage}" Spacing="8">
              <TextBlock Text="{loc:LocalizedText Key=native.assistant.sverka.zavershyonnogo.zaprosa.s.neizvestnoy.stoimostyu.ukazhite.}" TextWrapping="Wrap" Classes="caption" />
              <Grid ColumnDefinitions="220,*" ColumnSpacing="10">
                <TextBox Text="{Binding SettlementCostRub}" PlaceholderText="{loc:LocalizedText Key=native.assistant.fakticheskaya.stoimost}" />
                <TextBox Grid.Column="1" Text="{Binding SettlementReason}" PlaceholderText="{loc:LocalizedText Key=native.assistant.osnovanie.sverki}" />
              </Grid>
              <Button Content="{loc:LocalizedText Key=native.assistant.sokhranit.stoimost.i.osnovanie}" Classes="primary" Command="{Binding SettleUsageCommand}" IsVisible="{Binding CanSettle}" HorizontalAlignment="Left" />
            </StackPanel>
          </StackPanel>
        </Border>

        <Border Classes="card" Padding="18" IsVisible="{Binding CanManage}">
          <StackPanel Spacing="8">
            <TextBlock Text="{loc:LocalizedText Key=native.assistant.audit.izmeneniy}" Classes="section-title" />
            <TextBlock Text="{loc:LocalizedText Key=native.assistant.zapisey.poka.net}" IsVisible="{Binding !HasAudits}" Classes="caption" />
            <ItemsControl ItemsSource="{Binding Overview.Audits}">
              <ItemsControl.ItemTemplate><DataTemplate x:DataType="api:AdminAssistantAudit">
                <StackPanel Margin="0,6" Spacing="3">
                  <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Description}" TextWrapping="Wrap" /><TextBlock Grid.Column="1" Text="{loc:LocalizedFormat Key=core.format.dateTime, Path=CreatedAt, UseLocalTime=True}" Classes="caption" Margin="10,0" /></Grid>
                  <TextBlock Text="{loc:LocalizedFormat Key=native.assistant.administrator.0, Path=AdminUserId}" Classes="caption" />
                </StackPanel>
              </DataTemplate></ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
