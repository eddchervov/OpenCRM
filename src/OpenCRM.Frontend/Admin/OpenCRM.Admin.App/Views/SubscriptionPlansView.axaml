<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:views="using:OpenCRM.Admin.App.Views"
             x:Class="OpenCRM.Admin.App.Views.SubscriptionPlansView"
             x:DataType="vm:SubscriptionPlansViewModel">
  <UserControl.Styles>
    <Style Selector="Button.tab.active">
      <Setter Property="Background" Value="#23384A" />
      <Setter Property="BorderBrush" Value="#4C7392" />
      <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style Selector="Border.plan-status">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="8,3" />
      <Setter Property="Background" Value="#292929" />
    </Style>
    <Style Selector="Border.plan-status.active">
      <Setter Property="Background" Value="#20372B" />
    </Style>
    <Style Selector="Border.plan-status.inactive">
      <Setter Property="Background" Value="#3A2D25" />
    </Style>
    <Style Selector="Border.plan-row:pointerover">
      <Setter Property="Background" Value="#191D21" />
    </Style>
    <Style Selector="Border.plan-feature-row">
      <Setter Property="BorderBrush" Value="#292929" />
      <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
  </UserControl.Styles>
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="12">
    <Grid ColumnDefinitions="*,Auto,Auto" ColumnSpacing="8">
      <TextBlock Text="Тарифы Free и PRO" Classes="heading" AutomationProperties.AutomationId="SubscriptionPlansHeading" />
      <Button Grid.Column="1" Content="Новый вариант PRO" Classes="configurationPrimary" IsVisible="{Binding !IsEditorOpen}" Command="{Binding CreatePlanCommand}" />
      <Button Grid.Column="2" Content="Обновить" Command="{Binding RefreshCommand}" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock IsVisible="{Binding HasError}" Text="{Binding ErrorMessage}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock IsVisible="{Binding HasMessage}" Text="{Binding Message}" Foreground="#A8D8B4" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsLoading}" IsIndeterminate="True" Height="3" />
    </StackPanel>
    <Grid Grid.Row="2" IsVisible="{Binding HasWorkspace}">
      <ScrollViewer IsVisible="{Binding !IsEditorOpen}" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="18" MaxWidth="1400">
          <StackPanel Spacing="7" IsVisible="{Binding HasPlans}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,0,2,2">
              <StackPanel Spacing="2">
                <TextBlock Text="Тарифы организаций" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Бессрочный Free и варианты PRO. Старые базовые и демо-тарифы сохранены для прежних условий." Classes="caption" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding BusinessPlanCountLabel}" Classes="caption" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="card" Padding="0" ClipToBounds="True">
              <StackPanel>
                <Grid ColumnDefinitions="1.5*,*,130,110" ColumnSpacing="16" Margin="18,14"><TextBlock Text="Тариф" Classes="caption" /><TextBlock Grid.Column="1" Text="Группа" Classes="caption" /><TextBlock Grid.Column="2" Text="Стоимость" Classes="caption" /><TextBlock Grid.Column="3" Text="Действия" Classes="caption" /></Grid>
                <ItemsControl ItemsSource="{Binding BusinessRows}" AutomationProperties.AutomationId="BusinessPlansList">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionPlanListItem">
                      <Border Classes="plan-row" BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,14">
                        <Grid ColumnDefinitions="1.5*,*,130,110" ColumnSpacing="16">
                          <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Border Classes="configurationBadge" Classes.active="{Binding IsActive}" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusLabel}" /></Border>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding GroupLabel}" TextWrapping="Wrap" /><TextBlock Text="{Binding KindLabel}" Classes="caption" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding KindLabel}" /></StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding PriceLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding DurationLabel}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                          <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Открыть →" Padding="12,6" Command="{Binding $parent[views:SubscriptionPlansView].((vm:SubscriptionPlansViewModel)DataContext).OpenPlanCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="OpenSubscriptionPlan" />
                            <Button Content="{Binding ToggleLabel}" Padding="10,6" IsEnabled="{Binding CanToggle}" Command="{Binding $parent[views:SubscriptionPlansView].((vm:SubscriptionPlansViewModel)DataContext).TogglePlanCommand}" CommandParameter="{Binding}" />
                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Тарифы организаций не найдены" IsVisible="{Binding !HasBusinessPlans}" Classes="muted" Margin="14" />
              </StackPanel>
            </Border>
          </StackPanel>
          <StackPanel Spacing="7" IsVisible="{Binding HasPersonalPlans}">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="2,0,2,2">
              <StackPanel Spacing="2">
                <TextBlock Text="Личные тарифы" FontSize="18" FontWeight="SemiBold" />
                <TextBlock Text="Исторические записи, доступны только для просмотра" Classes="caption" />
              </StackPanel>
              <TextBlock Grid.Column="1" Text="{Binding PersonalPlanCountLabel}" Classes="caption" VerticalAlignment="Center" />
            </Grid>
            <Border Classes="card" Padding="0" ClipToBounds="True">
              <StackPanel>
                <Grid ColumnDefinitions="1.5*,*,130,110" ColumnSpacing="16" Margin="18,14"><TextBlock Text="Тариф" Classes="caption" /><TextBlock Grid.Column="1" Text="Группа" Classes="caption" /><TextBlock Grid.Column="2" Text="Стоимость" Classes="caption" /><TextBlock Grid.Column="3" Text="Действия" Classes="caption" /></Grid>
                <ItemsControl ItemsSource="{Binding PersonalRows}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:SubscriptionPlanListItem">
                      <Border Classes="plan-row" BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,14">
                        <Grid ColumnDefinitions="1.5*,*,130,110" ColumnSpacing="16">
                          <StackPanel Spacing="8" VerticalAlignment="Center">
                            <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                            <Border Classes="configurationBadge" Classes.active="{Binding IsActive}" HorizontalAlignment="Left"><TextBlock Text="{Binding StatusLabel}" /></Border>
                          </StackPanel>
                          <StackPanel Grid.Column="1" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding GroupLabel}" TextWrapping="Wrap" /><TextBlock Text="{Binding KindLabel}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                          <StackPanel Grid.Column="2" Spacing="4" VerticalAlignment="Center"><TextBlock Text="{Binding PriceLabel}" FontWeight="SemiBold" /><TextBlock Text="{Binding DurationLabel}" Classes="caption" TextWrapping="Wrap" /></StackPanel>
                          <StackPanel Grid.Column="3" Spacing="6" VerticalAlignment="Center">
                            <Button Content="Открыть →" Padding="12,6" Command="{Binding $parent[views:SubscriptionPlansView].((vm:SubscriptionPlansViewModel)DataContext).OpenPlanCommand}" CommandParameter="{Binding}" AutomationProperties.AutomationId="OpenSubscriptionPlan" />

                          </StackPanel>
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
      <ScrollViewer IsVisible="{Binding IsEditorOpen}" HorizontalScrollBarVisibility="Disabled">
        <Border Padding="0" HorizontalAlignment="Stretch" MaxWidth="1040">
          <StackPanel Spacing="16">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding SelectedPlan.Name}" IsVisible="{Binding !IsCreating}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                <TextBlock Text="Новый тариф" IsVisible="{Binding IsCreating}" FontSize="22" FontWeight="SemiBold" />
                <TextBlock Text="Организационный тариф · настройки и возможности" Classes="caption" IsVisible="{Binding IsBusinessPlanSelected}" />
                <TextBlock Text="Личный тариф · только просмотр" Classes="caption" IsVisible="{Binding IsReadOnly}" />
              </StackPanel>
              <Button Grid.Column="1" Content="← К тарифам" Command="{Binding CancelEditCommand}" VerticalAlignment="Top" />
            </Grid>
            <Border IsVisible="{Binding IsDeleteConfirmationOpen}" Background="#30211C" BorderBrush="#754E41" BorderThickness="1" CornerRadius="8" Padding="14">
              <StackPanel Spacing="10">
                <TextBlock TextWrapping="Wrap">Удалить тариф «<Run Text="{Binding SelectedPlan.Name}" />»? Это действие нельзя отменить.</TextBlock>
                <WrapPanel>
                  <Button Content="Удалить тариф" Classes="danger" Command="{Binding ConfirmDeleteCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="ConfirmDeletePlan" />
                  <Button Content="Отмена" Command="{Binding CancelDeleteCommand}" />
                </WrapPanel>
              </StackPanel>
            </Border>
            <StackPanel Spacing="12" IsVisible="{Binding !IsReadOnly}" IsEnabled="{Binding !IsSaving}">
              <Border Classes="configurationSection">
                <StackPanel Spacing="12">
                  <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                    <StackPanel Spacing="3">
                      <TextBlock Text="Основное" FontSize="17" FontWeight="SemiBold" />
                      <TextBlock Text="Название и описание, которые увидят пользователи" Classes="caption" TextWrapping="Wrap" />
                    </StackPanel>
                    <WrapPanel Grid.Column="1" VerticalAlignment="Center">
                      <Button Content="Сохранить тариф" Classes="configurationPrimary" Command="{Binding SavePlanCommand}" Margin="0,0,8,0" AutomationProperties.AutomationId="SaveSubscriptionPlan" />
                      <Button Content="Отмена" Command="{Binding CancelEditCommand}" Margin="0,0,8,0" />
                      <Button Content="Удалить" Classes="danger" IsVisible="{Binding CanDeletePlan}" Command="{Binding RequestDeleteCommand}" />
                    </WrapPanel>
                  </Grid>
                  <StackPanel Spacing="5">
                    <TextBlock Text="Название" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Editor.Name}" MaxLength="100" AutomationProperties.AutomationId="PlanName"
                             IsEnabled="{Binding !Editor.IsSystemFree}" />
                  </StackPanel>
                  <StackPanel Spacing="5">
                    <TextBlock Text="Описание" FontWeight="SemiBold" />
                    <TextBox Text="{Binding Editor.Description}" MaxLength="1000" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="76" VerticalContentAlignment="Top"
                             IsEnabled="{Binding !Editor.IsSystemFree}" />
                  </StackPanel>
                </StackPanel>
              </Border>
              <Border Classes="configurationSection">
                <StackPanel Spacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Стоимость и лимиты" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Срок, стоимость и ограничения рабочего пространства" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <TextBlock Text="Free · бесплатно и бессрочно" IsVisible="{Binding Editor.IsSystemFree}" FontWeight="SemiBold" />
                  <WrapPanel>
                    <StackPanel Width="200" Spacing="5" Margin="0,0,12,10" IsVisible="{Binding !Editor.IsSystemFree}">
                      <TextBlock Text="Цена, ₽" FontWeight="SemiBold" />
                      <NumericUpDown Value="{Binding Editor.Price}" Minimum="0" Maximum="100000000" Increment="100" FormatString="N2" ParsingNumberStyle="Float" ShowButtonSpinner="False"
                                     IsEnabled="{Binding !Editor.IsSystemFree}" />
                    </StackPanel>
                    <StackPanel Width="200" Spacing="5" Margin="0,0,12,10" IsVisible="{Binding !Editor.IsSystemFree}">
                      <TextBlock Text="Цена со скидкой, ₽" FontWeight="SemiBold" />
                      <NumericUpDown Value="{Binding Editor.DiscountPrice}" Minimum="0" Maximum="100000000" Increment="100" FormatString="N2" ParsingNumberStyle="Float" ShowButtonSpinner="False"
                                     IsEnabled="{Binding !Editor.IsSystemFree}" />
                    </StackPanel>
                    <StackPanel Width="150" Spacing="5" Margin="0,0,12,10" IsVisible="{Binding !Editor.IsSystemFree}">
                      <TextBlock Text="Срок, дней" FontWeight="SemiBold" />
                      <NumericUpDown Value="{Binding Editor.DurationDays}" Minimum="1" Maximum="36500" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ShowButtonSpinner="False"
                                     IsEnabled="{Binding !Editor.IsSystemFree}" />
                    </StackPanel>
                    <StackPanel Width="150" Spacing="5" Margin="0,0,12,10">
                      <TextBlock Text="Лимит техники" FontWeight="SemiBold" />
                      <NumericUpDown Value="{Binding Editor.VehicleLimit}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ShowButtonSpinner="False" />
                    </StackPanel>
                    <StackPanel Width="150" Spacing="5" Margin="0,0,12,10">
                      <TextBlock Text="Порядок" FontWeight="SemiBold" />
                      <NumericUpDown Value="{Binding Editor.Order}" Minimum="0" Maximum="1000000" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ShowButtonSpinner="False"
                                     IsEnabled="{Binding !Editor.IsSystemFree}" />
                    </StackPanel>
                    <StackPanel Width="260" Spacing="5" Margin="0,0,12,10">
                      <TextBlock Text="Группа" FontWeight="SemiBold" />
                      <TextBox Text="{Binding Editor.Group}" MaxLength="100" PlaceholderText="Например, Стандарт"
                               IsEnabled="{Binding !Editor.IsSystemFree}" />
                    </StackPanel>
                  </WrapPanel>
                </StackPanel>
              </Border>
              <Border Classes="configurationSection">
                <StackPanel Spacing="10">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Настройки тарифа" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Для системного Free цена, срок и статусы зафиксированы. Меняйте квоты и возможности тарифа." Classes="caption" TextWrapping="Wrap"
                               IsVisible="{Binding Editor.IsSystemFree}" />
                  </StackPanel>
                  <WrapPanel>
                    <CheckBox Content="Активен" IsChecked="{Binding Editor.IsActive}" IsEnabled="{Binding CanEditActiveFlag}" Margin="0,0,18,0" />
                    <CheckBox Content="По умолчанию" IsChecked="{Binding Editor.IsDefaultPlan}" IsEnabled="{Binding CanEditDefaultFlag}" Margin="0,0,18,0" />
                    <CheckBox Content="Демо-тариф" IsChecked="{Binding Editor.IsDemoPlan}" IsEnabled="{Binding CanEditDemoFlag}" />
                  </WrapPanel>
                </StackPanel>
              </Border>
            </StackPanel>
            <Border IsVisible="{Binding IsReadOnly}" Classes="configurationSection">
              <StackPanel Spacing="10">
                <TextBlock Text="Личные тарифы защищены от изменения в административной панели." Classes="caption" TextWrapping="Wrap" />
                <Grid ColumnDefinitions="130,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="8" ColumnSpacing="12">
                  <TextBlock Text="Описание" Classes="caption" /><TextBlock Grid.Column="1" Text="{Binding SelectedPlan.Description}" TextWrapping="Wrap" />
                  <TextBlock Grid.Row="1" Text="Цена" Classes="caption" /><TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding SelectedPlan.EffectivePrice, StringFormat='{}{0:C}'}" />
                  <TextBlock Grid.Row="2" Text="Срок" Classes="caption" /><TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding SelectedPlan.DurationDays, StringFormat='{}{0} дней'}" />
                  <TextBlock Grid.Row="3" Text="Техника" Classes="caption" /><TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding SelectedPlan.VehicleLimit}" />
                  <TextBlock Grid.Row="4" Text="Статус" Classes="caption" /><TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SelectedPlan.IsActive, StringFormat='Активен: {0}'}" />
                </Grid>
              </StackPanel>
            </Border>
            <Border IsVisible="{Binding IsFeatureEditorVisible}" Classes="configurationSection">
              <StackPanel Spacing="10">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                  <StackPanel Spacing="3">
                    <TextBlock Text="Возможности тарифа" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Общие настройки для всех сроков оплаты этой группы" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                  <Button Grid.Column="1" Content="Сохранить возможности" Classes="configurationPrimary" Command="{Binding SaveFeaturesCommand}" IsEnabled="{Binding CanSaveFeatures}" VerticalAlignment="Center" />
                </Grid>
                <ItemsControl ItemsSource="{Binding Features}" IsEnabled="{Binding !IsSaving}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PlanFeatureEditor">
                      <Border Classes="plan-feature-row" Padding="10,9">
                        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16" VerticalAlignment="Center">
                          <StackPanel Spacing="3" VerticalAlignment="Center">
                            <CheckBox Content="{Binding Name}" IsChecked="{Binding IsAssigned}" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding Description}" Classes="caption" TextWrapping="Wrap" Margin="24,0,0,0" />
                            <TextBlock Text="{Binding Category}" Classes="caption" Margin="24,0,0,0"  />
                          </StackPanel>
                          <CheckBox Grid.Column="1" IsVisible="{Binding IsBooleanValue}" Content="Включено" IsChecked="{Binding BoolValue}" IsEnabled="{Binding IsAssigned}" VerticalAlignment="Center" />
                          <NumericUpDown Grid.Column="1" IsVisible="{Binding IsIntegerValue}" Value="{Binding IntValue}" Minimum="0" Maximum="100000000" Increment="1" FormatString="0" ParsingNumberStyle="Integer" ShowButtonSpinner="False" IsEnabled="{Binding IsAssigned}" Width="120" VerticalAlignment="Center" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
                <TextBlock Text="Для тарифа нет настраиваемых возможностей." IsVisible="{Binding !HasFeatures}" Classes="muted" />
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
      </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="2" Text="Тарифы не найдены" IsVisible="{Binding IsEmpty}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" />
  </Grid>
</UserControl>
