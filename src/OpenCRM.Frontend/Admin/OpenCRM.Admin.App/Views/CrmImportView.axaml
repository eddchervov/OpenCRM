<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenCRM.Admin.App.Localization"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels" xmlns:api="using:OpenCRM.Admin.Api.Models"
             x:Class="OpenCRM.Admin.App.Views.CrmImportView" x:DataType="vm:CrmImportViewModel">
  <Grid RowDefinitions="Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto">
      <TextBlock Text="{loc:LocalizedText Key=native.crmImport.import.crm}" FontSize="28" FontWeight="SemiBold" />
      <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.billing.obnovit}" Command="{Binding RefreshCommand}" />
    </Grid>
    <StackPanel Grid.Row="1" Spacing="8">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{loc:LocalizedText Key=native.crmImport.rezultat.zaprosa.neizvesten.obnovite.proverku.pered.povtornym.po}"
                 IsVisible="{Binding IsOutcomeUnknown}" Foreground="#F0C58B" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>
    <ScrollViewer Grid.Row="2" HorizontalScrollBarVisibility="Disabled">
      <StackPanel MaxWidth="1200" Spacing="18">
        <Border Classes="configurationSection">
          <StackPanel Spacing="12" IsEnabled="{Binding !IsBusy}">
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.1.polzovatel.i.organizatsiya}" Classes="configurationHeading" />
            <WrapPanel>
              <TextBox Text="{Binding Search}" PlaceholderText="{loc:LocalizedText Key=native.crmImport.email.ili.telefon.polzovatelya}" Width="280" Margin="0,0,10,8" />
              <Button Content="{loc:LocalizedText Key=native.billing.nayti}" Command="{Binding SearchUsersCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.polzovatel}" Classes="caption" />
            <WrapPanel>
              <ComboBox ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser}" Width="320" Margin="0,0,10,8">
                <ComboBox.ItemTemplate><DataTemplate x:DataType="api:AdminCrmImportUser"><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
              </ComboBox>
              <Button Content="{loc:LocalizedText Key=native.crmImport.pokazat.organizatsii}" Command="{Binding LoadOrganizationsCommand}" Margin="0,0,0,8" />
            </WrapPanel>
            <TextBlock Text="{loc:LocalizedText Key=native.promoCodes.organizatsiya}" Classes="caption" />
            <ComboBox ItemsSource="{Binding Organizations}" SelectedItem="{Binding SelectedOrganization}" HorizontalAlignment="Left" Width="320">
              <ComboBox.ItemTemplate><DataTemplate x:DataType="api:AdminCrmImportOrganization"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate>
            </ComboBox>
          </StackPanel>
        </Border>
        <Border Classes="configurationSection">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.2.fayl.i.proverka}" Classes="configurationHeading" />
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.csv.xlsx.json.ili.xml.do.10.mb.do.5000.strok}" Classes="caption" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="{loc:LocalizedText Key=native.crmImport.vybrat.fayl}" Click="OnChooseFile" IsEnabled="{Binding CanSelectFile}" Margin="0,0,12,8" />
              <TextBlock Text="{Binding FileName}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </WrapPanel>
            <Button Content="{loc:LocalizedText Key=native.crmImport.proverit.fayl}" Command="{Binding PreviewFileCommand}" Classes="configurationPrimary" />
          </StackPanel>
        </Border>
        <Border Classes="configurationSection" IsVisible="{Binding HasPreview}">
          <StackPanel Spacing="14">
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.3.rezultat.proverki}" Classes="configurationHeading" />
            <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" />
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.etot.fayl.uzhe.importirovan}" IsVisible="{Binding Preview.AlreadyImported}" Foreground="#F0C58B" />
            <WrapPanel>
              <Button Content="{loc:LocalizedText Key=native.crmImport.sokhranit.otchyot.proverki}" Click="OnSavePreview" IsEnabled="{Binding CanDownload}" Margin="0,0,10,8" />
              <Button Content="{loc:LocalizedText Key=native.crmImport.nachat.import}" Command="{Binding RequestConfirmationCommand}" Classes="configurationPrimary" Margin="0,0,0,8" />
            </WrapPanel>
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
              <Grid RowDefinitions="Auto,*" MinWidth="700">
                <Grid ColumnDefinitions="65,2*,150,*" Margin="12,8">
                  <TextBlock Text="{loc:LocalizedText Key=native.crmImport.stroka}" Classes="caption" />
                  <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=native.crmImport.dannye}" Classes="caption" />
                  <TextBlock Grid.Column="2" Text="{loc:LocalizedText Key=native.crmImport.rezultat}" Classes="caption" />
                  <TextBlock Grid.Column="3" Text="{loc:LocalizedText Key=native.crmImport.kommentariy}" Classes="caption" />
                </Grid>
                <ListBox Grid.Row="1" ItemsSource="{Binding Preview.Rows}" Height="300" Background="Transparent"
                         BorderThickness="0" ItemContainerTheme="{StaticResource AdminListRowTheme}">
                  <ListBox.ItemTemplate>
                    <DataTemplate x:DataType="api:AdminCrmImportRow">
                      <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="12,10">
                        <Grid ColumnDefinitions="65,2*,150,*" ColumnSpacing="8">
                          <TextBlock Text="{Binding Number}" Classes="caption" />
                          <TextBlock Grid.Column="1" Text="{Binding Label}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="2" Text="{Binding StatusLabel}" TextWrapping="Wrap" />
                          <TextBlock Grid.Column="3" Text="{Binding Message}" TextWrapping="Wrap" />
                        </Grid>
                      </Border>
                    </DataTemplate>
                  </ListBox.ItemTemplate>
                </ListBox>
              </Grid>
            </ScrollViewer>
          </StackPanel>
        </Border>
        <Border Classes="configurationSection" IsVisible="{Binding IsConfirmationOpen}">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.confirmTitle}" Classes="configurationHeading" />
            <TextBlock Text="{loc:LocalizedFormat Key=native.crmImport.organizatsiya.0, Path=SelectedOrganization.Name}" TextWrapping="Wrap" />
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.budut.sozdany.zapisi.iz.proverennogo.fayla.dublikaty.budut.propu}" TextWrapping="Wrap" />
            <WrapPanel>
              <Button Content="{loc:LocalizedText Key=native.crmImport.confirmAction}" Command="{Binding ConfirmCommand}" Classes="configurationPrimary" Margin="0,0,10,0" />
              <Button Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelConfirmationCommand}" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Classes="configurationSection" IsVisible="{Binding HasResultReport}">
          <StackPanel Spacing="12">
            <TextBlock Text="{loc:LocalizedText Key=native.crmImport.import.zavershyon}" Classes="configurationHeading" />
            <TextBlock Text="{Binding ResultSummary}" TextWrapping="Wrap" IsVisible="{Binding HasResult}" />
            <Button Content="{loc:LocalizedText Key=native.crmImport.sokhranit.itogovyy.otchyot}" Click="OnSaveResult" IsEnabled="{Binding CanDownload}" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
