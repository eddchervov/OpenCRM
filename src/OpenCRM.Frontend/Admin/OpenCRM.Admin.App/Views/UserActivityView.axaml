<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             x:Class="OpenCRM.Admin.App.Views.UserActivityView"
             x:DataType="vm:UserActivityViewModel">
  <StackPanel Spacing="16">
    <StackPanel Spacing="5">
      <TextBlock Text="{Binding Title}" FontSize="24" FontWeight="SemiBold" />
      <TextBlock Text="{Binding StatusLabel}" Classes="caption" />
    </StackPanel>
    <Border IsVisible="{Binding IsDisabled}" Classes="card" Padding="14" Background="#352C1D" BorderBrush="#665335">
      <TextBlock Text="Сбор отключён: новые события не поступают, ранее записанные доступны в пределах срока хранения." TextWrapping="Wrap" />
    </Border>
    <Border Classes="card" Padding="14" Background="#111519" BorderBrush="#2D353E">
      <StackPanel Spacing="12">
        <Grid ColumnDefinitions="2*,*,*,1.5*" ColumnSpacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Пользователь" Classes="caption" />
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="6">
              <AutoCompleteBox x:Name="ActivityUserPicker" Text="{Binding UserSearch, Mode=TwoWay}"
                               ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}"
                               AsyncPopulator="{Binding PopulateUsers}" ValueMemberBinding="{ReflectionBinding Label}"
                               MinimumPrefixLength="0" MinimumPopulateDelay="0:0:0.25" FilterMode="None"
                               IsTextCompletionEnabled="False" IsEnabled="{Binding !IsUserFixed}"
                               PlaceholderText="Все пользователи · email или телефон"
                               HorizontalAlignment="Stretch" Background="#181818" Foreground="#F1F1F1"
                               BorderBrush="#393939" CornerRadius="7" Padding="10,7"
                               AutomationProperties.AutomationId="ActivityUserPicker">
                <AutoCompleteBox.InnerRightContent>
                  <Button Content="⌄" Click="OnOpenUserPicker" Background="Transparent" BorderThickness="0" Padding="6,0" />
                </AutoCompleteBox.InnerRightContent>
                <AutoCompleteBox.ItemTemplate>
                  <DataTemplate x:DataType="vm:ActivityUserOption">
                    <TextBlock Text="{Binding Label}" Margin="4,6" />
                  </DataTemplate>
                </AutoCompleteBox.ItemTemplate>
              </AutoCompleteBox>
              <Button Grid.Column="1" Content="×" Command="{Binding ClearUserCommand}" IsVisible="{Binding !IsUserFixed}"
                      ToolTip.Tip="Все пользователи" AutomationProperties.AutomationId="ActivityClearUser" />
            </Grid>
            <TextBlock Text="Ищем пользователей…" Classes="caption" IsVisible="{Binding IsSearchingUsers}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Spacing="5">
            <TextBlock Text="Тип события" Classes="caption" />
            <ComboBox ItemsSource="{Binding KindOptions}" SelectedItem="{Binding Kind}"
                      AutomationProperties.AutomationId="ActivityKind" />
          </StackPanel>
          <StackPanel Grid.Column="2" Spacing="5">
            <TextBlock Text="Сценарий" Classes="caption" />
            <ComboBox ItemsSource="{Binding ScenarioOptions}" SelectedItem="{Binding Scenario}"
                      AutomationProperties.AutomationId="ActivityScenario" />
          </StackPanel>
          <StackPanel Grid.Column="3" Spacing="5">
            <TextBlock Text="Поиск" Classes="caption" />
            <TextBox Text="{Binding Search}" PlaceholderText="Организация, действие, страница"
                     AutomationProperties.AutomationId="ActivitySearch" />
          </StackPanel>
        </Grid>
        <StackPanel Orientation="Horizontal" Spacing="10">
          <StackPanel Spacing="5">
            <TextBlock Text="Дата с (UTC)" Classes="caption" />
            <TextBox Width="150" Text="{Binding FromDate}" PlaceholderText="ГГГГ-ММ-ДД" AutomationProperties.AutomationId="ActivityFrom" />
          </StackPanel>
          <StackPanel Spacing="5">
            <TextBlock Text="Дата по (UTC)" Classes="caption" />
            <TextBox Width="150" Text="{Binding ToDate}" PlaceholderText="ГГГГ-ММ-ДД" AutomationProperties.AutomationId="ActivityTo" />
          </StackPanel>
          <Button Content="Применить" Command="{Binding ApplyFiltersCommand}" VerticalAlignment="Bottom"
                  AutomationProperties.AutomationId="ActivityApply" />
          <Button Content="Обновить" Command="{Binding RefreshCommand}" VerticalAlignment="Bottom"
                  AutomationProperties.AutomationId="ActivityRefresh" />
        </StackPanel>
      </StackPanel>
    </Border>
    <Border IsVisible="{Binding HasError}" Background="#261A1A" BorderBrush="#594040"
            BorderThickness="1" CornerRadius="8" Padding="14">
      <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F4CACA" />
    </Border>
    <TextBlock IsVisible="{Binding IsLoading}" Text="Загружаем журнал…" Classes="caption" />
    <TextBlock IsVisible="{Binding !HasItems}" Text="Для выбранных фильтров записей нет." Classes="muted" Margin="8,12" />
    <Border Classes="card" Padding="0" IsVisible="{Binding HasItems}" Background="#111519" BorderBrush="#2D353E">
      <StackPanel>
        <Border Padding="15,12" Background="#1B222A" CornerRadius="12,12,0,0">
          <Grid ColumnDefinitions="160,1.1*,*,1.7*" ColumnSpacing="18">
            <TextBlock Text="Когда" Classes="caption" />
            <TextBlock Grid.Column="1" Text="Пользователь" Classes="caption" />
            <TextBlock Grid.Column="2" Text="Организация" Classes="caption" />
            <TextBlock Grid.Column="3" Text="Действие" Classes="caption" />
          </Grid>
        </Border>
        <ItemsControl ItemsSource="{Binding Items}" AutomationProperties.AutomationId="ActivityItems">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:UserActivityRow">
              <Border Padding="15,14" BorderBrush="#2D353E" BorderThickness="0,0,0,1">
                <Grid ColumnDefinitions="160,1.1*,*,1.7*" ColumnSpacing="18">
                  <TextBlock Text="{Binding OccurredAt}" />
                  <TextBlock Grid.Column="1" Text="{Binding User}" TextWrapping="Wrap" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="2" Text="{Binding Organization}" TextWrapping="Wrap" />
                  <StackPanel Grid.Column="3" Spacing="4">
                    <TextBlock Text="{Binding Event}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Text="{Binding Location}" Classes="caption" TextWrapping="Wrap" />
                  </StackPanel>
                </Grid>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </StackPanel>
    </Border>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
      <Button Content="← Предыдущая страница" Command="{Binding PreviousPageCommand}" IsVisible="{Binding CanGoPrevious}"
              AutomationProperties.AutomationId="ActivityPreviousPage" />
      <Button Content="Следующая страница →" Command="{Binding NextPageCommand}" IsVisible="{Binding HasMore}"
              AutomationProperties.AutomationId="ActivityNextPage" />
    </StackPanel>
  </StackPanel>
</UserControl>
