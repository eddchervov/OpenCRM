<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:views="using:OpenCRM.Admin.App.Views"
             x:Class="OpenCRM.Admin.App.Views.ListPagination"
             x:DataType="views:ListPagination"
             x:Name="PaginationControl"
             AutomationProperties.AutomationId="ListPagination">
  <WrapPanel VerticalAlignment="Center">
    <TextBlock Text="{Binding PageLabel, ElementName=PaginationControl}" Classes="caption"
               VerticalAlignment="Center" Margin="0,0,16,0" />
    <Button Content="←" Command="{Binding PreviousCommand, ElementName=PaginationControl}"
            ToolTip.Tip="Предыдущая страница" Margin="0,0,8,0" />
    <Button Content="→" Command="{Binding NextCommand, ElementName=PaginationControl}"
            ToolTip.Tip="Следующая страница" />
  </WrapPanel>
</UserControl>
