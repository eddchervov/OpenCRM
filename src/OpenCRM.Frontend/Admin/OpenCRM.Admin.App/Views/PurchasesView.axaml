<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenCRM.Admin.App.Localization"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:views="using:OpenCRM.Admin.App.Views"
             x:Class="OpenCRM.Admin.App.Views.PurchasesView"
             x:DataType="vm:PurchasesViewModel">
  <Grid RowDefinitions="Auto,*" RowSpacing="12">
    <StackPanel Spacing="6">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{Binding SuccessMessage}" IsVisible="{Binding SuccessMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" Foreground="#A7DCA7" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>
    <Grid Grid.Row="1" IsVisible="{Binding !IsDetailOpen}" RowDefinitions="Auto,Auto,Auto,*" RowSpacing="12">
      <Border Classes="card" Padding="12">
        <WrapPanel>
          <TextBox Text="{Binding Search}" PlaceholderText="{loc:LocalizedText Key=native.billing.pokupatel.inn.email.tarif.ili.id}" Width="300" Margin="0,0,8,8" KeyDown="OnSearchKeyDown" />
          <ComboBox ItemsSource="{Binding BuyerOptions}" SelectedItem="{Binding SelectedBuyer}" Width="190" Margin="0,0,8,8" IsEnabled="{Binding !IsBusy}" />
          <ComboBox ItemsSource="{Binding ReceiptOptions}" SelectedItem="{Binding SelectedReceipt}" Width="170" Margin="0,0,8,8" IsEnabled="{Binding !IsBusy}" />
          <ComboBox ItemsSource="{Binding QueueOptions}" SelectedItem="{Binding SelectedQueue}" Width="210" Margin="0,0,8,8" IsEnabled="{Binding !IsBusy}" />
          <ComboBox ItemsSource="{Binding PeriodOptions}" SelectedItem="{Binding SelectedPeriod}" Width="160" Margin="0,0,8,8" IsEnabled="{Binding !IsBusy}" />
          <Button Content="{loc:LocalizedText Key=native.billing.nayti}" Command="{Binding ApplyFiltersCommand}" Classes="primary" Margin="0,0,8,8" />
          <Button Content="{loc:LocalizedText Key=native.billing.sbrosit}" Command="{Binding ResetFiltersCommand}" Margin="0,0,8,8" />
          <Button Content="{loc:LocalizedText Key=native.billing.obnovit}" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
        </WrapPanel>
      </Border>
      <StackPanel Grid.Row="1" Spacing="6">
        <TextBlock Text="{Binding Summary}" TextWrapping="Wrap" Classes="caption" />
        <TextBlock Text="{loc:LocalizedText Key=native.billing.cheki.bez.otmetki.pokazany.pervymi.24.chasa.vnutrenniy.orientir.}" TextWrapping="Wrap" Classes="caption" />
      </StackPanel>
      <views:ListPagination Grid.Row="2" PageLabel="{Binding PageLabel}"
                            PreviousCommand="{Binding PreviousPageCommand}" NextCommand="{Binding NextPageCommand}" />
      <Border Grid.Row="3" Classes="card" Padding="0">
        <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
          <Grid RowDefinitions="Auto,*" MinWidth="1040" Width="{Binding $parent[ScrollViewer].Viewport.Width}">
            <Grid ColumnDefinitions="60,2*,1.4*,2*,1.5*,100" Margin="12,10">
              <TextBlock Text="ID" Classes="caption" />
              <TextBlock Grid.Column="1" Text="{loc:LocalizedText Key=native.billing.pokupatel}" Classes="caption" />
              <TextBlock Grid.Column="2" Text="{loc:LocalizedText Key=native.billing.tarif.oplata}" Classes="caption" />
              <TextBlock Grid.Column="3" Text="{loc:LocalizedText Key=native.billing.summa.i.vozvraty}" Classes="caption" />
              <TextBlock Grid.Column="4" Text="{loc:LocalizedText Key=native.billing.chek.dostavka}" Classes="caption" />
              <TextBlock Grid.Column="5" Text="{loc:LocalizedText Key=native.billing.deystviya}" Classes="caption" />
            </Grid>
            <ListBox Grid.Row="1" ItemsSource="{Binding Rows}" SelectedItem="{Binding SelectedRow}" ItemContainerTheme="{StaticResource AdminListRowTheme}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     DoubleTapped="OnRowDoubleTapped" KeyDown="OnRowsKeyDown" AutomationProperties.AutomationId="PurchasesList">
              <ListBox.ItemTemplate>
                <DataTemplate x:DataType="vm:PurchasesRow">
                  <Border BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="12,12">
                    <Grid ColumnDefinitions="60,2*,1.4*,2*,1.5*,100">
                      <TextBlock Text="{Binding Id}" Classes="caption" />
                      <StackPanel Grid.Column="1" Spacing="4" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Buyer}" TextWrapping="Wrap" FontWeight="SemiBold" />
                        <TextBlock Text="{Binding BuyerType}" Classes="caption" />
                      </StackPanel>
                      <StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0">
                        <TextBlock Text="{Binding Plan}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding PaidAt}" Classes="caption" />
                        <TextBlock Text="{Binding PaymentStatus}" Classes="caption" />
                      </StackPanel>
                      <TextBlock Grid.Column="3" Text="{Binding Amount}" TextWrapping="Wrap" Margin="0,0,12,0" />
                      <StackPanel Grid.Column="4" Spacing="4">
                        <TextBlock Text="{Binding Receipt}" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding Delivery}" TextWrapping="Wrap" Classes="caption" />
                      </StackPanel>
                      <Button Grid.Column="5" Content="{loc:LocalizedText Key=native.billing.otkryt}" Padding="10,6" VerticalAlignment="Center" Margin="12,0,0,0" Click="OnOpenRowClick" />
                    </Grid>
                  </Border>
                </DataTemplate>
              </ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Grid.Row="1" IsVisible="{Binding IsEmpty}" Text="{loc:LocalizedText Key=native.billing.pokupki.po.vybrannym.filtram.ne.naydeny}" HorizontalAlignment="Center" VerticalAlignment="Center" Classes="caption" />
          </Grid>
        </ScrollViewer>
      </Border>
    </Grid>
    <Grid Grid.Row="1" IsVisible="{Binding IsDetailOpen}" RowDefinitions="Auto,*" RowSpacing="12">
      <Button Content="{loc:LocalizedText Key=native.billing.k.pokupkam}" Command="{Binding CloseDetailCommand}" HorizontalAlignment="Left" />
      <ScrollViewer Grid.Row="1">
        <StackPanel Spacing="12">
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:LocalizedText Key=native.billing.pokupka.i.chek.npd}" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Text="{Binding Detail.Buyer}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Detail.BuyerType}" />
              <TextBlock Text="{Binding Detail.Plan}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Detail.PaidAt}" />
              <TextBlock Text="{Binding Detail.Amount}" TextWrapping="Wrap" />
              <TextBlock Text="{Binding Detail.PaymentStatus}" />
              <TextBlock Text="{Binding Detail.Receipt}" />
              <TextBlock Text="{Binding Detail.Delivery}" />
              <SelectableTextBlock Text="{Binding Detail.ReceiptHistory}" TextWrapping="Wrap" />
            </StackPanel>
          </Border>
          <Border Classes="card">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:LocalizedText Key=native.billing.ssylka.fns.i.kommentariy}" FontWeight="SemiBold" />
              <TextBox Text="{Binding ReceiptUrl}" PlaceholderText="https://…nalog.ru/…" IsReadOnly="{Binding !CanManage}" IsEnabled="{Binding !IsBusy}" />
              <TextBox Text="{Binding ReceiptComment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" MaxLength="1000" PlaceholderText="{loc:LocalizedText Key=native.billing.kommentariy.k.cheku}" IsReadOnly="{Binding !CanManage}" IsEnabled="{Binding !IsBusy}" />
              <Button Content="{loc:LocalizedText Key=native.billing.sokhranit.ssylku.i.kommentariy}" Command="{Binding SaveDetailsCommand}" IsVisible="{Binding CanManage}" />
              <TextBlock Text="{Binding Detail.Purchase.NpdReceiptFileName}" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Content="{loc:LocalizedText Key=native.billing.skachat.fayl}" Click="OnDownloadFile" IsEnabled="{Binding CanDownload}" Margin="0,0,8,8" />
                <Button Content="{loc:LocalizedText Key=native.billing.vlozhit.pdf.png.jpg}" Click="OnUploadFile" IsEnabled="{Binding CanUpload}" IsVisible="{Binding CanManage}" Margin="0,0,8,8" />
                <Button Content="{loc:LocalizedText Key=native.billing.otkrepit.fayl}" Command="{Binding RequestDeleteFileCommand}" IsVisible="{Binding CanManage}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{loc:LocalizedText Key=native.billing.odin.fayl.do.5.mb.skachivanie.dostupno.tolko.avtorizovannomu.adm}" TextWrapping="Wrap" Classes="caption" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding CanManage}">
            <StackPanel Spacing="8">
              <TextBlock Text="{loc:LocalizedText Key=native.billing.vydacha.i.otpravka.cheka}" FontWeight="SemiBold" />
              <TextBlock Text="{loc:LocalizedText Key=native.billing.snachala.sozdayte.chek.v.moyom.naloge.i.peredayte.pokupatelyu.ot}" TextWrapping="Wrap" Classes="caption" />
              <TextBox Text="{Binding ChangeReason}" MaxLength="500" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="70" PlaceholderText="{loc:LocalizedText Key=native.billing.prichina.otmetki.ili.snyatiya.otmetki.obyazatelno}" IsEnabled="{Binding !IsBusy}" />
              <WrapPanel>
                <Button Content="{loc:LocalizedText Key=native.billing.izmenit.otmetku.o.vydache}" Command="{Binding RequestToggleIssuedCommand}" Margin="0,0,8,8" />
                <Button Content="{loc:LocalizedText Key=native.billing.otpravit.chek.pokupatelyu}" Command="{Binding RequestSendCommand}" Margin="0,0,8,8" />
              </WrapPanel>
              <TextBlock Text="{loc:LocalizedText Key=native.billing.otpravka.ispolzuet.sokhranyonnye.fayl.ili.ssylku.i.email.polzova}" TextWrapping="Wrap" Classes="caption" />
            </StackPanel>
          </Border>
          <Border Classes="card" IsVisible="{Binding IsConfirmationOpen}" BorderBrush="#A38540">
            <StackPanel Spacing="10">
              <TextBlock Text="{Binding ConfirmationMessage}" TextWrapping="Wrap" />
              <WrapPanel>
                <Button Content="{loc:LocalizedText Key=native.billing.podtverdit}" Command="{Binding ConfirmCommand}" Classes="primary" Margin="0,0,8,8" />
                <Button Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelConfirmationCommand}" Margin="0,0,8,8" />
              </WrapPanel>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
  </Grid>
</UserControl>
