<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="using:OpenCRM.Admin.App.Localization"
             xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
             xmlns:api="using:OpenCRM.Admin.Api.Models"
             x:Class="OpenCRM.Admin.App.Views.CatalogSuggestionsView"
             x:DataType="vm:CatalogSuggestionsViewModel">
  <UserControl.Resources>
    <ControlTheme x:Key="StatusTabTheme" TargetType="TabStripItem">
      <Setter Property="Background" Value="#171B20" />
      <Setter Property="Foreground" Value="#C7CED6" />
      <Setter Property="BorderBrush" Value="#303841" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                  BorderThickness="1" CornerRadius="7" Padding="16,10" Margin="0,0,8,0">
            <ContentPresenter Content="{TemplateBinding Content}" />
          </Border>
        </ControlTemplate>
      </Setter>
      <Style Selector="^:pointerover"><Setter Property="Background" Value="#242D36" /></Style>
      <Style Selector="^:selected">
        <Setter Property="Background" Value="#23384A" />
        <Setter Property="BorderBrush" Value="#527DA0" />
        <Setter Property="Foreground" Value="#F5F9FD" />
        <Setter Property="FontWeight" Value="SemiBold" />
      </Style>
      <Style Selector="^:selected:pointerover"><Setter Property="Background" Value="#2B4358" /></Style>
      <Style Selector="^:focus-visible"><Setter Property="BorderBrush" Value="#86B5DC" /></Style>
    </ControlTheme>
  </UserControl.Resources>
  <Grid RowDefinitions="Auto,Auto,Auto,*" RowSpacing="14">
    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
      <StackPanel Spacing="4">
        <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.predlozheniya.v.katalog}" Classes="heading" />
        <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.proveryayte.polzovatelskie.predlozheniya.i.prinimayte.reshenie.p}" Classes="caption" TextWrapping="Wrap" />
      </StackPanel>
      <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.billing.obnovit}" Command="{Binding RefreshCommand}" VerticalAlignment="Center" />
    </Grid>

    <StackPanel Grid.Row="1" Spacing="6">
      <TextBlock Text="{Binding ErrorMessage}" IsVisible="{Binding HasError}" Foreground="#F4CACA" TextWrapping="Wrap" />
      <TextBlock Text="{Binding Message}" IsVisible="{Binding HasMessage}" Foreground="#9CDABB" TextWrapping="Wrap" />
      <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3" />
    </StackPanel>

    <TabStrip Grid.Row="2" ItemsSource="{Binding Tabs}" SelectedIndex="{Binding SelectedTabIndex}"
              SelectionChanged="OnTabSelectionChanged" ItemContainerTheme="{StaticResource StatusTabTheme}" />

    <ScrollViewer Grid.Row="3" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="14">
        <Border Classes="configurationSection" Padding="0" IsVisible="{Binding !HasSelection}">
          <StackPanel>
            <Grid ColumnDefinitions="*,Auto" Margin="18,16,18,12">
              <StackPanel Spacing="3">
                <TextBlock Text="{Binding ListTitle}" Classes="configurationHeading" />
                <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.otkroyte.predlozhenie.chtoby.posmotret.detali.i.otvetit.avtoru}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
              <Border Grid.Column="1" Classes="configurationBadge" VerticalAlignment="Center">
                <TextBlock Text="{loc:LocalizedFormat Key=native.catalogSuggestions.v.spiske.0.n0, Path=Suggestions.Count}" />
              </Border>
            </Grid>
            <ItemsControl ItemsSource="{Binding Suggestions}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="api:AdminCatalogSuggestion">
                  <Border BorderBrush="#292D32" BorderThickness="0,1,0,0" Padding="18,12">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="16">
                      <StackPanel Spacing="5" VerticalAlignment="Center">
                        <TextBlock Text="{Binding BrandName}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding ModelName}" TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                          <TextBlock Text="{Binding KindText}" Classes="caption" />
                          <TextBlock Text="·" Classes="caption" />
                          <TextBlock Text="{loc:LocalizedFormat Path=SuggestedByEmail, FallbackKey=native.promoCodes.polzovatel}" Classes="caption" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                      </StackPanel>
                      <StackPanel Grid.Column="1" Spacing="8" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Border Classes="configurationBadge" HorizontalAlignment="Right">
                          <TextBlock Text="{Binding StatusText}" />
                        </Border>
                        <Button Content="{loc:LocalizedText Key=native.billing.otkryt}" HorizontalAlignment="Right" Classes="configurationPrimary"
                                Command="{Binding $parent[UserControl].((vm:CatalogSuggestionsViewModel)DataContext).SelectSuggestionCommand}"
                                CommandParameter="{Binding}" />
                      </StackPanel>
                    </Grid>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Border IsVisible="{Binding IsEmpty}" Padding="18,24">
              <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.predlozheniy.s.takim.statusom.net}" Classes="caption" TextWrapping="Wrap" />
            </Border>
          </StackPanel>
        </Border>

        <Border Classes="configurationSection" IsVisible="{Binding HasSelection}" Padding="20" MaxWidth="900" HorizontalAlignment="Stretch">
          <StackPanel Spacing="18">
            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding SelectedSuggestion.BrandName}" Classes="configurationHeading" TextWrapping="Wrap" />
                <TextBlock Text="{Binding SelectedSuggestion.ModelName}" FontSize="16" TextWrapping="Wrap" />
              </StackPanel>
              <Button Grid.Column="1" Content="{loc:LocalizedText Key=native.catalogSuggestions.k.predlozheniyam}" Command="{Binding CloseDetailsCommand}" VerticalAlignment="Center" />
            </Grid>

            <Border Classes="configurationSection" Padding="14">
              <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
                <StackPanel Spacing="5">
                  <TextBlock Text="{loc:LocalizedText Key=native.vehicleCatalog.vid.tekhniki}" Classes="caption" />
                  <TextBlock Text="{Binding SelectedSuggestion.KindText}" TextWrapping="Wrap" />
                </StackPanel>
                <StackPanel Grid.Column="1" Spacing="5">
                  <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.status.predlozheniya}" Classes="caption" />
                  <Border Classes="configurationBadge" HorizontalAlignment="Left">
                    <TextBlock Text="{Binding SelectedSuggestion.StatusText}" />
                  </Border>
                </StackPanel>
              </Grid>
            </Border>

            <Grid ColumnDefinitions="*,*" ColumnSpacing="20">
              <StackPanel Spacing="5">
                <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.predlozhil}" Classes="caption" />
                <TextBlock Text="{loc:LocalizedFormat Path=SelectedSuggestion.SuggestedByEmail, FallbackKey=native.promoCodes.polzovatel}" TextWrapping="Wrap" />
              </StackPanel>
              <StackPanel Grid.Column="1" Spacing="5">
                <TextBlock Text="{loc:LocalizedText Key=native.email.createdColumn}" Classes="caption" />
                <TextBlock Text="{loc:LocalizedFormat Key=core.format.dateTime, Path=SelectedSuggestion.CreatedAt, UseLocalTime=True}" />
              </StackPanel>
            </Grid>

            <StackPanel Spacing="7">
              <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.kommentariy.moderatora}" Classes="caption" />
              <TextBox Text="{Binding Comment}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="112" MaxHeight="240"
                       VerticalContentAlignment="Top" Padding="12,10" PlaceholderText="{loc:LocalizedText Key=native.catalogSuggestions.napishite.poyasnenie.dlya.avtora.esli.nuzhno}"
                       IsEnabled="{Binding CanManage}" />
              <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.kommentariy.budet.sokhranyon.vmeste.s.resheniem}" Classes="caption" TextWrapping="Wrap" />
            </StackPanel>

            <Grid ColumnDefinitions="*,Auto">
              <Button Content="{loc:LocalizedText Key=native.catalogSuggestions.deleteAction}" IsVisible="{Binding CanManage}" Command="{Binding RequestDeleteCommand}"
                      Foreground="#F4CACA" HorizontalAlignment="Left" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
                <Button Content="{loc:LocalizedText Key=native.catalogSuggestions.otklonit}" IsVisible="{Binding CanReview}" Command="{Binding RequestRejectCommand}" />
                <Button Content="{loc:LocalizedText Key=native.catalogSuggestions.odobrit}" Classes="configurationPrimary" IsVisible="{Binding CanReview}" Command="{Binding RequestApproveCommand}" />
              </StackPanel>
            </Grid>
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>

    <Border Grid.RowSpan="4" IsVisible="{Binding IsConfirmationOpen}" Background="#CC000000" ZIndex="10" Padding="20">
      <Border Classes="configurationSection" MaxWidth="480" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.podtverdite.reshenie}" Classes="configurationHeading" />
          <TextBlock Text="{Binding ConfirmationText}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:LocalizedText Key=native.billing.podtverdit}" Classes="configurationPrimary" Command="{Binding ConfirmReviewCommand}" />
            <Button Content="{loc:LocalizedText Key=native.siteNotifications.nazad}" Command="{Binding CancelConfirmationCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
    <Border Grid.RowSpan="4" IsVisible="{Binding IsDeleteConfirmationOpen}" Background="#CC000000" ZIndex="11" Padding="20">
      <Border Classes="configurationSection" MaxWidth="480" HorizontalAlignment="Stretch" VerticalAlignment="Center" Padding="22">
        <StackPanel Spacing="14">
          <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.deleteConfirmTitle}" Classes="configurationHeading" />
          <TextBlock Text="{loc:LocalizedText Key=native.catalogSuggestions.udalitsya.tolko.eto.predlozhenie.marki.modeli.i.tekhnika.sokhran}" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="{loc:LocalizedText Key=native.billing.otmena}" Command="{Binding CancelDeleteCommand}" />
            <Button Content="{loc:LocalizedText Key=native.plans.udalit}" Command="{Binding ConfirmDeleteCommand}" Foreground="#F4CACA" />
          </StackPanel>
        </StackPanel>
      </Border>
    </Border>
  </Grid>
</UserControl>
