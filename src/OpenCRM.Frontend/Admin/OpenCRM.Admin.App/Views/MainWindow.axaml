<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:OpenCRM.Admin.App.ViewModels"
        xmlns:views="using:OpenCRM.Admin.App.Views"
        x:Class="OpenCRM.Admin.App.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="Администрирование"
        Icon="/Assets/OpenCRM.ico"
        Width="1160" Height="800" MinWidth="900" MinHeight="650"
        WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:EmailComposeViewModel}"><views:EmailComposeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:EmailCampaignsViewModel}"><views:EmailCampaignsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SmsHistoryViewModel}"><views:SmsHistoryView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SiteNotificationsViewModel}"><views:SiteNotificationsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:VehicleCatalogViewModel}"><views:VehicleCatalogView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CatalogSuggestionsViewModel}"><views:CatalogSuggestionsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:TestDataViewModel}"><views:TestDataView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:CrmImportViewModel}"><views:CrmImportView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AssistantViewModel}"><views:AssistantView /></DataTemplate>
  </Window.DataTemplates>
  <Grid>
    <views:LoginView IsVisible="{Binding !IsAuthenticated}" />
    <Grid IsVisible="{Binding IsAuthenticated}" ColumnDefinitions="244,*">
      <Border Background="#0E0E0E" BorderBrush="#262626" BorderThickness="0,0,1,0">
        <Grid RowDefinitions="Auto,*,Auto" Margin="16,24,16,18">
          <StackPanel Margin="14,0,0,24" Spacing="5">
            <TextBlock Text="Администрирование" FontSize="22" FontWeight="Bold" LetterSpacing="2" />
            <TextBlock Text="Панель управления сервисом" Classes="caption" />
          </StackPanel>
          <ScrollViewer Grid.Row="1" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Spacing="5">
              <Button Classes="navigation" Classes.active="{Binding IsProfileOpen}" Command="{Binding ShowProfileCommand}" AutomationProperties.AutomationId="ProfileNavigation">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Мой профиль" FontWeight="SemiBold" />
                  <TextBlock Grid.Column="1" Text="●" IsVisible="{Binding IsProfileOpen}" Foreground="#C5C5C5" FontSize="9" VerticalAlignment="Center" />
                </Grid>
              </Button>
              <TextBlock Text="РАЗДЕЛЫ" Classes="caption" Margin="14,20,0,8" LetterSpacing="1" />
              <Button Content="Дашборд" Classes="navigation" Classes.active="{Binding IsDashboardOpen}"
                      IsVisible="{Binding CanViewDashboard}" Command="{Binding ShowDashboardCommand}"
                      AutomationProperties.AutomationId="DashboardNavigation" />
              <Button Classes="navigation" Classes.active="{Binding IsUsersOpen}"
                      IsVisible="{Binding CanViewUsers}" Command="{Binding ShowUsersCommand}"
                      AutomationProperties.AutomationId="UsersNavigation">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Пользователи" />
                  <Border Grid.Column="1" IsVisible="{Binding HasTodayUsers}" Background="#36312A" CornerRadius="9"
                          MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Новых записей с последнего просмотра">
                    <TextBlock Text="{Binding TodayUsersCount}" Foreground="#F0C58B" FontSize="11" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button Content="Организации" Classes="navigation" Classes.active="{Binding IsOrganizationsOpen}"
                      IsVisible="{Binding CanViewOrganizations}" Command="{Binding ShowOrganizationsCommand}"
                      AutomationProperties.AutomationId="OrganizationsNavigation" />
              <Button Classes="navigation" Classes.active="{Binding IsBillingOpen}"
                      IsVisible="{Binding CanViewBilling}" Command="{Binding ShowBillingCommand}"
                      AutomationProperties.AutomationId="BillingNavigation">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Платежи и подписки" />
                  <Border Grid.Column="1" IsVisible="{Binding HasTodayBilling}" Background="#36312A" CornerRadius="9"
                          MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Оплаченных платежей без чека или с незавершённой обработкой">
                    <TextBlock Text="{Binding TodayBillingCount}" Foreground="#F0C58B" FontSize="11" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button Classes="navigation" Classes.active="{Binding IsSupportMessagesOpen}"
                      IsVisible="{Binding CanViewSupportMessages}" Command="{Binding ShowSupportMessagesCommand}"
                      AutomationProperties.AutomationId="SupportMessagesNavigation">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="Обращения" />
                  <Border Grid.Column="1" IsVisible="{Binding HasTodaySupportMessages}" Background="#36312A" CornerRadius="9"
                          MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Новых записей с последнего просмотра">
                    <TextBlock Text="{Binding TodaySupportMessagesCount}" Foreground="#F0C58B" FontSize="11" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button Classes="navigation" Classes.active="{Binding IsEmailHistoryOpen}"
                      IsVisible="{Binding CanViewEmailHistory}" Command="{Binding ShowEmailHistoryCommand}"
                      AutomationProperties.AutomationId="EmailHistoryNavigation">
                <Grid ColumnDefinitions="*,Auto">
                  <TextBlock Text="История email" />
                  <Border Grid.Column="1" IsVisible="{Binding HasTodayEmailHistory}" Background="#36312A" CornerRadius="9"
                          MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center" ToolTip.Tip="Новых записей с последнего просмотра">
                    <TextBlock Text="{Binding TodayEmailHistoryCount}" Foreground="#F0C58B" FontSize="11" HorizontalAlignment="Center" />
                  </Border>
                </Grid>
              </Button>
              <Button Content="Тарифы" Classes="navigation" Classes.active="{Binding IsSubscriptionPlansOpen}"
                      IsVisible="{Binding CanManageConfiguration}" Command="{Binding ShowSubscriptionPlansCommand}"
                      AutomationProperties.AutomationId="SubscriptionPlansNavigation" />
              <Button Content="Промокоды" Classes="navigation" Classes.active="{Binding IsPromoCodesOpen}"
                      IsVisible="{Binding CanManageConfiguration}" Command="{Binding ShowPromoCodesCommand}"
                      AutomationProperties.AutomationId="PromoCodesNavigation" />
              <Button Content="Роли и права" Classes="navigation" Classes.active="{Binding IsRolesOpen}"
                      IsVisible="{Binding CanViewRoles}" Command="{Binding ShowRolesCommand}"
                      AutomationProperties.AutomationId="RolesNavigation" />
              <ItemsControl ItemsSource="{Binding VisibleOperationSections}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:AdminOperationSection">
                    <Button Classes="navigation" Classes.active="{Binding IsSelected}"
                            Command="{Binding $parent[Window].((vm:MainWindowViewModel)DataContext).ShowOperationCommand}"
                            CommandParameter="{Binding}" HorizontalAlignment="Stretch">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" />
                        <Border Grid.Column="1" IsVisible="{Binding HasBadge}" Background="#36312A" CornerRadius="9"
                                MinWidth="22" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Center"
                                ToolTip.Tip="Предложений ожидает модерации">
                          <TextBlock Text="{Binding BadgeCount}" Foreground="#F0C58B" FontSize="11" HorizontalAlignment="Center" />
                        </Border>
                      </Grid>
                    </Button>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding NavigationItems}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:NavigationItem">
                    <Border IsVisible="{Binding IsPlaceholder}" Padding="14,11" Margin="0,2" ToolTip.Tip="Раздел будет перенесён на следующем этапе">
                      <Grid ColumnDefinitions="*,Auto">
                        <TextBlock Text="{Binding Title}" Foreground="#929292" />
                        <TextBlock Grid.Column="1" Text="позже" Foreground="#858585" FontSize="10" Margin="8,0,0,0" VerticalAlignment="Center" />
                      </Grid>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </StackPanel>
          </ScrollViewer>
          <StackPanel Grid.Row="2" Spacing="14">
            <Border BorderBrush="#292929" BorderThickness="0,1,0,0" Padding="10,18,10,0">
              <StackPanel Spacing="5">
                <TextBlock Text="{Binding ProfileEmail}" TextTrimming="CharacterEllipsis" />
                <TextBlock Text="{Binding AccessLabel}" Classes="caption" TextWrapping="Wrap" />
              </StackPanel>
            </Border>
            <Button Content="Выйти из аккаунта" Command="{Binding LogoutCommand}"
                    HorizontalAlignment="Stretch" AutomationProperties.AutomationId="LogoutButton" />
          </StackPanel>
        </Grid>
      </Border>
      <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*">
        <Border BorderBrush="#262626" BorderThickness="0,0,0,1" Padding="32,18">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding PageLabel}" Classes="muted" VerticalAlignment="Center" />
            <TextBlock Grid.Column="1" Text="{Binding ServerAddress}" Classes="caption" VerticalAlignment="Center" />
          </Grid>
        </Border>
        <Border Grid.Row="1" IsVisible="{Binding HasError}" Background="#261A1A" BorderBrush="#594040"
                BorderThickness="1" CornerRadius="8" Margin="32,20,32,0" Padding="16,12">
          <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" Foreground="#F4CACA" />
        </Border>
        <ScrollViewer Grid.Row="2" IsVisible="{Binding IsScrollablePageOpen}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28,32,32">
            <views:ProfileView IsVisible="{Binding IsProfileOpen}" />
            <Border IsVisible="{Binding IsDashboardOpen}">
              <views:DashboardView DataContext="{Binding Dashboard}" />
            </Border>
          </StackPanel>
        </ScrollViewer>
        <Border Grid.Row="2" IsVisible="{Binding IsUsersOpen}" Margin="32,24,32,24">
          <views:UsersView DataContext="{Binding Users}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsBillingOpen}" Margin="32,24,32,24">
          <views:BillingView DataContext="{Binding Billing}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsOrganizationsOpen}" Margin="32,24,32,24">
          <views:OrganizationsView DataContext="{Binding Organizations}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsSubscriptionPlansOpen}" Margin="32,24,32,24">
          <views:SubscriptionPlansView DataContext="{Binding SubscriptionPlans}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsPromoCodesOpen}" Margin="32,24,32,24">
          <views:PromoCodesView DataContext="{Binding PromoCodes}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsRolesOpen}" Margin="32,24,32,24">
          <views:RolesView DataContext="{Binding Roles}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsEmailHistoryOpen}" Margin="32,24,32,24">
          <views:EmailHistoryView DataContext="{Binding EmailHistory}" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsOperationsOpen}" Margin="32,24,32,24">
          <ContentControl Content="{Binding CurrentOperation}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
        </Border>
        <Border Grid.Row="2" IsVisible="{Binding IsSupportMessagesOpen}" Margin="32,24,32,24">
          <views:SupportMessagesView DataContext="{Binding SupportMessages}" />
        </Border>
      </Grid>
    </Grid>
    <ProgressBar IsVisible="{Binding IsBusy}" IsIndeterminate="True" Height="3"
                 VerticalAlignment="Top" Foreground="#BBBBBB" Background="Transparent" />
  </Grid>
</Window>
