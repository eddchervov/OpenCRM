<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationIcon>..\OpenCRM.Admin.Launcher\Assets\OpenCRM.ico</ApplicationIcon>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Avalonia.Controls.WebView" Version="12.1.1" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.4" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.4" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.4" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.2" />
    <ProjectReference Include="..\OpenCRM.Admin.Api\OpenCRM.Admin.Api.csproj" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="../../../Helpers/ProjectBrand.cs" Link="Shared/ProjectBrand.cs" />
    <None Include="../../../../configuration/brand.json" Link="brand.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
    <AvaloniaResource Include="..\OpenCRM.Admin.Launcher\Assets\OpenCRM.ico" Link="Assets\OpenCRM.ico" />
  </ItemGroup>
</Project>
