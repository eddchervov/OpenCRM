<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Border.configurationSection">
    <Setter Property="Background" Value="#121416" />
    <Setter Property="BorderBrush" Value="#292D32" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="12" />
    <Setter Property="Padding" Value="22" />
  </Style>
  <Style Selector="TextBlock.configurationHeading">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="#F3F5F7" />
    <Setter Property="TextWrapping" Value="Wrap" />
  </Style>
  <Style Selector="Button.configurationPrimary">
    <Setter Property="Background" Value="#294962" />
    <Setter Property="BorderBrush" Value="#416783" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="#F4F9FF" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Padding" Value="18,10" />
  </Style>
  <Style Selector="Button.configurationPrimary:pointerover /template/ ContentPresenter">
    <Setter Property="Background" Value="#365C7A" />
    <Setter Property="Foreground" Value="#FFFFFF" />
  </Style>
  <Style Selector="Button.configurationPrimary:disabled">
    <Setter Property="Opacity" Value="0.45" />
  </Style>
  <Style Selector="Border.configurationBadge">
    <Setter Property="Background" Value="#25282E" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="9,4" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.configurationBadge.active">
    <Setter Property="Background" Value="#18382D" />
  </Style>
  <Style Selector="Border.configurationBadge TextBlock">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="#BBC4CF" />
  </Style>
  <Style Selector="Border.configurationBadge.active TextBlock">
    <Setter Property="Foreground" Value="#9CDABB" />
  </Style>
</Styles>
