{
  "Notifications": {
    "Transport": "Disabled"
  },
  "EmailConfirmation": {
    "Required": false
  },
  "Support": {
    "NotificationEmail": ""
  },
  "EmailPreferences": {
    "UnsubscribeTokenSecret": ""
  },
  "RabbitMq": {
    "Host": "192.0.2.1",
    "Port": 5672,
    "VirtualHost": "/",
    "Username": "",
    "Password": "",
    "ApplicationId": "opencrm-development",
    "DispatchIntervalSeconds": 5,
    "ResponseTimeoutSeconds": 60,
    "SendTimeoutSeconds": 15
  },
  "ConnectionStrings": {
    "OpenCRMConnection": ""
  },
  "AppSettings": {},
  "PlatformPolicy": {
    "Commercial": {
      "Enabled": false
    }
  },
  "S3": {
    "ServiceUrl": "https://s3.regru.cloud",
    "AccessKey": "",
    "SecretKey": "",
    "BucketName": ""
  },
  "YooKassa": {
    "ShopId": "",
    "SecretKey": "",
    "TestMode": false
  },
  "IdentitySettings": {
    "User": {
      "RequireUniqueEmail": true,
      "AllowedUserNameCharacters": "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789-._@+"
    },
    "Password": {
      "RequireDigit": true,
      "RequiredLength": 8,
      "RequiredUniqueChars": 1,
      "RequireLowercase": false,
      "RequireNonAlphanumeric": false,
      "RequireUppercase": false
    },
    "SignIn": {
      "RequireConfirmedEmail": false,
      "RequireConfirmedAccount": false
    },
    "ClaimsIdentity": {
      "UserIdClaimType": "UserID"
    },
    "Lockout": {
      "AllowedForNewUsers": true,
      "MaxFailedAccessAttempts": 5,
      "DefaultLockoutTimeSpan": "00:15:00"
    }
  },
  "Security": {
    "AllowedCorsOrigins": [
      "https://opencrm.example.invalid",
      "https://opencrm.example.invalid"
    ]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Serilog": {
    "Using": [
      "Serilog.Sinks.File",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft": "Warning",
        "System": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "/app/logs/log-.txt",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7
        }
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://seq:5341",
          "restrictedToMinimumLevel": "Information"
        }
      }
    ],
    "Enrich": [
      "FromLogContext",
      "WithMachineName",
      "WithThreadId"
    ],
    "Properties": {
      "Application": "OpenCRM"
    }
  },
  "Seq": {
    "Url": "http://seq:5341"
  },
  "AllowedHosts": "opencrm.example.invalid;opencrm.example.invalid;localhost;127.0.0.1",
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:8081",
      "https://localhost:8081",
      "http://127.0.0.1:8081",
      "https://127.0.0.1:8081"
    ]
  },
  "DataProtection": {
    "KeysDirectory": "_tmp/keys"
  }
}
