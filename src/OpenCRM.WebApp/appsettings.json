{
  "Notifications": {
    "Transport": "Disabled"
  },
  "EmailConfirmation": {
    "Required": false
  },
  "VehicleRegistrationPlates": {
    "MaxLength": 16,
    "RegexTimeoutMilliseconds": 100,
    "MaxSearchVariants": 64,
    "LetterPattern": "[АВЕКМНОРСТУХ]",
    "CharacterMappings": {
      "A": "А",
      "B": "В",
      "C": "С",
      "E": "Е",
      "H": "Н",
      "K": "К",
      "M": "М",
      "O": "О",
      "P": "Р",
      "T": "Т",
      "X": "Х",
      "Y": "У"
    },
    "Formats": [
      {
        "Code": "car",
        "Kinds": [
          1,
          2
        ],
        "Masks": [
          "L###LL##",
          "L###LL###"
        ],
        "Pattern": "^[АВЕКМНОРСТУХ][0-9]{3}[АВЕКМНОРСТУХ]{2}[0-9]{2,3}$",
        "Example": "А123ВС154"
      },
      {
        "Code": "trailer",
        "Kinds": [
          10
        ],
        "Masks": [
          "LL######",
          "LL#######"
        ],
        "Pattern": "^[АВЕКМНОРСТУХ]{2}[0-9]{6,7}$",
        "Example": "АА1234154"
      },
      {
        "Code": "motorcycle-tractor",
        "Kinds": [
          3,
          4,
          5,
          6,
          9
        ],
        "Masks": [
          "####LL##",
          "####LL###"
        ],
        "Pattern": "^[0-9]{4}[АВЕКМНОРСТУХ]{2}[0-9]{2,3}$",
        "Example": "1234АА154"
      }
    ]
  },
  "Assistant": {
    "Enabled": false,
    "WebEnabled": true,
    "TelegramEnabled": false,
    "SpeechRepliesEnabled": false,
    "ProviderBaseUrl": "https://routerai.ru/api/v1/",
    "AllowedProviderHosts": [
      "routerai.ru"
    ],
    "TextModel": "qwen/qwen3.5-flash-02-23",
    "SpeechModel": "openai/whisper-large-v3-turbo",
    "SpeechRecognitionPrompt": "Речь сотрудника автосервиса или детейлинг-студии: запись, автомобиль, прицеп, госномер, регион, работы, стоимость. Госномер диктуют буквами и цифрами; важны исходные символы и их порядок.",
    "VoiceModel": "microsoft/mai-voice-2.1",
    "VoiceName": "ru-RU-Masha:MAI-Voice-2.1",
    "DailyBudgetRub": 0,
    "MonthlyBudgetRub": 0,
    "TextReservationRub": 2,
    "AudioReservationRub": 2,
    "MaximumOutputTokens": 2500,
    "MaximumOutputTokensAllowed": 8000,
    "ProviderTimeoutSeconds": 60,
    "ConcurrentRequestsPerUser": 2,
    "ConversationTtlMinutes": 30,
    "DraftTtlMinutes": 10,
    "ProcessingLeaseSeconds": 120,
    "MaximumUserTurns": 12,
    "MaximumHistoryCharacters": 12000,
    "MaximumHistoryMessages": 96,
    "MaximumMessageCharacters": 1000,
    "MaximumCommandCharacters": 4000,
    "MaximumResponseBytes": 131072,
    "MaximumAudioBytes": 8388608,
    "MaximumUploadRequestBytes": 9437184,
    "MaximumAudioDurationSeconds": 90,
    "MaximumWorkLines": 20,
    "MaximumClarificationChoices": 50,
    "MaximumCatalogCandidates": 20,
    "LookupPageSize": 100,
    "LookupLimit": 1000,
    "MaintenanceHistoryLimit": 100,
    "AvailabilityPollingSeconds": 30,
    "StaleReservationMinutes": 10,
    "HistoryRetentionDays": 7,
    "ConversationHistoryRetentionDays": 90,
    "MaximumUsagePeriodDays": 366,
    "CleanupIntervalSeconds": 60,
    "BudgetTimeZone": "UTC",
    "DefaultTimeZone": "Asia/Novosibirsk",
    "AllowedScenarioCodes": [
      "detailing",
      "service-station"
    ],
    "MaximumBudgetRub": 1000000,
    "MaximumReservationRub": 1000
  },
  "AssistantTelegram": {
    "ApiBaseUrl": "https://api.telegram.org/",
    "BotUsername": "",
    "BotLinkBaseUrl": "https://example.invalid/community",
    "MaximumChoicesPerPage": 8,
    "LinkTtlMinutes": 10,
    "CallbackTtlMinutes": 10,
    "PollingIntervalSeconds": 1,
    "LongPollingEnabled": false,
    "LongPollingTimeoutSeconds": 20,
    "LongPollingBatchSize": 20,
    "HttpTimeoutSeconds": 30,
    "MaximumPayloadBytes": 65536,
    "MaximumTextCharacters": 1000,
    "MaximumPendingPerUser": 30
