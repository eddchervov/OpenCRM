@{
    Layout = "/Views/Personal/_PersonalLayout.cshtml";
    ViewData["PersonalVehiclePage"] = true;
    var vehicleScenario = ViewData["VehicleScenario"] as OpenCRM.WebApp.Models.Vehicles.VehicleScenarioViewModel ?? new OpenCRM.WebApp.Models.Vehicles.VehicleScenarioViewModel();
    var vehicleId = ViewData["VehicleId"] as string ?? string.Empty;
    var organizationId = ViewData["VehicleOrganizationId"] as string ?? string.Empty;
    if (string.IsNullOrWhiteSpace(organizationId))
    {
        organizationId = Context.Request.Query["organizationId"].ToString();
    }
    var organizationName = ViewData["VehicleOrganizationName"] as string ?? string.Empty;
    var returnUrl = ViewData["VehicleJournalReturnUrl"] as string ?? string.Empty;
    var rootBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var rootBreadcrumbText = string.IsNullOrWhiteSpace(organizationId)
        ? vehicleScenario.BreadcrumbTitle
        : !string.IsNullOrWhiteSpace(organizationName)
            ? organizationName
            : "Организация";
    ViewData["Title"] = "Журнал техники";
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "vehicle-card-page-body";
    var workspaceSidebar = new OpenCRM.WebApp.Models.Organizations.OrganizationWorkspaceSidebarViewModel
    {
        OrganizationId = string.IsNullOrWhiteSpace(organizationId) ? Guid.Empty : Guid.Parse(organizationId),
        OrganizationName = organizationName,
        CurrentSection = "vehicle",
        HasVehiclesModule = ViewData["VehicleHasVehiclesModule"] is bool vehiclesModule && vehiclesModule,
        HasClientsModule = ViewData["VehicleHasClientsModule"] is bool clientsModule && clientsModule,
        HasDefectsModule = ViewData["VehicleHasDefectsModule"] is bool defectsModule && defectsModule,
        HasCountersModule = ViewData["VehicleHasCountersModule"] is bool countersModule && countersModule,
        HasSchedulerModule = ViewData["VehicleHasSchedulerModule"] is bool schedulerModule && schedulerModule,
        CanManageSettings = ViewData["VehicleCanManageSettings"] is bool canManageSettings && canManageSettings,
        MembersCount = ViewData["VehicleOrganizationMembersCount"] is int membersCount ? membersCount : 0
    };
}

<div id="vehicle-form">
    <style>
        [v-cloak] {
            display: none;
        }
    </style>

    <div v-cloak>
        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organizations-page")">
            <div class="@(string.IsNullOrWhiteSpace(organizationId) ? "container py-4" : "container-fluid px-4 px-xxl-5 organization-workspace-shell organization-workspace-shell-wide")">
                <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-flow")">
                    <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-layout")">
                        @if (!string.IsNullOrWhiteSpace(organizationId))
                        {
                            <aside class="organization-workspace-sidebar">
                                <partial name="/Views/Organizations/_WorkspaceSidebar.cshtml" model="workspaceSidebar" />
                            </aside>
                        }
                        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-content")">
                        <div class="vehicle-details-container">


                            <div class="card maintenance-history-card">
                                <div class="card-header">
                                    <div class="maintenance-history-heading">
                                        <h4 class="card-title mb-0">
                                            <i class="fa fa-book me-2"></i>
                                            Журнал техники
                                        </h4>
                                        <a :href="getVehicleUrl()" class="btn btn-outline-dark btn-sm">
                                            <i class="fa fa-arrow-left me-2"></i>
                                            К технике
                                        </a>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div class="text-center py-4" v-if="loading">
                                        <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
                                        <p class="mt-2 text-muted">Загружаем журнал техники...</p>
                                    </div>

                                    <div class="empty-state text-center py-4" v-else-if="events.length === 0">
                                        <i class="fa fa-book fa-3x mb-3 text-muted"></i>
                                        <h5>Журнал пока пуст</h5>
                                        <p class="text-muted mb-0">Здесь появятся изменения техники, обслуживаний, счетчика и неисправностей.</p>
                                    </div>

                                    <div class="vehicle-journal-list" v-else>
                                        <div class="vehicle-journal-item" v-for="event in events" :key="event.id">
                                            <div class="vehicle-journal-icon">
                                                <i class="fa" :class="getVehicleHistoryIcon(event)"></i>
                                            </div>
                                            <div class="vehicle-journal-body">
                                                <div class="vehicle-journal-head">
                                                    <strong>{{ event.title }}</strong>
                                                    <span class="text-muted small">{{ formatDate(event.createdAt) }}</span>
                                                </div>
                                                <div class="vehicle-journal-description" v-if="event.description">{{ event.description }}</div>
                                                <div class="vehicle-journal-meta">
                                                    <span v-if="event.actorDisplayName">Автор: {{ event.actorDisplayName }}</span>
                                                    <a v-if="event.relatedUrl" :href="event.relatedUrl">Открыть</a>
                                                </div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <a :href="getVehicleUrl()" class="btn btn-outline-dark">
                                    <i class="fa fa-arrow-left me-2"></i>
                                    Вернуться к технике
                                </a>
                                <a v-if="returnUrl" :href="returnUrl" class="btn btn-outline-secondary">
                                    Вернуться назад
                                </a>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    @if (!string.IsNullOrWhiteSpace(organizationId))
    {
        <environment include="Development">
            <link rel="stylesheet" href="~/css/organizations.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/vehicle-card.organization.css" asp-append-version="true" />
        </environment>
        <environment exclude="Development">
            <link rel="stylesheet" href="~/css/organizations.min.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/vehicle-card.organization.css" asp-append-version="true" />
        </environment>
    }
    else
    {
        <link rel="stylesheet" href="~/css/vehicle-card.personal.css" asp-append-version="true" />
    }
}

@section Scripts {
    <script>
        window.vehicleJournalPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            vehicleId,
            organizationId,
            returnUrl
        }));
    </script>
    <script src="~/app/vehicle-journal-page.js" asp-append-version="true"></script>
}

@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-4">
                                <ol class="breadcrumb mb-0">
                                    <li class="breadcrumb-item"><a href="@rootBreadcrumbUrl">@rootBreadcrumbText</a></li>
                                    <li class="breadcrumb-item"><a href="/vehicle/@vehicleId">@(ViewData["VehicleDisplayName"] as string ?? "Техника")</a></li>
                                    <li class="breadcrumb-item active" aria-current="page"><h1>Журнал</h1></li>
                                </ol>
                            </nav>
}
