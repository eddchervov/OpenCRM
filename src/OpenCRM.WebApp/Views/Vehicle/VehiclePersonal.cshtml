@inject Microsoft.Extensions.Configuration.IConfiguration PlatformConfiguration
@{
    var commercialEnabled = string.Equals(PlatformConfiguration["PlatformPolicy:Commercial:Enabled"], "true", StringComparison.OrdinalIgnoreCase);
}
@{
    Layout = "/Views/Personal/_PersonalLayout.cshtml";
    ViewData["PersonalVehiclePage"] = true;
    var vehicleScenario = ViewData["VehicleScenario"] as OpenCRM.WebApp.Models.Vehicles.VehicleScenarioViewModel ?? new OpenCRM.WebApp.Models.Vehicles.VehicleScenarioViewModel();
    var organizationId = ViewData["VehicleOrganizationId"] as string ?? string.Empty;
    if (string.IsNullOrWhiteSpace(organizationId))
    {
        organizationId = Context.Request.Query["organizationId"].ToString();
    }
    var organizationName = ViewData["VehicleOrganizationName"] as string ?? string.Empty;
    var vehicleIdForLink = ViewData["VehicleId"] as string ?? string.Empty;
    var organizationMembersCount = ViewData["VehicleOrganizationMembersCount"] is int membersCount ? membersCount : 0;
    var hasClientsModule = ViewData["VehicleHasClientsModule"] is bool clientsModule && clientsModule;
    var hasDefectsModule = ViewData["VehicleHasDefectsModule"] is bool defectsModule && defectsModule;
    var hasCountersModule = ViewData["VehicleHasCountersModule"] is bool countersModule && countersModule;
    var hasSchedulerModule = ViewData["VehicleHasSchedulerModule"] is bool schedulerModule && schedulerModule;
    var rootBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var rootBreadcrumbText = string.IsNullOrWhiteSpace(organizationId)
        ? vehicleScenario.BreadcrumbTitle
        : !string.IsNullOrWhiteSpace(organizationName)
            ? organizationName
            : "Техника организации";
    var nextStepTitle = ViewData["VehicleNextStepTitle"] as string ?? "Что сделать дальше";
    var nextStepText = ViewData["VehicleNextStepText"] as string ?? "Начните с базовых действий, чтобы карточка техники стала полезной историей.";
    var transferOrganizationsJson = ViewData["TransferOrganizationsJson"] as string ?? "[]";
    var nextActions = ViewData["VehicleNextActions"] as IEnumerable<dynamic> ?? new[]
    {
        new { Kind = "AddMaintenance", IconCssClass = "fa fa-wrench", Title = "Добавить обслуживание", Text = "Запишите замену масла, ремонт, расходники или другую работу." },
        new { Kind = "UploadPhoto", IconCssClass = "fa fa-camera", Title = "Добавить фото", Text = "Сохраните внешний вид техники или важные детали." },
        new { Kind = "EditVehicle", IconCssClass = "fa fa-pencil", Title = "Заполнить карточку", Text = "Уточните имя, номер, год выпуска и описание." }
    };
    ViewData["Title"] = vehicleScenario.DetailsTitle;
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "vehicle-card-page-body";
    var workspaceSidebar = new OpenCRM.WebApp.Models.Organizations.OrganizationWorkspaceSidebarViewModel
    {
        OrganizationId = string.IsNullOrWhiteSpace(organizationId) ? Guid.Empty : Guid.Parse(organizationId),
        OrganizationName = organizationName,
        CurrentSection = "vehicle",
        HasClientsModule = hasClientsModule,
        HasDefectsModule = hasDefectsModule,
        HasCountersModule = hasCountersModule,
        HasSchedulerModule = hasSchedulerModule,
        ClientsCount = null,
        MembersCount = organizationMembersCount
    };
}

<style>
    [v-cloak] {
        display: none;
    }
</style>

<div id="vehicle-form" v-cloak>
    <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organizations-page")">
        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "container-fluid px-4 px-xxl-5 organization-workspace-shell organization-workspace-shell-wide")">
            <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-layout")">
                @if (!string.IsNullOrWhiteSpace(organizationId))
                {
                    <aside class="organization-workspace-sidebar">
                        <partial name="/Views/Organizations/_WorkspaceSidebar.cshtml" model="workspaceSidebar" />
                    </aside>
                }
                <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-content")">
    <div class="vehicle-details-container">
            <!-- Хлебные крошки -->


            <div class="vehicle-details-card vehicle-details-card-primary personal-vehicle-summary mb-4">
                <div class="card-header">
                    <h3 class="card-title">
                        <i class="fa fa-car"></i>
                        @vehicleScenario.DetailsTitle
                    </h3>
                    @if (!string.IsNullOrWhiteSpace(organizationName))
                    {
                        <div class="text-muted small mt-2">
                            Рабочее пространство: @organizationName
                        </div>
                    }
                </div>
                <div class="card-body vehicle-details-card-body">
                    <div v-if="formLoad" class="d-flex align-items-center gap-2 text-muted mb-4">
                        <i class="fa fa-spinner fa-spin"></i>
                        <span>Загружаем данные техники...</span>
                    </div>
                    <div class="row">
                        <!-- Изображение техники -->
                        <div class="col-md-4 mb-4">
                            <div class="vehicle-details-image-container">
                                <template v-if="currentVehiclePhotoUrl">
                                    <div class="vehicle-details-photo-carousel">
                                        <img :src="currentVehiclePhotoUrl"
                                             class="vehicle-details-image vehicle-details-image-clickable"
                                             :alt="getVehicleDisplayName(vehicle)"
                                             @@click="openVehiclePhotoGallery" />
                                        <button v-if="hasMultipleVehiclePhotos"
                                                type="button"
                                                class="vehicle-photo-nav vehicle-photo-nav-prev"
                                                @@click.stop="showPreviousVehiclePhoto"
                                                title="Предыдущее фото">
                                            <i class="fa fa-chevron-left"></i>
                                        </button>
                                        <button v-if="hasMultipleVehiclePhotos"
                                                type="button"
                                                class="vehicle-photo-nav vehicle-photo-nav-next"
                                                @@click.stop="showNextVehiclePhoto"
                                                title="Следующее фото">
                                            <i class="fa fa-chevron-right"></i>
                                        </button>
                                        <div v-if="hasMultipleVehiclePhotos" class="vehicle-photo-counter">
                                            {{ currentVehiclePhotoIndex + 1 }} / {{ vehiclePhotos.length }}
                                        </div>
                                    </div>
                                    <div v-if="vehicle.isUploading" class="photo-upload-overlay">
                                        <i class="fa fa-spinner fa-spin"></i>
                                    </div>
                                </template>
                                <template v-else>
                                    <div class="vehicle-details-placeholder">
                                        <i class="fa fa-car fa-4x"></i>
                                        <p class="mb-0 mt-2" v-if="vehicle.photoLoadFailed">Не удалось загрузить фото</p>
                                        <p class="mb-0 mt-2" v-else>Нет фотографии</p>
                                    </div>
                                </template>

                                <div class="vehicle-details-image-actions mt-3">
                                    <a class="btn btn-outline-dark btn-sm"
                                       href="/vehicle/@vehicleIdForLink/photos@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : $"?organizationId={organizationId}")">
                                        <i class="fa fa-camera me-1"></i>
                                        Управление фото
                                    </a>
                                    <a class="btn btn-outline-dark btn-sm"
                                       href="/vehicle/@vehicleIdForLink/albums@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : $"?organizationId={organizationId}")">
                                        <i class="fa fa-folder-open me-1"></i>
                                        Альбомы
                                    </a>
                                </div>
                            </div>
                        </div>

                        <!-- Информация о технике -->
                        <div class="col-md-8">
                            <div class="vehicle-overview-grid mb-4">
                                <div class="vehicle-info-item compact">
                                    <label class="vehicle-details-label">Тип техники</label>
                                    <p class="vehicle-details-value">{{ getVehicleKindText(vehicle.kind) }}</p>
                                </div>

                                <div class="vehicle-info-item compact">
                                    <label class="vehicle-details-label">Марка и модель</label>
                                    <p class="vehicle-details-value">{{ vehicle.brandName || '—' }} {{ vehicle.modelName || '' }}</p>
                                </div>

                                <div class="vehicle-info-item compact">
                                    <label class="vehicle-details-label">Год выпуска</label>
                                    <p class="vehicle-details-value">{{ vehicle.yearIssue ? vehicle.yearIssue + ' г.' : '—' }}</p>
                                </div>

                                <div class="vehicle-info-item compact">
                                    <label class="vehicle-details-label">Имя / номер</label>
                                    <p class="vehicle-details-value" :class="{ empty: !vehicle.name }">
                                        {{ vehicle.name || 'Не указано' }}
                                    </p>
                                </div>

                                <div class="vehicle-info-item compact">
                                    <label class="vehicle-details-label">{{ vehicle.mileageUnit === 2 ? 'Моточасы' : 'Километры' }}</label>
                                    <p class="vehicle-details-value" :class="{ empty: vehicle.currentMileage === null || vehicle.currentMileage === undefined }">
                                        {{ vehicle.currentMileage !== null && vehicle.currentMileage !== undefined ? vehicle.currentMileage.toLocaleString() + ' ' + mileageUnitShortText : 'Не указано' }}
                                    </p>
                                </div>

                                <div class="vehicle-info-item compact" v-if="vehicle.organizationId">
                                    <label class="vehicle-details-label">Клиент</label>
                                    <p class="vehicle-details-value" :class="{ empty: !vehicle.organizationClientName }">
                                        <a v-if="vehicle.organizationClientId && vehicle.organizationClientName"
                                           class="text-decoration-none"
                                           href="/organizations">
                                            {{ vehicle.organizationClientName }}
                                        </a>
                                        <span v-else>Не привязан</span>
                                    </p>
                                </div>
                            </div>

                            <div class="vehicle-info-item vehicle-info-item-description" v-if="vehicle.description">
                                <label class="vehicle-details-label">Описание</label>
                                <p class="vehicle-details-value" :class="{ empty: !vehicle.description }">
                                    {{ vehicle.description || 'Описание отсутствует' }}
                                </p>
                            </div>

                            <div class="vehicle-identity-block mt-4">
                                <h4 class="vehicle-identity-title">Реквизиты техники</h4>
                                <dl class="vehicle-identity-list">
                                    <div class="vehicle-identity-row">
                                        <dt>VIN</dt>
                                        <dd :class="{ empty: !vehicle.vin }">{{ vehicle.vin || 'Не указано' }}</dd>
                                    </div>
                                    <div class="vehicle-identity-row">
                                        <dt>Госномер</dt>
                                        <dd :class="{ empty: !vehicle.registrationPlate }">{{ vehicle.registrationPlate || 'Не указано' }}</dd>
                                    </div>
                                    <div class="vehicle-identity-row" v-if="vehicle.bodyNumber">
                                        <dt>Номер кузова</dt>
                                        <dd :class="{ empty: !vehicle.bodyNumber }">{{ vehicle.bodyNumber || 'Не указано' }}</dd>
                                    </div>
                                    <div class="vehicle-identity-row" v-if="vehicle.engineNumber">
                                        <dt>Номер двигателя</dt>
                                        <dd :class="{ empty: !vehicle.engineNumber }">{{ vehicle.engineNumber || 'Не указано' }}</dd>
                                    </div>
                                    <div class="vehicle-identity-row" v-if="vehicle.color">
                                        <dt>Цвет</dt>
                                        <dd :class="{ empty: !vehicle.color }">{{ vehicle.color || 'Не указано' }}</dd>
                                    </div>
                                    <div class="vehicle-identity-row" v-if="vehicle.registrationCertificate">
                                        <dt>СТС</dt>
                                        <dd :class="{ empty: !vehicle.registrationCertificate }">{{ vehicle.registrationCertificate || 'Не указано' }}</dd>
                                    </div>
                                    <div class="vehicle-identity-row" v-if="vehicle.commissioningDate">
                                        <dt>Дата ввода в эксплуатацию</dt>
                                        <dd :class="{ empty: !vehicle.commissioningDate }">{{ vehicle.commissioningDate ? formatDate(vehicle.commissioningDate) : 'Не указано' }}</dd>
                                    </div>
                                </dl>
                            </div>

                            <div class="vehicle-actions-container mt-4">
                                <div class="d-flex flex-column flex-sm-row gap-2">
                                    <button class="btn btn-edit-vehicle py-2 flex-fill" @@click="openEditVehicleModal">
                                        <i class="fa fa-pencil me-2"></i>
                                        Редактировать
                                    </button>
                                    <a :href="getMaintenanceCreateUrl()" class="btn btn-dark py-2 flex-fill">
                                        <i class="fa fa-plus me-2"></i>
                                        Добавить обслуживание
                                    </a>
                                    @if (!string.IsNullOrWhiteSpace(organizationId) && hasCountersModule)
                                    {
                                        <a class="btn btn-outline-dark py-2 flex-fill"
                                           href="/organizations">
                                            <i class="fa fa-tachometer me-2"></i>
                                            Пробег и наработка
                                        </a>
                                    }
                                    else
                                    {
                                        <button class="btn btn-outline-dark py-2 flex-fill" @@click="openPersonalCounterModal">
                                            <i class="fa fa-tachometer me-2"></i>
                                            {{ personalCounterButtonText }}
                                        </button>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(organizationId) && hasDefectsModule)
                                    {
                                        <a class="btn btn-outline-dark py-2 flex-fill"
                                           href="/organizations">
                                            <i class="fa fa-exclamation-triangle me-2"></i>
                                            Неисправности
                                        </a>
                                    }
                                    <button v-if="canTransferCurrentVehicle"
                                            class="btn btn-outline-primary py-2 flex-fill"
                                            @@click="openTransferVehicleModal">
                                        <i class="fa fa-share me-2"></i>
                                        В организацию
                                    </button>
                                    <button class="btn btn-outline-danger py-2 flex-fill" @@click="openDeleteVehicleModal">
                                        <i class="fa fa-trash me-2"></i>
                                        Удалить
                                    </button>
                                </div>
                            </div>
                            <div class="pt-3">
                                <div class="vehicle-export-panel">
                                    <h6 class="mb-3">
                                        <i class="fa fa-download me-1"></i>
                                        Экспорт отчетов
                                    </h6>
                                    <div v-if="!exportAccess.loaded" class="text-muted small mb-3">
                                        Проверяем доступные форматы...
                                    </div>
                                    <div v-else-if="!hasAnyExportAccess" class="alert alert-warning mb-3">
                                        Экспорт отчётов недоступен для этой техники.
                                    </div>
                                    <div v-else-if="!hasMaintenanceRecordsForExport" class="alert alert-info mb-3">
                                        Экспорт станет доступен после добавления хотя бы одной записи обслуживания.
                                    </div>

                                    <div class="dropdown" v-else>
                                        <button class="btn btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                                            <i class="fa fa-download me-2"></i>
                                            Выбрать формат
                                        </button>
                                        <ul class="dropdown-menu">
                                            <li class="dropdown-header" v-if="exportAccess.pdf || exportAccess.pdfWithPhotos || exportAccess.word || exportAccess.wordWithPhotos">@(commercialEnabled ? "Входит в тариф" : "Доступные форматы")</li>
                                            <li v-if="exportAccess.pdfWithPhotos">
                                                <button type="button" class="dropdown-item" @@click="generateVehiclePdf(true)">
                                                    <i class="fa fa-file-pdf-o text-danger me-2"></i>PDF с фотографиями
                                                </button>
                                            </li>
                                            <li v-if="exportAccess.pdf">
                                                <button type="button" class="dropdown-item" @@click="generateVehiclePdf(false)">
                                                    <i class="fa fa-file-pdf-o text-danger me-2"></i>PDF без фотографий
                                                </button>
                                            </li>
                                            <li v-if="exportAccess.wordWithPhotos">
                                                <button type="button" class="dropdown-item" @@click="generateVehicleWord(true)">
                                                    <i class="fa fa-file-word-o text-primary me-2"></i>Word с фотографиями
                                                </button>
                                            </li>
                                            <li v-if="exportAccess.word">
                                                <button type="button" class="dropdown-item" @@click="generateVehicleWord(false)">
                                                    <i class="fa fa-file-word-o text-primary me-2"></i>Word без фотографий
                                                </button>
                                            </li>

                                            <li v-if="(exportAccess.pdf || exportAccess.pdfWithPhotos || exportAccess.word || exportAccess.wordWithPhotos) && (!exportAccess.pdf || !exportAccess.pdfWithPhotos || !exportAccess.word || !exportAccess.wordWithPhotos)">
                                                <hr class="dropdown-divider">
                                            </li>

                                            <li class="dropdown-header text-muted" v-if="!exportAccess.pdf || !exportAccess.pdfWithPhotos || !exportAccess.word || !exportAccess.wordWithPhotos">@(commercialEnabled ? "Не входит в тариф" : "Недоступные форматы")</li>
                                            <li v-if="!exportAccess.pdfWithPhotos">
                                                <button type="button" class="dropdown-item disabled" disabled>
                                                    <i class="fa fa-file-pdf-o me-2"></i>PDF с фотографиями
                                                </button>
                                            </li>
                                            <li v-if="!exportAccess.pdf">
                                                <button type="button" class="dropdown-item disabled" disabled>
                                                    <i class="fa fa-file-pdf-o me-2"></i>PDF без фотографий
                                                </button>
                                            </li>
                                            <li v-if="!exportAccess.wordWithPhotos">
                                                <button type="button" class="dropdown-item disabled" disabled>
                                                    <i class="fa fa-file-word-o me-2"></i>Word с фотографиями
                                                </button>
                                            </li>
                                            <li v-if="!exportAccess.word">
                                                <button type="button" class="dropdown-item disabled" disabled>
                                                    <i class="fa fa-file-word-o me-2"></i>Word без фотографий
                                                </button>
                                            </li>
                                        </ul>
                                    </div>
                                </div>
                            </div>

                        </div>
                    </div>
                </div>
            </div>

            <div class="vehicle-albums-preview-section mt-4">
                <div class="card maintenance-history-card vehicle-albums-preview-card">
                    <div class="card-header">
                        <div class="maintenance-history-heading">
                            <h4 class="card-title mb-0">
                                <i class="fa fa-folder-open me-2"></i>
                                Альбомы
                            </h4>
                            <a class="btn btn-outline-dark btn-sm"
                               href="/vehicle/@vehicleIdForLink/albums@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : $"?organizationId={organizationId}")">
                                <i class="fa fa-th me-2"></i>
                                Показать все
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div v-if="albumsPreviewLoading" class="text-muted">
                            <i class="fa fa-spinner fa-spin me-2"></i>
                            Загружаем альбомы...
                        </div>
                        <div v-else-if="albumPreview.length === 0" class="vehicle-albums-preview-empty">
                            <i class="fa fa-folder-o"></i>
                            <div>
                                <strong>Альбомов пока нет</strong>
                                <p class="mb-0">Создайте альбомы для фото работ, состояния техники или истории проекта.</p>
                            </div>
                            <a class="btn btn-dark btn-sm"
                               href="/vehicle/@vehicleIdForLink/albums@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : $"?organizationId={organizationId}")">
                                <i class="fa fa-plus me-2"></i>
                                Создать альбом
                            </a>
                        </div>
                        <div v-else class="vehicle-albums-preview-grid">
                            <a class="vehicle-albums-preview-item"
                               v-for="album in albumPreview"
                               :key="album.albumId"
                               :href="getAlbumUrl(album)">
                                <div class="vehicle-albums-preview-cover">
                                    <img v-if="getAlbumCover(album)" :src="getAlbumCover(album)" :alt="album.title">
                                    <i v-else class="fa fa-folder-open"></i>
                                </div>
                                <div class="vehicle-albums-preview-title">{{ album.title }}</div>
                                <div class="vehicle-albums-preview-meta">{{ album.photoCount }} фото</div>
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="maintenance-analytics-section mt-4">
                <div class="card maintenance-analytics-card">
                    <div class="card-header">
                        <div class="maintenance-history-heading">
                            <h4 class="card-title mb-0">
                                <i class="fa fa-line-chart me-2"></i>
                                Пробег и история обслуживания
                            </h4>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="text-center py-4" v-if="!maintenanceAnalyticsLoaded || !counterHistoryLoaded">
                            <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
                            <p class="mt-2 text-muted">Подготавливаем график...</p>
                        </div>

                        <div class="empty-state text-center py-4" v-else-if="!hasVehicleTimelineData">
                            <i class="fa fa-line-chart fa-3x mb-3 text-muted"></i>
                            <h5>Пока нет данных для графика</h5>
                            <p class="text-muted mb-0">Добавьте пробег, наработку или обслуживание с указанным значением.</p>
                        </div>

                        <template v-else>
                            <div class="vehicle-timeline-legend mb-3">
                                <span class="vehicle-timeline-legend-item">
                                    <span class="vehicle-timeline-legend-dot vehicle-timeline-legend-dot-counter"></span>
                                    {{ vehicle.mileageUnit === 2 ? 'Наработка' : 'Пробег' }}
                                </span>
                                <span class="vehicle-timeline-legend-item">
                                    <span class="vehicle-timeline-legend-dot vehicle-timeline-legend-dot-maintenance"></span>
                                    Обслуживание
                                </span>
                            </div>

                            <div class="vehicle-timeline-chart-wrap">
                                <svg viewBox="0 0 780 320"
                                     preserveAspectRatio="xMidYMid meet"
                                     role="img"
                                     aria-label="График пробега, наработки и обслуживаний">
                                    <line x1="56" y1="24" x2="56" y2="276" class="vehicle-timeline-axis"></line>
                                    <line x1="56" y1="276" x2="740" y2="276" class="vehicle-timeline-axis"></line>

                                    <g v-for="line in vehicleTimelineGridLines" :key="'grid-' + line.value">
                                        <line x1="56" :y1="line.y" x2="740" :y2="line.y" class="vehicle-timeline-grid"></line>
                                        <text x="48" :y="line.y + 4" class="vehicle-timeline-y-label">{{ line.label }}</text>
                                    </g>

                                    <polyline v-if="vehicleTimelinePoints.length > 1"
                                              :points="vehicleTimelinePolyline"
                                              class="vehicle-timeline-line"></polyline>

                                    <g v-for="point in vehicleTimelineLabelPoints" :key="'label-' + point.id">
                                        <text :x="point.x" y="300" class="vehicle-timeline-x-label">{{ point.shortDate }}</text>
                                    </g>

                                    <g v-for="point in vehicleTimelinePoints" :key="point.id">
                                        <circle :cx="point.x"
                                                :cy="point.y"
                                                r="5"
                                                :class="['vehicle-timeline-point', point.colorClass]"
                                                data-ui-tooltip="true"
                                                data-bs-placement="top"
                                                :data-bs-title="point.tooltip"></circle>
                                    </g>
                                </svg>
                            </div>
                        </template>
                    </div>
                </div>
            </div>

            <div class="vehicle-journal-section mt-4">
                <div class="card maintenance-history-card">
                    <div class="card-header">
                        <div class="maintenance-history-heading">
                            <h4 class="card-title mb-0">
                                <i class="fa fa-book me-2"></i>
                                Журнал техники
                            </h4>
                            <a :href="getVehicleJournalUrl()" class="btn btn-outline-dark btn-sm">
                                <i class="fa fa-external-link me-2"></i>
                                Открыть
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- История обслуживания -->
            <div class="maintenance-history-section mt-4">
                <div class="card maintenance-history-card">
                    <div class="card-header">
                        <div class="maintenance-history-heading">
                            <h4 class="card-title mb-0">
                                <i class="fa fa-history me-2"></i>
                                История обслуживания
                                <span class="maintenance-count-badge badge bg-orange">{{ showDeletedMaintenance ? deletedMaintenanceTotalCount : maintenanceTotalCount }}</span>
                            </h4>
                            <a :href="getMaintenanceCreateUrl()" class="btn btn-dark btn-sm">
                                <i class="fa fa-plus me-2"></i>
                                Добавить обслуживание
                            </a>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="maintenance-deleted-mode" v-if="initialMaintenanceLoaded || maintenanceHistory.length > 0 || deletedMaintenanceTotalCount > 0">
                            <div class="form-check">
                                <input class="form-check-input" type="checkbox" id="showDeletedMaintenance"
                                       v-model="showDeletedMaintenance"
                                       @@change="toggleDeletedMaintenance">
                                <label class="form-check-label" for="showDeletedMaintenance">
                                    Показывать только удаленные
                                    <span v-if="deletedMaintenanceTotalCount">({{ deletedMaintenanceTotalCount }})</span>
                                </label>
                            </div>
                        </div>

                        <div class="maintenance-history-controls" v-if="!showDeletedMaintenance && (initialMaintenanceLoaded || maintenanceHistory.length > 0)">
                            <div class="maintenance-history-control">
                                <label class="form-label">Сортировка</label>
                                <select class="form-select" v-model="maintenanceFilters.sort" @@change="changeMaintenanceFilters">
                                    <option v-for="option in maintenanceSortOptions" :key="option.value" :value="option.value">
                                        {{ option.text }}
                                    </option>
                                </select>
                            </div>
                            <div class="maintenance-history-control">
                                <label class="form-label">Тип обслуживания</label>
                                <select class="form-select" v-model="maintenanceFilters.type" @@change="changeMaintenanceFilters">
                                    <option v-for="option in maintenanceTypeFilterOptions" :key="option.value" :value="option.value">
                                        {{ option.text }}
                                    </option>
                                </select>
                            </div>
                            <div class="maintenance-history-control">
                                <label class="form-label">Состояние</label>
                                <select class="form-select" v-model="maintenanceFilters.status" @@change="changeMaintenanceFilters">
                                    <option v-for="option in maintenanceStatusFilterOptions" :key="option.value" :value="option.value">
                                        {{ option.text }}
                                    </option>
                                </select>
                            </div>
                            <button type="button" class="btn btn-outline-dark maintenance-filter-reset"
                                    v-if="hasMaintenanceFilters"
                                    @@click="resetMaintenanceFilters">
                                Сбросить
                            </button>
                        </div>

                        <div class="empty-state text-center py-4" v-if="initialMaintenanceLoaded && !showDeletedMaintenance && displayedMaintenanceHistory.length === 0 && !pagination.isLoading && !hasMaintenanceFilters">
                            <i class="fa fa-wrench fa-3x mb-3 text-muted"></i>
                            <h5>Нет записей обслуживания</h5>
                            <p class="text-muted">Добавьте первое обслуживание для этой техники</p>
                        </div>

                        <div class="empty-state text-center py-4" v-if="initialMaintenanceLoaded && !showDeletedMaintenance && displayedMaintenanceHistory.length === 0 && !pagination.isLoading && hasMaintenanceFilters">
                            <i class="fa fa-filter fa-3x mb-3 text-muted"></i>
                            <h5>Ничего не найдено</h5>
                            <p class="text-muted">Попробуйте изменить сортировку или сбросить фильтр по типу обслуживания</p>
                            <button type="button" class="btn btn-outline-dark" @@click="resetMaintenanceFilters">Сбросить фильтры</button>
                        </div>

                        <div class="empty-state text-center py-4" v-if="initialMaintenanceLoaded && showDeletedMaintenance && displayedMaintenanceHistory.length === 0 && !deletedMaintenanceLoading">
                            <i class="fa fa-trash fa-3x mb-3 text-muted"></i>
                            <h5>Удаленных обслуживаний нет</h5>
                            <p class="text-muted">Здесь появятся обслуживания, удаленные из карточки техники.</p>
                        </div>

                        <div class="text-center py-4" v-if="!initialMaintenanceLoaded">
                            <i class="fa fa-spinner fa-spin fa-2x text-muted"></i>
                            <p class="mt-2 text-muted">Загрузка истории обслуживания...</p>
                        </div>

                        <div v-if="showDeletedMaintenance && deletedPagination.isLoading && displayedMaintenanceHistory.length === 0" class="text-muted small mb-3">
                                <i class="fa fa-spinner fa-spin me-1"></i>
                                Загружаем удаленные...
                        </div>

                        <div class="maintenance-list" v-if="displayedMaintenanceHistory.length > 0">
                            <div class="maintenance-item" v-for="(maintenance, index) in displayedMaintenanceHistory" :key="maintenance.id">
                                <div class="maintenance-header" @@click="toggleMaintenance(index)">
                                    <div class="maintenance-type-badge">
                                        <span class="badge" :class="getMaintenanceTypeClass(maintenance.type)">
                                            {{ getMaintenanceTypeText(maintenance.type) }}
                                        </span>
                                        <span class="badge ms-2" :class="getMaintenanceStatusClass(maintenance)">
                                            {{ getMaintenanceStatusDisplayText(maintenance) }}
                                        </span>
                                        <span class="badge text-bg-danger ms-2" v-if="isMaintenanceOverdue(maintenance)">Просрочено</span>
                                        <span class="badge text-bg-light border ms-2" v-if="maintenance.isDeleted">Удалено</span>
                                    </div>

                                    <div class="maintenance-info">
                                        <div class="maintenance-date">
                                            <i class="fa fa-calendar me-1"></i>
                                            {{ getMaintenancePrimaryDateLabel(maintenance) }}: {{ getMaintenancePrimaryDateValue(maintenance) }}
                                        </div>
                                        <div class="maintenance-mileage" v-if="maintenance.mileage">
                                            <i class="fa fa-tachometer me-1"></i>
                                            {{ maintenance.mileage.toLocaleString() }} {{ mileageUnitShortText }}
                                        </div>
                                        <div class="maintenance-location" v-if="maintenance.location">
                                            <i class="fa fa-map-marker me-1"></i>
                                            {{ maintenance.location }}
                                        </div>
                                        <div class="maintenance-location" v-if="maintenance.performer">
                                            <i class="fa fa-user me-1"></i>
                                            {{ maintenance.performer }}
                                        </div>
                                    </div>

                                    <div class="maintenance-price" v-if="maintenance.price">
                                        <span class="price-amount">{{ formatPrice(maintenance.price) }}</span>
                                    </div>

                                    <div class="maintenance-actions-header ms-2" @@click.stop>
                                        <a v-if="!maintenance.isDeleted" class="btn btn-sm btn-dark px-3" :href="getMaintenanceDetailsUrl(maintenance)">
                                            <i class="fa fa-info-circle me-1"></i>
                                            Подробнее
                                        </a>
                                    </div>

                                    <div class="maintenance-arrow">
                                        <i class="fa" :class="expandedMaintenance === index ? 'fa-chevron-up' : 'fa-chevron-down'"></i>
                                    </div>
                                </div>

                                <div class="maintenance-details" v-if="expandedMaintenance === index">

                                    <div class="maintenance-comment mb-3">
                                        <strong>Состояние:</strong>
                                        <span class="badge ms-2" :class="getMaintenanceStatusClass(maintenance)">
                                            {{ getMaintenanceStatusDisplayText(maintenance) }}
                                        </span>
                                        <span class="badge text-bg-danger ms-2" v-if="isMaintenanceOverdue(maintenance)">Просрочено</span>
                                        <span class="badge text-bg-light border ms-2" v-if="maintenance.isDeleted">Удалено</span>
                                    </div>

                                    <div class="maintenance-comment" v-if="maintenance.plannedDate">
                                        <strong>Плановая дата:</strong>
                                        <p class="mb-0">{{ formatDate(maintenance.plannedDate) }}</p>
                                    </div>

                                    <div class="maintenance-comment" v-if="maintenance.completedDate">
                                        <strong>Дата выполнения:</strong>
                                        <p class="mb-0">{{ formatDate(maintenance.completedDate) }}</p>
                                    </div>

                                    <div class="maintenance-comment" v-if="maintenance.performer">
                                        <strong>Исполнитель:</strong>
                                        <p class="mb-0">{{ maintenance.performer }}</p>
                                    </div>

                                    <div class="maintenance-services" v-if="maintenance.maintenanceDetails && maintenance.maintenanceDetails.length > 0">
                                        <strong>Услуги и работы:</strong>
                                        <ul class="service-list">
                                            <li v-for="detail in maintenance.maintenanceDetails" :key="detail.id">
                                                {{ detail.name }}
                                                <span v-if="detail.price" class="service-price">
                                                    {{ formatPrice(detail.price) }}
                                                </span>
                                            </li>
                                        </ul>
                                    </div>

                                    <div class="maintenance-comment" v-if="maintenance.comment">
                                        <strong>Комментарий:</strong>
                                        <p class="mb-0">{{ maintenance.comment }}</p>
                                    </div>

                                    @*   <template v-if="vehicle.photoUrl">
                                        <img :src="vehicle.photoUrl" class="car-image" />
                                        <div v-if="vehicle.isUploading" class="photo-upload-overlay">
                                            <i class="fa fa-spinner fa-spin"></i>
                                        </div>
                                    </template> *@

                                    <div class="maintenance-photos" v-if="(maintenance.photoUrls && maintenance.photoUrls.length > 0) || maintenance.failedPhotoCount > 0">
                                        <strong>Фотографии:</strong>
                                        <div class="photo-thumbnails">
                                            <img v-for="(photoUrl, photoIndex) in maintenance.photoUrls"
                                                 :key="photoIndex"
                                                 :src="photoUrl"
                                                 class="photo-thumbnail"
                                                 @@click="openPhotoGallery(maintenance.photoUrls, photoIndex)">
                                            <div v-for="failedIndex in maintenance.failedPhotoCount"
                                                 :key="'failed-photo-' + failedIndex"
                                                 class="photo-thumbnail d-flex flex-column align-items-center justify-content-center text-center bg-light text-muted p-2"
                                                 style="cursor: default;">
                                                <i class="fa fa-image mb-1"></i>
                                                <small>Не удалось загрузить фото</small>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="maintenance-actions mt-3" v-if="!maintenance.isDeleted">
                                    <a :href="getMaintenanceUpdateUrl(maintenance)" class="btn btn-sm btn btn-outline-dark me-2">
                                            <i class="fa fa-edit me-1"></i>
                                            Редактировать
                                        </a>
                                        <button class="btn btn-sm btn-outline-danger" @@click="deleteMaintenance(maintenance)">
                                            <i class="fa fa-trash me-1"></i>
                                            Удалить
                                        </button>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <div class="text-center mt-4" v-if="maintenanceLoadMoreVisible">
                            <button class="btn btn-outline-dark btn-load-more"
                                    @@click="loadMoreMaintenance"
                                    :disabled="maintenanceListLoading">
                                <template v-if="maintenanceListLoading">
                                    <i class="fa fa-spinner fa-spin me-2"></i>
                                    Загрузка...
                                </template>
                                <template v-else>
                                    <i class="fa fa-arrow-down me-2"></i>
                                    Загрузить еще
                                </template>
                            </button>
                        </div>

                    </div>
                </div>
            </div>

        </div>

        <!-- Модальное окно редактирования -->
        <div class="modal fade" id="editVehicleModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-pencil me-2"></i>
                            Редактирование техники
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label">Тип техники</label>
                                <select class="form-select" v-model.number="vehicle.kind" @@change="changeVehicleKind">
                                    <option v-for="option in vehicleKindOptions" :key="option.value" :value="option.value">
                                        {{ option.text }}
                                    </option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label">Учет пробега / наработки</label>
                                <select class="form-select" v-model.number="vehicle.mileageUnit" @@change="changeMileageUnit">
                                    <option v-for="option in mileageUnitOptions" :key="option.value" :value="option.value">
                                        {{ option.text }}
                                    </option>
                                </select>
                                <small class="text-muted d-block mt-1">
                                    В обслуживании поле будет автоматически подписано как километры или моточасы.
                                </small>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <div class="btn-group w-100" role="group" aria-label="Способ заполнения техники" v-if="catalogModeAvailable">
                                    <button type="button"
                                            class="btn"
                                            :class="!isManualIdentity ? 'btn-dark' : 'btn-outline-dark'"
                                            @@click="toggleIdentityMode(false)">
                                        Из справочника
                                    </button>
                                    <button type="button"
                                            class="btn"
                                            :class="isManualIdentity ? 'btn-dark' : 'btn-outline-dark'"
                                            @@click="toggleIdentityMode(true)">
                                        Ввести вручную
                                    </button>
                                </div>
                                <button type="button" class="btn btn-dark w-100" v-else disabled>
                                    Ручной режим
                                </button>
                            </div>
                        </div>

                        <template v-if="!isManualIdentity">
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="form-label">Марка</label>
                                    <v-select :options="brands"
                                              :reduce="brand => brand.id"
                                              label="name"
                                              :clearable="false"
                                              @@input="getModelOptions(null)"
                                              v-model="selectedBrandId">
                                        <template slot="no-options">
                                            Не найдено марок
                                        </template>
                                    </v-select>
                                </div>
                            </div>

                            <div class="row mb-3" v-if="selectedBrandId">
                                <div class="col-12">
                                    <label class="form-label">Модель</label>
                                    <template v-if="loadModels">
                                        <div class="text-center">
                                            <i class="fa fa-spinner fa-spin fa-fw c-blue"></i>
                                            <span>Загрузка моделей...</span>
                                        </div>
                                    </template>
                                    <template v-else>
                                        <v-select :options="models"
                                                  :reduce="m => m.id"
                                                  label="name"
                                                  :clearable="false"
                                                  v-model="vehicle.modelId">
                                            <template slot="no-options">
                                                Не найдено моделей
                                            </template>
                                        </v-select>
                                    </template>
                                </div>
                            </div>
                        </template>

                        <template v-else>
                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="form-label">Бренд / производитель</label>
                                    <input type="text"
                                           class="form-control"
                                           v-model.trim="vehicle.manualBrandName"
                                           placeholder="Например: Yamaha, Polaris, КамАЗ">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-12">
                                    <label class="form-label">Модель</label>
                                    <input type="text"
                                           class="form-control"
                                           v-model.trim="vehicle.manualModelName"
                                           placeholder="Например: Grizzly 700, Ranger XP 1000, 65115">
                                </div>
                            </div>

                            <div class="row mb-3">
                                <div class="col-12">
                                    <small class="text-muted d-block">
                                        Бренд / производитель и модель будут автоматически добавлены в справочники после одобрения модератором.
                                    </small>
                                </div>
                            </div>
                        </template>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label">Год выпуска</label>
                                <input type="number"
                                       class="form-control"
                                       v-model.number="vehicle.yearIssue"
                                       @@input="changeYearIssue"
                                       min="1900"
                                       :max="new Date().getFullYear()"
                                       placeholder="Укажите год выпуска">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label">Имя/Номер техники</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.name"
                                       placeholder="Например: 'Рабочий квадроцикл' или 'A123BC'">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label">VIN</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.vin"
                                       maxlength="32"
                                       placeholder="Например: XTA210990Y1234567">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Госномер</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.registrationPlate"
                           v-registration-plate="vehicle"
                                       maxlength="24"
                                       placeholder="Например: A123BC154">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label">Номер кузова</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.bodyNumber"
                                       maxlength="64"
                                       placeholder="Если нужен отдельный номер кузова или рамы">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Номер двигателя</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.engineNumber"
                                       maxlength="64"
                                       placeholder="Если нужно хранить номер двигателя">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6 mb-3 mb-md-0">
                                <label class="form-label">Цвет</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.color"
                                       maxlength="32"
                                       placeholder="Например: Белый">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">СТС</label>
                                <input type="text"
                                       class="form-control"
                                       v-model.trim="vehicle.registrationCertificate"
                                       maxlength="64"
                                       placeholder="Например: 99 ХХ 123456">
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label class="form-label">Дата ввода в эксплуатацию</label>
                                <vue-ctk-date-time-picker class="vehicle-counter-date-picker"
                                                          v-model="vehicle.commissioningDate"
                                                          :range="false"
                                                          format="DD.MM.YYYY"
                                                          formatted="YYYY-MM-DD"
                                                          output-format="YYYY-MM-DD"
                                                          only-date="true"
                                                          locale="ru"
                                                          first-day-of-week="1"
                                                          :auto-close="true"
                                                          :no-button-now="true"
                                                          :no-shortcuts="true"
                                                          :no-header="false"
                                                          :no-label="true"
                                                          color="#e67337"
                                                          button-color="#121212">
                                </vue-ctk-date-time-picker>
                            </div>
                        </div>

                        <div class="row mb-3" v-if="vehicle.organizationId && organizationClientsEnabled">
                            <div class="col-12">
                                <label class="form-label">Клиент</label>
                                <select class="form-select" v-model="vehicle.organizationClientId" :disabled="loadOrganizationClients">
                                    <option value="">Без клиента</option>
                                    <option v-for="client in organizationClients"
                                            :key="'vehicle-card-client-' + client.id"
                                            :value="client.id">
                                        {{ client.name }}
                                    </option>
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-12">
                                <label class="form-label">Описание</label>
                                <textarea class="form-control"
                                          v-model.trim="vehicle.description"
                                          rows="4"
                                          placeholder="Дополнительная информация о технике..."></textarea>
                            </div>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" @@click="cancelVehicleEdit">
                            Отмена
                        </button>
                        <button type="button"
                                class="btn btn-primary"
                                @@click="saveVehicle"
                                :disabled="!canSaveVehicle || saveModal">
                            <template v-if="saveModal">
                                <i class="fa fa-spinner fa-spin fa-fw"></i>
                                Сохранение...
                            </template>
                            <template v-else>
                                <i class="fa fa-save me-1"></i>
                                Сохранить изменения
                            </template>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="mileageUnitWarningModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-md modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Проверьте историю обслуживания
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-2">
                            Вы меняете единицу учета для уже созданной техники.
                        </p>
                        <p class="mb-0">
                            Числа в существующих обслуживаниях останутся прежними, но будут отображаться в новой единице. Например, старое значение пробега может начать показываться как моточасы. Проверьте историю обслуживания после сохранения.
                        </p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Понятно</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модалка удаления фото -->
        <div class="modal fade" id="deletePhotoModal" tabindex="-1">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Удаление фотографии
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fa fa-trash fa-3x text-danger mb-3"></i>
                            <h5>Вы уверены, что хотите удалить фотографию?</h5>
                            <p class="text-muted">Это действие нельзя будет отменить</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-danger" @@click="deleteVehiclePhoto">
                            <i class="fa fa-trash me-1"></i>
                            Удалить
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteVehicleModal" tabindex="-1">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-exclamation-triangle me-2 text-danger"></i>
                            Удаление техники
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fa fa-trash fa-3x text-danger mb-3"></i>
                            <h5>Удалить эту технику?</h5>
                            <p class="text-muted mb-2">
                                <strong>{{ getVehicleDisplayName(vehicle) }}</strong>
                                <span v-if="vehicle.yearIssue">({{ vehicle.yearIssue }} г.)</span>
                            </p>
                            <p class="text-muted mb-0">Техника перейдет в архив и исчезнет из активного списка.</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-danger" @@click="deleteCurrentVehicle" :disabled="saveModal">
                            <template v-if="!saveModal">
                                <i class="fa fa-trash me-1"></i>
                                Удалить
                            </template>
                            <template v-else>
                                <i class="fa fa-spinner fa-spin fa-fw"></i>
                                Удаление...
                            </template>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="transferVehicleModal" tabindex="-1">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-share me-2"></i>
                            Перенести в рабочее пространство
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p class="mb-3">
                            <strong>{{ getVehicleDisplayName(vehicle) }}</strong>
                            <span v-if="vehicle.yearIssue">({{ vehicle.yearIssue }} г.)</span>
                            будет перенесена из личной техники в организацию.
                        </p>

                        <div class="mb-3">
                            <label class="form-label">Рабочее пространство</label>
                            <select class="form-select" v-model="selectedTransferOrganizationId">
                                <option value="">Выберите организацию</option>
                                <option v-for="organization in transferOrganizations"
                                        :key="'detail-transfer-org-' + organization.id"
                                        :value="organization.id">
                                    {{ organization.name }}
                                </option>
                            </select>
                        </div>

                        <div class="text-muted small">
                            После переноса техника исчезнет из личного списка и будет доступна в выбранной организации вместе с историей обслуживания и фото.
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button"
                                class="btn btn-primary"
                                :disabled="!selectedTransferOrganizationId || transferSaveInProgress"
                                @@click="confirmTransferVehicle">
                            <template v-if="!transferSaveInProgress">
                                Перенести
                            </template>
                            <template v-else>
                                <i class="fa fa-spinner fa-spin fa-fw"></i>
                                Переносим...
                            </template>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="personalCounterModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-tachometer me-2"></i>
                            {{ personalCounterTitle }}
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <div class="vehicle-counter-modal-summary mb-3">
                            <div class="vehicle-counter-modal-title">{{ getVehicleDisplayName(vehicle) }}</div>
                            <div class="vehicle-counter-modal-subtitle">
                                <span v-if="vehicle.name">{{ vehicle.name }}</span>
                                <span v-else-if="vehicle.yearIssue">{{ vehicle.yearIssue }} г.</span>
                                <span v-else>Личная техника</span>
                            </div>
                        </div>

                        <div class="alert mb-3"
                             :class="personalCounterLookupAlertClass"
                             v-if="personalCounterLookupMessage">
                            {{ personalCounterLookupMessage }}
                        </div>

                        <div class="mb-3">
                            <label class="form-label">Дата <span class="text-danger">*</span></label>
                            <vue-ctk-date-time-picker class="vehicle-counter-date-picker"
                                                      v-model="personalCounterForm.recordedAt"
                                                      :range="false"
                                                      format="DD.MM.YYYY"
                                                      formatted="YYYY-MM-DD"
                                                      output-format="YYYY-MM-DD"
                                                      only-date="true"
                                                      locale="ru"
                                                      first-day-of-week="1"
                                                      :auto-close="true"
                                                      :no-button-now="true"
                                                      :no-shortcuts="true"
                                                      :no-header="false"
                                                      :no-label="true"
                                                      color="#e67337"
                                                      button-color="#121212"
                                                      @@input="handlePersonalCounterDateChange">
                            </vue-ctk-date-time-picker>
                        </div>

                        <div class="mb-3">
                            <label class="form-label">{{ personalCounterUnitLabel }} <span class="text-danger">*</span></label>
                            <input type="number"
                                   min="0"
                                   step="1"
                                   class="form-control"
                                   v-model.number="personalCounterForm.value"
                                   :placeholder="vehicle.mileageUnit === 2 ? 'Например: 480' : 'Например: 125000'">
                        </div>

                        <div class="mb-0">
                            <label class="form-label">Комментарий</label>
                            <textarea class="form-control"
                                      rows="3"
                                      maxlength="500"
                                      v-model.trim="personalCounterForm.comment"
                                      placeholder="Например: внесено вручную после поездки"></textarea>
                        </div>

                        <div class="d-flex align-items-center gap-2 text-muted small mt-3" v-if="personalCounterLookupLoading">
                            <i class="fa fa-spinner fa-spin"></i>
                            <span>Проверяем запись на выбранную дату...</span>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal" :disabled="personalCounterSaveInProgress">
                            Отмена
                        </button>
                        <button type="button"
                                class="btn btn-dark"
                                @@click="savePersonalCounterEntry"
                                :disabled="personalCounterSaveInProgress || personalCounterLookupLoading">
                            <template v-if="!personalCounterSaveInProgress">
                                {{ personalCounterSubmitText }}
                            </template>
                            <template v-else>
                                <i class="fa fa-spinner fa-spin me-2"></i>
                                Сохраняем...
                            </template>
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модалка ошибок -->
        <div class="modal fade" id="errorModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-danger text-white">
                        <h5 class="modal-title">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Ошибка
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <p>{{ errorMessage }}</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модалка удаления обслуживания -->
        <div class="modal fade" id="deleteMaintenanceModal" tabindex="-1">
            <div class="modal-dialog modal-md">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-exclamation-triangle me-2 text-danger"></i>
                            Удаление обслуживания
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fa fa-trash fa-3x text-danger mb-3"></i>
                            <h5>Вы уверены, что хотите удалить обслуживание?</h5>
                            <p class="text-muted mb-2">За дату: <strong>{{ selectedMaintenanceDate }}</strong></p>
                            <p class="text-muted">Это действие нельзя будет отменить</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-danger" @@click="confirmDeleteMaintenance">
                            <i class="fa fa-trash me-1"></i>
                            Удалить
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно галереи фотографий -->
        <div class="modal fade" id="photoModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-image me-2"></i>
                            Просмотр фотографии
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center">
                        <div v-if="currentPhotos.length > 0">
                            <img :src="currentPhotos[currentPhotoIndex]"
                                 class="img-fluid rounded"
                                 style="max-height: 70vh; object-fit: contain;"
                                 :alt="'Фото обслуживания ' + (currentPhotoIndex + 1)">

                            <div class="mt-3 d-flex justify-content-center align-items-center">
                                <button class="btn btn-outline-secondary me-2"
                                        @@click="currentPhotoIndex = (currentPhotoIndex - 1 + currentPhotos.length) % currentPhotos.length"
                                        :disabled="currentPhotos.length <= 1">
                                    <i class="fa fa-chevron-left"></i>
                                </button>

                                <span class="mx-2">
                                    {{ currentPhotoIndex + 1 }} / {{ currentPhotos.length }}
                                </span>

                                <button class="btn btn-outline-secondary ms-2"
                                        @@click="currentPhotoIndex = (currentPhotoIndex + 1) % currentPhotos.length"
                                        :disabled="currentPhotos.length <= 1">
                                    <i class="fa fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                        <div v-else>
                            <p>Нет фотографий для отображения</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-1"></i>
                            Закрыть
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно загрузки -->
        <div class="modal fade" id="loadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <h5>Генерация PDF...</h5>
                        <p class="text-muted">Пожалуйста, подождите</p>
                    </div>
                </div>
            </div>
    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/vehicle-card.personal.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/vehicle-photos.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/vehicle-card.personal.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/vehicle-photos.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <script>
        const vehicleId = '@(ViewData["VehicleId"] ?? string.Empty)';
        const vehicleOrganizationId = '@(ViewData["VehicleOrganizationId"] ?? string.Empty)';
        window.personalVehicleTransferOrganizations = @Html.Raw(transferOrganizationsJson);
    </script>
    <environment include="Development">
        <script src="~/app/vehicle-registration-plate.bundle.js" asp-append-version="true"></script>
        <script src="~/app/vehicle-card.personal.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/app/vehicle-registration-plate.bundle.js" asp-append-version="true"></script>
        <script src="~/app/vehicle-card.personal.js" asp-append-version="true"></script>
    </environment>
}








@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@rootBreadcrumbUrl" class="text-decoration-none">@rootBreadcrumbText</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><h1>@(ViewData["VehicleDisplayName"] as string ?? vehicleScenario.DetailsTitle)</h1></li>
                </ol>
            </nav>
}
