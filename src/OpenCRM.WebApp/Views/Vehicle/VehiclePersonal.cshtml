                            <i class="fa fa-trash fa-3x text-danger mb-3"></i>
                            <h5>@Text["vehicle.card.maintenance.deleteConfirm"]</h5>
                            <p class="text-muted mb-2">@Text["vehicle.card.maintenance.dateLabel"] <strong>{{ selectedMaintenanceDate }}</strong></p>
                            <p class="text-muted">@Text["vehicle.card.action.irreversible"]</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Text["vehicle.edit.cancel"]</button>
                        <button type="button" class="btn btn-danger" @@click="confirmDeleteMaintenance">
                            <i class="fa fa-trash me-1"></i>
                            @Text["vehicle.card.button.delete"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно галереи фотографий -->
        <div class="modal fade" id="photoModal" tabindex="-1">
            <div class="modal-dialog modal-lg">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-image me-2"></i>
                            @Text["vehicle.card.photo.viewerTitle"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center">
                        <div v-if="currentPhotos.length > 0">
                            <img :src="currentPhotos[currentPhotoIndex]"
                                 class="img-fluid rounded"
                                 style="max-height: 70vh; object-fit: contain;"
                                 :alt="'@Text["vehicle.card.photo.maintenanceAlt"]' + (currentPhotoIndex + 1)">

                            <div class="mt-3 d-flex justify-content-center align-items-center">
                                <button class="btn btn-outline-secondary me-2"
                                        @@click="currentPhotoIndex = (currentPhotoIndex - 1 + currentPhotos.length) % currentPhotos.length"
                                        :disabled="currentPhotos.length <= 1">
                                    <i class="fa fa-chevron-left"></i>
                                </button>

                                <span class="mx-2">
                                    {{ currentPhotoIndex + 1 }} / {{ currentPhotos.length }}
                                </span>

                                <button class="btn btn-outline-secondary ms-2"
                                        @@click="currentPhotoIndex = (currentPhotoIndex + 1) % currentPhotos.length"
                                        :disabled="currentPhotos.length <= 1">
                                    <i class="fa fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                        <div v-else>
                            <p>@Text["vehicle.card.photo.noneToDisplay"]</p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">
                            <i class="fa fa-times me-1"></i>
                            @Text["vehicle.card.button.close"]
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно загрузки -->
        <div class="modal fade" id="loadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">@Text["vehicle.card.loadingShort"]</span>
                        </div>
                        <h5>@Text["vehicle.card.pdf.generating"]</h5>
                        <p class="text-muted">@Text["vehicle.card.pleaseWait"]</p>
                    </div>
                </div>
            </div>
    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/vehicle-card.personal.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/vehicle-photos.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/vehicle-card.personal.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/vehicle-photos.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <script>
        const vehicleId = '@(ViewData["VehicleId"] ?? string.Empty)';
        const vehicleOrganizationId = '@(ViewData["VehicleOrganizationId"] ?? string.Empty)';
        window.personalVehicleTransferOrganizations = @Html.Raw(transferOrganizationsJson);
    </script>
    <environment include="Development">
        <script src="~/app/vehicle-registration-plate.bundle.js" asp-append-version="true"></script>
        <script src="~/app/vehicle-card.personal.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/app/vehicle-registration-plate.bundle.js" asp-append-version="true"></script>
        <script src="~/app/vehicle-card.personal.js" asp-append-version="true"></script>
    </environment>
}








@section Breadcrumbs {
    <nav aria-label="breadcrumb" class="mb-4">
                <ol class="breadcrumb mb-0">
                    <li class="breadcrumb-item"><a href="@rootBreadcrumbUrl" class="text-decoration-none">@rootBreadcrumbText</a></li>
                    <li class="breadcrumb-item active" aria-current="page"><h1>@(ViewData["VehicleDisplayName"] as string ?? Text["vehicle.card.detailsTitle"].Value)</h1></li>
                </ol>
            </nav>
}
