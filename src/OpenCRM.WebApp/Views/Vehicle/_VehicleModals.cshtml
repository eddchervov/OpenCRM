@{
    var vehicleScenario = ViewData["VehicleScenario"] as OpenCRM.WebApp.Models.Vehicles.VehicleScenarioViewModel ?? new OpenCRM.WebApp.Models.Vehicles.VehicleScenarioViewModel();
}

<div class="modal modal-lg fade" id="exampleModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" v-if="vehicle">
            <div class="modal-header">
                <h5 class="modal-title">
                    <template v-if="modalType === 'create'">@vehicleScenario.CreateModalTitle</template>
                    <template v-else-if="modalType === 'edit'">@vehicleScenario.EditModalTitle</template>
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Тип техники</label>
                        <select class="form-select" v-model.number="vehicle.kind" @@change="changeVehicleKind">
                            <option v-for="option in vehicleKindOptions" :key="option.value" :value="option.value">
                                {{ option.text }}
                            </option>
                        </select>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Учет пробега / наработки</label>
                        <select class="form-select" v-model.number="vehicle.mileageUnit" @@change="changeMileageUnit">
                            <option v-for="option in mileageUnitOptions" :key="option.value" :value="option.value">
                                {{ option.text }}
                            </option>
                        </select>
                        <small class="text-muted d-block mt-1">
                            В обслуживании поле будет автоматически подписано как километры или моточасы.
                        </small>
                    </div>
                </div>

                <div class="row mb-3">
                    <div class="col-12">
                        <div class="btn-group w-100" role="group" aria-label="Способ заполнения техники" v-if="catalogModeAvailable">
                            <button type="button"
                                    class="btn"
                                    :class="!isManualIdentity ? 'btn-dark' : 'btn-outline-dark'"
                                    @@click="toggleIdentityMode(false)">
                                Из справочника
                            </button>
                            <button type="button"
                                    class="btn"
                                    :class="isManualIdentity ? 'btn-dark' : 'btn-outline-dark'"
                                    @@click="toggleIdentityMode(true)">
                                Ввести вручную
                            </button>
                        </div>
                        <button type="button" class="btn btn-dark w-100" v-else disabled>
                            Ручной режим
                        </button>
                    </div>
                </div>

                <template v-if="!isManualIdentity">
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label">Марка</label>
                            <v-select :options="brands"
                                      :reduce="m => m.id"
                                      label="name"
                                      :clearable="false"
                                      @@input="getModelOptions(null)"
                                      v-model="selectedBrandId">
                                <template slot="no-options">Не найдено</template>
                            </v-select>
                        </div>
                    </div>
                    <div class="row mb-3" v-if="selectedBrandId">
                        <div class="col-12">
                            <template v-if="loadModels">
                                <i class="fa fa-spinner fa-spin fa-fw c-blue"></i> Загрузка моделей...
                            </template>
                            <template v-else>
                                <label class="form-label">Модель</label>
                                <v-select :options="models"
                                          :reduce="m => m.id"
                                          label="name"
                                          :clearable="false"
                                          v-model="vehicle.modelId">
                                    <template slot="no-options">Не найдено</template>
                                </v-select>
                            </template>
                        </div>
                    </div>
                </template>

                <template v-else>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label">Бренд / производитель</label>
                            <input class="form-control"
                                   v-model.trim="vehicle.manualBrandName"
                                   placeholder="Например: Yamaha, Polaris, КамАЗ">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <label class="form-label">Модель</label>
                            <input class="form-control"
                                   v-model.trim="vehicle.manualModelName"
                                   placeholder="Например: Grizzly 700, Ranger XP 1000, 65115">
                        </div>
                    </div>
                    <div class="row mb-3">
                        <div class="col-12">
                            <small class="text-muted d-block">
                                Бренд / производитель и модель будут автоматически добавлены в справочники после одобрения модератором.
                            </small>
                        </div>
                    </div>
                </template>

                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Год выпуска</label>
                        <input class="form-control" type="number" @@input="changeYearIssue" v-model.number="vehicle.yearIssue" />
                    </div>
                </div>
                <div class="row mb-3">
                    <div class="col-12">
                        <label class="form-label">Госномер</label>
                        <input class="form-control mb-3" v-model.trim="vehicle.registrationPlate"
                           v-registration-plate="vehicle" maxlength="24" placeholder="А123АА154" />
                        <label class="form-label">Имя / номер</label>
                        <input class="form-control" v-model.trim="vehicle.name" placeholder="Например: Служебный 01 или А123ВС" />
                    </div>
                </div>
                <div class="row mb-3" v-if="isOrganizationWorkspace && organizationClientsEnabled">
                    <div class="col-12">
                        <label class="form-label">Клиент</label>
                        <select class="form-select" v-model="vehicle.organizationClientId" :disabled="loadOrganizationClients">
                            <option value="">Без клиента</option>
                            <option v-for="client in organizationClients"
                                    :key="'vehicle-client-' + client.id"
                                    :value="client.id">
                                {{ client.name }}
                            </option>
                        </select>
                        <small class="text-muted d-block mt-1">
                            Если техника относится к клиенту, привяжите ее здесь.
                        </small>
                    </div>
                </div>
                <div class="row mb-0">
                    <div class="col-12">
                        <label class="form-label">Описание</label>
                        <textarea class="form-control w-100" rows="4" v-model.trim="vehicle.description"></textarea>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                <button type="button" class="btn btn-dark" :disabled="!canSaveVehicle || saveModal" @@click="save">
                    <template v-if="modalType === 'create' && !saveModal">Создать</template>
                    <template v-else-if="modalType === 'edit' && !saveModal">Сохранить</template>
                    <template v-else-if="saveModal"><i class="fa fa-spinner fa-spin fa-fw"></i> Сохранение</template>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal modal-md fade" id="deleteModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content" v-if="deleteVehicle">
            <div class="modal-header">
                <h5 class="modal-title">
                    @vehicleScenario.DeleteModalTitle {{ getVehicleDisplayName(deleteVehicle) }}
                    <span v-if="deleteVehicle.yearIssue">({{ deleteVehicle.yearIssue }} г.)</span>
                    <span v-if="deleteVehicle.name"> {{ deleteVehicle.name }}</span>?
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
                <button type="button" class="btn btn-dark" @@click="save_deleteVehicle" :disabled="saveModal">
                    <template v-if="saveModal === false">Удалить</template>
                    <template v-else-if="saveModal"><i class="fa fa-spinner fa-spin fa-fw"></i> Удаление</template>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="transferVehicleModal" data-bs-backdrop="static" data-bs-keyboard="false" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md">
        <div class="modal-content" v-if="transferVehicle">
            <div class="modal-header">
                <h5 class="modal-title">
                    Перенести в рабочее пространство
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-3">
                    <strong>{{ getVehicleDisplayName(transferVehicle) }}</strong>
                    <span v-if="transferVehicle.yearIssue">({{ transferVehicle.yearIssue }} г.)</span>
                    будет перенесена из личной техники в организацию.
                </p>

                <div class="mb-3">
                    <label class="form-label">Рабочее пространство</label>
                    <select class="form-select" v-model="selectedTransferOrganizationId">
                        <option value="">Выберите организацию</option>
                        <option v-for="organization in transferOrganizations"
                                :key="'transfer-org-' + organization.id"
                                :value="organization.id">
                            {{ organization.name }}
                        </option>
                    </select>
                </div>

                <div class="text-muted small">
                    После переноса техника исчезнет из личного списка и будет доступна в выбранной организации вместе с историей обслуживания и фото.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                <button type="button"
                        class="btn btn-primary"
                        :disabled="!selectedTransferOrganizationId || transferSaveInProgress"
                        @@click="confirmTransferVehicle">
                    <template v-if="!transferSaveInProgress">Перенести</template>
                    <template v-else><i class="fa fa-spinner fa-spin fa-fw"></i> Переносим</template>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="mileageUnitWarningModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-md modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-warning text-dark">
                <h5 class="modal-title">
                    <i class="fa fa-exclamation-triangle me-2"></i>
                    Проверьте историю обслуживания
                </h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p class="mb-2">
                    Вы меняете единицу учета для уже созданной техники.
                </p>
                <p class="mb-0">
                    Числа в существующих обслуживаниях останутся прежними, но будут отображаться в новой единице. Например, старое значение пробега может начать показываться как моточасы. Проверьте историю обслуживания после сохранения.
                </p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-dark" data-bs-dismiss="modal">Понятно</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="subscriptionModal" tabindex="-1" data-bs-backdrop="static">
    <div class="modal-dialog modal-lg">
        <div class="modal-content">
            <div class="modal-header bg-dark text-white">
                <h5 class="modal-title">
                    <i class="fa fa-crown me-2"></i>
                    <span v-if="!vehicleLimitInfo.hasActiveSubscription">Выберите тариф</span>
                    <span v-else>Увеличьте лимит</span>
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center py-3">
                    <i class="fa fa-car fa-4x mb-3 text-orange"></i>
                    <h4 class="mb-3" v-if="!vehicleLimitInfo.hasActiveSubscription">Превышен лимит стандартного тарифа</h4>
                    <h4 class="mb-3" v-else>Превышен лимит вашего тарифа</h4>

                    <div v-if="vehicleLimitInfo.isMaxPlan" class="alert alert-dark">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        <strong>Лимит полностью исчерпан</strong>
                        <p class="mb-0 mt-2">Вы используете максимальный доступный тариф. Для дальнейшего расширения возможностей свяжитесь с поддержкой.</p>
                        <a href="~/personal/support" class="btn btn-outline-dark btn-sm mt-2">
                            <i class="fa fa-headset me-1"></i>Поддержка
                        </a>
                    </div>

                    <div v-else class="card border-dark">
                        <div class="card-body">
                            <h5 class="card-title">
                                <i class="fa fa-list me-2"></i>
                                Перейдите на страницу тарифов
                            </h5>
                            <ul class="list-unstyled">
                                <li><i class="fa fa-check text-success me-2"></i>Сравните все доступные тарифы</li>
                                <li><i class="fa fa-check text-success me-2"></i>Посмотрите лимиты по количеству техники</li>
                                <li><i class="fa fa-check text-success me-2"></i>Выберите подходящий тариф</li>
                            </ul>
                        </div>
                    </div>

                    <div class="mt-4">
                        <a href="/subscription" class="text-orange text-decoration-none">
                            <i class="fa fa-list me-1"></i>Открыть страницу тарифов
                        </a>
                    </div>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-outline-dark" data-bs-dismiss="modal">Позже</button>
                <button v-if="!vehicleLimitInfo.isMaxPlan" type="button" class="btn btn-dark" @@click="goToSubscription">
                    Перейти к тарифам
                </button>
                <a v-else href="~/personal/support" class="btn btn-dark">Поддержка</a>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="errorModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false" aria-hidden="true">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="fa fa-exclamation-triangle me-2"></i>Ошибка</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Закрыть"></button>
            </div>
            <div class="modal-body">
                <p>{{ errorMessage }}</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Закрыть</button>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="restoreModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
    <div class="modal-dialog modal-md">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><i class="fa fa-undo me-2 text-success"></i>@vehicleScenario.RestoreModalTitle</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="text-center">
                    <i class="fa fa-car fa-3x text-success mb-3"></i>
                    <h5>Восстановить технику?</h5>
                    <p class="text-muted mb-2">{{ selectedRestoreVehicle ? getVehicleDisplayName(selectedRestoreVehicle) : '' }}</p>
                    <p class="text-muted">Запись будет перемещена обратно в список активной техники.</p>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal" :disabled="restoreSaving">Отмена</button>
                <button type="button" class="btn btn-success" @@click="confirmRestoreFromArchive" :disabled="restoreSaving">
                    <span v-if="restoreSaving" class="spinner-border spinner-border-sm me-1"></span>
                    <i v-else class="fa fa-undo me-1"></i>
                    {{ restoreSaving ? 'Восстанавливаем...' : 'Восстановить' }}
                </button>
            </div>
        </div>
    </div>
</div>


