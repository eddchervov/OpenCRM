@{
    var formMode = (ViewData["VehicleFormMode"] as string ?? "edit").ToLowerInvariant();
    var isCreateMode = formMode == "create";
    var title = isCreateMode ? "Новая техника" : "Параметры техники";
    var subtitle = isCreateMode
        ? "Заполните основную карточку, а детали можно будет дополнять и позже."
        : "Обновите основную информацию и реквизиты техники.";
    var returnUrl = ViewData["VehicleEditReturnUrl"] as string ?? "/vehicles";
}

<div class="vehicle-edit-card card">
    <div class="card-header">
        <h1 class="h4 mb-1">@title</h1>
        <div class="text-muted small">@subtitle</div>
    </div>
    <div class="card-body">
        <div v-if="formLoad" class="d-flex align-items-center gap-2 text-muted mb-4">
            <i class="fa fa-spinner fa-spin"></i>
            <span>Загружаем данные техники…</span>
        </div>

        <div v-if="errorMessage" class="alert alert-danger mb-4">
            {{ errorMessage }}
        </div>

        <div class="vehicle-edit-section" v-if="!formLoad">
            <h2 class="vehicle-edit-section-title">Основное</h2>

            <div class="mb-3">
                <label class="form-label" for="vehicle-kind">Тип техники <span class="text-danger">*</span></label>
                <v-select :options="vehicleKindOptions"
                          input-id="vehicle-kind"
                          :reduce="option => option.value"
                          label="text"
                          :clearable="false"
                          v-model="vehicle.kind"
                          @@input="changeVehicleKind">
                    <template slot="no-options">
                        Нет доступных типов
                    </template>
                </v-select>
            </div>

            <div class="mb-3">
                <label class="form-label" for="vehicle-mileage-unit">Учет пробега / наработки <span class="text-danger">*</span></label>
                <v-select :options="mileageUnitOptions"
                          input-id="vehicle-mileage-unit"
                          :reduce="option => option.value"
                          label="text"
                          :clearable="false"
                          v-model="vehicle.mileageUnit">
                    <template slot="no-options">
                        Нет доступных единиц
                    </template>
                </v-select>
                <small class="text-muted d-block mt-2">
                    В истории обслуживания и показаний поле будет автоматически подписано как километры или моточасы.
                </small>
            </div>

            <div class="mb-3">
                <div class="btn-group w-100" role="group" aria-label="Способ заполнения техники" v-if="catalogModeAvailable">
                    <button type="button"
                            class="btn"
                            :class="!isManualIdentity ? 'btn-dark' : 'btn-outline-dark'"
                            @@click="toggleIdentityMode(false)">
                        Из справочника
                    </button>
                    <button type="button"
                            class="btn"
                            :class="isManualIdentity ? 'btn-dark' : 'btn-outline-dark'"
                            @@click="toggleIdentityMode(true)">
                        Ввести вручную
                    </button>
                </div>
                <button type="button" class="btn btn-dark w-100" v-else disabled>
                    Ручной режим
                </button>
            </div>

            <template v-if="!isManualIdentity">
                <div class="mb-3">
                    <label class="form-label" for="vehicle-brand">Марка</label>
                    <v-select :options="brands"
                              input-id="vehicle-brand"
                              :reduce="brand => brand.id"
                              label="name"
                              :clearable="false"
                              @@input="getModelOptions(null)"
                              v-model="selectedBrandId">
                        <template slot="no-options">
                            Не найдено марок
                        </template>
                    </v-select>
                </div>

                <div class="mb-3" v-if="selectedBrandId">
                    <label class="form-label" for="vehicle-model">Модель</label>
                    <template v-if="loadModels">
                        <div class="text-center text-muted py-2">
                            <i class="fa fa-spinner fa-spin fa-fw"></i>
                            <span>Загрузка моделей...</span>
                        </div>
                    </template>
                    <template v-else>
                        <v-select :options="models"
                                  input-id="vehicle-model"
                                  :reduce="model => model.id"
                                  label="name"
                                  :clearable="false"
                                  v-model="vehicle.modelId">
                            <template slot="no-options">
                                Не найдено моделей
                            </template>
                        </v-select>
                    </template>
                </div>
            </template>

            <template v-else>
                <div class="mb-3">
                    <label class="form-label" for="vehicle-manual-brand">Бренд / производитель</label>
                    <input type="text" id="vehicle-manual-brand"
                           class="form-control"
                           v-model.trim="vehicle.manualBrandName"
                           placeholder="Например: Yamaha, Polaris, КамАЗ">
                </div>

                <div class="mb-3">
                    <label class="form-label" for="vehicle-manual-model">Модель</label>
                    <input type="text" id="vehicle-manual-model"
                           class="form-control"
                           v-model.trim="vehicle.manualModelName"
                           placeholder="Например: Grizzly 700, Ranger XP 1000, 65115">
                </div>
            </template>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-plate">Госномер</label>
                    <input type="text" id="vehicle-plate"
                           class="form-control"
                           v-model.trim="vehicle.registrationPlate"
                           v-registration-plate="vehicle"
                           maxlength="24"
                           placeholder="Например: A123BC154">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-year">Год выпуска</label>
                    <input type="number" id="vehicle-year"
                           class="form-control"
                           v-model.number="vehicle.yearIssue"
                           @@input="changeYearIssue"
                           min="1900"
                           :max="new Date().getFullYear()"
                           placeholder="Укажите год выпуска">
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-name">Имя / номер техники</label>
                    <input type="text" id="vehicle-name"
                           class="form-control"
                           v-model.trim="vehicle.name"
                           placeholder="Например: Рабочий квадроцикл или A123BC">
                </div>
            </div>
        </div>

        <details class="vehicle-edit-section vehicle-edit-identifiers" v-if="!formLoad">
            <summary class="vehicle-edit-section-title">Реквизиты техники</summary>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-vin">VIN</label>
                    <input type="text" id="vehicle-vin"
                           class="form-control"
                           v-model.trim="vehicle.vin"
                           maxlength="32"
                           placeholder="Например: XTA210990Y1234567">
                </div>

            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-body">Номер кузова</label>
                    <input type="text" id="vehicle-body"
                           class="form-control"
                           v-model.trim="vehicle.bodyNumber"
                           maxlength="64"
                           placeholder="Если нужен отдельный номер кузова или рамы">
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-engine">Номер двигателя</label>
                    <input type="text" id="vehicle-engine"
                           class="form-control"
                           v-model.trim="vehicle.engineNumber"
                           maxlength="64"
                           placeholder="Если нужно хранить номер двигателя">
                </div>
            </div>

            <div class="row g-3 mb-3">
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-color">Цвет</label>
                    <input type="text" id="vehicle-color"
                           class="form-control"
                           v-model.trim="vehicle.color"
                           maxlength="32"
                           placeholder="Например: Белый">
                </div>
                <div class="col-md-6">
                    <label class="form-label" for="vehicle-certificate">СТС</label>
                    <input type="text" id="vehicle-certificate"
                           class="form-control"
                           v-model.trim="vehicle.registrationCertificate"
                           maxlength="64"
                           placeholder="Например: 99 ХХ 123456">
                </div>
            </div>

            <div class="mb-3 vehicle-edit-inline-field vehicle-edit-inline-field-date">
                <label class="form-label mb-0" for="vehicle-commissioning-input">Дата ввода в эксплуатацию</label>
                <div class="vehicle-edit-inline-field-control">
                    <vue-ctk-date-time-picker class="vehicle-edit-date-picker"
                                              id="vehicle-commissioning"
                                              label=""
                                              hint=""
                                              v-model="vehicle.commissioningDateDisplay"
                                              :range="false"
                                              format="DD.MM.YYYY"
                                              formatted="DD.MM.YYYY"
                                              output-format="DD.MM.YYYY"
                                              only-date="true"
                                              locale="ru"
                                              first-day-of-week="1"
                                              :auto-close="true"
                                              :no-button-now="true"
                                              :no-shortcuts="true"
                                              :no-header="false"
                                              :no-label="true"
                                              color="#e67337"
                                              button-color="#121212">
                    </vue-ctk-date-time-picker>
                </div>
            </div>
        </details>

        <div class="vehicle-edit-section" v-if="!formLoad">
            <h2 class="vehicle-edit-section-title">Дополнительно</h2>

            <div class="mb-3" v-if="vehicle.organizationId && organizationClientsEnabled">
                <label class="form-label" for="vehicle-client">Клиент</label>
                <input v-if="lockOrganizationClient"
                       id="vehicle-client"
                       type="text"
                       class="form-control"
                       :value="lockedOrganizationClientName"
                       disabled />
                <v-select v-else
                          input-id="vehicle-client"
                          :options="organizationClientSelectOptions"
                          :reduce="client => client.id"
                          label="name"
                          :clearable="false"
                          v-model="vehicle.organizationClientId"
                          :disabled="loadOrganizationClients">
                    <template slot="no-options">
                        Нет доступных клиентов
                    </template>
                </v-select>
            </div>

            <div class="mb-0">
                <label class="form-label" for="vehicle-description">Описание</label>
                <textarea class="form-control" id="vehicle-description"
                          v-model.trim="vehicle.description"
                          rows="4"
                          placeholder="Дополнительная информация о технике"></textarea>
            </div>
        </div>
    </div>
    <div class="card-footer vehicle-edit-footer" v-if="!formLoad">
        <a class="btn btn-outline-secondary" href="@returnUrl">Отмена</a>
        <button type="button"
                class="btn btn-dark"
                @@click="saveVehicle"
                :disabled="!canSaveVehicle || saveInProgress">
            <template v-if="saveInProgress">
                <i class="fa fa-spinner fa-spin me-2"></i>
                Сохраняем…
            </template>
            <template v-else>
                @(isCreateMode ? "Добавить технику" : "Сохранить изменения")
            </template>
        </button>
    </div>
</div>
