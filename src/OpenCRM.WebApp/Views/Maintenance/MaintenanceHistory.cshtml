@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = Text["maintenance.legacy.page.history"].Value;
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "maintenance-details-page-body";
    var maintenanceId = ViewData["MaintenanceId"] as string ?? string.Empty;
    var organizationId = ViewData["MaintenanceOrganizationId"] as string ?? string.Empty;
    if (string.IsNullOrWhiteSpace(organizationId))
    {
        organizationId = Context.Request.Query["organizationId"].ToString();
    }
    if (string.IsNullOrWhiteSpace(organizationId))
    {
        Layout = "/Views/Personal/_PersonalLayout.cshtml";
        ViewData["PersonalVehiclePage"] = true;
        if (ViewData["MaintenanceVehicle"] is OpenCRM.Modules.Vehicles.Contracts.Dtos.GetVehicleDto breadcrumbVehicle)
        {
            ViewData["BreadcrumbLinks"] = new (string Url, string Title)[]
            {
                ("/vehicles", Text["maintenance.legacy.page.vehiclePersonal"].Value),
                ($"/vehicle/{breadcrumbVehicle.Id}", breadcrumbVehicle.DisplayName),
                ($"/maintenance/{maintenanceId}", Text["maintenance.legacy.page.maintenance"].Value)
            };
        }
    }

    var organizationName = ViewData["MaintenanceOrganizationName"] as string ?? string.Empty;
    var returnUrl = ViewData["MaintenanceReturnUrl"] as string ?? string.Empty;
    var rootBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var rootBreadcrumbText = string.IsNullOrWhiteSpace(organizationId)
        ? Text["maintenance.legacy.page.vehiclePersonal"].Value
        : !string.IsNullOrWhiteSpace(organizationName)
            ? organizationName
            : Text["maintenance.legacy.page.organization"].Value;
    var workspaceSidebar = new OpenCRM.WebApp.Models.Organizations.OrganizationWorkspaceSidebarViewModel
    {
        OrganizationId = string.IsNullOrWhiteSpace(organizationId) ? Guid.Empty : Guid.Parse(organizationId),
        OrganizationName = organizationName,
        CurrentSection = "maintenance",
        HasVehiclesModule = ViewData["MaintenanceHasVehiclesModule"] is bool vehiclesModule && vehiclesModule,
        HasClientsModule = ViewData["MaintenanceHasClientsModule"] is bool clientsModule && clientsModule,
        HasDefectsModule = ViewData["MaintenanceHasDefectsModule"] is bool defectsModule && defectsModule,
        HasCountersModule = ViewData["MaintenanceHasCountersModule"] is bool countersModule && countersModule,
        HasSchedulerModule = ViewData["MaintenanceHasSchedulerModule"] is bool schedulerModule && schedulerModule,
        CanManageSettings = ViewData["MaintenanceCanManageSettings"] is bool canManageSettings && canManageSettings,
        MembersCount = ViewData["MaintenanceOrganizationMembersCount"] is int membersCount ? membersCount : 0
    };
}

<div id="maintenance-details-form">
    <style>
        [v-cloak] {
            display: none;
        }
    </style>

    <div v-cloak>
        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organizations-page")">
            <div class="@(string.IsNullOrWhiteSpace(organizationId) ? "container py-4" : "container-fluid px-4 px-xxl-5 organization-workspace-shell organization-workspace-shell-wide")">
                <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-flow")">
                    <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-layout")">
                        @if (!string.IsNullOrWhiteSpace(organizationId))
                        {
                            <aside class="organization-workspace-sidebar">
                                <partial name="/Views/Organizations/_WorkspaceSidebar.cshtml" model="workspaceSidebar" />
                            </aside>
                        }
                        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-content")">
                        <div class="maintenance-details-container">
                            @if (!string.IsNullOrWhiteSpace(organizationId))
                            {
                                <nav aria-label="breadcrumb" class="mb-4">
                                    <ol class="breadcrumb mb-0">
                                        <li class="breadcrumb-item"><a href="@rootBreadcrumbUrl">@rootBreadcrumbText</a></li>
                                        <li class="breadcrumb-item"><a :href="getMaintenanceUrl()">@Text["maintenance.legacy.page.maintenance"]</a></li>
                                        <li class="breadcrumb-item active" aria-current="page">@Text["maintenance.legacy.page.history"]</li>
                                    </ol>
                                </nav>
                            }

                            <div class="card maintenance-details-card">
                                <div class="card-header bg-gradient-secondary text-white">
                                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                                        <h3 class="card-title mb-0">
                                            <i class="fa fa-history me-2"></i>
                                            @Text["maintenance.legacy.page.history"]
                                        </h3>
                                        <a :href="getMaintenanceUrl()" class="btn btn-light btn-sm">
                                            <i class="fa fa-arrow-left me-2"></i>
                                            @Text["maintenance.legacy.history.backToMaintenance"]
                                        </a>
                                    </div>
                                </div>
                                <div class="card-body">
                                    <div v-if="loading" class="d-flex align-items-center gap-2 text-muted">
                                        <i class="fa fa-spinner fa-spin"></i>
                                        <span>@Text["maintenance.legacy.history.loading"]</span>
                                    </div>
                                    <div v-else-if="events.length === 0" class="text-muted">
                                        @Text["maintenance.legacy.history.empty"]
                                    </div>
                                    <div v-else class="list-group list-group-flush">
                                        <div class="list-group-item px-0" v-for="event in events" :key="event.id">
                                            <div class="d-flex justify-content-between gap-3 flex-wrap">
                                                <div>
                                                    <div class="fw-semibold">{{ event.title }}</div>
                                                    <div class="text-muted small" v-if="event.description">{{ event.description }}</div>
                                                    <div class="text-muted small" v-if="event.actorDisplayName">@Text["maintenance.legacy.history.author"] {{ event.actorDisplayName }}</div>
                                                </div>
                                                <div class="text-muted small">{{ formatDate(event.createdAt) }}</div>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mt-3 d-flex gap-2 flex-wrap">
                                <a :href="getMaintenanceUrl()" class="btn btn-outline-dark">
                                    <i class="fa fa-arrow-left me-2"></i>
                                    @Text["maintenance.legacy.history.returnToMaintenance"]
                                </a>
                                <a v-if="returnUrl" :href="returnUrl" class="btn btn-outline-secondary">
                                    @Text["maintenance.legacy.history.returnBack"]
                                </a>
                            </div>
                        </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <partial name="_MaintenanceErrorModal" />
    </div>
</div>

@section Styles {
    @if (!string.IsNullOrWhiteSpace(organizationId))
    {
        <environment include="Development">
            <link rel="stylesheet" href="~/css/organizations.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/maintenance.organization.css" asp-append-version="true" />
        </environment>
        <environment exclude="Development">
            <link rel="stylesheet" href="~/css/organizations.min.css" asp-append-version="true" />
            <link rel="stylesheet" href="~/css/maintenance.organization.css" asp-append-version="true" />
        </environment>
    }
    else
    {
        <link rel="stylesheet" href="~/css/maintenance.personal.css" asp-append-version="true" />
    }
}

@section Scripts {
    <script>
        window.maintenanceHistoryPage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
        {
            maintenanceId,
            organizationId,
            returnUrl
        }));
    </script>
    <script src="~/app/maintenance-history-page.js" asp-append-version="true"></script>
}
