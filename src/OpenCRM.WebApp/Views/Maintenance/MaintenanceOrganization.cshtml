@{
    var scenarioCatalog = ViewData["MaintenanceScenarioCatalog"] as OpenCRM.Modules.Catalog.Contracts.Dtos.OrganizationScenarioCatalogDto;
    var scenarioDocumentTemplatesJson = System.Text.Json.JsonSerializer.Serialize(
        scenarioCatalog?.Documents.Where(x => x.IsActive).Select(x => new
        {
            id = x.Id,
            code = x.Code,
            name = x.Name,
            description = x.Description,
            documentKindCode = x.DocumentKindCode
        }) ?? []);
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = $"Сведения об обслуживании";
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "maintenance-details-page-body";
    var organizationId = ViewData["MaintenanceOrganizationId"] as string ?? string.Empty;
    if (string.IsNullOrWhiteSpace(organizationId))
    {
        organizationId = Context.Request.Query["organizationId"].ToString();
    }
    var organizationName = ViewData["MaintenanceOrganizationName"] as string ?? string.Empty;
    var rootBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var rootBreadcrumbText = string.IsNullOrWhiteSpace(organizationId)
        ? "Моя техника"
        : !string.IsNullOrWhiteSpace(organizationName)
            ? organizationName
            : "Организация";
    var vehiclesBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var workspaceSidebar = new OpenCRM.WebApp.Models.Organizations.OrganizationWorkspaceSidebarViewModel
    {
        OrganizationId = string.IsNullOrWhiteSpace(organizationId) ? Guid.Empty : Guid.Parse(organizationId),
        OrganizationName = organizationName,
        CurrentSection = "maintenance",
        HasVehiclesModule = ViewData["MaintenanceHasVehiclesModule"] is bool vehiclesModule && vehiclesModule,
        HasClientsModule = ViewData["MaintenanceHasClientsModule"] is bool clientsModule && clientsModule,
        HasDefectsModule = ViewData["MaintenanceHasDefectsModule"] is bool defectsModule && defectsModule,
        HasCountersModule = ViewData["MaintenanceHasCountersModule"] is bool countersModule && countersModule,
        HasSchedulerModule = ViewData["MaintenanceHasSchedulerModule"] is bool schedulerModule && schedulerModule,
        CanManageSettings = ViewData["MaintenanceCanManageSettings"] is bool canManageSettings && canManageSettings,
        MembersCount = ViewData["MaintenanceOrganizationMembersCount"] is int membersCount ? membersCount : 0
    };
}

<div id="maintenance-details-form">
    <style>
        [v-cloak] {
            display: none;
        }
    </style>

    <div v-cloak>
        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organizations-page")">
            <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "container-fluid px-4 px-xxl-5 organization-workspace-shell organization-workspace-shell-wide")">
                <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-flow")">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="@rootBreadcrumbUrl" class="text-decoration-none">@rootBreadcrumbText</a></li>
                            <li class="breadcrumb-item"><a href="@vehiclesBreadcrumbUrl" class="text-decoration-none">Техника</a></li>
                            <li class="breadcrumb-item">
                                <a :href="getVehicleUrl()" class="text-decoration-none">
                                    <template v-if="vehicle.id">
                                        {{ vehicle.displayName }}
                                        <span v-if="vehicle.yearIssue">{{ vehicle.yearIssue }} г.</span>
                                    </template>
                                    <template v-else>
                                        Техника
                                    </template>
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">Обслуживание</li>
                        </ol>
                    </nav>

                    <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-layout")">
                    @if (!string.IsNullOrWhiteSpace(organizationId))
                    {
                        <aside class="organization-workspace-sidebar">
                            <partial name="/Views/Organizations/_WorkspaceSidebar.cshtml" model="workspaceSidebar" />
                        </aside>
                    }
                        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-content")">
        <div class="maintenance-details-container">
            <!-- Сведения об обслуживании -->
            <div class="card maintenance-details-card maintenance-details-card-primary mb-4">
                <div class="card-header bg-gradient-primary text-white">
                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <h3 class="card-title mb-0">
                            <i class="fa fa-info-circle me-2"></i>
                            Сведения об обслуживании
                        </h3>
                        <div class="dropdown">
                            <button class="btn btn-sm dropdown-toggle maintenance-header-actions-btn" type="button" data-bs-toggle="dropdown" :disabled="workflowSaving || deleteSaving">
                                <i class="fa fa-cog me-2"></i>
                                Действия
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end">
                                <li>
                                    <a :href="getMaintenanceUpdateUrl()" class="dropdown-item maintenance-dropdown-edit">
                                        <i class="fa fa-edit me-2"></i>
                                        Редактировать
                                    </a>
                                </li>
                                <li v-if="maintenance.status !== 3"><hr class="dropdown-divider"></li>
                                <li v-if="maintenance.status === 1">
                                    <button class="dropdown-item" @@click="startMaintenance" :disabled="workflowSaving">
                                        <span v-if="workflowSaving" class="spinner-border spinner-border-sm me-2"></span>
                                        <i v-else class="fa fa-play me-2"></i>
                                        В работу
                                    </button>
                                </li>
                                <li v-if="maintenance.status !== 3 && maintenance.status !== 4">
                                    <button class="dropdown-item" @@click="openWorkflowModal('complete')">
                                        <i class="fa fa-check me-2"></i>
                                        Выполнить
                                    </button>
                                </li>
                                <li v-if="maintenance.status === 4">
                                    <button class="dropdown-item" @@click="openWorkflowModal('reopen')">
                                        <i class="fa fa-undo me-2"></i>
                                        Возобновить
                                    </button>
                                </li>
                                <li v-if="maintenance.status === 1 || maintenance.status === 2">
                                    <button class="dropdown-item" @@click="openWorkflowModal('reschedule')">
                                        <i class="fa fa-calendar me-2"></i>
                                        Перенести дату
                                    </button>
                                </li>
                                <li v-if="maintenance.status !== 4 && maintenance.status !== 3">
                                    <button class="dropdown-item" @@click="openWorkflowModal('cancel')">
                                        <i class="fa fa-ban me-2"></i>
                                        Отменить
                                    </button>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <button class="dropdown-item text-danger" @@click="deleteMaintenance" :disabled="deleteSaving">
                                        <i class="fa fa-trash me-2"></i>
                                        Удалить обслуживание
                                    </button>
                                </li>
                            </ul>
                        </div>
                    </div>
                </div>
                <div class="card-body">
                    <div v-if="formLoad" class="d-flex align-items-center gap-2 text-muted mb-4">
                        <i class="fa fa-spinner fa-spin"></i>
                        <span>Загружаем данные обслуживания...</span>
                    </div>
                    <div class="row">
                        <div class="col-md-6">
                            <div class="maintenance-info-grid">
                                <div class="maintenance-info-item">
                                    <label class="maintenance-info-label">Состояние</label>
                                    <span class="maintenance-info-value">
                                        <span class="badge" :class="getMaintenanceStatusClass(maintenance.status)">
                                            {{ getMaintenanceStatusDisplayText(maintenance.status) }}
                                        </span>
                                        <span class="badge text-bg-danger ms-2" v-if="isMaintenanceOverdue()">Просрочено</span>
                                    </span>
                                </div>

                                <div class="maintenance-info-item">
                                    <label class="maintenance-info-label">Тип обслуживания</label>
                                    <span class="maintenance-info-value">
                                        {{ getMaintenanceTypeText(maintenance.type) }}
                                    </span>
                                </div>

                                <div class="maintenance-info-item" v-if="maintenance.plannedDate || maintenance.status !== 3">
                                    <label class="maintenance-info-label">Плановая дата и время</label>
                                    <span class="maintenance-info-value">
                                        <i class="fa fa-calendar me-1 text-muted"></i>
                                        {{ formatPlannedDateTime() }}
                                    </span>
                                </div>

                                <div class="maintenance-info-item" v-if="maintenance.completedDate || maintenance.status === 3">
                                    <label class="maintenance-info-label">Фактическая дата выполнения</label>
                                    <span class="maintenance-info-value">
                                        <i class="fa fa-calendar me-1 text-muted"></i>
                                        {{ maintenance.completedDate ? formatDate(maintenance.completedDate) : formatDate(maintenance.date) }}
                                    </span>
                                </div>

                                <div class="maintenance-info-item" v-if="maintenance.mileage">
                                    <label class="maintenance-info-label">{{ mileageUnitLabel }}</label>
                                    <span class="maintenance-info-value">
                                        <i class="fa fa-tachometer me-1 text-muted"></i>
                                        {{ maintenance.mileage.toLocaleString() }} {{ mileageUnitShortText }}
                                    </span>
                                </div>
                            </div>
                        </div>

                        <div class="col-md-6">
                            <div class="maintenance-info-grid">
                                <div class="maintenance-info-item" v-if="maintenance.location">
                                    <label class="maintenance-info-label">Место проведения</label>
                                    <span class="maintenance-info-value">
                                        <i class="fa fa-map-marker me-1 text-muted"></i>
                                        {{ maintenance.location }}
                                    </span>
                                </div>

                                <div class="maintenance-info-item" v-if="maintenance.performer">
                                    <label class="maintenance-info-label">Исполнитель</label>
                                    <span class="maintenance-info-value">
                                        <i class="fa fa-user me-1 text-muted"></i>
                                        {{ maintenance.performer }}
                                    </span>
                                </div>

                                <div class="maintenance-info-item" v-if="maintenance.price">
                                    <label class="maintenance-info-label">Общая стоимость</label>
                                    <span class="maintenance-info-value text-success fw-bold">
                                        <i class="fa fa-rub me-1"></i>
                                        {{ formatPrice(maintenance.price) }}
                                    </span>
                                </div>

                                <div class="maintenance-info-item maintenance-info-item-wide">
                                    <label class="maintenance-info-label">Документы</label>
                                    <div class="maintenance-info-value maintenance-export-groups">
                                        <div v-if="!exportAccess.loaded" class="text-muted small mb-2">
                                            Проверяем доступные форматы...
                                        </div>
                                        <div v-else-if="!hasAnyExportAccess" class="alert alert-warning py-2 px-3 mb-2">
                                            Экспорт отчетов недоступен для вашего аккаунта.
                                        </div>
                                        <template v-else>
                                            <div class="dropdown maintenance-export-group">
                                                <button class="btn btn-outline-dark dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false" :disabled="!!documentActionKey">
                                                    <span v-if="documentActionKey" class="spinner-border spinner-border-sm me-2"></span>
                                                    <i v-else class="fa fa-download me-2"></i>
                                                    {{ documentActionKey ? 'Готовим файл...' : 'Скачать документ' }}
                                                </button>
                                                <ul class="dropdown-menu maintenance-document-download-menu">
                                                    <template v-if="scenarioDocumentTemplates.length > 0">
                                                        <li><h6 class="dropdown-header">Шаблоны организации</h6></li>
                                                        <li v-for="template in scenarioDocumentTemplates" :key="template.id" class="maintenance-document-template-menu-item">
                                                            <div class="maintenance-document-template-menu-title">{{ template.name }}</div>
                                                            <div class="maintenance-document-template-menu-description" v-if="template.description">{{ template.description }}</div>
                                                            <div class="maintenance-document-template-menu-actions">
                                                                <button class="btn btn-sm btn-outline-danger" type="button" @@click="generateScenarioDocumentForTemplate(template, 'pdf')" :disabled="!!documentActionKey || !exportAccess.pdf">
                                                                    <i class="fa fa-file-pdf-o me-1"></i>PDF
                                                                </button>
                                                                <button class="btn btn-sm btn-outline-primary" type="button" @@click="generateScenarioDocumentForTemplate(template, 'word')" :disabled="!!documentActionKey || !exportAccess.word">
                                                                    <i class="fa fa-file-word-o me-1"></i>Word
                                                                </button>
                                                            </div>
                                                        </li>
                                                        <li><hr class="dropdown-divider"></li>
                                                    </template>
                                                    <li><h6 class="dropdown-header">Стандартные документы</h6></li>
                                                    <li v-if="maintenance.status === 3 && exportAccess.pdf">
                                                        <button class="dropdown-item" @@click="generateWorkActPDF()" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-pdf-o text-danger me-2"></i>Акт выполненных работ PDF
                                                        </button>
                                                    </li>
                                                    <li v-if="maintenance.status === 3 && exportAccess.word">
                                                        <button class="dropdown-item" @@click="generateWorkActWord()" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-word-o text-primary me-2"></i>Акт выполненных работ Word
                                                        </button>
                                                    </li>
                                                    <li v-if="exportAccess.pdf">
                                                        <button class="dropdown-item" @@click="generateWorkOrderPDF()" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-pdf-o text-danger me-2"></i>Заказ-наряд PDF
                                                        </button>
                                                    </li>
                                                    <li v-if="exportAccess.word">
                                                        <button class="dropdown-item" @@click="generateWorkOrderWord()" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-word-o text-primary me-2"></i>Заказ-наряд Word
                                                        </button>
                                                    </li>
                                                    <li v-if="exportAccess.pdfWithPhotos">
                                                        <button class="dropdown-item" @@click="generatePDF(true)" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-pdf-o text-danger me-2"></i>Отчет для клиента PDF с фото
                                                        </button>
                                                    </li>
                                                    <li v-if="exportAccess.pdf">
                                                        <button class="dropdown-item" @@click="generatePDF(false)" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-pdf-o text-danger me-2"></i>Отчет для клиента PDF без фото
                                                        </button>
                                                    </li>
                                                    <li v-if="exportAccess.wordWithPhotos">
                                                        <button class="dropdown-item" @@click="generateWord(true)" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-word-o text-primary me-2"></i>Отчет для клиента Word с фото
                                                        </button>
                                                    </li>
                                                    <li v-if="exportAccess.word">
                                                        <button class="dropdown-item" @@click="generateWord(false)" :disabled="!!documentActionKey">
                                                            <i class="fa fa-file-word-o text-primary me-2"></i>Отчет для клиента Word без фото
                                                        </button>
                                                    </li>
                                                </ul>
                                            </div>
                                        </template>
                        </div>
                    </div>
                </div>
            </div>
        </div>
                    </div>
                </div>
            </div>

            <div class="card maintenance-details-card maintenance-documents-card mb-4" v-if="maintenanceDocumentsLoaded">
                <div class="card-header bg-gradient-secondary text-white">
                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <h3 class="card-title mb-0">
                            <i class="fa fa-folder-open me-2"></i>
                            Документы
                        </h3>
                        <button class="btn btn-light btn-sm" type="button" @@click="openSignedDocumentPicker" :disabled="documentUploading">
                            <span v-if="documentUploading" class="spinner-border spinner-border-sm me-2"></span>
                            <i v-else class="fa fa-upload me-2"></i>
                            {{ documentUploading ? 'Загружаем...' : 'Загрузить подписанный файл' }}
                        </button>
                    </div>
                </div>
                <div class="card-body">
                    <input class="d-none" type="file" ref="signedDocumentInput" @@change="uploadSignedDocument" accept=".pdf,.doc,.docx,.jpg,.jpeg,.png">
                    <div v-if="documentUploading" class="d-flex align-items-center gap-2 text-muted mb-3">
                        <i class="fa fa-spinner fa-spin"></i>
                        <span>Загружаем документ...</span>
                    </div>
                    <div v-if="maintenanceDocuments.length === 0" class="maintenance-document-empty">
                        Подписанные документы пока не загружены.
                    </div>
                    <div v-else class="maintenance-document-archive-list">
                        <div class="maintenance-document-archive-item" v-for="document in maintenanceDocuments" :key="document.id">
                            <span class="maintenance-document-icon" :class="getDocumentFormatClass(document)">
                                <i class="fa" :class="getDocumentIconClass(document)"></i>
                            </span>
                            <div class="maintenance-document-archive-body">
                                <div class="maintenance-document-archive-title">
                                    {{ document.title }}
                                    <span class="badge text-bg-light border ms-2">v{{ document.version }}</span>
                                </div>
                                <div class="maintenance-document-archive-meta">
                                    {{ document.format }}
                                    · {{ formatFileSize(document.size) }}
                                    · {{ formatDocumentDate(document.createdAt) }}
                                    <span v-if="document.createdByDisplayName">· {{ document.createdByDisplayName }}</span>
                                </div>
                            </div>
                            <a class="btn btn-outline-dark btn-sm maintenance-document-download" :href="getDocumentDownloadUrl(document.id)" @@click.prevent="downloadSignedDocument(document)">
                                <i class="fa fa-download me-1"></i>
                                Скачать
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Детали услуг -->
            <div class="card maintenance-details-card mb-4" v-if="maintenance.maintenanceDetails && maintenance.maintenanceDetails.length > 0">
                <div class="card-header bg-gradient-info text-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-wrench me-2"></i>
                        Выполненные работы и услуги
                        <span class="badge bg-white text-info ms-2">{{ maintenance.maintenanceDetails.length }}</span>
                    </h3>
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive">
                        <table class="table table-hover maintenance-services-table mb-0">
                            <thead class="table-light">
                                <tr>
                                    <th style="width: 40%">Услуга/Запчасть</th>
                                    <th style="width: 40%">Описание</th>
                                    <th style="width: 20%" class="text-end">Стоимость</th>
                                </tr>
                            </thead>
                            <tbody>
                                <tr v-for="(detail, index) in maintenance.maintenanceDetails" :key="index">
                                    <td>
                                        <div class="service-name">
                                            <small class="text-muted">#{{ index + 1 }}</small>
                                            {{ detail.name }}
                                        </div>
                                        <div class="small text-muted" v-if="detail.materialName || detail.materialQuantity">
                                            {{ detail.materialName || 'Материал' }}
                                            <span v-if="detail.materialQuantity"> · {{ detail.materialQuantity }} {{ detail.materialUnit || '' }}</span>
                                        </div>
                                    </td>
                                    <td>
                                        <div class="service-description" v-if="detail.description">
                                            {{ detail.description }}
                                        </div>
                                        <span class="text-muted" v-else>—</span>
                                    </td>
                                    <td class="text-end">
                                        <span class="service-price" v-if="detail.price">
                                            {{ formatPrice(detail.price) }}
                                        </span>
                                        <span class="text-muted" v-else>—</span>
                                    </td>
                                </tr>
                            </tbody>
                            <tfoot class="table-group-divider" v-if="calculateServicesTotal() > 0">
                                <tr>
                                    <td colspan="2" class="text-end fw-bold">Итого работ/услуг:</td>
                                    <td class="text-end fw-bold text-success">{{ formatPrice(calculateServicesTotal()) }}</td>
                                </tr>
                            </tfoot>
                        </table>
                    </div>
                </div>
            </div>

            <div class="card maintenance-details-card mb-4" v-if="maintenance.linkedDefects && maintenance.linkedDefects.length > 0">
                <div class="card-header bg-gradient-secondary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-exclamation-triangle me-2"></i>
                        Связанные неисправности
                        <span class="badge bg-white text-secondary ms-2">{{ maintenance.linkedDefects.length }}</span>
                    </h3>
                </div>
                <div class="card-body">
                    <div class="list-group list-group-flush">
                        <div class="list-group-item px-0 d-flex justify-content-between align-items-start gap-3" v-for="defect in maintenance.linkedDefects" :key="defect.id">
                            <div class="min-w-0">
                                <a class="fw-semibold text-decoration-none" :href="getDefectUrl(defect)">{{ defect.title }}</a>
                                <div class="text-muted small" v-if="defect.description">{{ defect.description }}</div>
                            </div>
                            <a class="btn btn-outline-dark btn-sm flex-shrink-0" :href="getDefectUrl(defect)">Открыть</a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="card maintenance-details-card mb-4">
                <div class="card-header bg-gradient-secondary text-white">
                    <div class="d-flex justify-content-between align-items-center gap-3 flex-wrap">
                        <h3 class="card-title mb-0">
                            <i class="fa fa-history me-2"></i>
                            История обслуживания
                        </h3>
                        <a :href="getMaintenanceHistoryUrl()" class="btn btn-light btn-sm">
                            <i class="fa fa-external-link me-2"></i>
                            Открыть
                        </a>
                    </div>
                </div>
            </div>

            <!-- Комментарий -->
            <div class="card maintenance-details-card mb-4" v-if="maintenance.comment">
                <div class="card-header bg-gradient-secondary text-white">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-comment me-2"></i>
                        Комментарий
                    </h3>
                </div>
                <div class="card-body">
                    <div class="maintenance-comment-content">
                        <p class="mb-0">{{ maintenance.comment }}</p>
                    </div>
                </div>
            </div>

            <!-- Фотографии -->
            <div class="card maintenance-details-card mb-4" v-if="photoUrls.length > 0 || failedPhotoCount > 0">
                <div class="card-header bg-gradient-warning text-dark">
                    <h3 class="card-title mb-0">
                        <i class="fa fa-camera me-2"></i>
                        Фотографии
                        <span class="badge bg-white text-warning ms-2">{{ photoUrls.length + failedPhotoCount }}</span>
                    </h3>
                </div>
                <div class="card-body">
                    <div class="maintenance-photos-grid">
                        <div class="maintenance-photo-item" v-for="(photoUrl, index) in photoUrls" :key="index">
                            <img :src="photoUrl"
                                 class="maintenance-photo-img"
                                 @@click="openPhotoGallery(index)"
                                 :alt="'Фото ' + (index + 1)">
                            <div class="maintenance-photo-overlay">
                                <button class="btn btn-sm btn-light maintenance-photo-view-btn"
                                        @@click="openPhotoGallery(index)">
                                    <i class="fa fa-search-plus"></i>
                                </button>
                            </div>
                        </div>
                        <div class="maintenance-photo-item bg-light border d-flex flex-column align-items-center justify-content-center text-center p-3"
                             style="cursor: default;"
                             v-for="index in failedPhotoCount"
                             :key="'failed-' + index">
                            <i class="fa fa-image text-muted mb-2" style="font-size: 2rem;"></i>
                            <div class="small text-muted">Не удалось загрузить фото</div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Действия -->
            <div class="maintenance-actions-container">
                <div class="row g-3">
                    <div class="col-12">
                        <a :href="getVehicleUrl()" class="btn btn-outline-dark w-100">
                            <i class="fa fa-arrow-left me-2"></i>
                            К карточке техники
                        </a>
                    </div>
                </div>
            </div>
        </div>

        <div class="modal fade" id="maintenanceWorkflowModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content maintenance-workflow-modal">
                    <div class="modal-header bg-gradient-primary text-white">
                        <h5 class="modal-title">
                            <i class="fa fa-tasks me-2"></i>
                            {{ workflowModalTitle }}
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="mb-3" v-if="workflowAction === 'complete'">
                            <label class="form-label">Фактическая дата выполнения</label>
                            <vue-ctk-date-time-picker class="create-maintenance-date-picker maintenance-workflow-date-picker"
                                                      v-model="workflowDatePickerValue"
                                                      :range="false"
                                                      only-date="true"
                                                      format="DD.MM.YYYY"
                                                      :max-date="moment().format('YYYY-MM-DD')"
                                                      formatted="DD.MM.YYYY"
                                                      output-format="DD.MM.YYYY"
                                                      locale="ru"
                                                      :first-day-of-week="1"
                                                      no-clear-button="true"
                                                      label=""
                                                      @@click.native.stop>
                            </vue-ctk-date-time-picker>
                        </div>
                        <div class="mb-3" v-if="workflowAction === 'complete'">
                            <label class="form-label">{{ mileageUnitLabel }}</label>
                            <input type="number" min="0" step="1" class="form-control" v-model.number="workflowMileage">
                        </div>
                        <div class="mb-3" v-if="workflowAction === 'reschedule' || workflowAction === 'cancel' || workflowAction === 'reopen'">
                            <label class="form-label">Плановая дата</label>
                            <vue-ctk-date-time-picker class="create-maintenance-date-picker maintenance-workflow-date-picker"
                                                      v-model="workflowDatePickerValue"
                                                      :range="false"
                                                      only-date="true"
                                                      format="DD.MM.YYYY"
                                                      formatted="DD.MM.YYYY"
                                                      output-format="DD.MM.YYYY"
                                                      locale="ru"
                                                      :first-day-of-week="1"
                                                      no-clear-button="true"
                                                      label=""
                                                      @@click.native.stop>
                            </vue-ctk-date-time-picker>
                        </div>
                        <div class="row g-3 mb-3" v-if="workflowAction === 'reschedule' || workflowAction === 'reopen'">
                            <div class="col-md-6">
                                <label class="form-label">Время начала</label>
                                <input type="time" class="form-control" v-model="workflowPlannedStartTime">
                            </div>
                            <div class="col-md-6">
                                <label class="form-label">Время окончания</label>
                                <input type="time" class="form-control" v-model="workflowPlannedEndTime">
                            </div>
                        </div>
                        <div class="mb-3" v-if="workflowAction === 'reschedule' || workflowAction === 'reopen'">
                            <label class="form-label">Плановая дата окончания</label>
                            <input type="date" class="form-control" v-model="workflowEndDate">
                        </div>
                        <div class="mb-0">
                            <label class="form-label">Комментарий</label>
                            <textarea class="form-control" rows="3" v-model="workflowReason" placeholder="Необязательно"></textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-primary" @@click="submitWorkflowModal" :disabled="workflowSaving">
                            <span v-if="workflowSaving" class="spinner-border spinner-border-sm me-2"></span>
                            {{ workflowConfirmText }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модалка подтверждения удаления -->
        <div class="modal fade" id="deleteMaintenanceModal" tabindex="-1">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-gradient-danger text-white">
                        <h5 class="modal-title">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Подтверждение удаления
                        </h5>
                        <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <div class="text-center">
                            <i class="fa fa-trash fa-3x text-danger mb-3"></i>
                            <h5>Вы уверены, что хотите удалить это обслуживание?</h5>
                            <p class="text-muted">
                                Дата: <strong>{{ formatDate(maintenance.date) }}</strong><br>
                                Тип: <strong>{{ getMaintenanceTypeText(maintenance.type) }}</strong>
                            </p>
                            <p class="text-danger">
                                <i class="fa fa-warning me-1"></i>
                                Это действие нельзя будет отменить!
                            </p>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-outline-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-danger" @@click="confirmDelete" :disabled="deleteSaving">
                            <span v-if="deleteSaving" class="spinner-border spinner-border-sm me-1"></span>
                            <i v-else class="fa fa-trash me-1"></i>
                            {{ deleteSaving ? 'Удаляем...' : 'Удалить' }}
                        </button>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно галереи -->
        <div class="modal fade" id="photoModal" tabindex="-1">
            <div class="modal-dialog modal-xl">
                <div class="modal-content">
                    <div class="modal-header">
                        <h5 class="modal-title">
                            <i class="fa fa-image me-2"></i>
                            Просмотр фотографии
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body text-center">
                        <div v-if="photoUrls.length > 0">
                            <img :src="photoUrls[currentPhotoIndex]"
                                 class="img-fluid rounded maintenance-photo-large"
                                 :alt="'Фото ' + (currentPhotoIndex + 1)">

                            <div class="maintenance-photo-navigation mt-3">
                                <button class="btn btn-outline-primary"
                                        @@click="currentPhotoIndex = (currentPhotoIndex - 1 + photoUrls.length) % photoUrls.length"
                                        :disabled="photoUrls.length <= 1">
                                    <i class="fa fa-chevron-left"></i>
                                </button>

                                <span class="mx-3 fw-bold">
                                    {{ currentPhotoIndex + 1 }} / {{ photoUrls.length }}
                                </span>

                                <button class="btn btn-outline-primary"
                                        @@click="currentPhotoIndex = (currentPhotoIndex + 1) % photoUrls.length"
                                        :disabled="photoUrls.length <= 1">
                                    <i class="fa fa-chevron-right"></i>
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Модальное окно загрузки -->
        <div class="modal fade" id="loadingModal" tabindex="-1" data-bs-backdrop="static" data-bs-keyboard="false">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body text-center py-4">
                        <div class="spinner-border text-primary mb-3" style="width: 3rem; height: 3rem;" role="status">
                            <span class="visually-hidden">Загрузка...</span>
                        </div>
                        <h5>{{ loadingTitle }}</h5>
                        <p class="text-muted">{{ loadingMessage }}</p>
                    </div>
                </div>
            </div>
        </div>

                    </div>
                </div>
            </div>
        </div>

        <partial name="_MaintenanceErrorModal" />
    </div>
</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/organizations.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/maintenance.organization.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/organizations.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/maintenance.organization.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <script>
        const maintenanceId = '@(ViewData["MaintenanceId"] ?? string.Empty)';
        const maintenanceOrganizationId = '@(ViewData["MaintenanceOrganizationId"] ?? string.Empty)';
        const maintenanceScenarioDocuments = @Html.Raw(scenarioDocumentTemplatesJson);
    </script>
    <environment include="Development">
        <script src="~/app/maintenance.organization.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/app/maintenance.organization.js" asp-append-version="true"></script>
    </environment>
}








