@model OpenCRM.WebApp.Models.Maintenance.UpdateMaintenanceFormModel
@{
    Layout = "/Views/Personal/_PersonalLayout.cshtml";
    ViewData["PersonalVehiclePage"] = true;
    ViewData["Title"] = Text["maintenance.legacy.form.editMaintenance"].Value;
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "maintenance-update-page-body";
    ViewData["BreadcrumbTitle"] = Text["maintenance.legacy.form.editMaintenance"].Value;
    ViewData["PageTitle"] = Text["maintenance.legacy.form.editMaintenance"].Value;
    ViewData["SubtitlePrefix"] = Text["maintenance.legacy.form.subtitleUpdate"].Value;
    ViewData["FormId"] = "maintenanceEditForm";
    ViewData["SaveAction"] = "save_editMaintenance";
    ViewData["SaveButtonText"] = Text["maintenance.legacy.form.saveChanges"].Value;
    var breadcrumbVehicle = Model.Vehicle;

}

<div id="update-maintenance-form">
    <style>
        [v-cloak] {
            display: none;
        }
    </style>

    <div v-cloak>
            <partial name="_MaintenanceProgress" />
            <form id="maintenanceEditForm">
                <div v-if="formLoad" class="d-flex align-items-center gap-2 text-muted mb-4">
                    <i class="fa fa-spinner fa-spin"></i>
                    <span>@Text["maintenance.legacy.form.loadingData"]</span>
                </div>
                <partial name="_MaintenanceSharedSteps" view-data="ViewData" />

                <div class="create-maintenance-step-content" :class="{'active': currentStep === 5}" v-show="currentStep === 5">
                    <div class="card create-maintenance-card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa fa-camera me-2"></i>
                                @Text["maintenance.legacy.photos.manage"]
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-4">
                                <i class="fa fa-check-circle text-success fa-3x mb-3"></i>
                                <h4>@Text["maintenance.legacy.form.update.successTitle"]</h4>
                                <p class="text-muted">@Text["maintenance.legacy.form.update.successText"]</p>
                            </div>

                            <div v-if="existingPhotos.length > 0">
                                <h5>@(Text["maintenance.legacy.photos.existing"].Value.Replace("{0}", "{{ existingPhotos.length }}"))</h5>
                                <div class="row mt-3">
                                    <div class="col-md-4 mb-3" v-for="(photo, index) in existingPhotos" :key="photo.id">
                                        <div class="card h-100">
                                            <img :src="photo.url"
                                                 class="card-img-top"
                                                 style="height: 150px; object-fit: cover;"
                                                 :alt="localizedText.photosPhotoLabel.replace('{0}', index + 1)">
                                            <div class="card-body p-2">
                                                <small class="text-muted">@(Text["maintenance.legacy.photos.photoLabel"].Value.Replace("{0}", "{{ index + 1 }}"))</small>
                                            </div>
                                            <div class="card-footer p-2">
                                                <button type="button" class="btn btn-sm btn-danger w-100" @@click="deleteExistingPhoto(photo, index)">
                                                    <i class="fa fa-trash me-1"></i>@Text["maintenance.legacy.photos.remove"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div v-else>
                                <div class="text-center py-4">
                                    <i class="fa fa-image fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">@Text["maintenance.legacy.photos.existingEmpty"]</p>
                                </div>
                            </div>

                            <div v-if="newPhotos.length > 0" class="mt-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5>@(Text["maintenance.legacy.photos.new"].Value.Replace("{0}", "{{ newPhotos.length }}"))</h5>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @@click="clearNewPhotos">
                                        <i class="fa fa-trash me-1"></i>@Text["maintenance.legacy.photos.clearAll"]
                                    </button>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-4 mb-3" v-for="(photo, index) in newPhotos" :key="'new-' + index">
                                        <div class="card h-100">
                                            <img :src="photo.preview"
                                                 class="card-img-top"
                                                 style="height: 150px; object-fit: cover;"
                                                 :alt="photo.name">
                                            <div class="card-body p-2">
                                                <small class="text-muted d-block text-truncate">{{ photo.name }}</small>
                                                <small class="text-muted">{{ photo.size }}</small>
                                            </div>
                                            <div class="card-footer p-2">
                                                <button type="button" class="btn btn-sm btn-danger w-100" @@click="removeNewPhoto(index)">
                                                    <i class="fa fa-trash me-1"></i>@Text["maintenance.legacy.photos.remove"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4 mt-4">
                                <label class="form-label">@Text["maintenance.legacy.form.update.addNewPhotos"]</label>
                                <input type="file"
                                       class="form-control create-maintenance-input"
                                       id="newPhotos"
                                       multiple
                                       accept="image/*"
                                       @@change="addNewPhotos($event)">
                                <div class="form-text">
                                    @Text["maintenance.legacy.photos.uploadInstructions"]

                                </div>
                            </div>

                            <div v-if="isUploading" class="mt-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@Text["maintenance.legacy.photos.uploading"]</span>
                                    <span>{{ uploadProgress }}%</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" :style="{width: uploadProgress + '%'}"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-dark" @@click="skipPhotoManagement">
                            @Text["maintenance.legacy.form.update.finish"]
                        </button>

                        <button type="button" class="btn btn-success"
                                :disabled="isUploading || newPhotos.length === 0"
                                @@click="uploadNewPhotos">
                            <template v-if="!isUploading">
                                <i class="fa fa-upload me-2"></i>@Text["maintenance.legacy.form.update.uploadRetry"]
                            </template>
                            <template v-else>
                                <i class="fa fa-spinner fa-spin fa-fw"></i> @Text["maintenance.legacy.photos.uploading"]
                            </template>
                        </button>
                    </div>
                </div>
            </form>
        </div>

        <partial name="_MaintenanceErrorModal" />

        <div class="modal fade" id="deletePhotoConfirmModal" tabindex="-1" aria-labelledby="deletePhotoConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title" id="deletePhotoConfirmModalLabel">
                            <i class="fa fa-exclamation-triangle me-2"></i>@Text["maintenance.legacy.form.deletePhoto.confirmTitle"]
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="@Text["maintenance.legacy.form.deletePhoto.close"]"></button>
                    </div>
                    <div class="modal-body">
                        <p>@Text["maintenance.legacy.form.deletePhoto.confirm"]</p>
                        <p class="text-muted small">@Text["maintenance.legacy.form.deletePhoto.warning"]</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">@Text["maintenance.legacy.form.deletePhoto.cancel"]</button>
                        <button type="button" class="btn btn-danger" @@click="confirmDeletePhoto">
                            <i class="fa fa-trash me-1"></i>@Text["maintenance.legacy.photos.remove"]
                        </button>
                    </div>
                </div>
            </div>

    </div>
</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/maintenance.personal.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/maintenance.personal.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <script>
        const maintenanceId = '@Model.MaintenanceId';
        const vehicleId = '@Model.Vehicle.Id';
        const vehicleMileageUnit = @((int)Model.Vehicle.MileageUnit);
        const vehicleCurrentMileage = @(Model.Vehicle.CurrentMileage?.ToString() ?? "null");
        const maintenanceOrganizationId = '@(ViewData["MaintenanceOrganizationId"] ?? string.Empty)';
        const maintenanceReturnUrl = '@(ViewData["MaintenanceReturnUrl"] ?? string.Empty)';
    </script>
    <environment include="Development">
        <script src="~/app/update-maintenance.personal.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/app/update-maintenance.personal.js" asp-append-version="true"></script>
    </environment>
}

@section Breadcrumbs {
    <nav aria-label="@Text["maintenance.legacy.page.breadcrumb"]">
        <ol>
            <li><a href="/vehicles">@Text["maintenance.legacy.page.vehiclePersonal"]</a></li>
            <li><a href="/vehicle/@breadcrumbVehicle?.Id">@(breadcrumbVehicle?.DisplayName ?? Text["maintenance.legacy.page.vehicle"].Value)</a></li>
            <li><a href="/maintenance/@Model.MaintenanceId">@Text["maintenance.legacy.page.maintenance"]</a></li>
            <li><h1 aria-current="page">@Text["maintenance.legacy.form.editMaintenance"]</h1></li>
        </ol>
    </nav>
}
