@model OpenCRM.Modules.Vehicles.Contracts.Dtos.GetVehicleDto
@{
    Layout = "/Views/Personal/_PersonalLayout.cshtml";
    ViewData["PersonalVehiclePage"] = true;
    ViewData["Title"] = Text["maintenance.legacy.form.createMaintenance"].Value;
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "maintenance-create-page-body";
    ViewData["BreadcrumbTitle"] = Text["maintenance.legacy.form.createMaintenance"].Value;
    ViewData["PageTitle"] = Text["maintenance.legacy.form.createMaintenance"].Value;
    ViewData["SubtitlePrefix"] = Text["maintenance.legacy.form.subtitleCreate"].Value;
    ViewData["FormId"] = "maintenanceCreateForm";
    ViewData["SaveAction"] = "save_createMaintenance";
    ViewData["SaveButtonText"] = Text["maintenance.legacy.form.saveMaintenance"].Value;
    var breadcrumbVehicle = Model;

}

<div id="create-maintenance-form">
    <style>
        [v-cloak] {
            display: none;
        }
    </style>
    <div v-cloak>
            <partial name="_MaintenanceProgress" />
            <form id="maintenanceCreateForm">
                <div v-if="formLoad" class="d-flex align-items-center gap-2 text-muted mb-4">
                    <i class="fa fa-spinner fa-spin"></i>
                    <span>@Text["maintenance.legacy.form.loading"]</span>
                </div>
                <partial name="_MaintenanceSharedSteps" view-data="ViewData" />

                <div class="create-maintenance-step-content" :class="{'active': currentStep === 5}" v-show="currentStep === 5">
                    <div class="card create-maintenance-card">
                        <div class="card-header">
                            <h3 class="card-title">
                                <i class="fa fa-camera me-2"></i>
                                @Text["maintenance.legacy.photos.uploadingPhotos"]
                            </h3>
                        </div>
                        <div class="card-body">
                            <div class="text-center mb-4">
                                <i class="fa fa-check-circle text-success fa-3x mb-3"></i>
                                <h4>@Text["maintenance.legacy.photos.successCreate"]</h4>
                                <p class="text-muted">@Text["maintenance.legacy.photos.finishHelpCreate"]</p>
                            </div>

                            <div v-if="photos.length > 0">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5>@(Text["maintenance.legacy.photos.selected"].Value.Replace("{0}", "{{ photos.length }}"))</h5>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @@click="clearPhotoPreviews">
                                        <i class="fa fa-trash me-1"></i>@Text["maintenance.legacy.photos.clearAll"]
                                    </button>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-4 mb-3" v-for="(photo, index) in photos" :key="index">
                                        <div class="card h-100">
                                            <img :src="photo.preview"
                                                 class="card-img-top"
                                                 style="height: 150px; object-fit: cover;"
                                                 :alt="photo.name">
                                            <div class="card-body p-2">
                                                <small class="text-muted d-block text-truncate">{{ photo.name }}</small>
                                                <small class="text-muted">{{ photo.size }}</small>
                                            </div>
                                            <div class="card-footer p-2">
                                                <button type="button" class="btn btn-sm btn-danger w-100" @@click="removePhoto(index)">
                                                    <i class="fa fa-trash me-1"></i>@Text["maintenance.legacy.photos.remove"]
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div v-else>
                                <div class="text-center py-4">
                                    <i class="fa fa-image fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">@Text["maintenance.legacy.photos.empty"]</p>
                                </div>
                            </div>

                            <div class="mb-4">
                                <label class="form-label">@Text["maintenance.legacy.photos.add"]</label>
                                <input type="file"
                                       class="form-control create-maintenance-input"
                                       id="photos"
                                       multiple
                                       accept="image/*"
                                       @@change="changeFile($event)">
                                <div class="form-text">
                                    @Text["maintenance.legacy.photos.uploadInstructions"]
                                    <strong><strong>@Text["maintenance.legacy.photos.limits"]</strong></strong>
                                </div>
                            </div>

                            <div v-if="isUploading" class="mt-4">
                                <div class="d-flex justify-content-between mb-2">
                                    <span>@Text["maintenance.legacy.photos.uploading"]</span>
                                    <span>{{ uploadProgress }}%</span>
                                </div>
                                <div class="progress">
                                    <div class="progress-bar progress-bar-striped progress-bar-animated" :style="{width: uploadProgress + '%'}"></div>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="d-flex justify-content-between mt-4">
                        <button type="button" class="btn btn-outline-dark" @@click="skipPhotoUpload" :disabled="isUploading">
                            @Text["maintenance.legacy.photos.skip"]
                        </button>

                        <button type="button" class="btn btn-success"
                                :disabled="isUploading || photos.length === 0"
                                @@click="uploadPhotos">
                            <template v-if="!isUploading">
                                <i class="fa fa-upload me-2"></i>@Text["maintenance.legacy.form.create.uploadPhoto"]
                            </template>
                            <template v-else>
                                <i class="fa fa-spinner fa-spin fa-fw"></i> @Text["maintenance.legacy.photos.uploading"]
                            </template>
                        </button>
                    </div>
                </div>
            </form>


        <partial name="_MaintenanceErrorModal" />
    </div>
</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/maintenance.personal.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/maintenance.personal.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <script>
        const vehicleId = '@Model.Id';
        const vehicleMileageUnit = @((int)Model.MileageUnit);
        const vehicleCurrentMileage = @(Model.CurrentMileage?.ToString() ?? "null");
        const maintenanceOrganizationId = '@(ViewData["MaintenanceOrganizationId"] ?? string.Empty)';
        const maintenanceReturnUrl = '@(ViewData["MaintenanceReturnUrl"] ?? string.Empty)';
        const maintenancePrefillTitle = '@(ViewData["MaintenancePrefillTitle"] ?? string.Empty)';
        const maintenancePrefillComment = '@(ViewData["MaintenancePrefillComment"] ?? string.Empty)';
        const maintenanceSchedulerSourceCode = '@(ViewData["MaintenanceSchedulerSourceCode"] ?? string.Empty)';
        const maintenanceSchedulerSourceEntityId = '@(ViewData["MaintenanceSchedulerSourceEntityId"] ?? string.Empty)';
        const maintenanceSchedulerTriggerKey = '@(ViewData["MaintenanceSchedulerTriggerKey"] ?? string.Empty)';
    </script>
    <environment include="Development">
        <script src="~/app/create-maintenance.personal.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/app/create-maintenance.personal.js" asp-append-version="true"></script>
    </environment>
}

@section Breadcrumbs {
    <nav aria-label="@Text["maintenance.legacy.page.breadcrumb"]">
        <ol>
            <li><a href="/vehicles">@Text["maintenance.legacy.page.vehiclePersonal"]</a></li>
            <li><a href="/vehicle/@breadcrumbVehicle?.Id">@(breadcrumbVehicle?.DisplayName ?? Text["maintenance.legacy.page.vehicle"].Value)</a></li>
            <li><h1 aria-current="page">@Text["maintenance.legacy.form.createMaintenance"]</h1></li>
        </ol>
    </nav>
}
