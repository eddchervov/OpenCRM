@{
    var saveAction = ViewData["SaveAction"] as string ?? "saveMaintenance";
    var saveButtonText = ViewData["SaveButtonText"] as string ?? Text["maintenance.legacy.form.action.save"].Value;
    var isOrganizationMode = !string.IsNullOrWhiteSpace(ViewData["MaintenanceOrganizationId"] as string);
    var locationLabel = isOrganizationMode ? Text["maintenance.legacy.form.field.location"].Value : Text["maintenance.legacy.form.field.locationShop"].Value;
    var locationPlaceholder = isOrganizationMode ? Text["maintenance.legacy.form.field.performerPlaceholder"].Value : Text["maintenance.legacy.form.field.locationShop"].Value;
}

<div class="create-maintenance-step-content" :class="{'active': currentStep === 1}" v-show="currentStep === 1">
    <div class="card create-maintenance-card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fa fa-info-circle me-2"></i>
                @Text["maintenance.legacy.form.section.basic"]
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Text["maintenance.legacy.form.field.status"] <span class="text-danger">*</span></label>
                    <v-select :options="statuses"
                              :reduce="status => status.id"
                              label="name"
                              :clearable="false"
                              v-model="selectedMaintenance.status"
                              @@input="changeStatus"
                              class="create-maintenance-select">
                        <template slot="no-options">
                            @Text["maintenance.legacy.form.common.notFound"]
                        </template>
                    </v-select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">@Text["maintenance.legacy.form.field.type"] <span class="text-danger">*</span></label>
                    <v-select :options="types"
                              :reduce="m => m.id"
                              label="name"
                              :clearable="false"
                              v-model="selectedMaintenance.type"
                              class="create-maintenance-select">
                        <template slot="no-options">
                            @Text["maintenance.legacy.form.common.notFound"]
                        </template>
                    </v-select>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">
                        @Text["maintenance.legacy.form.field.plannedDate"]
                        <span class="text-danger" v-if="plannedDateRequired">*</span>
                    </label>
                    <vue-ctk-date-time-picker class="create-maintenance-date-picker"
                                             v-model="plannedDatePicker"
                                              :range="false"
                                              only-date="true"
                                              format="@Text["maintenance.legacy.date.calendarFormat"]"
                                              formatted="@Text["maintenance.legacy.date.calendarFormat"]"
                                             output-format="@Text["maintenance.legacy.date.calendarFormat"]"
                                              locale="@System.Globalization.CultureInfo.CurrentUICulture.Name"
                                              :first-day-of-week="1"
                                              no-clear-button="true"
                                              label=""
                                              @@click.native.stop>
                    </vue-ctk-date-time-picker>
                    <div class="form-text" v-if="selectedMaintenance.status === maintenanceStatuses.completed">
                        @Text["maintenance.legacy.form.field.optionalMaintenance"]
                    </div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">@Text["maintenance.legacy.form.field.plannedEndDate"]</label>
                    <input type="date" class="form-control" v-model="selectedMaintenance.plannedEndDate" :min="selectedMaintenance.plannedDate">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Text["maintenance.legacy.form.field.startTime"]</label>
                    <input type="time" class="form-control" v-model="selectedMaintenance.plannedStartTime">
                </div>
                <div class="col-md-6 mb-3">
                    <label class="form-label">@Text["maintenance.legacy.form.field.endTime"]</label>
                    <input type="time" class="form-control" v-model="selectedMaintenance.plannedEndTime">
                </div>

                <div class="col-md-6 mb-3" v-if="showsCompletedDate">
                    <label class="form-label">@Text["maintenance.legacy.form.field.actualDate"] <span class="text-danger">*</span></label>
                    <vue-ctk-date-time-picker class="create-maintenance-date-picker"
                                             v-model="completedDatePicker"
                                              :range="false"
                                              only-date="true"
                                              format="@Text["maintenance.legacy.date.calendarFormat"]"
                                             :max-date="moment().format('YYYY-MM-DD')"
                                              formatted="@Text["maintenance.legacy.date.calendarFormat"]"
                                             output-format="@Text["maintenance.legacy.date.calendarFormat"]"
                                              locale="@System.Globalization.CultureInfo.CurrentUICulture.Name"
                                              :first-day-of-week="1"
                                              no-clear-button="true"
                                              label=""
                                              @@click.native.stop>
                    </vue-ctk-date-time-picker>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">@locationLabel</label>
                    <input type="text" class="form-control create-maintenance-input"
                           v-model.trim="selectedMaintenance.location"
                           placeholder="@locationPlaceholder">
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">@Text["maintenance.legacy.form.field.performer"]</label>
                    <input type="text" class="form-control create-maintenance-input"
                           v-model.trim="selectedMaintenance.performer"
                           placeholder="@Text["maintenance.legacy.form.field.performerPlaceholder"]">
                    <div class="form-text">@Text["maintenance.legacy.form.field.performerHelp"]</div>
                </div>

                <div class="col-md-6 mb-3">
                    <label class="form-label">{{ mileageInputLabel }}</label>
                    <input type="number" class="form-control create-maintenance-input"
                           v-model.number="selectedMaintenance.mileage"
                           @@input="changeMileage"
                           :placeholder="mileageInputPlaceholder">
                </div>
            </div>
        </div>
    </div>

    <div class="text-end mt-4">
        <button type="button" class="btn btn-dark create-maintenance-next-step" @@click="nextStep(2)">
            @Text["maintenance.legacy.form.action.next"] <i class="fa fa-arrow-right ms-2"></i>
        </button>
    </div>
</div>

<div class="create-maintenance-step-content" :class="{'active': currentStep === 2}" v-show="currentStep === 2">
    <div class="card create-maintenance-card">
        <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
            <h3 class="card-title mb-0">
                <i class="fa fa-wrench me-2"></i>
                @Text["maintenance.legacy.form.section.services"]
            </h3>
            <div class="text-muted small">
                @Text["maintenance.legacy.form.review.total"] <strong>{{ maintenanceDetailsTotalText }}</strong>
            </div>
        </div>
        <div class="card-body">
            <div id="services-container">
                <div class="create-maintenance-service-item card mb-3" v-for="(detail, index) in selectedMaintenance.maintenanceDetails" :key="index">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h6 class="mb-0">
                                <template v-if="index > 0">
                                    @(Text["maintenance.legacy.form.field.serviceNumber"].Value.Replace("{0}", "{{ index + 1 }}"))
                                </template>
                                <template v-else>
                                    @Text["maintenance.legacy.form.field.service"]
                                </template>
                            </h6>
                            <button type="button" class="btn btn-sm btn-danger create-maintenance-remove-service"
                                    v-if="index !== 0"
                                    @@click="removeService(index)">
                                <i class="fa fa-times"></i>
                            </button>
                        </div>
                        <div class="row">
                            <div class="col-md-6 mb-3">
                                <label class="form-label">@Text["maintenance.legacy.form.field.serviceName"] <span class="text-danger">*</span></label>
                                <input type="text" class="form-control create-maintenance-input"
                                       v-model.trim="detail.name"
                                       placeholder="@Text["maintenance.legacy.form.field.servicePlaceholder"]" required>
                                <div v-if="!detail.name" class="text-danger small mt-1">
                                    @Text["maintenance.legacy.form.field.serviceRequired"]
                                </div>
                            </div>
                            <div class="col-md-4 mb-3">
                                <label class="form-label">@Text["maintenance.legacy.form.field.price"]</label>
                                <input type="number" class="form-control create-maintenance-input"
                                       v-model.number="detail.price"
                                       @@input="normalizeDetailPrice(detail)"
                                       placeholder="0.00" step="0.01" min="0">
                            </div>
                            <div class="col-md-2 mb-3 d-flex align-items-end">
                                <div class="w-100 small text-muted text-md-end">
                                    <span v-if="detail.price !== null && detail.price !== undefined">
                                        {{ formatPrice(detail.price) }}
                                    </span>
                                    <span v-else>@Text["maintenance.legacy.form.field.priceMissing"]</span>
                                </div>
                            </div>
                            <div class="col-12 mb-3">
                                <label class="form-label">@Text["maintenance.legacy.form.field.description"]</label>
                                <textarea class="form-control create-maintenance-input"
                                          v-model.trim="detail.description"
                                          rows="2"
                                          placeholder="@Text["maintenance.legacy.form.field.descriptionPlaceholder"]"></textarea>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <button type="button" class="btn btn-dark mt-3" @@click="click_addMaintenanceDetail">
                <i class="fa fa-plus me-2"></i>@Text["maintenance.legacy.form.action.addService"]
            </button>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-outline-dark create-maintenance-prev-step" @@click="prevStep(1)">
            <i class="fa fa-arrow-left me-2"></i>@Text["maintenance.legacy.form.action.back"]
        </button>
        <button type="button" class="btn btn-dark create-maintenance-next-step" @@click="nextStep(3)">
            @Text["maintenance.legacy.form.action.next"] <i class="fa fa-arrow-right ms-2"></i>
        </button>
    </div>
</div>

<div class="create-maintenance-step-content" :class="{'active': currentStep === 3}" v-show="currentStep === 3">
    <div class="card create-maintenance-card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fa fa-comment me-2"></i>
                @Text["maintenance.legacy.form.section.additional"]
            </h3>
        </div>
        <div class="card-body">
            <div class="mb-3">
                <label class="form-label">@Text["maintenance.legacy.form.field.comment"]</label>
                <textarea class="form-control create-maintenance-input"
                          v-model.trim="selectedMaintenance.comment"
                          rows="4"
                          placeholder="@Text["maintenance.legacy.form.field.notesPlaceholder"]"></textarea>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-outline-dark create-maintenance-prev-step" @@click="prevStep(2)">
            <i class="fa fa-arrow-left me-2"></i>@Text["maintenance.legacy.form.action.back"]
        </button>
        <button type="button" class="btn btn-dark create-maintenance-next-step" @@click="nextStep(4)">
            @Text["maintenance.legacy.form.action.next"] <i class="fa fa-arrow-right ms-2"></i>
        </button>
    </div>
</div>

<div class="create-maintenance-step-content" :class="{'active': currentStep === 4}" v-show="currentStep === 4">
    <div class="card create-maintenance-card">
        <div class="card-header">
            <h3 class="card-title">
                <i class="fa fa-check-circle me-2"></i>
                @Text["maintenance.legacy.form.review.title"]
            </h3>
        </div>
        <div class="card-body">
            <div class="row">
                <div class="col-md-6">
                    <h5>@Text["maintenance.legacy.form.section.basic"]</h5>
                    <div class="create-maintenance-review-section">
                        <p><strong>@Text["maintenance.legacy.form.field.status"]:</strong> {{ getMaintenanceStatusText(selectedMaintenance.status) }}</p>
                        <p><strong>@Text["maintenance.legacy.form.field.type"]:</strong> {{ getTypeName(selectedMaintenance.type) }}</p>
                        <p><strong>@Text["maintenance.legacy.form.review.period"]:</strong> {{ DD_MM_YYYY(selectedMaintenance.plannedDate) }} {{ selectedMaintenance.plannedStartTime }}<template v-if="selectedMaintenance.plannedEndDate"> — {{ DD_MM_YYYY(selectedMaintenance.plannedEndDate) }} {{ selectedMaintenance.plannedEndTime }}</template></p>
                        <p v-if="showsCompletedDate"><strong>@Text["maintenance.legacy.form.field.actualDate"]:</strong> {{ DD_MM_YYYY(selectedMaintenance.completedDate) }}</p>
                        <p><strong>@Text["maintenance.legacy.form.field.locationLabel"]:</strong> {{ selectedMaintenance.location || localizedText.valueUnspecified }}</p>
                        <p><strong>@Text["maintenance.legacy.form.field.performer"]:</strong> {{ selectedMaintenance.performer || localizedText.formStatusNotSpecified }}</p>
                        <p><strong>{{ mileageReviewLabel }}:</strong> {{ mileageReviewValue }}</p>
                    </div>
                </div>
                <div class="col-md-6">
                    <h5>@Text["maintenance.legacy.form.section.services"]</h5>
                    <div class="create-maintenance-review-section">
                        <div v-if="selectedMaintenance.maintenanceDetails.length === 0">
                            <p>@Text["maintenance.legacy.form.review.servicesEmpty"]</p>
                        </div>
                        <div v-else v-for="(detail, index) in selectedMaintenance.maintenanceDetails" :key="index" class="pb-2 mb-2" :class="{'border-bottom': index !== selectedMaintenance.maintenanceDetails.length - 1 }">
                            <strong>{{ index + 1 }}. {{ detail.name }}</strong>
                            <span v-if="detail.price"><br>@Text["maintenance.legacy.form.review.serviceCost"] {{ formatPrice(detail.price) }}</span>
                            <span v-if="detail.description"><br>@Text["maintenance.legacy.form.review.description"] {{ detail.description }}</span>
                        </div>
                        <p class="mt-3 mb-0"><strong>@Text["maintenance.legacy.form.review.total"]</strong> {{ maintenanceDetailsTotalText }}</p>
                    </div>
                </div>
            </div>

            <div v-if="selectedMaintenance.comment" class="create-maintenance-review-section mt-4">
                <h5>@Text["maintenance.legacy.form.field.comment"]</h5>
                <p>{{ selectedMaintenance.comment }}</p>
            </div>
        </div>
    </div>

    <div class="d-flex justify-content-between mt-4">
        <button type="button" class="btn btn-outline-dark create-maintenance-prev-step" @@click="prevStep(3)">
            <i class="fa fa-arrow-left me-2"></i>@Text["maintenance.legacy.form.action.back"]
        </button>
        <button type="button" class="btn btn-success" :disabled="saveModal" @@click="@saveAction">
            <template v-if="!saveModal">
                <i class="fa fa-save me-2"></i>@saveButtonText
            </template>
            <template v-else>
                <i class="fa fa-spinner fa-spin fa-fw"></i> @Text["maintenance.legacy.form.create.saving"]
            </template>
        </button>
    </div>
</div>



