<div class="row mb-3">
    <div class="col-12">
        <div class="create-maintenance-progress">
            <div class="create-maintenance-progress-step" :class="{'active': currentStep === 1}">
                <div class="create-maintenance-step-number">1</div>
                <div class="create-maintenance-step-label">Основная информация</div>
            </div>
            <div class="create-maintenance-progress-step" :class="{'active': currentStep === 2}">
                <div class="create-maintenance-step-number">2</div>
                <div class="create-maintenance-step-label">Услуги и работы</div>
            </div>
            <div class="create-maintenance-progress-step" :class="{'active': currentStep === 3}">
                <div class="create-maintenance-step-number">3</div>
                <div class="create-maintenance-step-label">Дополнительно</div>
            </div>
            <div class="create-maintenance-progress-step" :class="{'active': currentStep === 4}">
                <div class="create-maintenance-step-number">4</div>
                <div class="create-maintenance-step-label">Проверка</div>
            </div>
            <div class="create-maintenance-progress-step" :class="{'active': currentStep === 5}">
                <div class="create-maintenance-step-number">5</div>
                <div class="create-maintenance-step-label">Фотографии</div>
            </div>
        </div>
    </div>
</div>

