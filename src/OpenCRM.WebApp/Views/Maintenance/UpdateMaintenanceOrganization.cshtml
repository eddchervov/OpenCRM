@model OpenCRM.WebApp.Models.Maintenance.UpdateMaintenanceFormModel
@using System.Text.Json
@using OpenCRM.Services.Interfaces.Organizations.Dtos
@using OpenCRM.WebApp.Presentation
@{
    Layout = "/Views/Shared/_Layout.cshtml";
    ViewData["Title"] = "Редактировать обслуживание";
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "maintenance-update-page-body";
    ViewData["BreadcrumbTitle"] = "Редактировать обслуживание";
    ViewData["PageTitle"] = "Редактировать обслуживание";
    ViewData["SubtitlePrefix"] = "Измените информацию об обслуживании или ремонте ";
    ViewData["FormId"] = "maintenanceEditForm";
    ViewData["SaveAction"] = "save_editMaintenance";
    ViewData["SaveButtonText"] = "Сохранить изменения";
    ViewData["HideMaintenanceBreadcrumb"] = true;
    var organizationId = ViewData["MaintenanceOrganizationId"] as string ?? string.Empty;
    if (string.IsNullOrWhiteSpace(organizationId))
    {
        organizationId = Context.Request.Query["organizationId"].ToString();
    }
    var organizationName = ViewData["MaintenanceOrganizationName"] as string ?? string.Empty;
    var workspaceShell = ViewData["MaintenanceWorkspaceShell"] as OrganizationWorkspaceShellDto;
    var maintenanceFormProfile = ViewData["MaintenanceFormProfile"] as OrganizationWorkspaceMaintenanceFormProfileDto;
    var rootBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var rootBreadcrumbText = string.IsNullOrWhiteSpace(organizationId)
        ? "Моя техника"
        : !string.IsNullOrWhiteSpace(organizationName)
            ? organizationName
            : "Организация";
    var vehiclesBreadcrumbUrl = string.IsNullOrWhiteSpace(organizationId) ? "/vehicles" : "/organizations";
    var vehicleUrl = string.IsNullOrWhiteSpace(organizationId)
        ? $"/vehicle/{Model.Vehicle.Id}"
        : $"/vehicle/{Model.Vehicle.Id}?organizationId={organizationId}";
    var workspaceSidebar = new OpenCRM.WebApp.Models.Organizations.OrganizationWorkspaceSidebarViewModel
    {
        OrganizationId = string.IsNullOrWhiteSpace(organizationId) ? Guid.Empty : Guid.Parse(organizationId),
        OrganizationName = organizationName,
        CurrentSection = "maintenance",
        HasVehiclesModule = ViewData["MaintenanceHasVehiclesModule"] is bool vehiclesModule && vehiclesModule,
        HasClientsModule = ViewData["MaintenanceHasClientsModule"] is bool clientsModule && clientsModule,
        HasDefectsModule = ViewData["MaintenanceHasDefectsModule"] is bool defectsModule && defectsModule,
        HasCountersModule = ViewData["MaintenanceHasCountersModule"] is bool countersModule && countersModule,
        HasSchedulerModule = ViewData["MaintenanceHasSchedulerModule"] is bool schedulerModule && schedulerModule,
        CanManageSettings = ViewData["MaintenanceCanManageSettings"] is bool canManageSettings && canManageSettings,
        MembersCount = ViewData["MaintenanceOrganizationMembersCount"] is int membersCount ? membersCount : 0,
        WorkspaceShell = workspaceShell
    };
    var scenarioCatalog = ViewData["MaintenanceScenarioCatalog"] as OpenCRM.Modules.Catalog.Contracts.Dtos.OrganizationScenarioCatalogDto;
    var scenarioUx = ViewData["MaintenanceScenarioUxProfile"] as OrganizationScenarioUxProfile
        ?? OrganizationScenarioPresentationHelper.ResolveUxProfile(scenarioCatalog?.ScenarioCode);
    ViewData["Title"] = scenarioUx.EditTitle;
    ViewData["BreadcrumbTitle"] = scenarioUx.EditTitle;
    ViewData["PageTitle"] = scenarioUx.EditTitle;
    ViewData["SubtitlePrefix"] = scenarioUx.SubtitlePrefix;
    var scenarioWorkTypesJson = JsonSerializer.Serialize(scenarioCatalog?.WorkTypes.Where(x => x.IsActive).Select(x => new { id = x.Id, name = x.Name, code = x.Code }) ?? []);
    var scenarioMaterialsJson = JsonSerializer.Serialize(scenarioCatalog?.Materials.Where(x => x.IsActive).Select(x => new { id = x.Id, name = x.Name, code = x.Code }) ?? []);
    var maintenanceFormProfileJson = JsonSerializer.Serialize(
        maintenanceFormProfile ?? new OrganizationWorkspaceMaintenanceFormProfileDto(),
        new JsonSerializerOptions { PropertyNamingPolicy = JsonNamingPolicy.CamelCase });
    var showLinkedDefects = maintenanceFormProfile?.ShowLinkedDefects ?? scenarioUx.ShowDefectsByDefault;
    var showPhotos = maintenanceFormProfile?.ShowPhotos ?? scenarioUx.ShowPhotosByDefault;
    var defectPlural = workspaceShell?.Scenario?.Terms?.Defects ?? "Неисправности";
    var defectSingularLower = workspaceShell?.Scenario?.Terms?.Defect.ToLowerInvariant() ?? "неисправность";
    var defectSingularTitle = workspaceShell?.Scenario?.Terms?.Defect ?? "Неисправность";
}

<div id="update-maintenance-form">
    <style>
        [v-cloak] {
            display: none;
        }
    </style>

    <div v-cloak>
        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organizations-page")">
            <div class="@(string.IsNullOrWhiteSpace(organizationId) ? "container" : "container-fluid px-4 px-xxl-5 organization-workspace-shell organization-workspace-shell-wide")">
                <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-flow")">
                    <nav aria-label="breadcrumb" class="mb-4">
                        <ol class="breadcrumb mb-0">
                            <li class="breadcrumb-item"><a href="@rootBreadcrumbUrl" class="text-decoration-none">@rootBreadcrumbText</a></li>
                            <li class="breadcrumb-item"><a href="@vehiclesBreadcrumbUrl" class="text-decoration-none">Техника</a></li>
                            <li class="breadcrumb-item">
                                <a href="@vehicleUrl" class="text-decoration-none">
                                    @Helpers.VehicleDisplayName.Format(Model.Vehicle.BrandName, Model.Vehicle.ModelName, Model.Vehicle.RegistrationPlate)
                                    @if (Model.Vehicle.YearIssue != null && Model.Vehicle.YearIssue != 0)
                                    {
                                        @Model.Vehicle.YearIssue <text>г.</text>
                                    }
                                </a>
                            </li>
                            <li class="breadcrumb-item active" aria-current="page">@scenarioUx.EditTitle</li>
                        </ol>
                    </nav>

                    <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-layout")">
                    @if (!string.IsNullOrWhiteSpace(organizationId))
                    {
                        <aside class="organization-workspace-sidebar">
                            <partial name="/Views/Organizations/_WorkspaceSidebar.cshtml" model="workspaceSidebar" />
                        </aside>
                    }
                        <div class="@(string.IsNullOrWhiteSpace(organizationId) ? string.Empty : "organization-workspace-content")">
            <partial name="_MaintenancePageIntro" model="Model.Vehicle" view-data="ViewData" />
            <form id="maintenanceEditFormElement">
                <div v-if="formLoad" class="d-flex align-items-center gap-2 text-muted mb-4">
                    <i class="fa fa-spinner fa-spin"></i>
                    <span>@scenarioUx.LoadingText</span>
                </div>
                <partial name="_MaintenanceOrganizationMainFields" view-data="ViewData" />

                @if (showLinkedDefects)
                {
                <div class="card create-maintenance-card maintenance-org-section-card mt-4">
                    <div class="card-header d-flex justify-content-between align-items-center flex-wrap gap-2">
                        <h3 class="card-title mb-0">
                            <i class="fa fa-exclamation-triangle me-2"></i>
                            Связанные @(defectPlural.ToLowerInvariant())
                        </h3>
                        <span class="badge text-bg-light border">{{ selectedMaintenance.linkedDefects.length }}</span>
                    </div>
                    <div class="card-body">
                        <div class="row g-2 align-items-end mb-3" v-if="availableDefectsToLink.length > 0">
                            <div class="col-md">
                                <label class="form-label">Добавить @defectSingularLower этого авто</label>
                                <select class="form-select" v-model="selectedLinkedDefectId">
                                    <option value="">Выберите @defectSingularLower</option>
                                    <option v-for="defect in availableDefectsToLink" :key="defect.id" :value="defect.id">
                                        {{ defect.title }} - {{ defectStatusText(defect.statusCode) }}
                                    </option>
                                </select>
                            </div>
                            <div class="col-md-auto">
                                <button type="button" class="btn btn-outline-dark" @@click="linkSelectedDefect" :disabled="!selectedLinkedDefectId">
                                    <i class="fa fa-link me-1"></i>Привязать
                                </button>
                            </div>
                        </div>

                        <div v-if="selectedMaintenance.linkedDefects.length > 0" class="list-group">
                            <div class="list-group-item d-flex justify-content-between align-items-start gap-3"
                                 v-for="defect in selectedMaintenance.linkedDefects"
                                 :key="defect.id">
                                <div class="min-w-0">
                                    <div class="fw-semibold">{{ defect.title }}</div>
                                    <div class="text-muted small" v-if="defect.description">{{ defect.description }}</div>
                                    <div class="d-flex flex-wrap gap-2 mt-2">
                                        <span class="badge text-bg-light border">{{ defectSeverityText(defect.severityCode) }}</span>
                                        <span class="badge text-bg-light border">{{ defectStatusText(defect.statusCode) }}</span>
                                    </div>
                                </div>
                                <button type="button" class="btn btn-sm btn-outline-danger" @@click="unlinkDefect(defect)">
                                    <i class="fa fa-unlink me-1"></i>Отвязать
                                </button>
                            </div>
                        </div>
                        <div v-else class="text-muted">
                            Для этой записи пока не привязаны @(defectPlural.ToLowerInvariant()).
                        </div>
                    </div>
                </div>
                }

                @if (showPhotos)
                {
                <div class="card create-maintenance-card maintenance-org-section-card mt-4" id="maintenance-photo-section">
                    <div class="card-header">
                        <h3 class="card-title">
                            <i class="fa fa-camera me-2"></i>
                            Управление фотографиями
                        </h3>
                    </div>
                    <div class="card-body">
                        <div v-if="saveSuccessMessage" class="alert alert-success">
                            {{ saveSuccessMessage }}
                        </div>
                        <div v-if="photoUploadErrorMessage" class="alert alert-warning">
                            {{ photoUploadErrorMessage }}
                        </div>
                        <div v-if="existingPhotos.length > 0">
                                <h5>Существующие фотографии ({{ existingPhotos.length }})</h5>
                                <div class="row mt-3">
                                    <div class="col-md-4 mb-3" v-for="(photo, index) in existingPhotos" :key="photo.id">
                                        <div class="card h-100">
                                            <img :src="photo.url"
                                                 class="card-img-top"
                                                 style="height: 150px; object-fit: cover;"
                                                 :alt="'Фото ' + (index + 1)">
                                            <div class="card-body p-2">
                                                <small class="text-muted">Фото {{ index + 1 }}</small>
                                            </div>
                                            <div class="card-footer p-2">
                                                <button type="button" class="btn btn-sm btn-danger w-100" @@click="deleteExistingPhoto(photo, index)">
                                                    <i class="fa fa-trash me-1"></i>Удалить
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div v-else>
                                <div class="text-center py-4">
                                    <i class="fa fa-image fa-3x text-muted mb-3"></i>
                                    <p class="text-muted">Нет загруженных фотографий</p>
                                </div>
                            </div>

                            <div v-if="newPhotos.length > 0" class="mt-4">
                                <div class="d-flex justify-content-between align-items-center mb-3">
                                    <h5>Новые фотографии для загрузки ({{ newPhotos.length }})</h5>
                                    <button type="button" class="btn btn-sm btn-outline-danger" @@click="clearNewPhotos">
                                        <i class="fa fa-trash me-1"></i>Очистить все
                                    </button>
                                </div>

                                <div class="row mt-3">
                                    <div class="col-md-4 mb-3" v-for="(photo, index) in newPhotos" :key="'new-' + index">
                                        <div class="card h-100">
                                            <img :src="photo.preview"
                                                 class="card-img-top"
                                                 style="height: 150px; object-fit: cover;"
                                                 :alt="photo.name">
                                            <div class="card-body p-2">
                                                <small class="text-muted d-block text-truncate">{{ photo.name }}</small>
                                                <small class="text-muted">{{ photo.size }}</small>
                                            </div>
                                            <div class="card-footer p-2">
                                                <button type="button" class="btn btn-sm btn-danger w-100" @@click="removeNewPhoto(index)">
                                                    <i class="fa fa-trash me-1"></i>Удалить
                                                </button>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                            </div>

                            <div class="mb-4 mt-4">
                                <label class="form-label">Добавить новые фотографии</label>
                                <input type="file"
                                       class="form-control create-maintenance-input"
                                       id="newPhotos"
                                       multiple
                                       accept="image/*"
                                       @@change="addNewPhotos($event)">
                                <div class="form-text">
                                    Можно загрузить до 10 фотографий (JPG, PNG).
                                    <strong>Максимальный общий размер всех файлов: 100 МБ</strong>
                                </div>
                            </div>

                        <div v-if="isUploading" class="mt-4">
                            <div class="d-flex justify-content-between mb-2">
                                <span>Загрузка...</span>
                                <span>{{ uploadProgress }}%</span>
                            </div>
                            <div class="progress">
                                <div class="progress-bar progress-bar-striped progress-bar-animated" :style="{width: uploadProgress + '%'}"></div>
                            </div>
                        </div>

                        <div class="d-flex justify-content-end gap-2 mt-4" v-if="newPhotos.length > 0 && photoUploadErrorMessage">
                            <button type="button" class="btn btn-outline-dark" @@click="clearNewPhotos" :disabled="isUploading">
                                Убрать новые фото
                            </button>
                            <button type="button" class="btn btn-dark" @@click="uploadNewPhotos" :disabled="isUploading">
                                <template v-if="!isUploading">
                                    <i class="fa fa-upload me-2"></i>Повторить загрузку фотографий
                                </template>
                                <template v-else>
                                    <i class="fa fa-spinner fa-spin fa-fw"></i> Загрузка...
                                </template>
                            </button>
                        </div>
                    </div>
                </div>
                }

                <div class="maintenance-org-actions">
                    <a href="javascript:void(0)"
                       class="btn btn-outline-dark"
                       @@click="redirectToCar">
                        Отмена
                    </a>
                    <button type="button" class="btn btn-dark" :disabled="saveModal || isUploading" @@click="save_editMaintenance">
                        <template v-if="!saveModal">
                            <i class="fa fa-save me-2"></i>Сохранить изменения
                        </template>
                        <template v-else>
                            <i class="fa fa-spinner fa-spin fa-fw"></i> {{ selectedFiles.length > 0 ? 'Сохраняем и загружаем фото...' : 'Сохраняем...' }}
                        </template>
                    </button>
                </div>
            </form>
        </div>

        <partial name="_MaintenanceErrorModal" />

        <div class="modal fade" id="deletePhotoConfirmModal" tabindex="-1" aria-labelledby="deletePhotoConfirmModalLabel" aria-hidden="true">
            <div class="modal-dialog">
                <div class="modal-content">
                    <div class="modal-header bg-warning text-dark">
                        <h5 class="modal-title" id="deletePhotoConfirmModalLabel">
                            <i class="fa fa-exclamation-triangle me-2"></i>Подтверждение удаления
                        </h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Закрыть"></button>
                    </div>
                    <div class="modal-body">
                        <p>Вы уверены, что хотите удалить эту фотографию?</p>
                        <p class="text-muted small">Действие нельзя будет отменить.</p>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Отмена</button>
                        <button type="button" class="btn btn-danger" @@click="confirmDeletePhoto">
                            <i class="fa fa-trash me-1"></i>Удалить
                        </button>
                    </div>
                </div>
            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/organizations.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/maintenance.organization.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/organizations.min.css" asp-append-version="true" />
        <link rel="stylesheet" href="~/css/maintenance.organization.css" asp-append-version="true" />
    </environment>
}

@section Scripts {
    <script>
        const maintenanceId = '@Model.MaintenanceId';
        const vehicleId = '@Model.Vehicle.Id';
        const vehicleMileageUnit = @((int)Model.Vehicle.MileageUnit);
        const vehicleCurrentMileage = @(Model.Vehicle.CurrentMileage?.ToString() ?? "null");
        const maintenanceOrganizationId = '@(ViewData["MaintenanceOrganizationId"] ?? string.Empty)';
        const maintenanceReturnUrl = '@(ViewData["MaintenanceReturnUrl"] ?? string.Empty)';
        const maintenanceScenarioWorkTypes = @Html.Raw(scenarioWorkTypesJson);
        const maintenanceScenarioMaterials = @Html.Raw(scenarioMaterialsJson);
        const maintenanceFormProfile = @Html.Raw(maintenanceFormProfileJson);
    </script>
    <environment include="Development">
        <script src="~/app/update-maintenance.organization.page.js" asp-append-version="true"></script>
    </environment>
    <environment exclude="Development">
        <script src="~/app/update-maintenance.organization.page.js" asp-append-version="true"></script>
    </environment>
}


