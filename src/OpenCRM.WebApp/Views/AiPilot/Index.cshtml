@{
    var isPreview = ViewData["AssistantPreviewOnly"] is true;
    var workspaceUrl = ViewData["AssistantWorkspaceUrl"] as string;
    ViewData["Title"] = $"ИИ помощник — {Brand.DisplayName}";
    ViewData["SeoRobots"] = "noindex,nofollow";
    var isEmbedded = ViewData["AssistantEmbedded"] is true;
    ViewData["BodyClass"] = isEmbedded
        ? "organizations-entry assistant-page assistant-embedded"
        : "organizations-entry assistant-page";
    ViewData["WorkspaceEntry"] = !isEmbedded;
    Layout = isEmbedded
        ? "/Views/Shared/_AssistantEmbeddedLayout.cshtml"
        : "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="@Url.Content("~/css/organizations-entry.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/app/date-time-fields.css")" asp-append-version="true" />
    <link rel="stylesheet" href="@Url.Content("~/css/ai-pilot.css")" asp-append-version="true" />
}

@section Scripts {
    @if (!isPreview)
    {
        <script src="@Url.Content("~/app/date-time-fields.bundle.js")" asp-append-version="true" defer></script>
        <script src="@Url.Content("~/js/ai-pilot-telegram.js")" asp-append-version="true" defer></script>
        <script src="@Url.Content("~/js/ai-pilot.js")" asp-append-version="true" defer></script>
        <script src="@Url.Content("~/js/ai-pilot-dashboard.js")" asp-append-version="true" defer></script>
        @if (isEmbedded)
        {
            <script src="@Url.Content("~/js/ai-pilot-embed.js")" asp-append-version="true" defer></script>
        }
    }
}

    <div class="pilot" data-ai-pilot data-embedded="@(isEmbedded ? "true" : "false")" data-organization-id="@ViewData["OrganizationId"]" data-api-url="@Url.Content("~/api/v1/assistant")" data-token-url="@Url.Content("~/api/v1/antiforgery/token")">
        @if (!isEmbedded)
        {
            <section class="intro">
                <div class="intro-heading">
                    <h1>ИИ помощник</h1>
                </div>
                <div class="workspace-chip" aria-live="polite">
                    <span class="chip-icon" aria-hidden="true">⌂</span>
                    <span><strong data-organization>@(isPreview ? ViewData["AssistantOrganizationName"] : "Загружаем…")</strong></span>
                </div>
            </section>
        }
        else
        {
            <span data-organization hidden></span>
        }

        <div class="@(isPreview ? "assistant-preview" : null)" inert="@(isPreview ? "" : null)" aria-hidden="@(isPreview ? "true" : null)">
        <nav class="assistant-tabs" role="tablist" aria-label="Разделы помощника">
            <button class="assistant-tab is-active" type="button" role="tab" id="assistant-tab-conversation" aria-controls="assistant-panel-conversation" aria-selected="true" data-assistant-tab="conversation" disabled>Разговор</button>
            <button class="assistant-tab" type="button" role="tab" id="assistant-tab-history" aria-controls="assistant-panel-history" aria-selected="false" data-assistant-tab="history" disabled>История разговоров</button>
            <button class="assistant-tab" type="button" role="tab" id="assistant-tab-usage" aria-controls="assistant-panel-usage" aria-selected="false" data-assistant-tab="usage" disabled>Лимиты и использование</button>
        </nav>

        <section class="assistant-tab-panel" role="tabpanel" id="assistant-panel-conversation" aria-labelledby="assistant-tab-conversation" data-assistant-panel="conversation">
        <section class="work-grid" aria-label="Создание действия голосом или текстом">
            <div class="conversation-column">
                <section class="panel conversation-panel" aria-labelledby="chat-title">
                    <div class="conversation-heading">
                        <h2 id="chat-title">Переписка</h2>
                        <button class="button button-secondary" type="button" data-new-conversation>Новый разговор</button>
                    </div>
                    <div class="conversation-toolbar">
                        <label class="speech-option"><input type="checkbox" data-speak-replies disabled /> Озвучивать ответы</label>
                        <button class="button button-secondary" type="button" data-telegram-connect hidden aria-haspopup="dialog" aria-controls="telegram-dialog">Telegram</button>
                    </div>
                    <div class="chat-messages" data-chat-messages role="log" aria-live="polite" aria-label="Разговор с помощником">
                        <div class="chat-message chat-assistant"><strong>Помощник</strong><p>Расскажите про автомобиль и работы. Если чего-то не хватит, я спрошу. Можно отвечать голосом или текстом.</p></div>
                    </div>
                    <div class="target-choice" data-clarification hidden>
                        <strong class="field-label" data-clarification-message>Уточните выбор</strong>
                        <div class="clarification-choices" data-clarification-choices></div>
                    </div>

                    <div class="conversation-actions">
                        <button class="button button-primary" type="button" data-open-composer aria-haspopup="dialog" aria-controls="composer-dialog" disabled>Новое сообщение</button>
                        <span class="field-help" data-conversation-status role="status">Ожидает сообщения</span>
                    </div>
                    <aside class="pending-action" data-pending-action hidden>
                        <div><strong>Действие готово к проверке</strong><span data-pending-target></span></div>
                        <button class="button button-secondary" type="button" data-open-draft aria-haspopup="dialog" aria-controls="draft-dialog">Проверить действие</button>
                    </aside>
                    <p class="field-help">Переписка сохраняется в истории разговоров.</p>
                </section>

            </div>

        </section>

        <dialog class="panel input-panel composer-panel assistant-dialog" id="composer-dialog" aria-labelledby="composer-title" data-composer-dialog>
            <div class="dialog-heading">
                <h2 id="composer-title">Ваше сообщение</h2>
                <button class="dialog-close" type="button" data-close-dialog aria-label="Закрыть сообщение" autofocus>×</button>
            </div>
            <p class="dialog-feedback" data-dialog-feedback hidden role="status"></p>

            <div class="input-tabs" role="tablist" aria-label="Способ ввода">
                <button class="input-tab is-active" type="button" role="tab" aria-selected="true" data-tab="voice">Голос</button>
                <button class="input-tab" type="button" role="tab" aria-selected="false" data-tab="text">Текстом</button>
            </div>

            <div class="voice-pane" data-pane="voice">
                <div class="recorder-box">
                    <button class="record-button" type="button" data-record aria-label="Начать запись голоса">
                        <span class="record-glyph" aria-hidden="true"></span>
                    </button>
                    <strong data-record-title>Записать голосовое</strong>
                    <span class="muted" data-record-hint>Говорите свободно, как привыкли на работе</span>
                    <span class="record-timer" data-record-timer hidden>00:00</span>
                </div>
                <label class="upload-control">
                    <input type="file" accept="audio/*" data-audio-file />
                    <span aria-hidden="true">↑</span> Загрузить аудио
                    <small data-audio-limit>Поддерживаемые аудиоформаты</small>
                </label>
            </div>

            <div class="transcript-block">
                <div class="transcript-heading"><label class="field-label" for="transcript">Текст сообщения</label><span class="editable-tag">проверьте перед отправкой</span></div>
                <textarea id="transcript" rows="3" placeholder="Введите фразу или запишите голосом…" data-transcript></textarea>
                <div class="transcript-actions">
                    <span class="field-help" data-transcribe-cost></span>
                    <button class="button button-primary" type="button" data-prepare disabled>Отправить в чат</button>
                </div>
            </div>

            <details class="examples">
                <summary>Примеры фраз</summary>
                <button type="button" class="example" data-example="А123ВС154, заменили масло и фильтр. Взял 6 500 рублей наличными."><span>01</span> «А123ВС154, масло и фильтр, взял 6 500»</button>
                <button type="button" class="example" data-example="М456ОР154 приехала сейчас. Начинаем диагностику."><span>02</span> «М456ОР154 приехала, начинаем диагностику»</button>
                <button type="button" class="example" data-example="Запиши В789КТ154 завтра в 10:30 на замену колодок. Стоимость 4 000 рублей."><span>03</span> «Запиши В789КТ154 завтра в 10:30»</button>
            </details>
        </dialog>

        <dialog class="panel draft-panel assistant-dialog" id="draft-dialog" aria-labelledby="draft-title" data-draft-dialog>
            <div class="dialog-heading">
                <h2 id="draft-title">Подтверждение действия</h2>
                <button class="dialog-close" type="button" data-close-dialog aria-label="Закрыть подтверждение" autofocus>×</button>
            </div>
            <span class="draft-status" data-draft-status>Ожидает команды</span>
            <p class="dialog-feedback" data-dialog-feedback hidden role="status"></p>
            <div class="draft-empty" data-draft-empty>
                <div class="empty-illustration" aria-hidden="true"><span>✓</span></div>
                <strong>Здесь появится действие</strong>
                <p>Обсудите задачу в переписке. Здесь вы проверите и подтвердите подготовленное действие.</p>
            </div>
            <div class="draft-content" data-draft hidden>
                <div class="summary" data-summary></div>
                <div class="plan-preview">
                    <strong data-plan-target></strong>
                    <ul class="warning-list" data-plan-changes></ul>
                    <div class="read-result" data-read-result hidden></div>
                    <label class="destructive-confirm" data-destructive-confirm hidden>
                        <input type="checkbox" data-confirm-destructive />
                        <span>Проверил объект и подтверждаю перечисленное действие.</span>
                    </label>
                </div>
                <button class="button button-confirm" type="button" data-execute disabled>Подтвердить</button>
                <p class="confirm-help">Данные сохранятся только после вашего подтверждения.</p>
            </div>
            <div class="result" data-result hidden role="status"></div>
        </dialog>
        <dialog class="panel assistant-dialog telegram-dialog" id="telegram-dialog" aria-labelledby="telegram-title" data-telegram-dialog>
            <div class="dialog-heading">
                <h2 id="telegram-title">Подключения Telegram</h2>
                <button class="dialog-close" type="button" data-telegram-close aria-label="Закрыть Telegram" autofocus>×</button>
            </div>
            <p class="field-help">Подключается аккаунт Telegram. Телефон и компьютер с этим аккаунтом отдельно не учитываются.</p>
            <p class="dialog-feedback" data-telegram-feedback hidden role="status"></p>
            <section class="telegram-section" aria-labelledby="telegram-self-title">
                <h3 id="telegram-self-title">Моё подключение</h3>
                <p class="telegram-connection-status" data-telegram-status role="status">Проверяем подключение…</p>
                <dl class="telegram-binding" data-telegram-binding hidden>
                    <div><dt>Telegram ID</dt><dd data-telegram-user-id></dd></div>
                    <div><dt>Подключён</dt><dd data-telegram-connected-at></dd></div>
                </dl>
                <p class="field-help">Бот: <strong data-telegram-bot>—</strong></p>
                <p class="field-help" data-telegram-selection hidden></p>
                <p class="field-help" data-telegram-unavailable hidden>Подключение новых аккаунтов сейчас недоступно. Существующую привязку можно отключить.</p>
                <div class="telegram-actions">
                    <button class="button button-primary" type="button" data-telegram-create-link disabled>Подключить Telegram</button>
                    <button class="button button-secondary" type="button" data-telegram-refresh>Обновить</button>
                </div>
                <div class="telegram-link-panel" data-telegram-link-panel hidden>
                    <a class="button button-primary" data-telegram-link target="_blank" rel="noopener noreferrer">Открыть Telegram и подключить</a>
                    <span class="field-help" data-telegram-link-expiry></span>
                    <p class="field-help">Прежняя привязка заменится только после подключения по новой ссылке.</p>
                </div>
                <details class="telegram-disconnect" data-telegram-disconnect-section hidden>
                    <summary>Отключить аккаунт</summary>
                    <label><input type="checkbox" data-telegram-disconnect-confirm>Отключить мой Telegram-помощник во всех организациях. История разговоров сохранится.</label>
                    <button class="button button-secondary" type="button" data-telegram-disconnect disabled>Отключить Telegram</button>
                </details>
            </section>
            <section class="telegram-section" data-telegram-team hidden aria-labelledby="telegram-team-title">
                <h3 id="telegram-team-title">Подключения сотрудников</h3>
                <p class="field-help">Аккаунты участников, у которых в боте сейчас выбрана эта организация.</p>
                <ul class="telegram-team-list" data-telegram-team-list></ul>
                <p class="field-help" data-telegram-team-empty hidden>Подключённых аккаунтов для этой организации пока нет.</p>
                <div class="dashboard-pagination" data-telegram-team-pagination hidden>
                    <button class="button button-secondary" type="button" data-telegram-team-prev>Назад</button>
                    <span data-telegram-team-page></span>
                    <button class="button button-secondary" type="button" data-telegram-team-next>Дальше</button>
                </div>
            </section>
        </dialog>
        </section>

        <section class="assistant-tab-panel assistant-dashboard" role="tabpanel" id="assistant-panel-history" aria-labelledby="assistant-tab-history" data-assistant-panel="history" hidden>
            <div class="panel dashboard-panel">
                <div class="panel-heading"><h2>История разговоров</h2></div>
                <div class="dashboard-toolbar history-toolbar">
                    <label><span>Канал</span><select data-history-channel disabled><option value="">Все каналы</option><option value="web">Сайт</option><option value="telegram">Telegram</option></select></label>
                    <span class="field-help history-retention" data-history-retention></span>
                    <button class="button button-secondary" type="button" data-history-refresh disabled>Обновить</button>
                </div>
                <div class="dashboard-message" data-history-status role="status" aria-live="polite">Загрузка истории…</div>
                <div class="history-layout" data-history-content hidden>
                    <div class="history-sidebar">
                        <div class="history-list" data-history-list aria-label="Разговоры"></div>
                        <nav class="history-pagination" data-history-pagination aria-label="Страницы разговоров" hidden><button type="button" data-history-prev aria-label="Предыдущая страница разговоров" disabled>‹</button><div class="history-page-numbers" data-history-page></div><button type="button" data-history-next aria-label="Следующая страница разговоров" disabled>›</button></nav>
                    </div>
                    <section class="history-detail" aria-label="Выбранный разговор">
                        <div class="history-detail-heading"><div><strong data-history-title>Выберите разговор</strong><span class="field-help" data-history-meta></span></div><button class="button button-secondary" type="button" data-history-resume hidden>Продолжить разговор</button></div>
                        <div class="history-messages" data-history-messages aria-live="polite"></div>
                        <nav class="history-pagination history-message-pagination" data-history-message-pagination aria-label="Страницы сообщений" hidden><button type="button" data-history-message-prev aria-label="Предыдущая страница сообщений" disabled>‹</button><div class="history-page-numbers" data-history-message-page></div><button type="button" data-history-message-next aria-label="Следующая страница сообщений" disabled>›</button></nav>
                    </section>
                </div>
            </div>
        </section>

        <section class="assistant-tab-panel assistant-dashboard" role="tabpanel" id="assistant-panel-usage" aria-labelledby="assistant-tab-usage" data-assistant-panel="usage" hidden>
            <div class="panel dashboard-panel">
                <div class="panel-heading"><h2>Лимиты и использование</h2></div>
                <div class="dashboard-toolbar usage-filters">
                    <div class="usage-date-field" data-ui-date-picker data-label="С" data-input-id="usage-from"><input type="hidden" data-usage-from disabled /></div>
                    <div class="usage-date-field" data-ui-date-picker data-label="По" data-input-id="usage-to"><input type="hidden" data-usage-to disabled /></div>
                    <label><span>Канал</span><select data-usage-channel disabled><option value="">Все каналы</option><option value="web">Сайт</option><option value="telegram">Telegram</option></select></label>
                    <button class="button button-secondary" type="button" data-usage-apply disabled>Применить</button>
                    <button class="button button-secondary" type="button" data-usage-refresh disabled>Обновить</button>
                </div>
                <div class="dashboard-message" data-usage-status role="status" aria-live="polite">Откройте вкладку, чтобы загрузить данные.</div>
                <div data-usage-content hidden>
                    <div class="usage-budget-grid" data-usage-budgets></div>
                    <h3 class="dashboard-subheading">За выбранный период</h3>
                    <div class="usage-summary" data-usage-summary></div>
                    <h3 class="dashboard-subheading">По каналу</h3>
                    <div class="table-scroll"><table class="dashboard-table"><thead><tr><th>Канал</th><th>Запросы</th><th>Расход</th><th>Резерв</th><th>Токены</th></tr></thead><tbody data-usage-channels></tbody></table></div>
                    <h3 class="dashboard-subheading">По сотрудникам</h3>
                    <div class="table-scroll"><table class="dashboard-table"><thead><tr><th>Сотрудник</th><th>Запросы</th><th>Расход</th><th>Резерв</th><th>Токены</th></tr></thead><tbody data-usage-users></tbody></table></div>
                </div>
            </div>
        </section>

        <div class="capabilities-actions"><button class="button button-secondary" type="button" data-open-capabilities aria-haspopup="dialog">Доступные команды</button></div>
        <dialog class="capabilities-dialog" data-capabilities-dialog aria-labelledby="capabilities-title">
            <div class="capabilities-dialog-heading"><h2 id="capabilities-title">Доступные команды</h2><button class="button button-secondary" type="button" data-close-capabilities aria-label="Закрыть окно">Закрыть</button></div>
            <div data-actions-list></div>
        </dialog>

        <div class="assistant-toast" data-toast role="status" aria-live="polite" hidden></div>
        </div>
        @if (isPreview)
        {
            <div class="assistant-pro-overlay">
                <a class="assistant-pro-notice" href="@(workspaceUrl + "#billing")">
                    <span class="assistant-pro-icon" aria-hidden="true"><svg viewBox="0 0 24 24" fill="none"><rect x="5" y="10" width="14" height="11" rx="2" /><path d="M8 10V7a4 4 0 0 1 8 0v3M12 14v3" /></svg></span>
                    <span>ИИ помощник доступен в PRO</span>
                    <svg class="assistant-pro-arrow" viewBox="0 0 24 24" fill="none" aria-hidden="true"><path d="m9 5 7 7-7 7" /></svg>
                </a>
            </div>
        }
    </div>
