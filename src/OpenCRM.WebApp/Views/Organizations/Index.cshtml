@model OpenCRM.WebApp.Models.Organizations.OrganizationIndexViewModel
@using OpenCRM.WebApp.Navigation

@{
    ViewData["Title"] = Text["entry.organizations"].Value;
    ViewData["SeoRobots"] = "noindex,nofollow";
    ViewData["BodyClass"] = "organizations-entry";
    ViewData["WorkspaceEntry"] = true;
    Layout = "/Views/Shared/_Layout.cshtml";
}

<section class="entry-page">
    <div class="entry-shell">
        <header class="entry-heading">
            <div>
                <h1>@Text["entry.organizations"]</h1>
                <p>@Text["entry.chooseOrganization"]</p>
            </div>
            <div class="entry-heading-actions">
                @if (Model.CanCreateOrganization)
                {
                    <a class="btn entry-primary" href="/organizations/create"><span aria-hidden="true">+</span> @Text["entry.createOrganization"]</a>
                }
            </div>
        </header>
        @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
        {
            <div class="alert alert-success" role="status">@Model.StatusMessage</div>
        }
        @if (!string.IsNullOrWhiteSpace(Model.ErrorMessage))
        {
            <div class="alert alert-danger" role="alert">@Model.ErrorMessage</div>
        }

        @if (!Model.CanCreateOrganization && !string.IsNullOrWhiteSpace(Model.CreateOrganizationMessage))
        {
            <div class="alert alert-warning" role="status">
                @Model.CreateOrganizationMessage
                @if (Model.Overview.HasArchivedOrganizations)
                {
                    <a href="#organization-archive-tab">@Text["entry.openArchive"]</a>
                }
            </div>
        }

        <partial name="_PendingOrganizationInvitations" model="Model.Invitations" />

        <div class="entry-tabs" role="tablist" aria-label="@Text["entry.organizationList"]">
            <button class="active" id="organization-active-tab" data-bs-toggle="tab" data-bs-target="#organization-active-list" type="button" role="tab" aria-controls="organization-active-list" aria-selected="true">
                @Text["entry.active"] <span>@Model.Overview.Organizations.Count</span>
            </button>
            <button id="organization-archive-tab" data-bs-toggle="tab" data-bs-target="#organization-archive-list" type="button" role="tab" aria-controls="organization-archive-list" aria-selected="false">
                @Text["entry.archive"] <span>@Model.Overview.ArchivedOrganizations.Count</span>
            </button>
        </div>
        <div class="tab-content">
            <div class="tab-pane show active" id="organization-active-list" role="tabpanel" aria-labelledby="organization-active-tab" tabindex="0">
                @if (!Model.Overview.HasOrganizations)
                {
                    <div class="entry-empty">
                        <i class="fa fa-building-o" aria-hidden="true"></i>
                        <h2>@Text["entry.yourWorkspace"]</h2>
                        <p>@Text["entry.createOrganizationHelp"]</p>
                        @if (Model.CanCreateOrganization)
                        {
                            <a class="btn entry-primary" href="/organizations/create">@Text["entry.createOrganization"]</a>
                        }
                    </div>
                }
                else
                {
                    <div class="entry-organization-grid">
                        @foreach (var organization in Model.Overview.Organizations)
                        {
                            Model.WorkspaceAccessByOrganizationId.TryGetValue(organization.Id, out var workspaceAccess);
                            var hasDedicatedWorkspace = OrganizationWorkspaceUrlHelper.HasDedicatedWorkspace(organization.PrimaryScenarioCode);
                            var scenario = Text[$"organization.create.scenario.{organization.PrimaryScenarioCode}.title"];
                            var role = Text[$"organization.role.{organization.CurrentUserRoleCode}"];

                            <article class="entry-organization">
                                <div class="entry-organization-type"><i class="fa fa-building-o" aria-hidden="true"></i> @(scenario.ResourceNotFound ? organization.PrimaryScenarioName : scenario.Value)</div>
                                <h2>
                                    @if (hasDedicatedWorkspace)
                                    {
                                        <a href="@OrganizationWorkspaceUrlHelper.Resolve(organization)">@organization.Name</a>
                                    }
                                    else
                                    {
                                        @organization.Name
                                    }
                                </h2>
                                @if (!string.IsNullOrWhiteSpace(organization.Description))
                                {
                                    <p class="entry-organization-description">@organization.Description</p>
                                }
                                <div class="entry-organization-meta">
                                    <span>@(role.ResourceNotFound ? organization.CurrentUserRoleName : role.Value)</span>
                                    <span><i class="fa fa-users" aria-hidden="true"></i> @Text["entry.members"] @organization.MembersCount</span>
                                </div>
                                @if (workspaceAccess?.IsReadOnly == true)
                                {
                                    <div class="entry-access-note"><i class="fa fa-lock" aria-hidden="true"></i> @Text["entry.readOnly"]</div>
                                }
                                <div class="entry-organization-actions">
                                    @if (hasDedicatedWorkspace)
                                    {
                                        <a class="btn entry-primary" href="@OrganizationWorkspaceUrlHelper.Resolve(organization)">@Text["entry.open"] <span aria-hidden="true">→</span></a>
                                    }
                                    else
                                    {
                                        <span class="entry-muted">@Text["entry.workspaceUnavailable"]</span>
                                    }
                                    @if (organization.CanManageSettings && hasDedicatedWorkspace)
                                    {
                                        <a class="btn entry-secondary" href='@OrganizationWorkspaceUrlHelper.Resolve(organization, "settings")'>@Text["entry.settings"]</a>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
            <div class="tab-pane" id="organization-archive-list" role="tabpanel" aria-labelledby="organization-archive-tab" tabindex="0">
                @if (!Model.Overview.HasArchivedOrganizations)
                {
                    <div class="entry-empty">
                        <i class="fa fa-archive" aria-hidden="true"></i>
                        <h2>@Text["entry.archiveEmpty"]</h2>
                        <p>@Text["entry.archiveHelp"]</p>
                    </div>
                }
                else
                {
                    <div class="alert alert-warning">@Text["entry.archiveRetention"]</div>
                    <div class="entry-organization-grid">
                        @foreach (var organization in Model.Overview.ArchivedOrganizations)
                        {
                            <article class="entry-organization">
                                <div class="entry-organization-type"><i class="fa fa-archive" aria-hidden="true"></i> @Text["entry.archived"]</div>
                                <h2>@organization.Name</h2>
                                <p class="entry-muted">@Text["entry.archivedAt", organization.ArchiveDate?.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture) ?? Text["entry.notSpecified"].Value]</p>
                                <div class="entry-access-note">
                                    @(organization.DaysLeft switch
                                    {
                                        null => Text["entry.deleteUnknown"].Value,
                                        <= 0 => Text["entry.deleteToday"].Value,
                                        1 => Text["entry.deleteTomorrow"].Value,
                                        _ => Text["entry.deletedIn", organization.DaysLeft].Value
                                    })
                                </div>
                                <div class="entry-organization-actions">
                                    @if (organization.CanRestore)
                                    {
                                        <form asp-controller="Organizations" asp-action="Restore" asp-route-organizationId="@organization.Id" method="post">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn entry-secondary">@Text["entry.restore"]</button>
                                        </form>
                                    }
                                </div>
                            </article>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</section>

@section Styles {
    <environment include="Development">
        <link rel="stylesheet" href="~/css/organizations-entry.css" asp-append-version="true" />
    </environment>
    <environment exclude="Development">
        <link rel="stylesheet" href="~/css/organizations-entry.min.css" asp-append-version="true" />
    </environment>
}
