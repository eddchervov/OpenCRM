@model ResetPasswordModel
@{
    ViewData["Title"] = "Сбросить пароль";
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container narrow-form">
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">Сбросить пароль</h1>

                    <form method="post" class="auth-form">
                        <input asp-for="Code" type="hidden" />
                        <input asp-for="UserId" type="hidden" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        @if (!string.IsNullOrEmpty(Model.StatusMessage))
                        {
                            <div class="alert alert-danger auth-alert-message" role="alert">
                                @Model.StatusMessage
                            </div>
                        }

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" readonly />
                            <label asp-for="Email" class="form-label">Email</label>
                        </div>

                        <div class="form-floating mb-3">
                            <input asp-for="Password" class="form-control" autocomplete="new-password" aria-describedby="password-requirements"
                                   aria-required="true" placeholder="Новый пароль" />
                            <label asp-for="Password">Новый пароль</label>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <partial name="_PasswordRequirements" />

                        <div class="form-floating mb-3">
                            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password"
                                   aria-required="true" placeholder="Подтвердите пароль" />
                            <label asp-for="ConfirmPassword">Подтвердите пароль</label>
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button class="w-100 btn btn-dark btn-lg auth-btn mb-3" type="submit">Изменить пароль</button>

                        <div class="auth-links text-center">
                            <div class="mb-2">
                                <a href="~/auth/login">Вернуться к входу</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

