@model RegisterModel
@using OpenCRM.WebApp.Infrastructure.Security
@inject IConfiguration Configuration

@{
    ViewData["Title"] = $"{Text["auth.registerButton"]} {Brand.DisplayNameLower}";
    var isEmailDeliveryAvailable = EmailDeliveryPolicy.IsAvailable(Configuration);
}

<div class="auth-page register-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container">
                <!-- Блок формы регистрации -->
                <div class="auth-form-wrapper">
                    <div class="auth-form-kicker">@Brand.DisplayName</div>
                    <h1 class="auth-title">@Text["auth.createAccount"]</h1>
                    <p class="auth-subtitle">@Text["auth.registerSubtitle"]</p>

                    @if (isEmailDeliveryAvailable)
                    {
                        <div class="mb-4">
                            <a asp-action="EmailCodeLogin"
                           asp-controller="Auth"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="w-100 btn btn-lg rounded-4 btn-light auth-email-code-link"
                           title="@Text["auth.signInByEmailCodeTitle"]">
                                <i class="fa fa-envelope-o me-3" aria-hidden="true"></i>
                                @Text["auth.signInByEmailCode"]
                            </a>
                        </div>
                    }

                    @if (isEmailDeliveryAvailable)
                    {
                        <div class="auth-divider">
                            <span>@Text["auth.orRegisterByEmail"]</span>
                        </div>
                    }

                    <form method="post"
                          asp-route-returnUrl="@Model.ReturnUrl"
                          class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-floating mb-3">
                            <input type="email" asp-for="Email" class="form-control" placeholder="@Text["auth.emailPlaceholder"]">
                            <label asp-for="Email">@Text["auth.email"]</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" asp-for="Password" class="form-control" placeholder="@Text["auth.password"]" autocomplete="new-password" aria-describedby="password-requirements">
                            <label asp-for="Password">@Text["auth.password"]</label>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>
                        <partial name="_PasswordRequirements" />

                        <partial name="_RegistrationConsentFields" model="Model.PersonalDataProcessingConsent" />

                        <button class="w-100 btn btn-dark btn-lg auth-btn mb-3" type="submit">@Text["auth.registerButton"]</button>

                        <div class="auth-links text-center">
                            <div>
                                @Text["auth.haveAccount"] <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Text["auth.signInLink"]</a>
                            </div>
                        </div>
                    </form>
                </div>

                <partial name="_AuthVisual" />
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

