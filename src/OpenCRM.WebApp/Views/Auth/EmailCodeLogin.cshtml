@model EmailCodeLoginModel

@{
    ViewData["Title"] = $"{Text["auth.emailCodeTitle"]} {Brand.DisplayNameLower}";
}

<div class="auth-page email-code-login-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container narrow-form">
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">@Text["auth.emailCodeTitle"]</h1>

                    @if (!string.IsNullOrWhiteSpace(Model.StatusMessage))
                    {
                        <div class="alert alert-info auth-alert-message">
                            @Model.StatusMessage
                        </div>
                    }

                    <form method="post" asp-action="SendEmailLoginCode" class="auth-form email-code-form">
                        <input type="hidden" asp-for="ReturnUrl" />
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-floating mb-3">
                            <input type="email" asp-for="Email" class="form-control" placeholder="@Text["auth.emailPlaceholder"]">
                            <label asp-for="Email">@Text["auth.email"]</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        @if (Model.RequiresRegistrationConsent)
                        {
                            <div class="auth-form-note mb-3">
                                @Text["auth.noAccountFound"]
                            </div>

                            <partial name="_RegistrationConsentFields" model="Model.PersonalDataProcessingConsent" />
                        }

                        <button class="w-100 btn btn-dark btn-lg auth-btn mb-3" type="submit">@Text["auth.sendCode"]</button>
                    </form>

                    @if (Model.CodeSent)
                    {
                        <div class="auth-divider">
                            <span>@Text["auth.codeValidFor"]</span>
                        </div>

                        <form method="post" asp-action="VerifyEmailLoginCode" class="auth-form email-code-form">
                            <input type="hidden" asp-for="Email" />
                            <input type="hidden" asp-for="ReturnUrl" />

                            <div class="form-floating mb-3">
                                <input type="text"
                                       asp-for="Code"
                                       class="form-control email-code-form__code"
                                       placeholder="12345678"
                                       inputmode="numeric"
                                       autocomplete="one-time-code"
                                       maxlength="8">
                                <label asp-for="Code">@Text["auth.eightDigitCode"]</label>
                                <span asp-validation-for="Code" class="text-danger"></span>
                            </div>

                            <button class="w-100 btn btn-dark btn-lg auth-btn mb-3" type="submit">@Text["auth.signIn"]</button>
                        </form>
                    }

                    <div class="auth-links text-center">
                        <a asp-controller="Auth" asp-action="Login" asp-route-returnUrl="@Model.ReturnUrl">@Text["auth.signInWithPassword"]</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
