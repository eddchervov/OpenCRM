<aside class="auth-visual" aria-label="Рабочее пространство @Brand.DisplayName">
    <div class="auth-visual__brand">
        <span class="auth-visual__brand-mark"></span>
        @Brand.DisplayName
    </div>
    <div class="auth-visual__panel">
        <span class="auth-visual__eyebrow">CRM для автобизнеса</span>
        <div class="auth-visual__modules" aria-label="Основные разделы">
            <span><i class="fa fa-calendar" aria-hidden="true"></i>Записи</span>
            <span><i class="fa fa-users" aria-hidden="true"></i>Клиенты</span>
            <span><i class="fa fa-car" aria-hidden="true"></i>Автомобили</span>
            <span><i class="fa fa-file-text-o" aria-hidden="true"></i>Документы</span>
        </div>
    </div>
</aside>
