<aside class="auth-visual" aria-label="@Text["auth.workspaceCrm"] @Brand.DisplayName">
    <div class="auth-visual__brand">
        <span class="auth-visual__brand-mark"></span>
        @Brand.DisplayName
    </div>
    <div class="auth-visual__panel">
        <span class="auth-visual__eyebrow">@Text["auth.workspaceCrm"]</span>
        <div class="auth-visual__modules" aria-label="@Text["auth.mainSections"]">
            <span><i class="fa fa-calendar" aria-hidden="true"></i>@Text["auth.bookings"]</span>
            <span><i class="fa fa-users" aria-hidden="true"></i>@Text["auth.clients"]</span>
            <span><i class="fa fa-car" aria-hidden="true"></i>@Text["auth.vehicles"]</span>
            <span><i class="fa fa-file-text-o" aria-hidden="true"></i>@Text["auth.documents"]</span>
        </div>
    </div>
</aside>
