@model LoginModel
@using OpenCRM.WebApp.Infrastructure.Security
@inject IConfiguration Configuration

@{
    ViewData["Title"] = $"{Text["auth.loginTitle"]} {Brand.DisplayNameLower}";
    var isEmailDeliveryAvailable = EmailDeliveryPolicy.IsAvailable(Configuration);
}

<div class="auth-page login-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container">
                <!-- Блок формы входа -->
                <div class="auth-form-wrapper">
                    <div class="auth-form-kicker">@Brand.DisplayName</div>
                    <h1 class="auth-title">@Text["auth.loginTitle"]</h1>
                    <p class="auth-subtitle">@Text["auth.loginSubtitle"]</p>

                    @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                    {
                        <div class="alert alert-danger auth-alert-message">
                            @Model.ErrorMessage
                        </div>
                    }

                    @if (isEmailDeliveryAvailable)
                    {
                        <div class="mb-4">
                            <a asp-action="EmailCodeLogin"
                           asp-controller="Auth"
                           asp-route-returnUrl="@Model.ReturnUrl"
                           class="w-100 btn btn-lg rounded-4 btn-light auth-email-code-link"
                           title="@Text["auth.signInByEmailCodeTitle"]">
                                <i class="fa fa-envelope-o me-3" aria-hidden="true"></i>
                                @Text["auth.signInByEmailCode"]
                            </a>
                        </div>
                    }

                    @if (isEmailDeliveryAvailable)
                    {
                        <div class="auth-divider">
                            <span>@Text["auth.orEmailPassword"]</span>
                        </div>
                    }

                    <form method="post" asp-route-returnUrl="@Model.ReturnUrl" class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-floating mb-3">
                            <input type="email" asp-for="Email" class="form-control" placeholder="@Text["auth.emailPlaceholder"]">
                            <label asp-for="Email">@Text["auth.email"]</label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="form-floating mb-3">
                            <input type="password" asp-for="Password" class="form-control" placeholder="@Text["auth.password"]">
                            <label asp-for="Password">@Text["auth.password"]</label>
                            <span asp-validation-for="Password" class="text-danger"></span>
                        </div>

                        <button class="w-100 btn btn-dark btn-lg auth-btn mb-3" type="submit">@Text["auth.signIn"]</button>

                        <div class="auth-links text-center">
                            @if (isEmailDeliveryAvailable)
                            {
                                <div class="mb-2">
                                    <a href="~/auth/forgotPassword" id="forgot-password">@Text["auth.forgotPassword"]</a>
                                </div>
                            }
                            <div>
                                @Text["auth.noAccount"] <a asp-controller="Auth" asp-action="Register" asp-route-returnUrl="@Model.ReturnUrl">@Text["auth.register"]</a>
                            </div>
                        </div>
                    </form>
                </div>

                <partial name="_AuthVisual" />
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

