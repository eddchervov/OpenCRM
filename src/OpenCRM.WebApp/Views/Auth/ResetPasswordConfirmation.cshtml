@{
    ViewData["Title"] = "Подтверждение сброса пароля";
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container extra-narrow-form">
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">@ViewData["Title"]</h1>

                    <div class="alert alert-success auth-alert-message" role="alert">
                        <p class="mb-0">
                            Ваш пароль был успешно сброшен.
                        </p>
                    </div>

                    <div class="text-center mt-4">
                        <a href="~/auth/login" class="btn btn-dark auth-btn d-inline-flex align-items-center justify-content-center px-4">Войти в аккаунт</a>
                    </div>

                    <div class="auth-links text-center mt-3">
                        <a href="~/">Вернуться на главную</a>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
