@{
    ViewData["Title"] = Text["auth.invalidLink"].Value;
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container extra-narrow-form">
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">@ViewData["Title"]</h1>

                    <div class="alert alert-danger auth-alert-message" role="alert">
                        <p class="mb-0">
                            @Text["auth.invalidResetLink"]
                        </p>
                    </div>

                    <div class="auth-links text-center mt-3">
                        <div class="mb-2">
                            <a href="~/auth/forgotpassword" class="btn btn-dark">@Text["auth.requestNewLink"]</a>
                        </div>
                        <div>
                            <a href="~/auth/login">@Text["auth.backToSignIn"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

