@{
    ViewData["Title"] = "Недействительная ссылка";
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container extra-narrow-form">
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">@ViewData["Title"]</h1>

                    <div class="alert alert-danger auth-alert-message" role="alert">
                        <p class="mb-0">
                            Ссылка для сброса пароля недействительна или устарела. Запросите новую ссылку и попробуйте еще раз.
                        </p>
                    </div>

                    <div class="auth-links text-center mt-3">
                        <div class="mb-2">
                            <a href="~/auth/forgotpassword" class="btn btn-dark">Запросить новую ссылку</a>
                        </div>
                        <div>
                            <a href="~/auth/login">Вернуться ко входу</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

