@{
    ViewData["Title"] = "Подтверждение регистрации";
    var email = ViewData["Email"] as string;
    var deliveryFailed = ViewData["DeliveryFailed"] as bool? == true;
    var validationError = TempData["EmailValidationError"] as string;
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container extra-narrow-form">
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">@ViewData["Title"]</h1>

                    <div class="alert @(deliveryFailed ? "alert-warning" : "alert-success") auth-alert-message" role="alert">
                        <p class="mb-0">
                            @if (deliveryFailed)
                            {
                                @if (!string.IsNullOrWhiteSpace(validationError))
                                {
                                    <text>Письмо не отправлено. @validationError</text>
                                }
                                else
                                {
                                    <text>Аккаунт создан, но письмо с подтверждением отправить не удалось. Повторите попытку позже или обратитесь в поддержку.</text>
                                }
                            }
                            else
                            {
                                <text>
                                    Если @(string.IsNullOrEmpty(email) ? "указанный email зарегистрирован" : $"адрес {email} зарегистрирован") и ещё не подтверждён, проверьте письмо со ссылкой подтверждения.
                                    Перейдите по ссылке из письма, чтобы завершить регистрацию.
                                    Повторная отправка доступна не чаще одного раза в минуту.
                                </text>
                            }
                        </p>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(email))
                    {
                        <form asp-action="ResendEmailConfirmation" asp-controller="Auth" method="post" class="text-center mt-3 mb-2">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@email" />
                            <button type="submit" class="btn btn-outline-dark">Отправить письмо повторно</button>
                        </form>
                    }

                    <div class="auth-links text-center mt-3">
                        <div class="mb-2">
                            <a href="~/auth/login">Перейти ко входу</a>
                        </div>
                        <div>
                            <a href="~/">На главную</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>

