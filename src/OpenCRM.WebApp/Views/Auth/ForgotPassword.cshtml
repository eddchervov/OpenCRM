@model ForgotPasswordModel
@{
    ViewData["Title"] = "Забыли пароль?";
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container narrow-form">
                <!-- Используем класс вместо style -->
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">Забыли пароль?</h1>

                    <partial name="_StatusMessage" for="StatusMessage" />

                    <div class="text-start mb-4">Введите Email своего аккаунта @Brand.DisplayNameLower, чтобы изменить пароль</div>

                    <form method="post" class="auth-form">
                        <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                        <div class="form-floating mb-3">
                            <input asp-for="Email" class="form-control" placeholder="Введите email адрес" />
                            <label asp-for="Email" class="form-label"></label>
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <button class="w-100 btn btn-dark btn-lg auth-btn mb-3" type="submit">Восстановить пароль</button>

                        <div class="auth-links text-center">
                            <div class="mb-2">
                                <a href="~/auth/login" id="forgot-password">Вернуться к входу</a>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

