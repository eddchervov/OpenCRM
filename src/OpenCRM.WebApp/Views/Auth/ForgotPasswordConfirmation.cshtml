@{
    ViewData["Title"] = Text["auth.resetRequestConfirmation"].Value;
}

<div class="auth-page">
    <main class="auth-main">
        <div class="container">
            <div class="auth-container extra-narrow-form">
                <!-- Используем более узкий класс -->
                <div class="auth-form-wrapper">
                    <h1 class="auth-title">@ViewData["Title"]</h1>

                    <div class="alert alert-success auth-alert-message" role="alert">
                        <p class="mb-0">
                            @Text["auth.checkEmailToReset"]
                        </p>
                    </div>

                    <div class="auth-links text-center mt-3">
                        <div class="mb-2">
                            <a href="~/auth/login" id="forgot-password">@Text["auth.backToSignIn"]</a>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </main>
</div>
