@model OpenCRM.WebApp.Models.Payments.PaymentCompleteViewModel
@{
    ViewData["Title"] = Model.Title;
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-pages.css" asp-append-version="true" />
}

<div class="platform-page">
    <div class="container platform-page-shell">
        <nav aria-label="breadcrumb" class="platform-page-breadcrumbs">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="@Url.Content("~/")" class="text-decoration-none">@Text["entry.home"]</a></li>
                <li class="breadcrumb-item"><a href="@Url.Content("~/subscription")" class="text-decoration-none">@Text["entry.plans"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Text["entry.paymentStatus"]</li>
            </ol>
        </nav>

        <div class="platform-empty-card"
            id="payment-completion"
            data-purchase-id="@(Model.ShouldPollPurchase ? Model.PurchaseId?.ToString("D") : null)"
            data-status-url="@(Model.ShouldPollPurchase ? Model.PurchaseStatusUrl : null)"
            data-poll-enabled="@(Model.ShouldPollPurchase ? "true" : "false")">
            <span id="payment-status-icon" class="platform-status-icon @(Model.IconCssClass.Contains("check") ? "is-success" : Model.IconCssClass.Contains("times") ? "is-danger" : "is-warning")">
                <i id="payment-status-icon-glyph" class="fa @Model.IconCssClass fa-2x"></i>
            </span>

            <h1 id="payment-status-title" class="platform-page-title h2 mb-3">@Model.Title</h1>

            <p id="payment-status-message" class="platform-page-subtitle mx-auto mb-4" aria-live="polite">
                @Model.Message
            </p>

            <div class="d-grid gap-2 col-md-7 mx-auto">
                <a href="@Url.Content($"~{Model.PrimaryActionUrl}")" class="btn btn-dark">
                    <i class="fa fa-line-chart me-2"></i>@Model.PrimaryActionText
                </a>
                <a href="@Url.Content("~/")" class="btn btn-outline-dark">
                    <i class="fa fa-home me-2"></i>@Text["entry.homeAction"]
                </a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script src="@Url.Content("~/js/payment-complete.js")" asp-append-version="true"></script>
}
