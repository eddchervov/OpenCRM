@{
    var statusCode = Context.Response.StatusCode;
    var (title, message) = statusCode switch
    {
        400 => ("Не удалось обработать запрос", "Проверьте введённые данные и адрес страницы. Если ошибка повторяется, обратитесь в поддержку."),
        401 => ("Требуется вход", "Войдите в свой аккаунт, чтобы открыть эту страницу."),
        403 => ("Доступ запрещён", "У вашего аккаунта нет доступа к этой странице. Проверьте выбранную организацию или уточните права у её владельца."),
        429 => ("Слишком много запросов", "Подождите немного и повторите попытку. Это временное ограничение частоты обращений к сайту."),
        503 => ("Сервис временно недоступен", "Попробуйте открыть страницу позже. Если проблема сохраняется, обратитесь в поддержку."),
        _ => ("Произошла ошибка", "При обработке вашего запроса возникла непредвиденная ошибка. Пожалуйста, попробуйте позже.")
    };
    ViewData["Title"] = title;
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-pages.css" asp-append-version="true" />
}

<div class="platform-page">
    <div class="container platform-page-shell">
        <nav aria-label="breadcrumb" class="platform-page-breadcrumbs">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Главная</a></li>
                <li class="breadcrumb-item active" aria-current="page">@title</li>
            </ol>
        </nav>

        <div class="platform-empty-card">
            <span class="platform-status-icon is-danger">
                <i class="fa fa-exclamation-triangle fa-2x"></i>
            </span>

            <h1 class="platform-page-title h2 mb-3">@statusCode — @title</h1>
            <p class="platform-page-subtitle mx-auto mb-4">
                @message
            </p>

            @if (ViewBag.ErrorId != null)
            {
                <p class="text-muted mb-4">Код ошибки: <strong>@ViewBag.ErrorId</strong></p>
            }

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="~/" class="btn btn-dark">
                    <i class="fa fa-home me-2"></i>На главную
                </a>
                @if (statusCode == 401)
                {
                    <a href="~/auth/login" class="btn btn-outline-dark">Войти</a>
                }
            </div>
        </div>
    </div>
</div>

