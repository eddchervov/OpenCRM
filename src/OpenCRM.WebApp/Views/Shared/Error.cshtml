@{
    var statusCode = Context.Response.StatusCode;
    var (title, message) = statusCode switch
    {
        400 => (Text["entry.badRequest"].Value, Text["entry.badRequestHelp"].Value),
        401 => (Text["entry.loginRequired"].Value, Text["entry.loginHelp"].Value),
        403 => (Text["entry.forbidden"].Value, Text["entry.forbiddenHelp"].Value),
        429 => (Text["entry.tooMany"].Value, Text["entry.tooManyHelp"].Value),
        503 => (Text["entry.unavailable"].Value, Text["entry.unavailableHelp"].Value),
        _ => (Text["entry.error"].Value, Text["entry.errorHelp"].Value)
    };
    ViewData["Title"] = title;
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-pages.css" asp-append-version="true" />
}

<div class="platform-page">
    <div class="container platform-page-shell">
        <nav aria-label="breadcrumb" class="platform-page-breadcrumbs">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">@Text["entry.home"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@title</li>
            </ol>
        </nav>

        <div class="platform-empty-card">
            <span class="platform-status-icon is-danger">
                <i class="fa fa-exclamation-triangle fa-2x"></i>
            </span>

            <h1 class="platform-page-title h2 mb-3">@statusCode — @title</h1>
            <p class="platform-page-subtitle mx-auto mb-4">
                @message
            </p>

            @if (ViewBag.ErrorId != null)
            {
                <p class="text-muted mb-4">@Text["entry.errorId"] <strong>@ViewBag.ErrorId</strong></p>
            }

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="~/" class="btn btn-dark">
                    <i class="fa fa-home me-2"></i>@Text["entry.homeAction"]
                </a>
                @if (statusCode == 401)
                {
                    <a href="~/auth/login" class="btn btn-outline-dark">@Text["entry.login"]</a>
                }
            </div>
        </div>
    </div>
</div>

