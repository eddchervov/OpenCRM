@using Microsoft.Extensions.Configuration
@inject IConfiguration Configuration
@using Microsoft.AspNetCore.Identity
@using OpenCRM.Domain.Identity
@using OpenCRM.Domain
@using Microsoft.AspNetCore.Authorization
@using OpenCRM.Services.Interfaces.Admin
@using OpenCRM.WebApp.Product
@using OpenCRM.WebApp.Infrastructure.Localization
@inject SignInManager<ApplicationUser> SignInManager
@inject IAuthorizationService AuthorizationService
@{
    var isSignedIn = SignInManager.IsSignedIn(User);
    var isImpersonating = !string.IsNullOrEmpty(Context.Request.Cookies["ImpersonatorId"]);
    var canOpenAdminPanel = (await AuthorizationService.AuthorizeAsync(
        User,
        AdminAuthorizationPolicies.Access)).Succeeded;
}
<header class="site-header border-bottom bg-white">
    <div class="container">
        <nav class="navbar navbar-expand-lg navbar-light bg-white px-0">
            <a class="navbar-brand fw-bold" href="~/">@Brand.DisplayName</a>

            @if (!isSignedIn)
            {
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="@Text["nav.menu"]">
                    <span class="navbar-toggler-icon"></span>
                </button>
            }

            <div class="@(isSignedIn ? "header-auth-container ms-auto" : "collapse navbar-collapse ms-auto justify-content-end")" id="navbarNav">
                @if (isSignedIn)
                {
                    <div class="site-header-actions d-flex align-items-center justify-content-end gap-2 flex-nowrap">
                        <!-- Кнопка возврата к админской учетке (только при имперсонации) -->
                        @if (isImpersonating)
                        {
                            <form id="stopImpersonationForm" class="d-inline">
                                @Html.AntiForgeryToken()
                                <button type="button" class="btn btn-warning btn-sm js-stop-impersonation" data-stop-impersonation-url="/Auth/StopImpersonation">
                                    <i class="fa fa-undo me-1"></i> @Text["nav.stopImpersonation"]
                                </button>
                            </form>
                        }

                        <a href="~/organizations" class="text-dark text-decoration-none fw-semibold px-1 me-3" title="@Text["nav.organizations"]">
                            @Text["nav.organizations"]
                        </a>

                        <button type="button" class="entry-theme-toggle" data-entry-theme aria-label="@Text["nav.theme"]" title="@Text["nav.theme"]"><i class="fa fa-adjust" aria-hidden="true"></i></button>

                        <div class="dropdown site-notification-bell" data-site-notification-bell>
                            <button type="button" class="btn btn-dark btn-icon d-flex align-items-center justify-content-center position-relative"
                                    id="notificationDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="@Text["nav.notifications"]"
                                    aria-label="@Text["nav.notifications"]">
                                <i class="fa fa-bell-o" aria-hidden="true"></i>
                                <span class="site-notification-count" data-site-notification-count hidden></span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end p-3" aria-labelledby="notificationDropdown">
                                <div class="fw-semibold mb-2">@Text["nav.notifications"]</div>
                                <div data-site-notification-preview></div>
                                <a class="d-block mt-3 text-decoration-none" href="~/notifications">@Text["nav.notificationHistory"]</a>
                            </div>
                        </div>

                        <div class="dropdown">
                            <button type="button" class="btn btn-dark btn-icon dropdown-toggle d-flex align-items-center justify-content-center menu-profile-button" id="profileDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="@Text["nav.profile"]">
                                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                    <circle cx="12" cy="7" r="4"></circle>
                                </svg>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end" aria-labelledby="profileDropdown">
                                @if (canOpenAdminPanel)
                                {
                                    <li>
                                        <a class="dropdown-item" href="~/admin-panel/index.html">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E67337" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                                <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"></path>
                                            </svg>
                                            @Text["nav.adminPanel"]
                                        </a>
                                    </li>
                                }
                                <li>
                                    <a class="dropdown-item" href="~/organizations">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E67337" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                            <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="9" cy="7" r="4"></circle>
                                            <path d="M22 21v-2a4 4 0 0 0-3-3.87"></path>
                                            <path d="M16 3.13a4 4 0 0 1 0 7.75"></path>
                                        </svg>
                                        @Text["nav.organizations"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="~/personal">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E67337" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
                                            <circle cx="12" cy="7" r="4"></circle>
                                        </svg>
                                        @Text["nav.profile"]
                                    </a>
                                </li>
                                <li>
                                    <a class="dropdown-item" href="~/vehicles">
                                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E67337" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                            <path d="M19 17h2c.6 0 1-.4 1-1v-3c0-.9-.7-1.7-1.5-1.9C18.7 10.6 16 10 16 10s-1.3-1.4-2.2-2.3c-.5-.4-1.1-.7-1.8-.7H5c-.6 0-1.1.4-1.4 1L2 10v8c0 .6.4 1 1 1h2"></path>
                                            <circle cx="7" cy="17" r="2"></circle>
                                            <path d="M9 17h6"></path>
                                            <circle cx="17" cy="17" r="2"></circle>
                                            <path d="M7 11h10"></path>
                                        </svg>
                                        @Text["nav.personalVehicles"]
                                    </a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li>
                                    <form asp-action="Logout" asp-controller="auth" asp-route-returnUrl="@Url.Action("Index", "Home", new { area = "" })">
                                        <button type="submit" class="dropdown-item">
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#E67337" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="me-2">
                                                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"></path>
                                                <polyline points="16 17 21 12 16 7"></polyline>
                                                <line x1="21" y1="12" x2="9" y2="12"></line>
                                            </svg>
                                            @Text["nav.signOut"]
                                        </button>
                                    </form>
                                </li>
                            </ul>
                        </div>
                    </div>
                }
                else
                {
                    <div class="site-header-actions d-flex align-items-center justify-content-end gap-2 py-2 py-lg-0">
                        @if (Configuration.GetValue<bool>("PlatformPolicy:Commercial:Enabled"))
                        {
                            <a href="~/subscription" class="text-dark text-decoration-none fw-semibold px-1 me-2" title="@Text["nav.plans"]">
                                @Text["nav.plans"]
                            </a>
                        }
                        <a href="~/auth/login" class="btn btn-outline-dark btn-sm">@Text["nav.signIn"]</a>
                        <a href="~/auth/register" class="btn btn-dark btn-sm">@Text["auth.registerButton"]</a>
                    </div>
                }
            </div>

        </nav>
    </div>
</header>

