@using OpenCRM.Modules.Organizations.Contracts.Dtos
@using OpenCRM.Domain
@model IReadOnlyList<PendingOrganizationInvitationDto>

@if (Model.Any())
{
    <section class="pending-org-invitations mb-4">
        <div class="pending-org-invitations-card">
            <div class="pending-org-invitations-head">
                <div>
                    <div class="pending-org-invitations-kicker">@Text["entry.invitations"]</div>
                    <h2>@Text["entry.orgInvitations"]</h2>
                </div>
            </div>

            <div class="pending-org-invitations-list">
                @foreach (var invitation in Model)
                {
                    var role = Text[$"organization.role.{invitation.RoleCode}"];
                    var status = Text[$"organization.invitation.{invitation.StatusCode}"];
                    var scenario = Text[$"organization.create.scenario.{invitation.OrganizationScenarioCode}.title"];

                    <article class="pending-org-invitation-item">
                        <div class="pending-org-invitation-main">
                            <div class="pending-org-invitation-badges">
                                <span>@(scenario.ResourceNotFound ? invitation.OrganizationScenarioName : scenario.Value)</span>
                                <span>@Text["entry.role"] @(role.ResourceNotFound ? invitation.RoleName : role.Value)</span>
                                <span>@Text["entry.status"] @(status.ResourceNotFound ? invitation.StatusName : status.Value)</span>
                                @if (!string.IsNullOrWhiteSpace(invitation.EmployeeName))
                                {
                                    <span>@Text["entry.employeeCard"] @invitation.EmployeeName</span>
                                }
                            </div>
                            <h3>@invitation.OrganizationName</h3>
                            <div class="pending-org-invitation-meta">
                                @Text["entry.invitedAt", invitation.CreatedAt.ToLocalTime().ToString("d", System.Globalization.CultureInfo.CurrentCulture)]
                            </div>
                        </div>

                        @if (invitation.StatusCode == OrganizationInvitationStatusCodes.Pending)
                        {
                            <div class="pending-org-invitation-actions">
                                @if (invitation.CanAccept)
                                {
                                    <form asp-controller="Personal" asp-action="AcceptOrganizationInvitation" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="invitationId" value="@invitation.InvitationId" />
                                        <button type="submit" class="btn btn-dark">@Text["entry.accept"]</button>
                                    </form>
                                }
                                else
                                {
                                    <p class="mb-0 small">@Text["entry.verifyEmail"] <a href="/personal">@Text["entry.profile"]</a>.</p>
                                }

                                @if (invitation.CanAccept)
                                {
                                    <form asp-controller="Personal" asp-action="DeclineOrganizationInvitation" method="post">
                                        @Html.AntiForgeryToken()
                                        <input type="hidden" name="invitationId" value="@invitation.InvitationId" />
                                        <button type="submit" class="btn btn-outline-secondary">@Text["entry.decline"]</button>
                                    </form>
                                }
                            </div>
                        }
                    </article>
                }
            </div>
        </div>
    </section>
}
