@model OpenCRM.WebApp.Models.Features.FeatureCollectionViewModel
@using Helpers

@{
    var visibleFeatures = FeaturePresentationHelper
        .GetVisiblePresentationFeatures(Model.Features, Model.ShowVehiclesLimit)
        .ToList();

    var rawVisibleFeatures = FeaturePresentationHelper
        .GetVisibleFeatures(Model.Features, Model.ShowVehiclesLimit)
        .ToList();

    var vehiclesLimit = Model.ShowVehiclesLimit
        ? FeaturePresentationHelper.GetVehicleLimit(Model.Features, Model.FallbackVehicleLimit)
        : null;

    IReadOnlyList<(string Title, string Description)> highlights = Model.ShowProductHighlights
        ? FeaturePresentationHelper.GetProductHighlights(Model.ProductHighlightsForBusiness, Text)
        : [];
}

@if (Model.RenderAsBadges)
{
    <div class="@Model.ContainerCssClass">
        @foreach (var feature in visibleFeatures)
        {
            <span class="badge @Model.BadgeCssClass me-1 mb-1">@FeaturePresentationHelper.FormatFeature(feature, Text)</span>
        }

        @if (Model.ShowVehiclesLimit && vehiclesLimit.HasValue && !rawVisibleFeatures.Any(feature => feature.Code == FeatureCodes.VehiclesLimit))
        {
            <span class="badge @Model.BadgeCssClass me-1 mb-1">@Text["entry.vehicleLimit", vehiclesLimit!]</span>
        }
    </div>
}
else
{
    <ul class="@Model.ContainerCssClass">
        @foreach (var feature in visibleFeatures)
        {
            var description = Model.ShowDescriptions
                ? FeaturePresentationHelper.GetFeatureDescription(feature, Text)
                : null;

            <li class="d-flex gap-2">
                <i class="@Model.IconCssClass mt-1"></i>
                <span>
                    <span class="fw-semibold">@FeaturePresentationHelper.FormatFeature(feature, Text)</span>
                    @if (!string.IsNullOrWhiteSpace(description))
                    {
                        <span class="d-block text-muted small">@description</span>
                    }
                </span>
            </li>
        }

        @if (Model.ShowVehiclesLimit && vehiclesLimit.HasValue && !rawVisibleFeatures.Any(feature => feature.Code == FeatureCodes.VehiclesLimit))
        {
            <li class="d-flex gap-2">
                <i class="@Model.IconCssClass mt-1"></i>
                <span>
                    <span class="fw-semibold">@Text["entry.vehicleLimit", vehiclesLimit!]</span>
                    @if (Model.ShowDescriptions)
                    {
                        <span class="d-block text-muted small">@Text["entry.vehicleLimitHelp"]</span>
                    }
                </span>
            </li>
        }

        @foreach (var highlight in highlights)
        {
            <li class="d-flex gap-2">
                <i class="@Model.IconCssClass mt-1"></i>
                <span>
                    <span class="fw-semibold">@highlight.Title</span>
                    @if (Model.ShowDescriptions)
                    {
                        <span class="d-block text-muted small">@highlight.Description</span>
                    }
                </span>
            </li>
        }
    </ul>
}
