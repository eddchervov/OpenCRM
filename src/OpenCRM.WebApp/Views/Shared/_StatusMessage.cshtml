@model string?

@if (!string.IsNullOrEmpty(Model))
{
    var isError = ViewData["StatusMessageIsError"] is true
        || string.Equals(Model, TempData.Peek("Error") as string, StringComparison.Ordinal)
        || !ViewData.ModelState.IsValid;
    var statusMessageClass = isError ? "danger" : "success";
    <div class="alert alert-@statusMessageClass alert-dismissible" role="alert">
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="@Text["entry.close"]"></button>
        @Model
    </div>
}

