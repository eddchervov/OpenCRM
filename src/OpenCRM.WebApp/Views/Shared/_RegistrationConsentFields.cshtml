@model bool

@{
    const string PersonalDataConsentRequiredMessage = "Необходимо дать согласие на обработку персональных данных.";
}

<div class="form-check mb-2">
    <input id="PersonalDataProcessingConsent"
           name="PersonalDataProcessingConsent"
           class="form-check-input"
           type="checkbox"
           value="true"
           required
           data-val="true"
           data-val-required="@PersonalDataConsentRequiredMessage"
           data-msg-required="@PersonalDataConsentRequiredMessage"
           checked="@(Model ? "checked" : null)"
           oninvalid="this.setCustomValidity('@PersonalDataConsentRequiredMessage')"
           oninput="this.setCustomValidity('')"
           onchange="this.setCustomValidity('')" />
    <input type="hidden" name="PersonalDataProcessingConsent" value="false" />
    <label class="form-check-label small" for="PersonalDataProcessingConsent">
        Я даю согласие на обработку персональных данных.
    </label>
    @Html.ValidationMessage("PersonalDataProcessingConsent", null, new { @class = "text-danger d-block" })
</div>