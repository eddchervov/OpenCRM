@{
    ViewData["Title"] = Text["entry.notFound"].Value;
    Layout = "/Views/Shared/_Layout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/platform-pages.css" asp-append-version="true" />
}

<div class="platform-page">
    <div class="container platform-page-shell">
        <nav aria-label="breadcrumb" class="platform-page-breadcrumbs">
            <ol class="breadcrumb mb-0">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">@Text["entry.home"]</a></li>
                <li class="breadcrumb-item active" aria-current="page">@Text["entry.notFound"]</li>
            </ol>
        </nav>

        <div class="platform-empty-card">
            <span class="platform-status-icon is-warning">
                <i class="fa fa-search fa-2x"></i>
            </span>

            <h1 class="platform-page-title h2 mb-3">@Text["entry.notFoundTitle"]</h1>
            <p class="platform-page-subtitle mx-auto mb-4">
                @Text["entry.notFoundHelp"]
            </p>

            <div class="d-flex flex-wrap justify-content-center gap-2">
                <a href="~/" class="btn btn-dark">
                    <i class="fa fa-home me-2"></i>@Text["entry.homeAction"]
                </a>
            </div>
        </div>
    </div>
</div>

