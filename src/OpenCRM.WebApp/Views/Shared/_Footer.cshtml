@using Microsoft.AspNetCore.Identity
@using OpenCRM.Domain.Identity
@inject SignInManager<ApplicationUser> SignInManager
@{
    var isSignedIn = SignInManager.IsSignedIn(User);
}
<footer class="bg-dark text-white py-4">
    <div class="container">
        <div class="row justify-content-between align-items-start">
            <div class="col-auto mb-4 mb-md-0">
                <h6 class="fw-bold mb-3">@Brand.DisplayName</h6>
                <div class="d-flex flex-column gap-2">
                    <a href="~/" class="text-white text-decoration-none small">Главная</a>
                    <a href="@Helpers.ProjectBrand.GitHubUrl" target="_blank" rel="noopener noreferrer" class="text-white text-decoration-none small">GitHub</a>
                </div>
            </div>
            <div class="col-auto mb-4 mb-md-0">
                @if (isSignedIn)
                {
                    <h6 class="fw-bold mb-3">Рабочее пространство</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="~/organizations" class="text-white text-decoration-none small">Организации</a>
                        <a href="~/personal" class="text-white text-decoration-none small">Личный кабинет</a>
                        <a href="~/personal/support" class="text-white text-decoration-none small">Обращения и поддержка</a>
                    </div>
                }
                else
                {
                    <h6 class="fw-bold mb-3">Аккаунт</h6>
                    <div class="d-flex flex-column gap-2">
                        <a href="~/auth/login" class="text-white text-decoration-none small">Вход</a>
                        <a href="~/auth/register" class="text-white text-decoration-none small">Регистрация</a>
                    </div>
                }
            </div>
        </div>
        <div class="row mt-4">
            <div class="col-12 text-center">
                <div class="text-white small mb-2"><partial name="_ProjectAttribution" /></div>
                <div class="text-white-50 small">© @Brand.DisplayName, @DateTime.Now.Year</div>
            </div>
        </div>
    </div>
</footer>
