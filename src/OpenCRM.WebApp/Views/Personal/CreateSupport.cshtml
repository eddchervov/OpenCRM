@using Microsoft.Extensions.Configuration
@inject Microsoft.Extensions.Configuration.IConfiguration PlatformConfiguration
@model OpenCRM.WebApp.Models.Personal.CreateSupportViewModel
@{
    ViewData["Title"] = Text["personal.support.createTitle"];
    ViewData["ActivePage"] = "Support";
    ViewData["BreadcrumbLinks"] = new[] { ("/personal", Text["personal.support.profile"].Value), ("/personal/support", Text["personal.support.title"].Value) };
    Layout = "_PersonalLayout.cshtml";
}

@section Styles {
    <link rel="stylesheet" href="~/css/personal-support.css" asp-append-version="true" />
}

<section class="profile-card support-new">
    <h2>@Text["personal.support.createTitle"]</h2>
    @if (Model.Error != null)
    {
        <p class="support-error" role="alert">@Model.Error</p>
    }
    <form action="/personal/support/create" method="post" enctype="multipart/form-data" class="support-form">
        @Html.AntiForgeryToken()
        <label>@Text["personal.support.type"]
            <select name="TypeCode" required>
                <option value="question" selected="@(Model.Request.TypeCode == "question")">@Text["personal.support.type.question"]</option>
                <option value="bug" selected="@(Model.Request.TypeCode == "bug")">@Text["personal.support.type.bug"]</option>
                @if (PlatformConfiguration.GetValue("PlatformPolicy:Commercial:Enabled", false))
                {
                    <option value="billing" selected="@(Model.Request.TypeCode == "billing")">@Text["personal.support.type.billing"]</option>
                }
                <option value="suggestion" selected="@(Model.Request.TypeCode == "suggestion")">@Text["personal.support.type.suggestion"]</option>
                <option value="cooperation" selected="@(Model.Request.TypeCode == "cooperation")">@Text["personal.support.type.cooperation"]</option>
            </select>
        </label>
        <label class="support-check"><input type="checkbox" name="IsOrganizationQuestion" value="true" id="support-organization-question" checked="@Model.Request.IsOrganizationQuestion"> @Text["personal.support.organizationQuestion"]</label>
        <label id="support-organization-field" hidden="@(!Model.Request.IsOrganizationQuestion)">@Text["personal.support.organization"]
            <select name="OrganizationId" id="support-organization-select" required="@Model.Request.IsOrganizationQuestion">
                <option value="">@Text["personal.support.selectOrganization"]</option>
                @foreach (var organization in Model.Organizations)
                {
                    <option value="@organization.Id" selected="@(Model.Request.OrganizationId == organization.Id)">@organization.Name</option>
                }
            </select>
        </label>
        <label>@Text["personal.support.topic"] <input name="Topic" maxlength="180" required value="@Model.Request.Topic"></label>
        <label>@Text["personal.support.message"] <textarea name="Text" maxlength="4000" rows="6" required>@Model.Request.Text</textarea></label>
        <partial name="_SupportAttachments" />
        <div class="support-actions">
            <button class="btn entry-primary" type="submit">@Text["personal.support.send"]</button>
            <a class="btn entry-secondary" href="/personal/support">@Text["personal.support.cancel"]</a>
        </div>
    </form>
</section>

@section Scripts {
    <script>
        (() => {
            const checkbox = document.getElementById('support-organization-question');
            const field = document.getElementById('support-organization-field');
            const select = document.getElementById('support-organization-select');
            checkbox.addEventListener('change', () => {
                field.hidden = !checkbox.checked;
                select.required = checkbox.checked;
                if (!checkbox.checked) select.value = '';
            });
        })();
    </script>
}
