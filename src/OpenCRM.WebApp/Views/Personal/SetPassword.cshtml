@model SetPasswordModel
@{
    ViewData["Title"] = "Установка пароля";
    ViewData["ActivePage"] = ManageNavPages.ChangePassword;
    Layout = "_PersonalLayout.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />
<section class="profile-card">
    <form id="set-password-form" method="post" class="personal-form">
        <p class="personal-muted">Добавьте пароль, чтобы входить в аккаунт по email.</p>
        <div asp-validation-summary="ModelOnly" class="text-danger" role="alert"></div>
        <div class="personal-field">
            <label asp-for="NewPassword">Новый пароль</label>
            <input asp-for="NewPassword" class="form-control" autocomplete="new-password" aria-describedby="password-requirements" />
            <span asp-validation-for="NewPassword" class="text-danger"></span>
        </div>
        <partial name="_PasswordRequirements" />
        <div class="personal-field">
            <label asp-for="ConfirmPassword">Повторите пароль</label>
            <input asp-for="ConfirmPassword" class="form-control" autocomplete="new-password" />
            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
        </div>
        <div class="personal-form-actions">
            <button type="submit" class="btn entry-primary">Установить пароль</button>
            <a href="/personal" class="btn entry-secondary">Отмена</a>
        </div>
    </form>
</section>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
