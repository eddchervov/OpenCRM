@model IndexModel
@using OpenCRM.WebApp.Infrastructure.Security
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Профиль";
    ViewData["ActivePage"] = ManageNavPages.Index;
    Layout = "_PersonalLayout.cshtml";
    var isEmailDeliveryAvailable = EmailDeliveryPolicy.IsAvailable(Configuration);
}

<partial name="_StatusMessage" for="StatusMessage" />
<div class="personal-grid personal-profile-grid">
    <section class="profile-card">
        <h2>Личные данные</h2>
        <dl class="personal-details">
            <div>
                <dt>Email</dt>
                <dd>
                    <div class="personal-contact"><span>@Model.Email</span><span class="personal-badge">@(Model.IsEmailConfirmed ? "Подтверждён" : "Не подтверждён")</span></div>
                    @if (isEmailDeliveryAvailable && !Model.IsEmailConfirmed)
                    {
                        <form asp-controller="Personal" asp-action="SendVerificationEmail" method="post" class="personal-inline-form">
                            <button type="submit" class="btn entry-secondary">Отправить подтверждение</button>
                        </form>
                    }
                </dd>
            </div>
            <div><dt>Телефон</dt><dd>@(string.IsNullOrEmpty(Model.PhoneNumber) ? "Не указан" : Model.PhoneNumber)</dd></div>
            <div><dt>Дата регистрации</dt><dd>@Model.DatetimeCreation.ToString("dd.MM.yyyy")</dd></div>
        </dl>
        <div class="personal-divider"></div>
        <div class="personal-card-heading"><h2>Вход в аккаунт</h2><a href="/personal/changePassword">Настроить пароль</a></div>
        <p class="personal-muted">@(isEmailDeliveryAvailable ? "Входите по паролю или коду из email." : "Входите по паролю.")</p>
    </section>
    <section class="profile-card">
        <div class="personal-card-heading"><h2>Личная техника</h2><a href="/vehicles">Открыть</a></div>
        <dl class="personal-counters">
            <div><dd>@Model.CountVehicles</dd><dt>Единиц техники</dt></div>
            <div><dd>@Model.CountMaintenance</dd><dt>Обслуживаний</dt></div>
        </dl>
    </section>
</div>
<div class="personal-account-footer">
    <span>Управление аккаунтом</span>
    <a asp-controller="Auth" asp-action="DeleteAccount" class="personal-danger-link">Удалить аккаунт</a>
</div>
