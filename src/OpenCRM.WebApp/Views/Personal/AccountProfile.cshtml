@model AccountProfileViewModel
@{
    ViewData["Title"] = Text["personal.workspaces.title"].Value;
    ViewData["ActivePage"] = ManageNavPages.AccountProfile;
    Layout = "_PersonalLayout.cshtml";
}

<partial name="_StatusMessage" for="StatusMessage" />
<partial name="_PendingOrganizationInvitations" model="Model.OrganizationInvitations" />
<div class="personal-grid">
    <section class="profile-card personal-workspace-card">
        <i class="fa fa-building-o personal-section-icon" aria-hidden="true"></i>
        <h2>@Text["personal.workspaces.organizations"]</h2>
        <p class="personal-muted">@Text["personal.workspaces.organizationHint"]</p>
        <div class="personal-form-actions">
            <a class="btn entry-primary" href="/organizations">@Text["personal.workspaces.myOrganizations"]</a>
            <a class="btn entry-secondary" href="/organizations/create">@Text["personal.workspaces.createOrganization"]</a>
        </div>
    </section>
    <section class="profile-card personal-workspace-card">
        <i class="fa fa-car personal-section-icon" aria-hidden="true"></i>
        <h2>@Text["personal.workspaces.vehicles"]</h2>
        <p class="personal-muted">@Text["personal.workspaces.vehicleHint"]</p>
        <div class="personal-form-actions"><a class="btn entry-secondary" href="/vehicles">@Text["personal.workspaces.openVehicles"]</a></div>
    </section>
</div>
