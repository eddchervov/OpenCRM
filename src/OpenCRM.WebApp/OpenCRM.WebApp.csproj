<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultRazorGenerateItems>false</EnableDefaultRazorGenerateItems>
    <DockerDefaultTargetOS>Linux</DockerDefaultTargetOS>
    <DockerfileContext>..\..</DockerfileContext>
    <RunBundleMinify>false</RunBundleMinify>
    <BuildScenarioClientsOnBuild>true</BuildScenarioClientsOnBuild>
    <BuildScenarioClientsOnPublish>true</BuildScenarioClientsOnPublish>
  </PropertyGroup>

  <ItemGroup>
    <Compile Remove="wwwroot\img\cars\**" />
    <Content Remove="wwwroot\img\cars\**" />
    <EmbeddedResource Remove="wwwroot\img\cars\**" />
    <None Remove="wwwroot\img\cars\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Azure.Containers.Tools.Targets" Version="1.21.0" />
    <PackageReference Include="BuildBundlerMinifier" Version="3.2.449" />
  </ItemGroup>

  <ItemGroup>
    <Content Update="web.config">
      <CopyToOutputDirectory>Always</CopyToOutputDirectory>
    </Content>
    <Content Include="..\..\integrations\1c\bp30\OpenCRMAccountingImport.epf"
             Condition="Exists('..\..\integrations\1c\bp30\OpenCRMAccountingImport.epf')"
             Link="wwwroot\downloads\1c\OpenCRMAccountingImport.epf"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <ItemGroup>
    <Folder Include="wwwroot\app\components\" />
  </ItemGroup>

  <Target Name="BundleMinifyBeforeStaticWebAssets" BeforeTargets="AssignTargetPaths" Condition="Exists('$(MSBuildProjectDirectory)\bundleconfig.json')">
    <BundlerMinifier.BundlerBuildTask FileName="$(MSBuildProjectDirectory)\bundleconfig.json" />
  </Target>

  <Target Name="BundleMinifyCleanCustom" AfterTargets="CoreClean" Condition="Exists('$(MSBuildProjectDirectory)\bundleconfig.json')">
    <BundlerMinifier.BundlerCleanTask FileName="$(MSBuildProjectDirectory)\bundleconfig.json" />
  </Target>

  <ItemGroup>
    <AdminClient Include="..\OpenCRM.Frontend\Admin\admin-client" WorkspaceName="@opencrm/admin-client" />
    <ScenarioClient Include="..\OpenCRM.Frontend\Scenarios\detailing-client" WorkspaceName="@opencrm/detailing-client" />
    <ScenarioClient Include="..\OpenCRM.Frontend\Scenarios\autoservice-client" WorkspaceName="@opencrm/autoservice-client" />
    <ScenarioClient Include="..\OpenCRM.Frontend\Scenarios\fleet-client" WorkspaceName="@opencrm/fleet-client" />
  </ItemGroup>

  <ItemGroup Condition="'$(BuildScenarioClientsOnBuild)' == 'true'">
    <FrontendBuildInput Include="..\OpenCRM.Frontend\package*.json;..\OpenCRM.Frontend\Admin\admin-client\**\*;..\OpenCRM.Frontend\Scenarios\**\*;..\OpenCRM.Frontend\packages\**\*"
                        Exclude="..\OpenCRM.Frontend\**\node_modules\**;..\OpenCRM.Frontend\**\dist\**;..\OpenCRM.Frontend\**\*.tsbuildinfo" />
    <FrontendBuildOutput Include="wwwroot\admin-panel\index.html;wwwroot\admin-panel\manifest.json;wwwroot\clients\detailing\index.html;wwwroot\clients\detailing\manifest.json;wwwroot\clients\autoservice\index.html;wwwroot\clients\autoservice\manifest.json;wwwroot\clients\fleet\index.html;wwwroot\clients\fleet\manifest.json;wwwroot\app\date-time-fields.bundle.js;wwwroot\app\date-time-fields.css" />
    <UpToDateCheckInput Include="@(FrontendBuildInput)" Set="ScenarioClients" />
    <UpToDateCheckOutput Include="@(FrontendBuildOutput)" Set="ScenarioClients" />
  </ItemGroup>

  <Target Name="BuildScenarioClientsBeforeBuild"
          BeforeTargets="ResolveProjectStaticWebAssets;AssignTargetPaths"
          Condition="'$(BuildScenarioClientsOnBuild)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <Content Remove="wwwroot\clients\**;wwwroot\admin-panel\**;wwwroot\app\vehicle-registration-plate.bundle.js;wwwroot\app\date-time-fields.bundle.js;wwwroot\app\date-time-fields.css" />
    </ItemGroup>
    <Message Importance="high" Text="Building Vue scenario clients before WebApp build..." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" Condition="!Exists('$(MSBuildProjectDirectory)\..\OpenCRM.Frontend\node_modules') and Exists('$(MSBuildProjectDirectory)\..\OpenCRM.Frontend\package-lock.json')" />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" Condition="!Exists('$(MSBuildProjectDirectory)\..\OpenCRM.Frontend\node_modules') and !Exists('$(MSBuildProjectDirectory)\..\OpenCRM.Frontend\package-lock.json')" />
    <Exec Command="npm run build" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" />
    <ItemGroup>
      <Content Include="wwwroot\clients\**;wwwroot\admin-panel\**;wwwroot\app\vehicle-registration-plate.bundle.js;wwwroot\app\date-time-fields.bundle.js;wwwroot\app\date-time-fields.css" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="BuildScenarioClientsBeforePublish"
          BeforeTargets="ComputeFilesToPublish"
          Condition="'$(BuildScenarioClientsOnPublish)' == 'true'">
    <Message Importance="high" Text="Building Vue scenario clients before publish..." />
    <Exec Command="npm ci --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" Condition="Exists('$(MSBuildProjectDirectory)\..\OpenCRM.Frontend\package-lock.json')" />
    <Exec Command="npm install --no-audit --no-fund" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" Condition="!Exists('$(MSBuildProjectDirectory)\..\OpenCRM.Frontend\package-lock.json')" />
    <Exec Command="npm run build --workspace %(ScenarioClient.WorkspaceName)" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" />
    <Exec Command="npm run build --workspace %(AdminClient.WorkspaceName)" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" />
    <Exec Command="npm run build --workspace @opencrm/workspace" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" />
    <Exec Command="npm run build --workspace @opencrm/ui" WorkingDirectory="$(MSBuildProjectDirectory)\..\OpenCRM.Frontend" />
    <ItemGroup>
      <Content Remove="wwwroot\app\date-time-fields.bundle.js;wwwroot\app\date-time-fields.css" />
      <Content Include="wwwroot\app\date-time-fields.bundle.js;wwwroot\app\date-time-fields.css" CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

  <Target Name="ValidateFrontendAssetsBeforePublish"
          BeforeTargets="ComputeFilesToPublish"
          DependsOnTargets="BuildScenarioClientsBeforePublish">
    <ItemGroup>
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/admin-panel/index.html" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/app/vehicle-registration-plate.bundle.js" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/app/date-time-fields.bundle.js" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/app/date-time-fields.css" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/admin-panel/manifest.json" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/clients/detailing/index.html" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/clients/detailing/manifest.json" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/clients/autoservice/index.html" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/clients/autoservice/manifest.json" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/clients/fleet/index.html" />
      <RequiredFrontendAsset Include="$(MSBuildProjectDirectory)/wwwroot/clients/fleet/manifest.json" />
    </ItemGroup>
    <Error Condition="!Exists('%(RequiredFrontendAsset.Identity)')"
           Text="Не собран клиент: %(RequiredFrontendAsset.Identity). Выполните npm run build в src/OpenCRM.Frontend перед публикацией." />
  </Target>

  <ItemGroup>
    <Content Include="../../configuration/brand.json" Link="brand.json" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="wwwroot/robots.txt" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <ProjectReference Include="../OpenCRM.Hosting/OpenCRM.Hosting.csproj" />
  </ItemGroup>
</Project>
