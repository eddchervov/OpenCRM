
&НаКлиенте
Процедура ImportData(Команда)
	ПередатьФайл("Проверка");
КонецПроцедуры

&НаКлиенте
Процедура CreateDrafts(Команда)
	ПередатьФайл("Реализации");
КонецПроцедуры

&НаКлиенте
Процедура CreatePaymentDrafts(Команда)
	ПередатьФайл("Оплаты");
КонецПроцедуры

&НаКлиенте
Процедура ShowNextClient(Команда)
	Если ПустаяСтрока(АдресФайла) Тогда
		ПоказатьПредупреждение(, "Сначала проверьте файл выгрузки.");
		Возврат;
	КонецЕсли;

	Попытка
		ОбновитьКлиентаДляСопоставления(ИдентификаторКлиента);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура SaveClientMapping(Команда)
	Если ПустаяСтрока(ИдентификаторКлиента) Или Не ЗначениеЗаполнено(КонтрагентДляСопоставления) Тогда
		ПоказатьПредупреждение(, "Выберите клиента из файла и контрагента в 1С.");
		Возврат;
	КонецЕсли;

	Попытка
		Сообщить(СохранитьСопоставлениеКлиента(АдресФайла, ИдентификаторКлиента, КонтрагентДляСопоставления));
		ОбновитьКлиентаДляСопоставления(ИдентификаторКлиента);
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьКлиентаДляСопоставления(ТекущийИдентификатор)
	Клиент = СледующийКлиентБезИнн(АдресФайла, ТекущийИдентификатор);
	ИдентификаторКлиента = Клиент.Идентификатор;
	КлиентДляСопоставления = Клиент.Представление;
	КонтрагентДляСопоставления = Клиент.Контрагент;
	Если ПустаяСтрока(ИдентификаторКлиента) Тогда
		Сообщить("В файле нет клиентов без ИНН для загрузки.");
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПередатьФайл(Режим)
	Если Режим <> "Проверка" И Не ПустаяСтрока(АдресФайла) Тогда
		Попытка
			Сообщить(ОбработатьФайлНаСервере(АдресФайла, Режим));
		Исключение
			ПоказатьПредупреждение(, ОписаниеОшибки());
		КонецПопытки;
		Возврат;
	КонецЕсли;

	Оповещение = Новый ОписаниеОповещения("ПослеПомещенияФайла", ЭтотОбъект, Режим);
	НачатьПомещениеФайла(Оповещение, , , Истина, УникальныйИдентификатор);
КонецПроцедуры

&НаКлиенте
Процедура ПослеПомещенияФайла(Результат, Адрес, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	Если Не Результат Тогда
		Возврат;
	КонецЕсли;

	ПутьКФайлу = ВыбранноеИмяФайла;
	АдресФайла = Адрес;
	ИдентификаторКлиента = "";
	КлиентДляСопоставления = "";
	КонтрагентДляСопоставления = Неопределено;
	Попытка
		Сообщить(ОбработатьФайлНаСервере(Адрес, ДополнительныеПараметры));
	Исключение
		ПоказатьПредупреждение(, ОписаниеОшибки());
	КонецПопытки;
КонецПроцедуры

&НаСервере
Функция ОбработатьФайлНаСервере(Адрес, Режим)
	Данные = ПрочитатьДанныеФайла(Адрес);

	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		ВызватьИсключение "Неверный формат файла выгрузки.";
	КонецЕсли;

	Версия = Неопределено;
	ОрганизацияПакета = Неопределено;
	ИдентификаторОрганизации = Неопределено;
	Заказы = Неопределено;
	Если Не Данные.Свойство("schemaVersion", Версия) Или (Версия <> 1 И Версия <> 2 И Версия <> 3) Тогда
		ВызватьИсключение "Неподдерживаемая версия файла выгрузки.";
	КонецЕсли;

	Если Не Данные.Свойство("organization", ОрганизацияПакета)
		Или ТипЗнч(ОрганизацияПакета) <> Тип("Структура") Тогда
		ВызватьИсключение "В файле отсутствует организация.";
	КонецЕсли;

	Если Не ОрганизацияПакета.Свойство("id", ИдентификаторОрганизации)
		Или ПустаяСтрока(ИдентификаторОрганизации) Тогда
		ВызватьИсключение "В файле отсутствует идентификатор организации.";
	КонецЕсли;

	Если Не Данные.Свойство("orders", Заказы) Или ТипЗнч(Заказы) <> Тип("Массив") Тогда
		ВызватьИсключение "В файле отсутствуют заказы.";
	КонецЕсли;

	КоличествоГотовых = 0;
	КоличествоКонтекстных = 0;
	Для Каждого Заказ Из Заказы Цикл
		Если ТипЗнч(Заказ) <> Тип("Структура") Тогда
			ВызватьИсключение "Обнаружен заказ неверного формата.";
		КонецЕсли;

		ИдентификаторЗаказа = Неопределено;
		Если Не Заказ.Свойство("id", ИдентификаторЗаказа)
			Или ПустаяСтрока(ИдентификаторЗаказа) Тогда
			ВызватьИсключение "Обнаружен заказ без идентификатора.";
		КонецЕсли;

		КонтекстОплаты = Ложь;
		Если Версия >= 2 Тогда
			Заказ.Свойство("isPaymentContextOnly", КонтекстОплаты);
		КонецЕсли;
		Если КонтекстОплаты Тогда
			КоличествоКонтекстных = КоличествоКонтекстных + 1;
		ИначеЕсли Заказ.status = "Completed" Тогда
			КоличествоГотовых = КоличествоГотовых + 1;
		КонецЕсли;
	КонецЦикла;

	Если Режим <> "Проверка" Тогда
		Если Версия <> 2 И Версия <> 3 Тогда
			ВызватьИсключение "Для загрузки черновиков скачайте новый файл выгрузки " + ПолучитьИмяПроектаПакета(Данные) + ".";
		КонецЕсли;

		Если Режим = "Реализации" Тогда
			Возврат ЗагрузитьЧерновики(ОрганизацияПакета, Заказы, Версия);
		КонецЕсли;

		Если Режим = "Оплаты" Тогда
			Платежи = Неопределено;
			Если Не Данные.Свойство("payments", Платежи) Или ТипЗнч(Платежи) <> Тип("Массив") Тогда
				ВызватьИсключение "В файле отсутствуют оплаты.";
			КонецЕсли;

			Возврат ЗагрузитьЧерновикиОплат(ОрганизацияПакета, Платежи);
		КонецЕсли;

		ВызватьИсключение "Неизвестный режим загрузки.";
	КонецЕсли;

	Возврат СтрШаблон(
		"Файл " + ПолучитьИмяПроектаПакета(Данные) + " проверен. Организация: %1. Заказов: %2, завершённых: %3, только для связи оплат: %4.",
		ОрганизацияПакета.name,
		Заказы.Количество(),
		КоличествоГотовых,
		КоличествоКонтекстных);
КонецФункции

&НаСервере
Функция ПрочитатьДанныеФайла(Адрес)
	ДвоичныеДанные = ПолучитьИзВременногоХранилища(Адрес);
	Если ТипЗнч(ДвоичныеДанные) <> Тип("ДвоичныеДанные") Тогда
		ВызватьИсключение "Файл выгрузки не получен.";
	КонецЕсли;

	ВременныйФайл = ПолучитьИмяВременногоФайла("json");
	Попытка
		ДвоичныеДанные.Записать(ВременныйФайл);
		Чтение = Новый ЧтениеJSON;
		Чтение.ОткрытьФайл(ВременныйФайл, "utf-8");
		Данные = ПрочитатьJSON(Чтение);
		Чтение.Закрыть();
	Исключение
		УдалитьФайлы(ВременныйФайл);
		ВызватьИсключение "Не удалось прочитать JSON: " + ОписаниеОшибки();
	КонецПопытки;
	УдалитьФайлы(ВременныйФайл);

	Возврат Данные;
КонецФункции

&НаСервере
Функция СледующийКлиентБезИнн(Адрес, ТекущийИдентификатор)
	Данные = ПрочитатьДанныеФайла(Адрес);
	ОрганизацияПакета = Неопределено;
	Если ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("organization", ОрганизацияПакета) Тогда
		ВызватьИсключение "В файле отсутствует организация.";
	КонецЕсли;
	ПроверитьОрганизациюДляСопоставления(ОрганизацияПакета);

	Клиенты = Новый Массив;
	Идентификаторы = Новый Соответствие;
	Для Каждого Заказ Из Данные.orders Цикл
		Если Заказ.isPaymentContextOnly Или Заказ.status <> "Completed" Или Заказ.isDeleted Тогда
			Продолжить;
		КонецЕсли;
		Если СтроковоеПоле(Заказ, "clientPartyTypeCode") <> "person"
			Или Не ПустаяСтрока(СтроковоеПоле(Заказ, "clientInn")) Тогда
			Продолжить;
		КонецЕсли;
		Идентификатор = СтроковоеПоле(Заказ, "clientId");
		Если Не ПустаяСтрока(Идентификатор) И Идентификаторы.Получить(Идентификатор) = Неопределено Тогда
			Клиенты.Добавить(Новый Структура("Идентификатор,Представление", Идентификатор,
				СтроковоеПоле(Заказ, "clientName") + " · " + Идентификатор));
			Идентификаторы.Вставить(Идентификатор, Истина);
		КонецЕсли;
	КонецЦикла;

	Если Данные.Свойство("payments") Тогда
		Для Каждого Платеж Из Данные.payments Цикл
			Если СтроковоеПоле(Платеж, "payerPartyTypeCode") <> "person"
				Или Не ПустаяСтрока(СтроковоеПоле(Платеж, "payerInn")) Тогда
				Продолжить;
			КонецЕсли;
			Идентификатор = СтроковоеПоле(Платеж, "payerClientId");
			Если Не ПустаяСтрока(Идентификатор) И Идентификаторы.Получить(Идентификатор) = Неопределено Тогда
				Клиенты.Добавить(Новый Структура("Идентификатор,Представление", Идентификатор,
					СтроковоеПоле(Платеж, "payerName") + " · " + Идентификатор));
				Идентификаторы.Вставить(Идентификатор, Истина);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Если Клиенты.Количество() = 0 Тогда
		Возврат Новый Структура("Идентификатор,Представление,Контрагент", "", "Нет клиентов для сопоставления", Неопределено);
	КонецЕсли;

	ИндексКлиента = 0;
	Для НомерКлиента = 0 По Клиенты.Количество() - 1 Цикл
		Если Клиенты[НомерКлиента].Идентификатор = ТекущийИдентификатор Тогда
			ИндексКлиента = (НомерКлиента + 1) % Клиенты.Количество();
			Прервать;
		КонецЕсли;
	КонецЦикла;

	Клиент = Клиенты[ИндексКлиента];
	Контрагент = НайтиКонтрагентаПоСвязи(ОрганизацияПакета.id, Клиент.Идентификатор, Ложь);
	Если ЗначениеЗаполнено(Контрагент) Тогда
		Клиент.Представление = Клиент.Представление + " · связан: " + Строка(Контрагент);
	КонецЕсли;

	Возврат Новый Структура("Идентификатор,Представление,Контрагент", Клиент.Идентификатор,
		Клиент.Представление, Контрагент);
КонецФункции

&НаСервере
Функция СохранитьСопоставлениеКлиента(Адрес, ИдентификаторКлиента, Контрагент)
	Данные = ПрочитатьДанныеФайла(Адрес);
	ОрганизацияПакета = Неопределено;
	Если ТипЗнч(Данные) <> Тип("Структура")
		Или Не Данные.Свойство("organization", ОрганизацияПакета) Тогда
		ВызватьИсключение "В файле отсутствует организация.";
	КонецЕсли;
	ПроверитьОрганизациюДляСопоставления(ОрганизацияПакета);
	Если Не ЗначениеЗаполнено(Контрагент) Или Контрагент.ПометкаУдаления
		Или Контрагент.ЮридическоеФизическоеЛицо <> Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо Тогда
		ВызватьИсключение "Выберите действующего контрагента с видом «Физическое лицо».";
	КонецЕсли;

	КлиентЕстьВФайле = Ложь;
	Для Каждого Заказ Из Данные.orders Цикл
		Если СтроковоеПоле(Заказ, "clientId") = ИдентификаторКлиента
			И Не Заказ.isPaymentContextOnly И Заказ.status = "Completed" И Не Заказ.isDeleted
			И СтроковоеПоле(Заказ, "clientPartyTypeCode") = "person"
			И ПустаяСтрока(СтроковоеПоле(Заказ, "clientInn")) Тогда
			КлиентЕстьВФайле = Истина;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	Если Не КлиентЕстьВФайле И Данные.Свойство("payments") Тогда
		Для Каждого Платеж Из Данные.payments Цикл
			Если СтроковоеПоле(Платеж, "payerClientId") = ИдентификаторКлиента
				И СтроковоеПоле(Платеж, "payerPartyTypeCode") = "person"
				И ПустаяСтрока(СтроковоеПоле(Платеж, "payerInn")) Тогда
				КлиентЕстьВФайле = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Если Не КлиентЕстьВФайле Тогда
		ВызватьИсключение "Клиент без ИНН не найден в выбранном файле.";
	КонецЕсли;

	Свойство = ПолучитьСвойствоСопоставления(Истина);
	Ключ = КлючКлиента(ОрганизацияПакета.id, ИдентификаторКлиента);
	НачатьТранзакцию();
	Попытка
		Блокировка = Новый БлокировкаДанных;
		ЭлементБлокировки = Блокировка.Добавить("РегистрСведений.ДополнительныеСведения");
		ЭлементБлокировки.УстановитьЗначение("Свойство", Свойство);
		Блокировка.Заблокировать();
		СуществующийКонтрагент = НайтиКонтрагентаПоСвязи(ОрганизацияПакета.id, ИдентификаторКлиента, Ложь);
		Если СуществующийКонтрагент <> Контрагент Тогда
			СтароеЗначение = УправлениеСвойствами.ЗначениеСвойства(Контрагент, Свойство);
			НовоеЗначение = "";
			Если ТипЗнч(СтароеЗначение) = Тип("Строка") Тогда
				НовоеЗначение = СокрЛП(СтароеЗначение);
			КонецЕсли;
			Если Не ПустаяСтрока(НовоеЗначение) Тогда
				НовоеЗначение = НовоеЗначение + Символы.ПС;
			КонецЕсли;
			НовоеЗначение = НовоеЗначение + Ключ;
			Если СтрДлина(НовоеЗначение) > 1024 Тогда
				ВызватьИсключение "У этого контрагента слишком много связей CRM. Выберите отдельного контрагента.";
			КонецЕсли;
			Если ЗначениеЗаполнено(СуществующийКонтрагент) Тогда
				ПрежниеКлючи = Новый Массив;
				СтарыеСвязи = УправлениеСвойствами.ЗначениеСвойства(СуществующийКонтрагент, Свойство);
				Для Каждого СтрокаКлюча Из СтрРазделить(СтарыеСвязи, Символы.ПС, Ложь) Цикл
					Если СокрЛП(СтрокаКлюча) <> Ключ Тогда
						ПрежниеКлючи.Добавить(СокрЛП(СтрокаКлюча));
					КонецЕсли;
				КонецЦикла;
				ЗаписатьЗначениеСопоставления(СуществующийКонтрагент, Свойство, СтрСоединить(ПрежниеКлючи, Символы.ПС));
			КонецЕсли;
			ЗаписатьЗначениеСопоставления(Контрагент, Свойство, НовоеЗначение);
		КонецЕсли;
		ЗафиксироватьТранзакцию();
	Исключение
		ОтменитьТранзакцию();
		ВызватьИсключение;
	КонецПопытки;

	Если ЗначениеЗаполнено(СуществующийКонтрагент) И СуществующийКонтрагент <> Контрагент Тогда
		Возврат "Связь клиента изменена на «" + Строка(Контрагент)
			+ "». Ранее загруженные документы не изменены, проверьте их вручную.";
	КонецЕсли;

	Возврат "Клиент CRM связан с контрагентом «" + Строка(Контрагент) + "».";
КонецФункции

&НаСервере
Процедура ЗаписатьЗначениеСопоставления(Контрагент, Свойство, Значение)
	Значения = Новый ТаблицаЗначений;
	Значения.Колонки.Добавить("Свойство");
	Значения.Колонки.Добавить("Значение");
	СтрокаЗначения = Значения.Добавить();
	СтрокаЗначения.Свойство = Свойство;
	СтрокаЗначения.Значение = Значение;
	УправлениеСвойствами.ЗаписатьСвойстваУОбъекта(Контрагент, Значения);
КонецПроцедуры

&НаСервере
Процедура ПроверитьОрганизациюДляСопоставления(ОрганизацияПакета)
	Если Не ЗначениеЗаполнено(Организация1С) Тогда
		ВызватьИсключение "Выберите организацию в 1С.";
	КонецЕсли;
	Если ПустаяСтрока(СтроковоеПоле(ОрганизацияПакета, "id"))
		Или СтроковоеПоле(ОрганизацияПакета, "inn") <> СокрЛП(Организация1С.ИНН)
		Или (Не ПустаяСтрока(СтроковоеПоле(ОрганизацияПакета, "kpp"))
			И СтроковоеПоле(ОрганизацияПакета, "kpp") <> СокрЛП(Организация1С.КПП)) Тогда
		ВызватьИсключение "Реквизиты выбранной организации в 1С не совпадают с файлом.";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Функция ЗагрузитьЧерновики(ОрганизацияПакета, Заказы, Версия)
	Если Не ЗначениеЗаполнено(Организация1С) Тогда
		ВызватьИсключение "Выберите организацию в 1С.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Номенклатура1С) Или Не Номенклатура1С.Услуга Тогда
		ВызватьИсключение "Выберите номенклатуру с видом «Услуга».";
	КонецЕсли;

	Если Версия = 2 И СтавкаНДС1С <> Перечисления.СтавкиНДС.БезНДС Тогда
		ВызватьИсключение "Для старого формата файла выберите ставку «Без НДС».";
	КонецЕсли;

	ИннПакета = СтроковоеПоле(ОрганизацияПакета, "inn");
	Если ПустаяСтрока(ИннПакета) Или ИннПакета <> СокрЛП(Организация1С.ИНН) Тогда
		ВызватьИсключение "ИНН выбранной организации в 1С не совпадает с ИНН в файле.";
	КонецЕсли;

	КппПакета = СтроковоеПоле(ОрганизацияПакета, "kpp");
	Если Не ПустаяСтрока(КппПакета) И КппПакета <> СокрЛП(Организация1С.КПП) Тогда
		ВызватьИсключение "КПП выбранной организации в 1С не совпадает с КПП в файле.";
	КонецЕсли;

	Создано = 0;
	УжеЗагружено = 0;
	СОшибкой = 0;
	Ошибки = Новый Массив;
	Для Каждого Заказ Из Заказы Цикл
		Если Заказ.isPaymentContextOnly Или Заказ.status <> "Completed" Или Заказ.isDeleted Тогда
			Продолжить;
		КонецЕсли;

		Попытка
			НачатьТранзакцию();
			Если СоздатьЧерновикЗаказа(ОрганизацияПакета.id, Заказ, Версия) Тогда
				Создано = Создано + 1;
			Иначе
				УжеЗагружено = УжеЗагружено + 1;
			КонецЕсли;
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			СОшибкой = СОшибкой + 1;
			Если Ошибки.Количество() < 10 Тогда
				Ошибки.Добавить(Строка(Заказ.id) + ": " + ОписаниеОшибки());
			КонецЕсли;
		КонецПопытки;
	КонецЦикла;

	Для Каждого Ошибка Из Ошибки Цикл
		Сообщить(Ошибка);
	КонецЦикла;

	Возврат СтрШаблон(
		"Черновиков создано: %1. Уже загружено: %2. Не загружено: %3. Перед проведением проверьте счета и суммы.",
		Создано,
		УжеЗагружено,
		СОшибкой);
КонецФункции

&НаСервере
Функция ЗагрузитьЧерновикиОплат(ОрганизацияПакета, Платежи)
	Если Не ЗначениеЗаполнено(Организация1С) Тогда
		ВызватьИсключение "Выберите организацию в 1С.";
	КонецЕсли;

	ИннПакета = СтроковоеПоле(ОрганизацияПакета, "inn");
	Если ПустаяСтрока(ИннПакета) Или ИннПакета <> СокрЛП(Организация1С.ИНН) Тогда
		ВызватьИсключение "ИНН выбранной организации в 1С не совпадает с ИНН в файле.";
	КонецЕсли;

	КппПакета = СтроковоеПоле(ОрганизацияПакета, "kpp");
	Если Не ПустаяСтрока(КппПакета) И КппПакета <> СокрЛП(Организация1С.КПП) Тогда
		ВызватьИсключение "КПП выбранной организации в 1С не совпадает с КПП в файле.";
	КонецЕсли;

	Создано = 0;
	УжеЗагружено = 0;
	СОшибкой = 0;
	Для Каждого Платеж Из Платежи Цикл
		Попытка
			Если ТипЗнч(Платеж) <> Тип("Структура") Тогда
				ВызватьИсключение "Неверный формат оплаты.";
			КонецЕсли;

			Если СоздатьЧерновикОплаты(ОрганизацияПакета.id, Платеж) Тогда
				Создано = Создано + 1;
			Иначе
				УжеЗагружено = УжеЗагружено + 1;
			КонецЕсли;
		Исключение
			СОшибкой = СОшибкой + 1;
			Сообщить(СтроковоеПоле(Платеж, "id") + ": " + ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;

	Возврат СтрШаблон(
		"Черновиков оплат создано: %1. Уже загружено: %2. Требуют проверки: %3. Перед проведением сверьте кассу, эквайринг или выписку банка.",
		Создано,
		УжеЗагружено,
		СОшибкой);
КонецФункции

&НаСервере
Функция СоздатьЧерновикОплаты(ИдентификаторОрганизации, Платеж)
	Если ПустаяСтрока(СтроковоеПоле(Платеж, "id")) Или ПустаяСтрока(СтроковоеПоле(Платеж, "orderId")) Тогда
		ВызватьИсключение "В оплате нет идентификатора или заказа.";
	КонецЕсли;

	Если Платеж.isOpeningBalance Тогда
		ВызватьИсключение "Начальный остаток нельзя автоматически считать новой оплатой.";
	КонецЕсли;

	Если ЗначениеЗаполнено(Платеж.cancelledAtUtc) Тогда
		ВызватьИсключение "Оплата отменена в CRM. Проверьте ранее загруженный черновик в 1С вручную.";
	КонецЕсли;

	Если ТипЗнч(Платеж.amount) <> Тип("Число") Или Платеж.amount <= 0 Тогда
		ВызватьИсключение "Сумма оплаты должна быть больше нуля.";
	КонецЕсли;

	Способ = СтроковоеПоле(Платеж, "methodCode");
	Если Способ = "cash" Тогда
		ИмяДокумента = "ПриходныйКассовыйОрдер";
	ИначеЕсли Способ = "card" Тогда
		ИмяДокумента = "ОплатаПлатежнойКартой";
	ИначеЕсли Способ = "bank" Тогда
		ИмяДокумента = "ПоступлениеНаРасчетныйСчет";
	Иначе
		ВызватьИсключение "Способ оплаты не указан или не поддерживается для загрузки в 1С.";
	КонецЕсли;

	Если СтроковоеПоле(Платеж, "payerPartyTypeCode") = "person"
		И ПустаяСтрока(СтроковоеПоле(Платеж, "payerInn")) Тогда
		Контрагент = НайтиКонтрагентаПоСвязи(
			ИдентификаторОрганизации, СтроковоеПоле(Платеж, "payerClientId"));
	Иначе
		Контрагент = НайтиКонтрагентаПоРеквизитам(
			СтроковоеПоле(Платеж, "payerInn"), СтроковоеПоле(Платеж, "payerKpp"));
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ВызватьИсключение "Плательщик не найден в 1С. Для физлица без ИНН сначала свяжите клиента с контрагентом.";
	КонецЕсли;

	Договор = НайтиДоговор(Контрагент);
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ВызватьИсключение "Договор плательщика не найден однозначно в 1С.";
	КонецЕсли;

	ДатаДокумента = ДатаИзПакета(Платеж);
	Метка = "OPENCRM-PAYMENT:" + Строка(ИдентификаторОрганизации) + ":" + Строка(Платеж.id);
	ТипыОплат = Новый Массив;
	ТипыОплат.Добавить("ПриходныйКассовыйОрдер");
	ТипыОплат.Добавить("ОплатаПлатежнойКартой");
	ТипыОплат.Добавить("ПоступлениеНаРасчетныйСчет");
	Для Каждого ТипОплаты Из ТипыОплат Цикл
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Дата, Контрагент, ДоговорКонтрагента, ВидОперации, СуммаДокумента ИЗ Документ." + ТипОплаты
			+ " ГДЕ Организация = &Организация И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(255)) = &Метка");
		Запрос.УстановитьПараметр("Организация", Организация1С);
		Запрос.УстановитьПараметр("Метка", Метка);
		Выборка = Запрос.Выполнить().Выбрать();
		Если Не Выборка.Следующий() Тогда
			Продолжить;
		КонецЕсли;
		Если Способ = "cash" Тогда
			ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;
		ИначеЕсли Способ = "card" Тогда
			ВидОперации = Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя;
		Иначе
			ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя;
		КонецЕсли;
		Если ТипОплаты <> ИмяДокумента Тогда
			ВызватьИсключение "Ранее загруженная оплата имеет другой способ оплаты: " + Строка(Выборка.Ссылка) + ".";
		КонецЕсли;
		Если НачалоДня(Выборка.Дата) <> ДатаДокумента Тогда
			ВызватьИсключение "Ранее загруженная оплата имеет другую дату: " + Строка(Выборка.Ссылка) + ".";
		КонецЕсли;
		Если Выборка.Контрагент <> Контрагент Тогда
			ВызватьИсключение "Ранее загруженная оплата имеет другого контрагента: " + Строка(Выборка.Ссылка) + ".";
		КонецЕсли;
		Если Выборка.ДоговорКонтрагента <> Договор Тогда
			ВызватьИсключение "Ранее загруженная оплата имеет другой договор: " + Строка(Выборка.Ссылка)
				+ ". В документе: «" + Строка(Выборка.ДоговорКонтрагента) + "», ожидается: «" + Строка(Договор) + "».";
		КонецЕсли;
		Если Выборка.ВидОперации <> ВидОперации Тогда
			ВызватьИсключение "Ранее загруженная оплата имеет другой вид операции: " + Строка(Выборка.Ссылка) + ".";
		КонецЕсли;
		Если Выборка.СуммаДокумента <> Платеж.amount Тогда
			ВызватьИсключение "Ранее загруженная оплата имеет другую сумму: " + Строка(Выборка.Ссылка) + ".";
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;

	Если Не РазрешитьПохожиеДокументы Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ." + ИмяДокумента
			+ " ГДЕ Организация = &Организация И Контрагент = &Контрагент"
			+ " И Дата МЕЖДУ &НачалоДня И &КонецДня И СуммаДокумента = &Сумма");
		Запрос.УстановитьПараметр("Организация", Организация1С);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("НачалоДня", ДатаДокумента);
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаДокумента));
		Запрос.УстановитьПараметр("Сумма", Платеж.amount);
		Если Не Запрос.Выполнить().Пустой() Тогда
			ВызватьИсключение "В 1С уже есть похожая оплата. Проверьте её или разрешите похожие документы.";
		КонецЕсли;
	КонецЕсли;

	Если Способ = "cash" Тогда
		Документ = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
		Документ.ВидОперации = Перечисления.ВидыОперацийПКО.ОплатаПокупателя;
	ИначеЕсли Способ = "card" Тогда
		Документ = Документы.ОплатаПлатежнойКартой.СоздатьДокумент();
		Документ.ВидОперации = Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя;
	Иначе
		Документ = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
		Документ.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя;
	КонецЕсли;

	Документ.Дата = ДатаДокумента;
	Документ.Организация = Организация1С;
	Документ.Контрагент = Контрагент;
	Документ.ДоговорКонтрагента = Договор;
	Документ.СуммаДокумента = Платеж.amount;
	Документ.Комментарий = Метка;
	СтрокаПлатежа = Документ.РасшифровкаПлатежа.Добавить();
	СтрокаПлатежа.ДоговорКонтрагента = Договор;
	СтрокаПлатежа.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	СтрокаПлатежа.СуммаПлатежа = Платеж.amount;
	СтрокаПлатежа.СуммаВзаиморасчетов = Платеж.amount;
	МеткаЗаказа = "OPENCRM:" + Строка(ИдентификаторОрганизации) + ":" + Строка(Платеж.orderId);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.РеализацияТоваровУслуг"
		+ " ГДЕ Организация = &Организация И Контрагент = &Контрагент"
		+ " И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(255)) = &Метка");
	Запрос.УстановитьПараметр("Организация", Организация1С);
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Метка", МеткаЗаказа);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Документ.ДокументОснование = Выборка.Ссылка;
	КонецЕсли;
	Документ.Записать(РежимЗаписиДокумента.Запись);

	Возврат Истина;
КонецФункции

&НаСервере
Функция СоздатьЧерновикЗаказа(ИдентификаторОрганизации, Заказ, Версия)
	Если ПустаяСтрока(СтроковоеПоле(Заказ, "clientId")) Тогда
		ВызватьИсключение "У заказа не указан покупатель в CRM.";
	КонецЕсли;

	Метка = "OPENCRM:" + Строка(ИдентификаторОрганизации) + ":" + Строка(Заказ.id);
	ДатаДокумента = ДатаИзПакета(Заказ);
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка, Дата, СуммаДокумента ИЗ Документ.РеализацияТоваровУслуг "
		+ "ГДЕ Организация = &Организация И ВЫРАЗИТЬ(Комментарий КАК СТРОКА(255)) = &Метка");
	Запрос.УстановитьПараметр("Организация", Организация1С);
	Запрос.УстановитьПараметр("Метка", Метка);
	РанееЗагруженный = Запрос.Выполнить().Выбрать();
	РанееЗагруженныйСсылка = Неопределено;
	Если РанееЗагруженный.Следующий() Тогда
		Если НачалоДня(РанееЗагруженный.Дата) <> ДатаДокумента
			Или РанееЗагруженный.СуммаДокумента <> Заказ.netAmount Тогда
			ВызватьИсключение "Ранее загруженный заказ изменился. Проверьте реализацию " + Строка(РанееЗагруженный.Ссылка) + ".";
		КонецЕсли;
		РанееЗагруженныйСсылка = РанееЗагруженный.Ссылка;
	КонецЕсли;

	Контрагент = НайтиКонтрагента(ИдентификаторОрганизации, Заказ);
	Если Не ЗначениеЗаполнено(Контрагент) Тогда
		ВызватьИсключение "Покупатель не найден в 1С. Для физлица без ИНН сначала свяжите клиента с контрагентом.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(РанееЗагруженныйСсылка) Тогда
		Запрос = Новый Запрос(
			"ВЫБРАТЬ ПЕРВЫЕ 1 Ссылка ИЗ Документ.РеализацияТоваровУслуг "
			+ "ГДЕ Организация = &Организация И Контрагент = &Контрагент "
			+ "И Дата МЕЖДУ &НачалоДня И &КонецДня И СуммаДокумента = &Сумма");
		Запрос.УстановитьПараметр("Организация", Организация1С);
		Запрос.УстановитьПараметр("Контрагент", Контрагент);
		Запрос.УстановитьПараметр("НачалоДня", ДатаДокумента);
		Запрос.УстановитьПараметр("КонецДня", КонецДня(ДатаДокумента));
		Запрос.УстановитьПараметр("Сумма", Заказ.netAmount);
		Если Не Запрос.Выполнить().Пустой() И Не РазрешитьПохожиеДокументы Тогда
			ВызватьИсключение "В 1С уже есть реализация этого контрагента на ту же дату и сумму. Проверьте её. Если это другой заказ, включите «Разрешить похожие документы» и повторите загрузку.";
		КонецЕсли;
	КонецЕсли;

	Договор = НайтиДоговор(Контрагент);
	Если Не ЗначениеЗаполнено(Договор) Тогда
		ВызватьИсключение "Договор покупателя не найден однозначно в 1С.";
	КонецЕсли;

	СтрокиЗаказа = Неопределено;
	Если Не Заказ.Свойство("lines", СтрокиЗаказа) Или ТипЗнч(СтрокиЗаказа) <> Тип("Массив")
		Или СтрокиЗаказа.Количество() = 0 Тогда
		ВызватьИсключение "В заказе нет строк работ.";
	КонецЕсли;

	Если Заказ.netAmount <= 0 Или Заказ.grossAmount <= 0
		Или Заказ.netAmount > Заказ.grossAmount Тогда
		ВызватьИсключение "Проверьте сумму и скидку заказа.";
	КонецЕсли;

	ВаловаяСуммаСтрок = 0;
	Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
		Если ТипЗнч(СтрокаЗаказа) <> Тип("Структура") Тогда
			ВызватьИсключение "Строка заказа имеет неверный формат.";
		КонецЕсли;

		ЦенаСтроки = Неопределено;
		Если Не СтрокаЗаказа.Свойство("totalPrice", ЦенаСтроки)
			Или ТипЗнч(ЦенаСтроки) <> Тип("Число") Тогда
			ВызватьИсключение "Стоимость одной из работ не указана. Укажите её в CRM перед загрузкой в 1С.";
		КонецЕсли;
		ВаловаяСуммаСтрок = ВаловаяСуммаСтрок + ЦенаСтроки;
	КонецЦикла;
	Если Окр(ВаловаяСуммаСтрок, 2) <> Заказ.grossAmount Тогда
		ВызватьИсключение "Сумма строк не совпадает с суммой заказа.";
	КонецЕсли;

	Документ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	Документ.Дата = ДатаДокумента;
	Документ.ВидОперации = Перечисления.ВидыОперацийРеализацияТоваров.Услуги;
	Документ.Организация = Организация1С;
	Документ.Контрагент = Контрагент;
	Документ.ДоговорКонтрагента = Договор;
	ЕстьНДС = Ложь;
	Если Версия = 3 Тогда
		Для Каждого СтрокаЗаказа Из СтрокиЗаказа Цикл
			Если СтроковоеПоле(СтрокаЗаказа, "vatRateCode") <> "without_vat" Тогда
				ЕстьНДС = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	Документ.СуммаВключаетНДС = ЕстьНДС;
	Документ.ДокументБезНДС = Не ЕстьНДС;
	Документ.Комментарий = Метка;

	ЗаполнитьСтрокиУслуг(Документ, Заказ, СтрокиЗаказа, Версия);
	Документ.СуммаДокумента = Заказ.netAmount;
	Если ЗначениеЗаполнено(РанееЗагруженныйСсылка) Тогда
		Существующий = РанееЗагруженныйСсылка.ПолучитьОбъект();
		Если Существующий.Контрагент <> Документ.Контрагент
			Или Существующий.ДоговорКонтрагента <> Документ.ДоговорКонтрагента
			Или Существующий.СуммаВключаетНДС <> Документ.СуммаВключаетНДС
			Или Существующий.ДокументБезНДС <> Документ.ДокументБезНДС
			Или Существующий.Услуги.Количество() <> Документ.Услуги.Количество() Тогда
			ВызватьИсключение "Ранее загруженный заказ изменился. Проверьте реализацию " + Строка(РанееЗагруженныйСсылка) + ".";
		КонецЕсли;
		Для Индекс = 0 По Документ.Услуги.Количество() - 1 Цикл
			Если Существующий.Услуги[Индекс].Содержание <> Документ.Услуги[Индекс].Содержание
				Или Существующий.Услуги[Индекс].Количество <> Документ.Услуги[Индекс].Количество
				Или Существующий.Услуги[Индекс].Цена <> Документ.Услуги[Индекс].Цена
				Или Существующий.Услуги[Индекс].Сумма <> Документ.Услуги[Индекс].Сумма
				Или Существующий.Услуги[Индекс].СтавкаНДС <> Документ.Услуги[Индекс].СтавкаНДС
				Или Существующий.Услуги[Индекс].СуммаНДС <> Документ.Услуги[Индекс].СуммаНДС Тогда
				ВызватьИсключение "Строки ранее загруженного заказа изменились. Проверьте реализацию " + Строка(РанееЗагруженныйСсылка) + ".";
			КонецЕсли;
		КонецЦикла;
		Возврат Ложь;
	КонецЕсли;

	Документ.Записать(РежимЗаписиДокумента.Запись);
	СохраненныйДокумент = Документ.Ссылка.ПолучитьОбъект();
	Если СохраненныйДокумент.СуммаДокумента <> Заказ.netAmount
		Или СохраненныйДокумент.Услуги.Количество() <> Документ.Услуги.Количество() Тогда
		ВызватьИсключение "Суммы черновика изменились при записи в 1С.";
	КонецЕсли;
	Для Индекс = 0 По Документ.Услуги.Количество() - 1 Цикл
		Если СохраненныйДокумент.Услуги[Индекс].Сумма <> Документ.Услуги[Индекс].Сумма
			Или СохраненныйДокумент.Услуги[Индекс].СуммаНДС <> Документ.Услуги[Индекс].СуммаНДС
			Или СохраненныйДокумент.Услуги[Индекс].СтавкаНДС <> Документ.Услуги[Индекс].СтавкаНДС Тогда
			ВызватьИсключение "НДС или суммы строк изменились при записи в 1С.";
		КонецЕсли;
	КонецЦикла;

	Возврат Истина;
КонецФункции

&НаСервере
Функция НайтиКонтрагента(ИдентификаторОрганизации, Заказ)
	Инн = СтроковоеПоле(Заказ, "clientInn");
	Кпп = СтроковоеПоле(Заказ, "clientKpp");
	Если СтроковоеПоле(Заказ, "clientPartyTypeCode") = "person" И ПустаяСтрока(Инн) Тогда
		Возврат НайтиКонтрагентаПоСвязи(
			ИдентификаторОрганизации, СтроковоеПоле(Заказ, "clientId"));
	КонецЕсли;

	Возврат НайтиКонтрагентаПоРеквизитам(Инн, Кпп);
КонецФункции

&НаСервере
Функция НайтиКонтрагентаПоСвязи(ИдентификаторОрганизации, ИдентификаторКлиента, ПроверятьВид = Истина)
	Если ПустаяСтрока(ИдентификаторОрганизации) Или ПустаяСтрока(ИдентификаторКлиента) Тогда
		Возврат Неопределено;
	КонецЕсли;
	Свойство = ПолучитьСвойствоСопоставления(Ложь);
	Если Не ЗначениеЗаполнено(Свойство) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ Объект, Значение ИЗ РегистрСведений.ДополнительныеСведения"
		+ " ГДЕ Свойство = &Свойство");
	Запрос.УстановитьПараметр("Свойство", Свойство);
	Выборка = Запрос.Выполнить().Выбрать();
	Ключ = КлючКлиента(ИдентификаторОрганизации, ИдентификаторКлиента);
	Контрагент = Неопределено;
	Пока Выборка.Следующий() Цикл
		Если ТипЗнч(Выборка.Объект) <> Тип("СправочникСсылка.Контрагенты")
			Или Не СодержитКлючКлиента(Выборка.Значение, Ключ) Тогда
			Продолжить;
		КонецЕсли;
		Если ЗначениеЗаполнено(Контрагент) Тогда
			ВызватьИсключение "Один клиент CRM связан с несколькими контрагентами в 1С.";
		КонецЕсли;
		Контрагент = Выборка.Объект;
	КонецЦикла;
	Если ПроверятьВид И ЗначениеЗаполнено(Контрагент)
		И (Контрагент.ПометкаУдаления
			Или Контрагент.ЮридическоеФизическоеЛицо <> Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо) Тогда
		ВызватьИсключение "Связанный с клиентом контрагент удалён или больше не является физическим лицом. Исправьте связь.";
	КонецЕсли;

	Возврат Контрагент;
КонецФункции

&НаСервере
Функция ПолучитьСвойствоСопоставления(Создать)
	Наименование = "OpenCRM: идентификаторы клиентов";
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка, ТипЗначения ИЗ ПланВидовХарактеристик.ДополнительныеРеквизитыИСведения"
		+ " ГДЕ НЕ ПометкаУдаления И Наименование = &Наименование И ЭтоДополнительноеСведение");
	Запрос.УстановитьПараметр("Наименование", Наименование);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ТипЗначения <> Новый ОписаниеТипов("Строка") Тогда
			ВызватьИсключение "Свойство сопоставления CRM имеет неверный тип в 1С.";
		КонецЕсли;
		Свойство = Выборка.Ссылка;
		Если Выборка.Следующий() Тогда
			ВызватьИсключение "В 1С найдено несколько свойств сопоставления CRM.";
		КонецЕсли;
	Иначе
		Если Не Создать Тогда
			Возврат Неопределено;
		КонецЕсли;
		СвойствоОбъект = ПланыВидовХарактеристик.ДополнительныеРеквизитыИСведения.СоздатьЭлемент();
		СвойствоОбъект.Наименование = Наименование;
		СвойствоОбъект.Заголовок = Наименование;
		СвойствоОбъект.Комментарий = "Связь клиентов CRM с контрагентами этой базы 1С.";
		СвойствоОбъект.ТипЗначения = Новый ОписаниеТипов("Строка");
		СвойствоОбъект.ЭтоДополнительноеСведение = Истина;
		СвойствоОбъект.Записать();
		Свойство = СвойствоОбъект.Ссылка;
	КонецЕсли;

	Набор = Справочники.НаборыДополнительныхРеквизитовИСведений.Справочник_Контрагенты.ПолучитьОбъект();
	Если Набор.ДополнительныеСведения.Найти(Свойство, "Свойство") = Неопределено Тогда
		Если Создать Тогда
			НоваяСтрока = Набор.ДополнительныеСведения.Добавить();
			НоваяСтрока.Свойство = Свойство;
			Набор.Записать();
		Иначе
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;

	Возврат Свойство;
КонецФункции

&НаСервере
Функция КлючКлиента(ИдентификаторОрганизации, ИдентификаторКлиента)
	Возврат "OPENCRM:" + Строка(ИдентификаторОрганизации) + ":" + Строка(ИдентификаторКлиента);
КонецФункции

&НаСервере
Функция СодержитКлючКлиента(Значение, Ключ)
	Если ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат Ложь;
	КонецЕсли;
	Для Каждого СтрокаКлюча Из СтрРазделить(Значение, Символы.ПС, Ложь) Цикл
		Если СокрЛП(СтрокаКлюча) = Ключ Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;

	Возврат Ложь;
КонецФункции

&НаСервере
Функция НайтиКонтрагентаПоРеквизитам(Инн, Кпп)
	Если ПустаяСтрока(Инн) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.Контрагенты "
		+ "ГДЕ НЕ ПометкаУдаления И ИНН = &ИНН И КПП = &КПП");
	Запрос.УстановитьПараметр("ИНН", Инн);
	Запрос.УстановитьПараметр("КПП", Кпп);

	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Контрагент = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Контрагент;
КонецФункции

&НаСервере
Функция НайтиДоговор(Контрагент)
	Запрос = Новый Запрос(
		"ВЫБРАТЬ ПЕРВЫЕ 2 Ссылка ИЗ Справочник.ДоговорыКонтрагентов "
		+ "ГДЕ НЕ ПометкаУдаления И Владелец = &Контрагент И Организация = &Организация "
		+ "И ВидДоговора = &ВидДоговора");
	Запрос.УстановитьПараметр("Контрагент", Контрагент);
	Запрос.УстановитьПараметр("Организация", Организация1С);
	Запрос.УстановитьПараметр("ВидДоговора", Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Не Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Договор = Выборка.Ссылка;
	Если Выборка.Следующий() Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Договор;
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокиУслуг(Документ, Заказ, СтрокиЗаказа, Версия)
	Остаток = Заказ.netAmount;
	СуммаВсехСтрок = 0;
	Для Индекс = 0 По СтрокиЗаказа.Количество() - 1 Цикл
		СтрокаЗаказа = СтрокиЗаказа[Индекс];
		Если ТипЗнч(СтрокаЗаказа) <> Тип("Структура") Тогда
			ВызватьИсключение "Строка заказа имеет неверный формат.";
		КонецЕсли;

		ЦенаСтроки = Неопределено;
		КоличествоСтроки = Неопределено;
		Если Не СтрокаЗаказа.Свойство("totalPrice", ЦенаСтроки) Тогда
			ВызватьИсключение "В строке заказа отсутствует цена.";
		КонецЕсли;

		Если Не СтрокаЗаказа.Свойство("quantity", КоличествоСтроки) Тогда
			ВызватьИсключение "В строке заказа отсутствует количество.";
		КонецЕсли;

		Если ТипЗнч(ЦенаСтроки) <> Тип("Число") Или ТипЗнч(КоличествоСтроки) <> Тип("Число")
			Или КоличествоСтроки <= 0 Или КоличествоСтроки <> Цел(КоличествоСтроки)
			Или ЦенаСтроки < 0 Тогда
			ВызватьИсключение "В заказе обнаружена неверная цена или количество.";
		КонецЕсли;

		Если Версия = 3 Тогда
			СуммаСтроки = Неопределено;
			СуммаНДС = Неопределено;
			Если Не СтрокаЗаказа.Свойство("discountedTotalPrice", СуммаСтроки)
				Или Не СтрокаЗаказа.Свойство("vatAmount", СуммаНДС)
				Или ТипЗнч(СуммаСтроки) <> Тип("Число")
				Или ТипЗнч(СуммаНДС) <> Тип("Число") Тогда
				ВызватьИсключение "В строке заказа отсутствуют сумма после скидки или НДС.";
			КонецЕсли;
			КодСтавки = СтроковоеПоле(СтрокаЗаказа, "vatRateCode");
			СтавкаСтроки = СтавкаНДСПоКоду(КодСтавки);
			Если СуммаСтроки < 0 Или СуммаСтроки > ЦенаСтроки Или СуммаНДС < 0
				Или СуммаНДС > СуммаСтроки Тогда
				ВызватьИсключение "Проверьте сумму скидки и НДС строки заказа.";
			КонецЕсли;
			Если КодСтавки = "without_vat" Или КодСтавки = "0" Тогда
				ОжидаемыйНДС = 0;
			Иначе
				ПроцентНДС = Число(КодСтавки);
				ОжидаемыйНДС = Окр(СуммаСтроки * ПроцентНДС / (100 + ПроцентНДС), 2);
			КонецЕсли;
			Если СуммаНДС - ОжидаемыйНДС > 0.01 Или ОжидаемыйНДС - СуммаНДС > 0.01 Тогда
				ВызватьИсключение "Сумма НДС строки не соответствует ставке.";
			КонецЕсли;
		Иначе
			Если Индекс = СтрокиЗаказа.Количество() - 1 Тогда
				СуммаСтроки = Остаток;
			Иначе
				СуммаСтроки = Окр(ЦенаСтроки * Заказ.netAmount / Заказ.grossAmount, 2);
				Если СуммаСтроки > Остаток Тогда
					СуммаСтроки = Остаток;
				КонецЕсли;
				Остаток = Остаток - СуммаСтроки;
			КонецЕсли;
			СтавкаСтроки = СтавкаНДС1С;
			СуммаНДС = 0;
		КонецЕсли;

		Если СуммаСтроки < 0 Тогда
			ВызватьИсключение "Скидка больше суммы работ.";
		КонецЕсли;

		ЦенаВКопейках = Цел(Окр(СуммаСтроки * 100, 0) / КоличествоСтроки);
		КоличествоПоПовышеннойЦене = Окр(СуммаСтроки * 100 - ЦенаВКопейках * КоличествоСтроки, 0);
		КоличествоПоБазовойЦене = КоличествоСтроки - КоличествоПоПовышеннойЦене;
		Если ЦенаВКопейках = 0 И КоличествоПоПовышеннойЦене > 0 Тогда
			ВызватьИсключение "Сумму строки нельзя распределить по количеству без нулевой цены в 1С.";
		КонецЕсли;

		НазваниеСтроки = Лев(СтроковоеПоле(СтрокаЗаказа, "name"), 1000);
		Если КоличествоПоБазовойЦене > 0 Тогда
			СуммаПоБазовойЦене = ЦенаВКопейках * КоличествоПоБазовойЦене / 100;
			Если КоличествоПоПовышеннойЦене = 0 Тогда
				НдсПоБазовойЦене = СуммаНДС;
			Иначе
				НдсПоБазовойЦене = Окр(СуммаНДС * СуммаПоБазовойЦене / СуммаСтроки, 2);
			КонецЕсли;
			ДобавитьСтрокуУслуги(Документ, НазваниеСтроки, КоличествоПоБазовойЦене,
				ЦенаВКопейках / 100, СуммаПоБазовойЦене, СтавкаСтроки, НдсПоБазовойЦене);
		КонецЕсли;
		Если КоличествоПоПовышеннойЦене > 0 Тогда
			ДобавитьСтрокуУслуги(Документ, НазваниеСтроки, КоличествоПоПовышеннойЦене,
				(ЦенаВКопейках + 1) / 100, СуммаСтроки - СуммаПоБазовойЦене,
				СтавкаСтроки, СуммаНДС - НдсПоБазовойЦене);
		КонецЕсли;
		СуммаВсехСтрок = СуммаВсехСтрок + СуммаСтроки;
	КонецЦикла;
	Если Окр(СуммаВсехСтрок, 2) <> Заказ.netAmount Тогда
		ВызватьИсключение "Сумма строк после скидки не совпадает с суммой заказа.";
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ДобавитьСтрокуУслуги(Документ, Название, Количество, Цена, Сумма, СтавкаНДС, СуммаНДС)
	СтрокаУслуги = Документ.Услуги.Добавить();
	СтрокаУслуги.Номенклатура = Номенклатура1С;
	СтрокаУслуги.Содержание = Название;
	СтрокаУслуги.Количество = Количество;
	СтрокаУслуги.Цена = Цена;
	СтрокаУслуги.Сумма = Сумма;
	СтрокаУслуги.СтавкаНДС = СтавкаНДС;
	СтрокаУслуги.СуммаНДС = СуммаНДС;
КонецПроцедуры

&НаСервере
Функция СтавкаНДСПоКоду(КодСтавки)
	Если КодСтавки = "without_vat" Тогда
		Возврат Перечисления.СтавкиНДС.БезНДС;
	КонецЕсли;
	Если КодСтавки <> "0" И КодСтавки <> "5" И КодСтавки <> "7"
		И КодСтавки <> "10" И КодСтавки <> "20" И КодСтавки <> "22" Тогда
		ВызватьИсключение "В строке заказа не указана допустимая ставка НДС.";
	КонецЕсли;

	НайденнаяСтавка = Неопределено;
	Для Каждого МетаСтавка Из Метаданные.Перечисления.СтавкиНДС.ЗначенияПеречисления Цикл
		ИмяСтавки = МетаСтавка.Имя;
		ЗначениеСтавки = Перечисления.СтавкиНДС[ИмяСтавки];
		Представление = СокрЛП(Строка(ЗначениеСтавки));
		Если ИмяСтавки <> "НДС" + КодСтавки
			И Представление <> КодСтавки + "%"
			И Представление <> "НДС " + КодСтавки + "%"
			И Представление <> "НДС " + КодСтавки + " %" Тогда
			Продолжить;
		КонецЕсли;
		Если НайденнаяСтавка <> Неопределено Тогда
			ВызватьИсключение "Ставка НДС " + КодСтавки + "% неоднозначна в этой конфигурации 1С.";
		КонецЕсли;
		НайденнаяСтавка = ЗначениеСтавки;
	КонецЦикла;
	Если НайденнаяСтавка = Неопределено Тогда
		ВызватьИсключение "Ставка НДС " + КодСтавки + "% отсутствует в этой конфигурации 1С.";
	КонецЕсли;

	Возврат НайденнаяСтавка;
КонецФункции

&НаСервере
Функция ДатаИзПакета(Заказ)
	ЗначениеДаты = СтроковоеПоле(Заказ, "accountingDate");
	Если СтрДлина(ЗначениеДаты) <> 10 Тогда
		ВызватьИсключение "В заказе отсутствует дата для бухгалтерии. Скачайте новый файл.";
	КонецЕсли;

	Попытка
		Возврат Дата(
			Число(Лев(ЗначениеДаты, 4)),
			Число(Сред(ЗначениеДаты, 6, 2)),
			Число(Прав(ЗначениеДаты, 2)));
	Исключение
		ВызватьИсключение "Неверная дата заказа для бухгалтерии.";
	КонецПопытки;
КонецФункции

&НаСервере
Функция СтроковоеПоле(Данные, Имя)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "";
	КонецЕсли;

	Значение = Неопределено;
	Если Не Данные.Свойство(Имя, Значение) Или ТипЗнч(Значение) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат СокрЛП(Значение);
КонецФункции

&НаСервере
Функция ПолучитьИмяПроектаПакета(Данные)
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат "CRM";
	КонецЕсли;

	ИмяПроекта = СокрЛП(СтроковоеПоле(Данные, "projectName"));
	Если ПустаяСтрока(ИмяПроекта) Тогда
		Возврат "CRM";
	КонецЕсли;

	Возврат ИмяПроекта;
КонецФункции
